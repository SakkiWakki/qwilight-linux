+{
+    struct composition_object object;   /* must be first: owns the refcount */
+    ICompositionEffectBrush ICompositionEffectBrush_iface;  /* the [default] interface */
+    ICompositionBrush ICompositionBrush_iface;
+
+    IGraphicsEffect *effect;            /* the graph description, strong */
+    struct list sources;                /* struct effect_source_binding */
+};
