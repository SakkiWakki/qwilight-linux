diff --git a/dlls/windows.ui.composition/object.c b/dlls/windows.ui.composition/object.c
new file mode 100644
index 00000000..feced978
--- /dev/null
+++ b/dlls/windows.ui.composition/object.c
@@ -0,0 +1,405 @@
+/*
+ * Windows.UI.Composition.CompositionObject — the shared base every composition
+ * class embeds.
+ *
+ * Copyright (C) 2026 Wine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(composition);
+
+/*
+ * These objects are record-only: they remember the properties a caller sets and
+ * hand them back, and they compose nothing.  That is enough for the Windows App
+ * SDK's SystemBackdrops (Mica/Acrylic) fallback path, which builds a colour
+ * brush, reads its Comment, and hands it to XAML.  Everything that would need a
+ * real DirectComposition object behind it is a FIXME.
+ */
+
+static inline struct composition_object *impl_from_ICompositionObject( ICompositionObject *iface )
+{
+    return CONTAINING_RECORD( iface, struct composition_object, ICompositionObject_iface );
+}
+
+HRESULT composition_object_query_interface( struct composition_object *obj, REFIID iid, void **out )
+{
+    HRESULT hr;
+
+    TRACE( "obj %p, iid %s, out %p.\n", obj, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    /* the derived class's own interfaces, including its [default] one */
+    if (obj->ops->query_interface && (hr = obj->ops->query_interface( obj, iid, out )) != E_NOINTERFACE)
+        return hr;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = obj->default_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ICompositionObject ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&obj->ICompositionObject_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ICompositionObject2 ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&obj->ICompositionObject2_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&obj->IClosable_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+ULONG composition_object_add_ref( struct composition_object *obj )
+{
+    ULONG ref = InterlockedIncrement( &obj->ref );
+    TRACE( "obj %p, ref %lu.\n", obj, ref );
+    return ref;
+}
+
+ULONG composition_object_release( struct composition_object *obj )
+{
+    ULONG ref = InterlockedDecrement( &obj->ref );
+
+    TRACE( "obj %p, ref %lu.\n", obj, ref );
+
+    if (!ref)
+    {
+        if (obj->comment) WindowsDeleteString( obj->comment );
+        if (obj->compositor) ICompositor_Release( obj->compositor );
+        obj->ops->destroy( obj );
+    }
+    return ref;
+}
+
+HRESULT composition_object_get_iids( struct composition_object *obj, ULONG *iid_count, IID **iids )
+{
+    FIXME( "obj %p, iid_count %p, iids %p stub!\n", obj, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+HRESULT composition_object_get_runtime_class_name( struct composition_object *obj, HSTRING *class_name )
+{
+    TRACE( "obj %p, class_name %p.\n", obj, class_name );
+    return WindowsCreateString( obj->ops->class_name, obj->ops->class_name_len, class_name );
+}
+
+HRESULT composition_object_get_trust_level( struct composition_object *obj, TrustLevel *trust_level )
+{
+    TRACE( "obj %p, trust_level %p.\n", obj, trust_level );
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+/*
+ * ICompositionObject {bcb4ad45-7609-4550-934f-16002a68fded} — vtable order taken
+ * from include/windows.ui.composition.idl, which matches mingw-w64's
+ * windows.ui.composition.h (get_Compositor, get_Dispatcher, get_Properties,
+ * StartAnimation, StopAnimation).
+ */
+static HRESULT WINAPI composition_object_QueryInterface( ICompositionObject *iface, REFIID iid, void **out )
+{
+    return composition_object_query_interface( impl_from_ICompositionObject( iface ), iid, out );
+}
+
+static ULONG WINAPI composition_object_AddRef( ICompositionObject *iface )
+{
+    return composition_object_add_ref( impl_from_ICompositionObject( iface ) );
+}
+
+static ULONG WINAPI composition_object_Release( ICompositionObject *iface )
+{
+    return composition_object_release( impl_from_ICompositionObject( iface ) );
+}
+
+static HRESULT WINAPI composition_object_GetIids( ICompositionObject *iface, ULONG *iid_count, IID **iids )
+{
+    return composition_object_get_iids( impl_from_ICompositionObject( iface ), iid_count, iids );
+}
+
+static HRESULT WINAPI composition_object_GetRuntimeClassName( ICompositionObject *iface, HSTRING *class_name )
+{
+    return composition_object_get_runtime_class_name( impl_from_ICompositionObject( iface ), class_name );
+}
+
+static HRESULT WINAPI composition_object_GetTrustLevel( ICompositionObject *iface, TrustLevel *trust_level )
+{
+    return composition_object_get_trust_level( impl_from_ICompositionObject( iface ), trust_level );
+}
+
+static HRESULT WINAPI composition_object_get_Compositor( ICompositionObject *iface, ICompositor **value )
+{
+    struct composition_object *obj = impl_from_ICompositionObject( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if ((*value = obj->compositor)) ICompositor_AddRef( *value );
+    return S_OK;
+}
+
+/* A desktop (non-CoreWindow) composition object has no CoreDispatcher; Windows
+ * returns S_OK with a null pointer here, and C++/WinRT turns that into a null
+ * CoreDispatcher rather than throwing. */
+static HRESULT WINAPI composition_object_get_Dispatcher( ICompositionObject *iface, ICoreDispatcher **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI composition_object_get_Properties( ICompositionObject *iface, ICompositionPropertySet **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+/* Record-only: there is no animation engine here.  S_OK rather than E_NOTIMPL
+ * because every caller in the App SDK is C++/WinRT, i.e. a failure is an
+ * uncatchable throw on whatever thread it happens on. */
+static HRESULT WINAPI composition_object_StartAnimation( ICompositionObject *iface, HSTRING name,
+                                                         ICompositionAnimation *animation )
+{
+    FIXME( "iface %p, name %s, animation %p semi-stub!\n", iface, debugstr_hstring( name ), animation );
+    return S_OK;
+}
+
+static HRESULT WINAPI composition_object_StopAnimation( ICompositionObject *iface, HSTRING name )
+{
+    FIXME( "iface %p, name %s semi-stub!\n", iface, debugstr_hstring( name ) );
+    return S_OK;
+}
+
+static const struct ICompositionObjectVtbl composition_object_vtbl =
+{
+    composition_object_QueryInterface,
+    composition_object_AddRef,
+    composition_object_Release,
+    /* IInspectable */
+    composition_object_GetIids,
+    composition_object_GetRuntimeClassName,
+    composition_object_GetTrustLevel,
+    /* ICompositionObject */
+    composition_object_get_Compositor,
+    composition_object_get_Dispatcher,
+    composition_object_get_Properties,
+    composition_object_StartAnimation,
+    composition_object_StopAnimation,
+};
+
+/*
+ * ICompositionObject2 {ef874ea1-5cff-4b68-9e30-a1519d08ba03}.  Slot 6 is
+ * get_Comment: verified from wuceffectsi.dll rva 0x3105c, which QIs for this IID
+ * and then calls *(vtable + 0x30).  The rest of the order comes from
+ * Microsoft.UI.Composition.ICompositionObject2 in the shipped Microsoft.UI.winmd.
+ * BaseController::Crossfade (wuceffectsi rva 0x31268) compares the Comment of the
+ * brush it is given against L"Crossfade" to decide whether the brush is one of its
+ * own crossfade brushes, so a brush that has never had a comment set must return a
+ * null/empty HSTRING here, not fail.
+ */
+static inline struct composition_object *impl_from_ICompositionObject2( ICompositionObject2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct composition_object, ICompositionObject2_iface );
+}
+
+static HRESULT WINAPI composition_object2_QueryInterface( ICompositionObject2 *iface, REFIID iid, void **out )
+{
+    return composition_object_query_interface( impl_from_ICompositionObject2( iface ), iid, out );
+}
+
+static ULONG WINAPI composition_object2_AddRef( ICompositionObject2 *iface )
+{
+    return composition_object_add_ref( impl_from_ICompositionObject2( iface ) );
+}
+
+static ULONG WINAPI composition_object2_Release( ICompositionObject2 *iface )
+{
+    return composition_object_release( impl_from_ICompositionObject2( iface ) );
+}
+
+static HRESULT WINAPI composition_object2_GetIids( ICompositionObject2 *iface, ULONG *iid_count, IID **iids )
+{
