+/*
+ * Windows Animation Manager 2 (IUIAnimationManager2 and friends)
+ *
+ * A real, minimal animation engine: variables (up to WAM_MAX_DIM dimensions), storyboards
+ * made of transitions placed sequentially per variable or at keyframes, and the transition
+ * library's curve shapes. The host drives it by calling IUIAnimationManager2::Update() with
+ * its clock; value changes are reported through the change handlers. This is what the
+ * WinAppSDK's DirectManipulation uses to animate scrolling.
+ *
+ * Copyright 2026 The Wine Project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "uianimation.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(uianimation);
+
+#define WAM_MAX_DIM 4
+#define WAM_MAX_KEYFRAMES 64
+
+enum transition_kind
+{
+    T_INSTANT, T_CONSTANT, T_DISCRETE, T_LINEAR, T_LINEAR_SPEED, T_SIN_VELOCITY, T_SIN_RANGE,
+    T_ACCEL_DECEL, T_REVERSAL, T_CUBIC, T_SMOOTH_STOP, T_PARABOLIC, T_BEZIER, T_INTERPOLATOR,
+};
+
+struct transition2
+{
+    IUIAnimationTransition2 IUIAnimationTransition2_iface;
+    LONG ref;
+    enum transition_kind kind;
+    UINT dim;
+    double duration;                 /* as created; may be resolved at schedule time */
+    BOOL duration_known;
+    double final[WAM_MAX_DIM], final_velocity[WAM_MAX_DIM];
+    double initial[WAM_MAX_DIM], initial_velocity[WAM_MAX_DIM];
+    BOOL has_initial, has_initial_velocity;
+    double delay, hold, speed, period, minimum, maximum, accel_ratio, decel_ratio, acceleration;
+    double x1, y1, x2, y2;
+    UI_ANIMATION_SLOPE slope;
+    IUIAnimationInterpolator2 *interpolator;
+    /* resolved for the storyboard it is scheduled in */
+    double start_value[WAM_MAX_DIM], start_velocity[WAM_MAX_DIM], end_value[WAM_MAX_DIM];
+    double resolved_duration;
+    BOOL scheduled;                  /* a transition belongs to at most one storyboard */
+};
+
+struct variable2
+{
+    IUIAnimationVariable2 IUIAnimationVariable2_iface;
+    LONG ref;
+    struct manager2 *manager;
+    struct list entry;               /* manager->variables */
+    UINT dim;
+    double value[WAM_MAX_DIM], previous[WAM_MAX_DIM], final[WAM_MAX_DIM];
+    double lower[WAM_MAX_DIM], upper[WAM_MAX_DIM];
+    BOOL has_lower, has_upper;
+    UI_ANIMATION_ROUNDING_MODE rounding;
+    IUnknown *tag_object;
+    UINT tag_id;
+    IUIAnimationVariableChangeHandler2 *handler;
+    IUIAnimationVariableIntegerChangeHandler2 *integer_handler;
+    IUIAnimationVariableCurveChangeHandler2 *curve_handler;
+    struct storyboard2 *current;     /* not referenced: cleared when the storyboard ends */
+};
+
+struct sb_transition
+{
+    struct list entry;
+    struct transition2 *transition;
+    struct variable2 *variable;
+    int start_keyframe;              /* -1: after the previous transition of the variable */
+    int end_keyframe;                /* -1: none */
+    double start, end;               /* offsets from the storyboard start, resolved at Schedule() */
+    BOOL done;
+};
+
+enum keyframe_kind { KF_OFFSET, KF_AFTER_TRANSITION };
+
+struct keyframe
+{
+    enum keyframe_kind kind;
+    int base;                        /* keyframe index (KF_OFFSET, -1 = storyboard start) or transition index */
+    double offset;
+    double resolved;
+    BOOL is_resolved;
+};
+
+struct storyboard2
+{
+    IUIAnimationStoryboard2 IUIAnimationStoryboard2_iface;
+    LONG ref;
+    struct manager2 *manager;
+    struct list entry;               /* manager->storyboards while scheduled/playing */
+    BOOL in_list;
+    struct list transitions;         /* struct sb_transition */
+    unsigned int transition_count;
+    struct keyframe keyframes[WAM_MAX_KEYFRAMES];
+    unsigned int keyframe_count;
+    UI_ANIMATION_STORYBOARD_STATUS status;
+    double start_time, end_offset, elapsed;
+    double longest_delay, skip_duration;
+    IUnknown *tag_object;
+    UINT tag_id;
+    IUIAnimationStoryboardEventHandler2 *handler;
+};
+
+struct manager2
+{
+    IUIAnimationManager2 IUIAnimationManager2_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    struct list storyboards;
+    struct list variables;
+    UI_ANIMATION_MANAGER_STATUS status;
+    UI_ANIMATION_MODE mode;
+    IUIAnimationManagerEventHandler2 *handler;
+    double last_time;
+    BOOL has_time, paused, shutdown;
+};
+
+struct library2
+{
+    IUIAnimationTransitionLibrary2 IUIAnimationTransitionLibrary2_iface;
+    LONG ref;
+};
+
+struct factory2
+{
+    IUIAnimationTransitionFactory2 IUIAnimationTransitionFactory2_iface;
+    LONG ref;
+};
+
+static inline struct transition2 *impl_from_IUIAnimationTransition2( IUIAnimationTransition2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct transition2, IUIAnimationTransition2_iface );
+}
+
+static inline struct variable2 *impl_from_IUIAnimationVariable2( IUIAnimationVariable2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct variable2, IUIAnimationVariable2_iface );
+}
+
+static inline struct storyboard2 *impl_from_IUIAnimationStoryboard2( IUIAnimationStoryboard2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct storyboard2, IUIAnimationStoryboard2_iface );
+}
+
+static inline struct manager2 *impl_from_IUIAnimationManager2( IUIAnimationManager2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager2, IUIAnimationManager2_iface );
+}
+
+static const IUIAnimationTransition2Vtbl transition2_vtbl;
+static const IUIAnimationVariable2Vtbl variable2_vtbl;
+static const IUIAnimationStoryboard2Vtbl storyboard2_vtbl;
+
+static struct transition2 *unsafe_transition( IUIAnimationTransition2 *iface )
+{
+    if (!iface || iface->lpVtbl != &transition2_vtbl) return NULL;
+    return impl_from_IUIAnimationTransition2( iface );
+}
+
+static struct variable2 *unsafe_variable( IUIAnimationVariable2 *iface )
+{
+    if (!iface || iface->lpVtbl != &variable2_vtbl) return NULL;
+    return impl_from_IUIAnimationVariable2( iface );
+}
+
+/* ---------------------------------------------------------------- transitions */
+
+static double cubic_bezier_progress( double x1, double y1, double x2, double y2, double x )
+{
+    /* solve B_x(s) = x for s, then return B_y(s); CSS-style easing with P0 = (0,0), P3 = (1,1) */
+    double lo = 0.0, hi = 1.0, s = x;
+    unsigned int i;
+
+    if (x <= 0.0) return 0.0;
+    if (x >= 1.0) return 1.0;
+    for (i = 0; i < 8; i++)
+    {
+        double t = 1.0 - s;
+        double bx = 3 * t * t * s * x1 + 3 * t * s * s * x2 + s * s * s;
+        double dx = 3 * t * t * x1 + 6 * t * s * (x2 - x1) + 3 * s * s * (1.0 - x2);
+        if (fabs(bx - x) < 1e-7) break;
+        if (dx < 1e-6) break;
+        s -= (bx - x) / dx;
+        if (s < 0.0 || s > 1.0) break;
+    }
+    if (s < 0.0 || s > 1.0 || fabs(3 * (1 - s) * (1 - s) * s * x1 + 3 * (1 - s) * s * s * x2 + s * s * s - x) > 1e-5)
+    {
+        for (i = 0; i < 40; i++)
+        {
+            double t;
+            s = (lo + hi) / 2; t = 1.0 - s;
+            if (3 * t * t * s * x1 + 3 * t * s * s * x2 + s * s * s < x) lo = s; else hi = s;
+        }
+    }
+    {
+        double t = 1.0 - s;
+        return 3 * t * t * s * y1 + 3 * t * s * s * y2 + s * s * s;
+    }
+}
+
+static double hermite( double p0, double m0, double p1, double m1, double u )
+{
+    double u2 = u * u, u3 = u2 * u;
+    return (2 * u3 - 3 * u2 + 1) * p0 + (u3 - 2 * u2 + u) * m0 + (-2 * u3 + 3 * u2) * p1 + (u3 - u2) * m1;
+}
+
+static double transition_sign( double x )
+{
+    return x < 0.0 ? -1.0 : 1.0;
+}
+
+/* Fix the transition's start state and duration for the value it will start from. */
+static void transition_resolve( struct transition2 *t, const double *v0, const double *vel0 )
+{
+    unsigned int i;
+
+    for (i = 0; i < t->dim; i++)
+    {
+        t->start_value[i] = t->has_initial ? t->initial[i] : v0[i];
+        t->start_velocity[i] = t->has_initial_velocity ? t->initial_velocity[i] : (vel0 ? vel0[i] : 0.0);
+    }
+    t->resolved_duration = t->duration;
+
+    switch (t->kind)
+    {
+    case T_LINEAR_SPEED:
+    {
+        double longest = 0.0;
+        for (i = 0; i < t->dim; i++)
+        {
+            double d = t->speed > 0.0 ? fabs(t->final[i] - t->start_value[i]) / t->speed : 0.0;
+            if (d > longest) longest = d;
+        }
+        t->resolved_duration = longest;
+        break;
+    }
+    case T_SMOOTH_STOP:
+    {
+        double d = t->duration;   /* maximum duration */
+        for (i = 0; i < t->dim; i++)
+        {
+            double v = t->start_velocity[i], dist = t->final[i] - t->start_value[i];
+            if (v != 0.0 && dist * v > 0.0)
+            {
+                double dd = 2.0 * fabs(dist) / fabs(v);
+                if (dd < d) d = dd;
+            }
+        }
+        t->resolved_duration = d;
+        break;
+    }
+    case T_PARABOLIC:
+    {
+        double longest = 0.0;
+        for (i = 0; i < t->dim; i++)
+        {
+            double v0i = t->start_velocity[i], fv = t->final_velocity[i], dist = t->final[i] - t->start_value[i], d;
+            if (t->acceleration <= 0.0) { d = 0.0; }
+            else if (fabs(fv - v0i) > 1e-9) d = fabs(fv - v0i) / t->acceleration;
+            else d = sqrt(2.0 * fabs(dist) / t->acceleration);
+            if (d > longest) longest = d;
+        }
+        t->resolved_duration = longest;
+        break;
+    }
+    case T_INTERPOLATOR:
+        if (t->interpolator)
+        {
+            double d = 0.0;
+            IUIAnimationInterpolator2_SetInitialValueAndVelocity( t->interpolator, t->start_value, t->start_velocity, t->dim );
+            if (SUCCEEDED(IUIAnimationInterpolator2_GetDuration( t->interpolator, &d ))) t->resolved_duration = d;
+        }
+        break;
+    default:
+        break;
+    }
+    if (t->resolved_duration < 0.0) t->resolved_duration = 0.0;
+}
+
+/* Value of the transition at offset tt (0 <= tt <= resolved duration). */
+static void transition_value( struct transition2 *t, double tt, double *out )
+{
+    double D = t->resolved_duration, u = D > 0.0 ? tt / D : 1.0;
+    unsigned int i;
+
+    if (u < 0.0) u = 0.0;
+    if (u > 1.0) u = 1.0;
+
+    switch (t->kind)
+    {
+    case T_INSTANT:
+        for (i = 0; i < t->dim; i++) out[i] = t->final[i];
+        break;
+    case T_CONSTANT:
+        for (i = 0; i < t->dim; i++) out[i] = t->start_value[i];
+        break;
+    case T_DISCRETE:
+        for (i = 0; i < t->dim; i++) out[i] = tt < t->delay ? t->start_value[i] : t->final[i];
+        break;
+    case T_LINEAR:
+    case T_LINEAR_SPEED:
+        for (i = 0; i < t->dim; i++) out[i] = t->start_value[i] + (t->final[i] - t->start_value[i]) * u;
+        break;
+    case T_SIN_VELOCITY:
+        for (i = 0; i < t->dim; i++)
+        {
+            double amp = t->period > 0.0 ? t->start_velocity[i] * t->period / (2 * M_PI) : 0.0;
+            out[i] = t->start_value[i] + amp * sin(t->period > 0.0 ? 2 * M_PI * tt / t->period : 0.0);
+        }
+        break;
+    case T_SIN_RANGE:
+    {
+        double mid = (t->minimum + t->maximum) / 2, amp = (t->maximum - t->minimum) / 2;
+        for (i = 0; i < t->dim; i++)
+        {
+            double phase = 0.0, r;
+            if (amp > 0.0)
+            {
+                r = (t->start_value[i] - mid) / amp;
+                if (r < -1.0) r = -1.0;
+                if (r > 1.0) r = 1.0;
+                phase = asin(r);
+                if (t->slope == UI_ANIMATION_SLOPE_DECREASING) phase = M_PI - phase;
+            }
+            out[i] = mid + amp * sin((t->period > 0.0 ? 2 * M_PI * tt / t->period : 0.0) + phase);
+        }
+        break;
+    }
+    case T_ACCEL_DECEL:
+    {
+        double a = t->accel_ratio, d = t->decel_ratio, p;
+        if (a < 0.0) a = 0.0;
+        if (d < 0.0) d = 0.0;
+        if (a + d > 1.0) { double s = a + d; a /= s; d /= s; }
+        if (a + d <= 0.0) p = u;
+        else if (u < a) p = u * u / (a * (2.0 - a - d));
+        else if (u > 1.0 - d) p = 1.0 - (1.0 - u) * (1.0 - u) / (d * (2.0 - a - d));
+        else p = (2.0 * u - a) / (2.0 - a - d);
+        for (i = 0; i < t->dim; i++) out[i] = t->start_value[i] + (t->final[i] - t->start_value[i]) * p;
+        break;
+    }
+    case T_REVERSAL:
+        for (i = 0; i < t->dim; i++)
+            out[i] = t->start_value[i] + t->start_velocity[i] * tt * (1.0 - u);
+        break;
+    case T_CUBIC:
+        for (i = 0; i < t->dim; i++)
+            out[i] = hermite( t->start_value[i], t->start_velocity[i] * D, t->final[i], t->final_velocity[i] * D, u );
+        break;
+    case T_SMOOTH_STOP:
+        for (i = 0; i < t->dim; i++)
+            out[i] = hermite( t->start_value[i], t->start_velocity[i] * D, t->final[i], 0.0, u );
+        break;
+    case T_PARABOLIC:
+        for (i = 0; i < t->dim; i++)
+        {
+            double v0i = t->start_velocity[i], fv = t->final_velocity[i], dist = t->final[i] - t->start_value[i];
+            double a = fabs(fv - v0i) > 1e-9 ? t->acceleration * transition_sign(fv - v0i) : t->acceleration * transition_sign(dist);
+            out[i] = t->start_value[i] + v0i * tt + a * tt * tt / 2.0;
+        }
+        break;
+    case T_BEZIER:
+    {
+        double p = cubic_bezier_progress( t->x1, t->y1, t->x2, t->y2, u );
+        for (i = 0; i < t->dim; i++) out[i] = t->start_value[i] + (t->final[i] - t->start_value[i]) * p;
+        break;
+    }
+    case T_INTERPOLATOR:
+        if (t->interpolator && SUCCEEDED(IUIAnimationInterpolator2_InterpolateValue( t->interpolator, tt, out, t->dim )))
+            break;
+        for (i = 0; i < t->dim; i++) out[i] = t->start_value[i];
+        break;
+    }
+}
