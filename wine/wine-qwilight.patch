+    if (!value) return E_POINTER;
+    if ((*value = impl->content_location)) IUriRuntimeClass_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI content_headers_put_ContentLocation( IHttpContentHeaderCollection *iface, IUriRuntimeClass *value )
+{
+    struct content_headers *impl = impl_from_IHttpContentHeaderCollection( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (value) IUriRuntimeClass_AddRef( value );
+    if (impl->content_location) IUriRuntimeClass_Release( impl->content_location );
+    impl->content_location = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI content_headers_Append( IHttpContentHeaderCollection *iface, HSTRING name, HSTRING value )
+{
+    struct content_headers *impl = impl_from_IHttpContentHeaderCollection( iface );
+    TRACE( "iface %p, name %s, value %s.\n", iface, debugstr_hstring( name ), debugstr_hstring( value ) );
+    return header_list_append( &impl->headers, name, value );
+}
+
+static HRESULT WINAPI content_headers_TryAppendWithoutValidation( IHttpContentHeaderCollection *iface, HSTRING name,
+                                                                  HSTRING value, boolean *succeeded )
+{
+    struct content_headers *impl = impl_from_IHttpContentHeaderCollection( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, name %s, value %s, succeeded %p.\n", iface, debugstr_hstring( name ),
+           debugstr_hstring( value ), succeeded );
+
+    if (!succeeded) return E_POINTER;
+    hr = header_list_append( &impl->headers, name, value );
+    *succeeded = SUCCEEDED(hr);
+    return SUCCEEDED(hr) ? S_OK : hr;
+}
+
+static const struct IHttpContentHeaderCollectionVtbl content_headers_vtbl =
+{
+    content_headers_QueryInterface,
+    content_headers_AddRef,
+    content_headers_Release,
+    /* IInspectable */
+    content_headers_GetIids,
+    content_headers_GetRuntimeClassName,
+    content_headers_GetTrustLevel,
+    /* IHttpContentHeaderCollection */
+    content_headers_get_ContentDisposition,
+    content_headers_put_ContentDisposition,
+    content_headers_get_ContentEncoding,
+    content_headers_get_ContentLanguage,
+    content_headers_get_ContentLength,
+    content_headers_put_ContentLength,
+    content_headers_get_ContentLocation,
+    content_headers_put_ContentLocation,
+    content_headers_get_ContentMD5,
+    content_headers_put_ContentMD5,
+    content_headers_get_ContentRange,
+    content_headers_put_ContentRange,
+    content_headers_get_ContentType,
+    content_headers_put_ContentType,
+    content_headers_get_Expires,
+    content_headers_put_Expires,
+    content_headers_get_LastModified,
+    content_headers_put_LastModified,
+    content_headers_Append,
+    content_headers_TryAppendWithoutValidation,
+};
+
+HRESULT content_headers_create( IHttpContentHeaderCollection **out )
+{
+    struct content_headers *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IHttpContentHeaderCollection_iface.lpVtbl = &content_headers_vtbl;
+    impl->ref = 1;
+    list_init( &impl->headers );
+
+    *out = &impl->IHttpContentHeaderCollection_iface;
+    TRACE( "created HttpContentHeaderCollection %p.\n", *out );
+    return S_OK;
+}
+
+/*
+ * Windows.Web.Http.Headers.HttpCredentialsHeaderValue activation factory
+ */
+struct credentials_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IHttpCredentialsHeaderValueFactory IHttpCredentialsHeaderValueFactory_iface;
+    LONG ref;
+};
+
+static inline struct credentials_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct credentials_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI credentials_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct credentials_factory *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IActivationFactory_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IHttpCredentialsHeaderValueFactory ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IHttpCredentialsHeaderValueFactory_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI credentials_factory_AddRef( IActivationFactory *iface )
+{
+    struct credentials_factory *impl = impl_from_IActivationFactory( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI credentials_factory_Release( IActivationFactory *iface )
+{
+    struct credentials_factory *impl = impl_from_IActivationFactory( iface );
+    return InterlockedDecrement( &impl->ref );
+}
+
+static HRESULT WINAPI credentials_factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI credentials_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Web_Http_Headers_HttpCredentialsHeaderValue,
+                                ARRAY_SIZE(RuntimeClass_Windows_Web_Http_Headers_HttpCredentialsHeaderValue) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI credentials_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI credentials_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* HttpCredentialsHeaderValue has no default constructor. */
+    WARN( "iface %p, instance %p: not activatable.\n", iface, instance );
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl credentials_factory_vtbl =
+{
+    credentials_factory_QueryInterface,
+    credentials_factory_AddRef,
+    credentials_factory_Release,
+    /* IInspectable */
+    credentials_factory_GetIids,
+    credentials_factory_GetRuntimeClassName,
+    credentials_factory_GetTrustLevel,
+    /* IActivationFactory */
+    credentials_factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( credentials_value_factory, IHttpCredentialsHeaderValueFactory, struct credentials_factory,
+                     IActivationFactory_iface )
+
+static HRESULT WINAPI credentials_value_factory_CreateFromScheme( IHttpCredentialsHeaderValueFactory *iface,
+                                                                  HSTRING scheme, IHttpCredentialsHeaderValue **value )
+{
+    TRACE( "iface %p, scheme %s, value %p.\n", iface, debugstr_hstring( scheme ), value );
+    if (!value) return E_POINTER;
+    return credentials_header_value_create( scheme, NULL, value );
+}
+
+static HRESULT WINAPI credentials_value_factory_CreateFromSchemeWithToken( IHttpCredentialsHeaderValueFactory *iface,
+                                                                           HSTRING scheme, HSTRING token,
+                                                                           IHttpCredentialsHeaderValue **value )
+{
+    TRACE( "iface %p, scheme %s, token %s, value %p.\n", iface, debugstr_hstring( scheme ),
+           debugstr_hstring( token ), value );
+    if (!value) return E_POINTER;
+    return credentials_header_value_create( scheme, token, value );
+}
+
+static const struct IHttpCredentialsHeaderValueFactoryVtbl credentials_value_factory_vtbl =
+{
+    credentials_value_factory_QueryInterface,
+    credentials_value_factory_AddRef,
+    credentials_value_factory_Release,
+    /* IInspectable */
+    credentials_value_factory_GetIids,
+    credentials_value_factory_GetRuntimeClassName,
+    credentials_value_factory_GetTrustLevel,
+    /* IHttpCredentialsHeaderValueFactory */
+    credentials_value_factory_CreateFromScheme,
+    credentials_value_factory_CreateFromSchemeWithToken,
+};
+
+static struct credentials_factory credentials_factory =
+{
+    {&credentials_factory_vtbl},
+    {&credentials_value_factory_vtbl},
+    1,
+};
+
+IActivationFactory *credentials_header_value_factory = &credentials_factory.IActivationFactory_iface;
+
+struct list *request_headers_get_list( IHttpRequestHeaderCollection *iface )
+{
+    return iface ? &impl_from_IHttpRequestHeaderCollection( iface )->headers : NULL;
+}
+
+struct list *content_headers_get_list( IHttpContentHeaderCollection *iface )
+{
+    return iface ? &impl_from_IHttpContentHeaderCollection( iface )->headers : NULL;
+}
+
+struct list *product_info_collection_get_list( IHttpProductInfoHeaderValueCollection *iface )
+{
+    return iface ? &impl_from_IHttpProductInfoHeaderValueCollection( iface )->values : NULL;
+}
