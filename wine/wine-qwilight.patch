+/* Snapshot back buffer 0 into the next presented surface of the ring, ordered after the
+ * application's rendering on the immediate context, and publish it. The compositor (another
+ * device) samples the published snapshot; the cross-device fences order the copy after the
+ * compositor's flushed draws, but a draw still executing on the GPU is only protected by the
+ * ring: the writer comes back to the same surface two presents later. A single surface tore
+ * (a scrolling note showed as two offset halves). */
+static void d3d11_swapchain_update_presented_surface(struct d3d11_swapchain *swapchain)
+{
+    ID3D11Texture2D *back_buffer = NULL, *presented = NULL;
+    D3D11_TEXTURE2D_DESC desc, presented_desc;
+    ID3D11DeviceContext *context = NULL;
+    ID3D11Device *device = NULL;
+    IDXGISurface *surface, **slot;
+    HRESULT hr;
+
+    swapchain->presented_index = (swapchain->presented_index + 1) % ARRAY_SIZE(swapchain->presented_surfaces);
+    slot = &swapchain->presented_surfaces[swapchain->presented_index];
