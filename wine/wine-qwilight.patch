+
+/* Coexistence with dcomp: once dcomp's IDCompositionDevice::CreateSurfaceFromHandle() has
+ * turned the swapchain's composition surface handle into visual content, dcomp draws the
+ * swapchain's back buffer into the target window in visual-tree order (below the XAML atlas
+ * that dwmcorei draws over it). The hosting window would present the same frames on top of
+ * that, so it is withdrawn for as long as the binding lasts and restored afterwards; the
+ * swapchain still presents (into the hidden window) so its buffers keep cycling. Called from
+ * Present1() on the presenting thread, like the sync above. */
+void dxgi_composition_window_set_withdrawn(HWND hwnd, BOOL withdrawn)
+{
+    if (!hwnd || !GetPropW(hwnd, L"__wine_dxgi_composition")) return;
+    if (withdrawn)
+    {
+        BOOL transition = !GetPropW(hwnd, L"__wine_dxgi_composition_withdrawn");
+
+        if (transition)
+        {
+            FIXME("TEMP DIAG: withdrawing composition hosting window %p (visible %u).\n", hwnd, IsWindowVisible(hwnd));
+            SetPropW(hwnd, L"__wine_dxgi_composition_withdrawn", (HANDLE)1);
+        }
+        /* Posted (SWP_ASYNCWINDOWPOS): the presenting thread must not wait for
+         * the window's owner thread, which may be blocked on our locks.
+         *
+         * Always post the hide on a transition: the binding is dropped and re-made
+         * around every island resize, and a restore posted a moment ago may not have
+         * been processed yet, so IsWindowVisible() still says hidden while a show is
+         * queued. Gating the hide on it left the hosting window shown, on top of the
+         * composed XAML, until the next visibility change ("the UI is gone, only the
+         * game scene shows"). Both posts are processed in order by the owner thread. */
+        if (transition || IsWindowVisible(hwnd))
+            SetWindowPos(hwnd, NULL, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE
+                    | SWP_ASYNCWINDOWPOS | SWP_HIDEWINDOW);
+        return;
+    }
+    if (GetPropW(hwnd, L"__wine_dxgi_composition_withdrawn"))
+    {
+        FIXME("TEMP DIAG: restoring composition hosting window %p (visible %u).\n", hwnd, IsWindowVisible(hwnd));
+        RemovePropW(hwnd, L"__wine_dxgi_composition_withdrawn");
+        /* the mirror image of the above: a queued hide must be followed by our show */
+        dxgi_composition_window_sync_full(hwnd, TRUE);
+        return;
+    }
+    dxgi_composition_window_sync(hwnd);
 }
 
