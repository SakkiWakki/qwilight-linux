+HRESULT create_property_transform(unsigned int kind, REFIID iid, void **out)
+{
+    struct composition_property_transform *object;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->IUnknown_iface.lpVtbl = (const IUnknownVtbl *)&property_transform_vtbl;
+    object->ref = 1;
+    object->kind = kind;
+    switch (kind)
+    {
+        case TRANSFORM_SCALE: object->prop[0] = object->prop[1] = 1.0f; break;
+        case TRANSFORM_SCALE_3D: object->prop[0] = object->prop[1] = object->prop[2] = 1.0f; break;
+        case TRANSFORM_ROTATE_3D: object->prop[3] = 1.0f; break;
+        default: break;
+    }
+    hr = IUnknown_QueryInterface(&object->IUnknown_iface, iid, out);
+    IUnknown_Release(&object->IUnknown_iface);
+    return hr;
+}
