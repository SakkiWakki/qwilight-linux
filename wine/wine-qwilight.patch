+++ b/dlls/windows.web.http/async.c
@@ -0,0 +1,660 @@
+/* WinRT IAsync* implementation
+ *
+ * Copyright 2022 Bernhard Kölbl for CodeWeavers
+ * Copyright 2022 Rémi Bernon for CodeWeavers
+ * Copyright 2026 Conor McCarthy for CodeWeavers
+ *
