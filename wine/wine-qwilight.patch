+/* ------------------------------------------------------------------------------------------
+ * Composition surface handles.
+ *
+ * On Windows, IDXGISwapChainPartner::GetCompositionSurface() returns a kernel handle to the
+ * composition surface a "composition swapchain" presents into, and
+ * IDCompositionDevice::CreateSurfaceFromHandle() turns that handle into visual content.
+ * WinAppSDK's dwmcorei.dll uses exactly that pair for every SwapChainPanel: dcompi calls
+ * GetCompositionSurface on the UI thread, and CGlobalDCompSurfaceBitmapRenderStrategy::Draw
+ * on the render thread calls CreateSurfaceFromHandle(handle) once per frame until it succeeds,
+ * then hands the object to CLiftedOverlayPlane::Update, which QIs it for IDCompositionVisual
+ * and otherwise passes it to IDCompositionVisual::SetContent() on an overlay visual.
+ *
+ * Here a handle is a named event object: the name encodes the process id and the id of an
+ * entry in a process-global registry, so any duplicate of the handle resolves to the same
+ * entry (NtQueryObject(ObjectNameInformation)), DuplicateHandle/CloseHandle work, and the
+ * registry entry can point at the DXGI swapchain that dlls/dxgi bound to the handle.  The
+ * registry holds no reference on the swapchain; dxgi unbinds from its final Release(). */
+
+struct surface_handle_entry
+{
+    struct list entry;
+    ULONG id;
+    IUnknown *swapchain; /* weak, see above; NULL for DCompositionCreateSurfaceHandle() handles */
+};
+
+static struct list surface_handles = LIST_INIT(surface_handles);
+static ULONG surface_handle_next_id;
+static CRITICAL_SECTION surface_handles_cs;
+static CRITICAL_SECTION_DEBUG surface_handles_cs_debug =
+{
+    0, 0, &surface_handles_cs,
+    { &surface_handles_cs_debug.ProcessLocksList, &surface_handles_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": surface_handles_cs") }
+};
+static CRITICAL_SECTION surface_handles_cs = { &surface_handles_cs_debug, -1, 0, 0, 0, 0 };
+
+static const WCHAR surface_handle_prefix[] = L"__wine_dcomp_surface_";
+
+/* dlls/dxgi/factory.c reads this private-data tag from a composition swapchain to know that
+ * dcomp composites it, and withdraws its own hosting window. */
+static const GUID GUID_wine_dxgi_composition_bound =
+        {0x8b2c7f5a, 0x1d7e, 0x4c3b, {0x9a, 0x6f, 0x2e, 0x5d, 0x4c, 0x3b, 0x2a, 0x19}};
+
+HRESULT create_surface_handle(IUnknown *swapchain, HANDLE *handle)
+{
+    struct surface_handle_entry *entry;
+    WCHAR name[80];
+    HANDLE event;
+
+    if (!handle)
+        return E_INVALIDARG;
+    if (!(entry = calloc(1, sizeof(*entry))))
+        return E_OUTOFMEMORY;
+
+    EnterCriticalSection(&surface_handles_cs);
+    entry->id = ++surface_handle_next_id;
+    entry->swapchain = swapchain;
+    swprintf(name, ARRAY_SIZE(name), L"%s%08lx_%08lx", surface_handle_prefix, GetCurrentProcessId(), entry->id);
+    /* Manual-reset, never signalled: waiting on a composition surface handle is meaningless. */
+    if (!(event = CreateEventW(NULL, TRUE, FALSE, name)))
+    {
+        LeaveCriticalSection(&surface_handles_cs);
+        ERR("Failed to create the handle object, error %lu.\n", GetLastError());
+        free(entry);
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+    list_add_tail(&surface_handles, &entry->entry);
+    LeaveCriticalSection(&surface_handles_cs);
+
+    TRACE("Created composition surface handle %p (%s) for swapchain %p.\n", event, debugstr_w(name), swapchain);
+    *handle = event;
+    return S_OK;
+}
+
+/* Resolve any handle value to its registry entry and take a reference on the swapchain. */
+static HRESULT surface_handle_lookup(HANDLE handle, ULONG *id, IUnknown **swapchain)
+{
+    char buffer[sizeof(OBJECT_NAME_INFORMATION) + 1024];
+    OBJECT_NAME_INFORMATION *info = (OBJECT_NAME_INFORMATION *)buffer;
+    struct surface_handle_entry *entry;
+    WCHAR name[512], *p, *end;
+    ULONG len, pid, entry_id;
+    NTSTATUS status;
+
+    if ((status = NtQueryObject(handle, ObjectNameInformation, buffer, sizeof(buffer), &len)))
+    {
+        WARN("NtQueryObject(%p) failed, status %#lx.\n", handle, status);
+        return E_INVALIDARG;
+    }
+    if (!info->Name.Buffer || !info->Name.Length || info->Name.Length / sizeof(WCHAR) >= ARRAY_SIZE(name))
+        return E_INVALIDARG;
+    memcpy(name, info->Name.Buffer, info->Name.Length);
+    name[info->Name.Length / sizeof(WCHAR)] = 0;
+
+    if (!(p = wcsstr(name, surface_handle_prefix)))
+    {
+        WARN("%p (%s) is not a composition surface handle.\n", handle, debugstr_w(name));
+        return E_INVALIDARG;
+    }
+    p += ARRAY_SIZE(surface_handle_prefix) - 1;
+    pid = wcstoul(p, &end, 16);
+    if (*end != '_')
+        return E_INVALIDARG;
+    entry_id = wcstoul(end + 1, &end, 16);
+    if (pid != GetCurrentProcessId())
+    {
+        FIXME("Handle %p belongs to process %#lx, cross-process composition surfaces are not supported.\n",
+                handle, pid);
+        return E_INVALIDARG;
+    }
+
+    EnterCriticalSection(&surface_handles_cs);
+    LIST_FOR_EACH_ENTRY(entry, &surface_handles, struct surface_handle_entry, entry)
+    {
+        if (entry->id != entry_id)
+            continue;
+        *id = entry->id;
+        if ((*swapchain = entry->swapchain))
+            IUnknown_AddRef(*swapchain);
+        LeaveCriticalSection(&surface_handles_cs);
+        return S_OK;
+    }
+    LeaveCriticalSection(&surface_handles_cs);
+
+    WARN("Composition surface %lu of handle %p is gone.\n", entry_id, handle);
+    return E_INVALIDARG;
+}
+
+/* Tag (or untag) the swapchain so that dlls/dxgi stops presenting it into its own window.
+ * Reference counted: XAML binds the new handle surface before it releases the old one on a
+ * resize, and the tag must survive that. */
+static void surface_handle_set_bound(IUnknown *swapchain, BOOL bound)
+{
+    IDXGIObject *object;
+    DWORD count = 0;
+    UINT size = sizeof(count);
+
+    if (!swapchain || FAILED(IUnknown_QueryInterface(swapchain, &IID_IDXGIObject, (void **)&object)))
+        return;
+    if (FAILED(IDXGIObject_GetPrivateData(object, &GUID_wine_dxgi_composition_bound, &size, &count)) || size != sizeof(count))
+        count = 0;
+    if (bound)
+        count++;
+    else if (count)
+        count--;
+    TRACE("swapchain %p bound count %lu.\n", swapchain, count);
+    IDXGIObject_SetPrivateData(object, &GUID_wine_dxgi_composition_bound, count ? sizeof(count) : 0, count ? &count : NULL);
+    IDXGIObject_Release(object);
+}
+
+/* The object CreateSurfaceFromHandle() returns. */
+struct composition_handle_surface
+{
+    IWineDCompHandleSurface IWineDCompHandleSurface_iface;
+    IUnknown *swapchain;
+    ULONG id;
+    LONG ref;
+};
+
+static inline struct composition_handle_surface *impl_from_IWineDCompHandleSurface(IWineDCompHandleSurface *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_handle_surface, IWineDCompHandleSurface_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE handle_surface_QueryInterface(IWineDCompHandleSurface *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWineDCompHandleSurface))
+    {
+        IWineDCompHandleSurface_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    /* dwmcorei!CLiftedOverlayPlane::Update asks for IDCompositionVisual to decide between
+     * AddVisual() and SetContent(); a surface is content. */
+    TRACE("%s not supported.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE handle_surface_AddRef(IWineDCompHandleSurface *iface)
+{
+    struct composition_handle_surface *surface = impl_from_IWineDCompHandleSurface(iface);
+    ULONG ref = InterlockedIncrement(&surface->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG STDMETHODCALLTYPE handle_surface_Release(IWineDCompHandleSurface *iface)
+{
+    struct composition_handle_surface *surface = impl_from_IWineDCompHandleSurface(iface);
+    ULONG ref = InterlockedDecrement(&surface->ref);
+
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+
+    if (!ref)
+    {
+        if (surface->swapchain)
+        {
+            surface_handle_set_bound(surface->swapchain, FALSE);
+            IUnknown_Release(surface->swapchain);
+        }
+        free(surface);
+    }
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE handle_surface_GetSwapChain(IWineDCompHandleSurface *iface, IUnknown **swapchain)
+{
+    struct composition_handle_surface *surface = impl_from_IWineDCompHandleSurface(iface);
+
+    TRACE("iface %p, swapchain %p.\n", iface, swapchain);
+
+    if ((*swapchain = surface->swapchain))
+        IUnknown_AddRef(*swapchain);
+    return *swapchain ? S_OK : S_FALSE;
+}
+
+static const struct IWineDCompHandleSurfaceVtbl handle_surface_vtbl =
+{
+    handle_surface_QueryInterface,
+    handle_surface_AddRef,
+    handle_surface_Release,
+    handle_surface_GetSwapChain,
+};
+
+HRESULT create_surface_from_handle(HANDLE handle, IUnknown **out)
+{
+    struct composition_handle_surface *surface;
+    IUnknown *swapchain = NULL;
+    ULONG id = 0;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+    if (!handle)
+        return E_INVALIDARG;
+    if (FAILED(hr = surface_handle_lookup(handle, &id, &swapchain)))
+        return hr;
+
+    if (!(surface = calloc(1, sizeof(*surface))))
+    {
+        if (swapchain)
+            IUnknown_Release(swapchain);
+        return E_OUTOFMEMORY;
+    }
+    surface->IWineDCompHandleSurface_iface.lpVtbl = &handle_surface_vtbl;
+    surface->swapchain = swapchain;
+    surface->id = id;
+    surface->ref = 1;
+    surface_handle_set_bound(swapchain, TRUE);
+
+    TRACE("Handle %p -> composition surface %lu, swapchain %p, object %p.\n", handle, id, swapchain, surface);
+    *out = (IUnknown *)&surface->IWineDCompHandleSurface_iface;
+    return S_OK;
+}
+
+/***********************************************************************
+ *      DCompositionCreateSurfaceHandle (dcomp.@)
+ */
+HRESULT WINAPI DCompositionCreateSurfaceHandle(DWORD desired_access, SECURITY_ATTRIBUTES *security_attributes,
+        HANDLE *surface_handle)
+{
+    TRACE("desired_access %#lx, security_attributes %p, surface_handle %p.\n", desired_access,
+            security_attributes, surface_handle);
+
+    if (security_attributes)
+        FIXME("Ignoring security attributes.\n");
+    return create_surface_handle(NULL, surface_handle);
+}
+
+/* Wine-internal, called by dlls/dxgi: IDXGISwapChainPartner::GetCompositionSurface(). */
+HRESULT WINAPI __wine_dcomp_bind_swapchain_surface(IUnknown *swapchain, HANDLE *handle)
+{
+    TRACE("swapchain %p, handle %p.\n", swapchain, handle);
+
+    if (!swapchain)
+        return E_INVALIDARG;
+    return create_surface_handle(swapchain, handle);
+}
+
+/* Wine-internal, called by dlls/dxgi from the swapchain's final Release(). */
+void WINAPI __wine_dcomp_unbind_swapchain_surface(IUnknown *swapchain)
+{
+    struct surface_handle_entry *entry, *next;
+
+    TRACE("swapchain %p.\n", swapchain);
+
+    EnterCriticalSection(&surface_handles_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &surface_handles, struct surface_handle_entry, entry)
+    {
+        if (entry->swapchain != swapchain)
+            continue;
+        list_remove(&entry->entry);
+        free(entry);
+    }
+    LeaveCriticalSection(&surface_handles_cs);
+}
+
+
+/* ---------------------------------------------------------------- CreateSurfaceFromHwnd() content */
+
+struct composition_hwnd_surface
+{
+    IWineDCompHwndSurface IWineDCompHwndSurface_iface;
+    LONG ref;
+    HWND hwnd;
+    HANDLE handle;      /* shared visual registered for hwnd (device.c dcomp_create_shared_visual_handle()) */
+};
+
+static inline struct composition_hwnd_surface *impl_from_IWineDCompHwndSurface(IWineDCompHwndSurface *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_hwnd_surface, IWineDCompHwndSurface_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE hwnd_surface_QueryInterface(IWineDCompHwndSurface *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IWineDCompHwndSurface))
+    {
+        IWineDCompHwndSurface_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE hwnd_surface_AddRef(IWineDCompHwndSurface *iface)
+{
+    struct composition_hwnd_surface *surface = impl_from_IWineDCompHwndSurface(iface);
+    ULONG ref = InterlockedIncrement(&surface->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG STDMETHODCALLTYPE hwnd_surface_Release(IWineDCompHwndSurface *iface)
+{
+    struct composition_hwnd_surface *surface = impl_from_IWineDCompHwndSurface(iface);
+    ULONG ref = InterlockedDecrement(&surface->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    if (!ref)
+    {
+        if (surface->handle) CloseHandle(surface->handle);
+        free(surface);
+    }
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE hwnd_surface_GetWindow(IWineDCompHwndSurface *iface, HWND *hwnd)
+{
+    struct composition_hwnd_surface *surface = impl_from_IWineDCompHwndSurface(iface);
+    *hwnd = surface->hwnd;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE hwnd_surface_GetHandle(IWineDCompHwndSurface *iface, HANDLE *handle)
+{
+    struct composition_hwnd_surface *surface = impl_from_IWineDCompHwndSurface(iface);
+    *handle = surface->handle;
+    return surface->handle ? S_OK : S_FALSE;
+}
+
+static const struct IWineDCompHwndSurfaceVtbl hwnd_surface_vtbl =
+{
+    hwnd_surface_QueryInterface,
+    hwnd_surface_AddRef,
+    hwnd_surface_Release,
+    hwnd_surface_GetWindow,
+    hwnd_surface_GetHandle,
+};
+
+HRESULT create_surface_from_hwnd(HWND hwnd, IUnknown **out)
+{
+    struct composition_hwnd_surface *surface;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsWindow(hwnd)) return E_INVALIDARG;
+    if (!(surface = calloc(1, sizeof(*surface)))) return E_OUTOFMEMORY;
+    surface->IWineDCompHwndSurface_iface.lpVtbl = &hwnd_surface_vtbl;
+    surface->ref = 1;
+    surface->hwnd = hwnd;
+    if (FAILED(dcomp_create_shared_visual_handle(hwnd, &surface->handle)))
+        surface->handle = NULL;
+    FIXME("Window %p as visual content: shared visual handle %p for the window's composition targets.\n",
+          hwnd, surface->handle);
+    *out = (IUnknown *)&surface->IWineDCompHwndSurface_iface;
+    return S_OK;
+}
