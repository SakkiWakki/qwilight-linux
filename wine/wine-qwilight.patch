+
+/* a helper thread finished its wait; runs on the main thread */
+static void inproc_waiter_finished( struct inproc_waiter *waiter )
+{
+    int signaled = !waiter->error && waiter->index == 0;
+
+    if (debug_level)
+        fprintf( stderr, "inproc_waiter_finished %p fd=%d signaled=%d cancelled=%d error=%d\n",
+                 waiter, waiter->sync->fd, signaled, waiter->cancelled, waiter->error );
