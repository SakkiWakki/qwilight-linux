+/* TEMP DIAG: WINE_MASK_DIAG=1 — for every indexed draw whose vertex layout is XAML's (stride 32:
+ * pos xyz, packed colour, uv0, uv1) and whose PS srv1 is a guarded atlas, flag triangles whose uv1
+ * maps 1:1 onto screen pixels over an element-sized span but does not lie inside any rasterised
+ * tile: that is the "garbage on buttons/words" artifact. One line per distinct screen rect per draw. */
+static void mask_diag_check(struct d3d11_device_context *context, unsigned int count, unsigned int start, int base)
+{
+    struct wined3d_device_context *ctx = context->wined3d_context;
+    struct wined3d_shader_resource_view *srv;
+    struct d3d_shader_resource_view *v;
+    struct wined3d_rendertarget_view *rtv;
+    struct wined3d_resource_desc rdesc, tdesc;
+    struct wined3d_buffer *vb, *ib;
+    unsigned int vb_offset = 0, stride = 0, ib_offset = 0, vb_size, ib_size, i, idx_size, nflag = 0;
+    enum wined3d_format_id ib_format = 0;
+    const unsigned char *vdata, *idata;
+    ID3D11Texture2D *tex;
+    float flagged[16][4];
+    float tw, th;
+
+    if (!mask_diag_enabled() || context->type != D3D11_DEVICE_CONTEXT_IMMEDIATE) return;
+    wined3d_device_context_get_stream_source(ctx, 0, &vb, &vb_offset, &stride);
+    if (!vb || stride != 32) return;
+    if (!(srv = wined3d_device_context_get_shader_resource_view(ctx, WINED3D_SHADER_TYPE_PIXEL, 1))) return;
+    if (!(v = wined3d_shader_resource_view_get_parent(srv)) || !v->resource) return;
+    wined3d_resource_get_desc(wined3d_resource_from_d3d11_resource(v->resource), &tdesc);
+    if (tdesc.resource_type != WINED3D_RTYPE_TEXTURE_2D || tdesc.width < 1024) return;
+    tex = &((struct d3d_texture2d *)wined3d_resource_get_parent(wined3d_resource_from_d3d11_resource(v->resource)))->ID3D11Texture2D_iface;
+    if (mask_diag_in_tile(tdesc.width, tdesc.height, 0, 0, 0, 0) < 0) return;   /* not a guarded atlas */
+    tw = tdesc.width; th = tdesc.height;
+    if (!(rtv = wined3d_device_context_get_rendertarget_view(ctx, 0))) return;
+    wined3d_resource_get_desc(wined3d_rendertarget_view_get_resource(rtv), &rdesc);
+    vdata = draw_diag_shadow((ID3D11Resource *)&((struct d3d_buffer *)wined3d_resource_get_parent(wined3d_buffer_get_resource(vb)))->ID3D11Buffer_iface, &vb_size);
+    if (!(ib = wined3d_device_context_get_index_buffer(ctx, &ib_format, &ib_offset))) return;
+    idata = draw_diag_shadow((ID3D11Resource *)&((struct d3d_buffer *)wined3d_resource_get_parent(wined3d_buffer_get_resource(ib)))->ID3D11Buffer_iface, &ib_size);
+    if (!vdata || !idata) return;
+    idx_size = ib_format == WINED3DFMT_R32_UINT ? 4 : 2;
+    for (i = 0; i + 3 <= count; i += 3)
+    {
+        const float *f[3]; unsigned int k, id, j;
+        float xl = 1e9f, xr = -1e9f, yt = 1e9f, yb = -1e9f, ul = 1e9f, ur = -1e9f, vt = 1e9f, vb2 = -1e9f;
+        for (k = 0; k < 3; ++k)
+        {
+            unsigned int pos = ib_offset + (start + i + k) * idx_size;
+            if (pos + idx_size > ib_size) return;
+            id = (idx_size == 4 ? *(const unsigned int *)(idata + pos) : *(const unsigned short *)(idata + pos)) + base;
+            if (vb_offset + id * stride + stride > vb_size) return;
+            f[k] = (const float *)(vdata + vb_offset + id * stride);
+            if (f[k][0] < xl) xl = f[k][0]; if (f[k][0] > xr) xr = f[k][0];
+            if (f[k][1] < yt) yt = f[k][1]; if (f[k][1] > yb) yb = f[k][1];
+            if (f[k][6] * tw < ul) ul = f[k][6] * tw; if (f[k][6] * tw > ur) ur = f[k][6] * tw;
+            if (f[k][7] * th < vt) vt = f[k][7] * th; if (f[k][7] * th > vb2) vb2 = f[k][7] * th;
+        }
+        /* WINE_MASK_SURVEY=1 + the draw-diag trigger: one line per triangle group of every quad that
+         * samples the atlas 1:1 (text and element-sized masks), with colour and tile status, so the
+         * artifacted quads can be compared with the healthy ones on the same attributes. */
+        {
+            static int survey = -1;
+            if (survey < 0) survey = !!getenv("WINE_MASK_SURVEY");
+            if (survey && draw_diag_active()
+                    && fabsf((ur - ul) - (xr - xl)) <= 0.75f && fabsf((vb2 - vt) - (yb - yt)) <= 0.75f
+                    && ((xr - xl) >= 4.0f || (yb - yt) >= 4.0f))
+            {
+                static float last[4]; static unsigned int last_col; static unsigned int last_tex;
+                unsigned int col = ((const unsigned int *)f[0])[3];
+                int in = mask_diag_in_tile(tdesc.width, tdesc.height, ul, vt, ur, vb2);
+                /* merge with the previous group when it is the same element (same colour, touching rects) */
+                if (col == last_col && last_tex == tdesc.width && xl <= last[2] + 2 && xr >= last[0] - 2 && yt <= last[3] + 2 && yb >= last[1] - 2)
+                {
+                    if (xl < last[0]) last[0] = xl; if (yt < last[1]) last[1] = yt; if (xr > last[2]) last[2] = xr; if (yb > last[3]) last[3] = yb;
+                }
+                else
+                {
+                    FIXME("SURVEY col %#010x uv0 %g pos (%.0f,%.0f)-(%.0f,%.0f) size %.0fx%.0f atlas %ux%u uv (%.0f,%.0f)-(%.0f,%.0f) intile %d rt %ux%u\n",
+                            col, f[0][4], xl, yt, xr, yb, xr - xl, yb - yt, tdesc.width, tdesc.height, ul, vt, ur, vb2, in, rdesc.width, rdesc.height);
+                    last[0] = xl; last[1] = yt; last[2] = xr; last[3] = yb; last_col = col; last_tex = tdesc.width;
+                }
+            }
+        }
+        /* 1:1 mapping over a span of at least 12 px in one direction, uv0 unused (no AA gradient) */
+        if (f[0][4] != 0.0f || f[0][5] != 0.0f) continue;
+        if (fabsf((ur - ul) - (xr - xl)) > 0.75f || fabsf((vb2 - vt) - (yb - yt)) > 0.75f) continue;
+        if ((xr - xl) < 12.0f && (yb - yt) < 12.0f) continue;
+        if (mask_diag_in_tile(tdesc.width, tdesc.height, ul, vt, ur, vb2) != 0) continue;
+        /* dedupe by screen rect (merge overlapping/adjacent flagged tris of the same element) */
+        for (j = 0; j < nflag; ++j)
+            if (xl <= flagged[j][2] + 2 && xr >= flagged[j][0] - 2 && yt <= flagged[j][3] + 2 && yb >= flagged[j][1] - 2)
+            {
+                if (xl < flagged[j][0]) flagged[j][0] = xl; if (yt < flagged[j][1]) flagged[j][1] = yt;
+                if (xr > flagged[j][2]) flagged[j][2] = xr; if (yb > flagged[j][3]) flagged[j][3] = yb;
+                break;
+            }
+        if (j == nflag && nflag < 16) { flagged[nflag][0] = xl; flagged[nflag][1] = yt; flagged[nflag][2] = xr; flagged[nflag][3] = yb; nflag++; }
+    }
+    for (i = 0; i < nflag; ++i)
+        FIXME("UNMASKED quad on rt %ux%u at (%.0f,%.0f)-(%.0f,%.0f) size %.0fx%.0f, atlas %p %ux%u, tid %04lx\n",
+                rdesc.width, rdesc.height, flagged[i][0], flagged[i][1], flagged[i][2], flagged[i][3],
+                flagged[i][2] - flagged[i][0], flagged[i][3] - flagged[i][1], tex, tdesc.width, tdesc.height, GetCurrentThreadId());
+}
+
+static void draw_diag(struct d3d11_device_context *context, const char *what, unsigned int count,
+        unsigned int start, int base)
+{
+    struct wined3d_device_context *ctx = context->wined3d_context;
+    struct wined3d_rendertarget_view *rtv;
+    struct wined3d_shader_resource_view *srv;
+    struct wined3d_buffer *buffer;
+    struct wined3d_viewport vp;
+    unsigned int i, offset, stride, size, vp_count = 1, rect_count = 1;
+    RECT scissor;
+    char b0[128], b1[128], b2[128], b3[128];
+    enum wined3d_format_id ib_format;
+    struct wined3d_color blend_factor;
+    unsigned int sample_mask;
+
+    if (context->type != D3D11_DEVICE_CONTEXT_IMMEDIATE || !draw_diag_active()) return;
+    rtv = wined3d_device_context_get_rendertarget_view(ctx, 0);
+    wined3d_device_context_get_viewports(ctx, &vp_count, &vp);
+    wined3d_device_context_get_scissor_rects(ctx, &rect_count, &scissor);
+    FIXME("DRAW %s count %u start %u base %d rt %s vp (%g,%g %gx%g) scissor %s vs %p ps %p blend %p tid %04lx\n", what, count, start, base,
+            draw_diag_resource(rtv ? wined3d_rendertarget_view_get_resource(rtv) : NULL, b0, sizeof(b0)),
+            vp.x, vp.y, vp.width, vp.height, wine_dbgstr_rect(&scissor),
+            wined3d_device_context_get_shader(ctx, WINED3D_SHADER_TYPE_VERTEX),
+            wined3d_device_context_get_shader(ctx, WINED3D_SHADER_TYPE_PIXEL),
+            wined3d_device_context_get_blend_state(ctx, &blend_factor, &sample_mask), GetCurrentThreadId());
+    buffer = NULL; offset = stride = 0;
+    wined3d_device_context_get_stream_source(ctx, 0, &buffer, &offset, &stride);
+    FIXME("DRAW   vb0 %s offset %u stride %u ib %s\n", draw_diag_resource(buffer ? wined3d_buffer_get_resource(buffer) : NULL, b0, sizeof(b0)),
+            offset, stride, draw_diag_resource((buffer = wined3d_device_context_get_index_buffer(ctx, &ib_format, &offset)) ? wined3d_buffer_get_resource(buffer) : NULL, b1, sizeof(b1)));
+    for (i = 0; i < 2; ++i)
+    {
+        struct wined3d_constant_buffer_state cbs;
+        wined3d_device_context_get_constant_buffer(ctx, WINED3D_SHADER_TYPE_VERTEX, i, &cbs);
+        draw_diag_resource(cbs.buffer ? wined3d_buffer_get_resource(cbs.buffer) : NULL, b0, sizeof(b0));
+        wined3d_device_context_get_constant_buffer(ctx, WINED3D_SHADER_TYPE_PIXEL, i, &cbs);
+        FIXME("DRAW   vs cb%u %s | ps cb%u %s\n", i, b0, i, draw_diag_resource(cbs.buffer ? wined3d_buffer_get_resource(cbs.buffer) : NULL, b1, sizeof(b1)));
+    }
+    for (i = 0; i < 4; ++i)
+    {
+        srv = wined3d_device_context_get_shader_resource_view(ctx, WINED3D_SHADER_TYPE_PIXEL, i);
+        if (!srv) continue;
+        {
+        struct d3d_shader_resource_view *v = wined3d_shader_resource_view_get_parent(srv);
+        FIXME("DRAW   ps srv%u %s sampler %p\n", i, draw_diag_resource(v && v->resource ? wined3d_resource_from_d3d11_resource(v->resource) : NULL, b2, sizeof(b2)),
+                wined3d_device_context_get_sampler(ctx, WINED3D_SHADER_TYPE_PIXEL, i));
+        /* WINE_DRAW_DIAG_DUMP=<dir>: dump srv1 textures of WINE_DRAW_DIAG_DUMP_W width (importer side), at most 12 */
+        if (i == 1 && v && v->resource)
+        {
+            static const char *ddir; static BOOL dchecked; static int dcount; static DWORD last_tick; static unsigned int want_w;
+            ID3D11Texture2D *tex;
+            if (!dchecked) { const char *e; ddir = getenv("WINE_DRAW_DIAG_DUMP"); e = getenv("WINE_DRAW_DIAG_DUMP_W"); want_w = e ? atoi(e) : 1792; dchecked = TRUE; }
+            if (ddir && dcount < 12 && GetTickCount() - last_tick > 300
+                    && SUCCEEDED(ID3D11Resource_QueryInterface(v->resource, &IID_ID3D11Texture2D, (void **)&tex)))
+            {
+                D3D11_TEXTURE2D_DESC td; ID3D11Texture2D_GetDesc(tex, &td);
+                if (td.Width == want_w)
+                {
+                    static const char *saved_dir; RECT r = {0, 0, 0, 0};
+                    char tag[64]; snprintf(tag, sizeof(tag), "importer-%08lx", GetTickCount());
+                    /* reuse guard_debug_dump through its env: temporarily point WINE_GUARD_DUMP at ddir */
+                    (void)saved_dir; guard_debug_dump_to(context->device, tex, &r, tag, ddir);
+                    dcount++; last_tick = GetTickCount();
+                }
+                ID3D11Texture2D_Release(tex);
+            }
+        }
+        }
+    }
+    {
+        struct wined3d_constant_buffer_state cbs;
+        const float *f; unsigned int sz, k, len = 0; char line[512];
+        wined3d_device_context_get_constant_buffer(ctx, WINED3D_SHADER_TYPE_PIXEL, 0, &cbs);
+        if (cbs.buffer && (f = draw_diag_shadow((ID3D11Resource *)&((struct d3d_buffer *)wined3d_resource_get_parent(wined3d_buffer_get_resource(cbs.buffer)))->ID3D11Buffer_iface, &sz)))
+        {
+            for (k = 0; k < min(sz / 4, 24); ++k) len += snprintf(line + len, sizeof(line) - len, " %g", f[k]);
+            FIXME("DRAW   ps cb0 data:%s\n", line);
+        }
+    }
+    draw_diag_vertices(context, count, start, base, what[0] != 'd' || what[1] != 'r');
+    (void)b3; (void)size;
+}
+
+/* mapped buffer bookkeeping for the diag */
+static struct { ID3D11Resource *resource; void *data; unsigned int size, bind; DWORD tid; } draw_diag_maps[32];
+static struct { ID3D11Resource *resource; void *copy; unsigned int size; } draw_diag_shadows[64];
+
+static void draw_diag_map(ID3D11Resource *resource, void *data)
+{
+    D3D11_RESOURCE_DIMENSION dim;
+    struct d3d_buffer *buffer;
+    unsigned int i;
+
+    if (!draw_diag_active() && !mask_diag_enabled()) return;
+    ID3D11Resource_GetType(resource, &dim);
+    if (dim != D3D11_RESOURCE_DIMENSION_BUFFER) return;
+    buffer = unsafe_impl_from_ID3D11Buffer((ID3D11Buffer *)resource);
+    if (!(buffer->desc.BindFlags & (D3D11_BIND_VERTEX_BUFFER | D3D11_BIND_CONSTANT_BUFFER | D3D11_BIND_INDEX_BUFFER))) return;
+    wined3d_mutex_lock();
+    for (i = 0; i < 32; ++i)
+        if (!draw_diag_maps[i].resource)
+        {
+            draw_diag_maps[i].resource = resource; draw_diag_maps[i].data = data;
+            draw_diag_maps[i].size = buffer->desc.ByteWidth; draw_diag_maps[i].bind = buffer->desc.BindFlags;
+            draw_diag_maps[i].tid = GetCurrentThreadId();
+            break;
+        }
+    wined3d_mutex_unlock();
+}
+
+static void draw_diag_dump_floats(const char *what, ID3D11Resource *resource, unsigned int bind, unsigned int size, const void *data, unsigned int max_floats)
+{
+    const float *f = data;
+    const DWORD *u = data;
+    unsigned int n = min(size / 4, max_floats), i;
+    char line[1024];
+    int pos = 0;
+
+    FIXME("%s %p bind %#x size %u:\n", what, resource, bind, size);
+    for (i = 0; i < n; ++i)
+    {
+        if (bind & D3D11_BIND_INDEX_BUFFER)
+            pos += snprintf(line + pos, sizeof(line) - pos, " %#lx", (unsigned long)u[i]);
+        else
+            pos += snprintf(line + pos, sizeof(line) - pos, " %g", f[i]);
+        if ((i % 8) == 7 || i == n - 1) { FIXME("   [%u] %s\n", i - (i % 8), line); pos = 0; line[0] = 0; }
+    }
+}
+
+static void draw_diag_unmap(ID3D11Resource *resource)
+{
+    unsigned int i;
+    void *data = NULL;
+    unsigned int size = 0, bind = 0;
+
+    wined3d_mutex_lock();
+    for (i = 0; i < 32; ++i)
+        if (draw_diag_maps[i].resource == resource && draw_diag_maps[i].tid == GetCurrentThreadId())
+        {
+            data = draw_diag_maps[i].data; size = draw_diag_maps[i].size; bind = draw_diag_maps[i].bind;
+            draw_diag_maps[i].resource = NULL;
+            break;
+        }
+    wined3d_mutex_unlock();
+    if (data && !IsBadReadPtr(data, min(size, 512)))
+    {
+        unsigned int i;
+        wined3d_mutex_lock();
+        for (i = 0; i < 64; ++i)
+            if (draw_diag_shadows[i].resource == resource || !draw_diag_shadows[i].resource)
+            {
+                if (!draw_diag_shadows[i].resource || draw_diag_shadows[i].size < size)
+                {
+                    free(draw_diag_shadows[i].copy);
+                    draw_diag_shadows[i].copy = malloc(size);
+                    draw_diag_shadows[i].size = size;
+                    draw_diag_shadows[i].resource = resource;
+                }
+                memcpy(draw_diag_shadows[i].copy, data, size);
+                break;
+            }
+        wined3d_mutex_unlock();
+        if ((bind & D3D11_BIND_CONSTANT_BUFFER) && size <= 256 && draw_diag_active())
+            draw_diag_dump_floats("UNMAP", resource, bind, size, data, 64);
+    }
+}
+
+static const void *draw_diag_shadow(ID3D11Resource *resource, unsigned int *size)
+{
+    unsigned int i;
+    for (i = 0; i < 64; ++i)
+        if (draw_diag_shadows[i].resource == resource) { *size = draw_diag_shadows[i].size; return draw_diag_shadows[i].copy; }
+    return NULL;
+}
