+{
+    struct composition_visual *impl = impl_from_IVisual2( iface );
+    TRACE( "iface %p, value (%f, %f).\n", iface, value.X, value.Y );
+    if (value.X || value.Y) FIXME( "relative size adjustment (%f, %f) is stored but not applied.\n", value.X, value.Y );
+    impl->relative_size_adjustment = value;
+    return S_OK;
+}
+
+static const struct IVisual2Vtbl visual2_vtbl =
+{
+    visual2_QueryInterface,
+    visual2_AddRef,
+    visual2_Release,
+    /* IInspectable */
+    visual2_GetIids,
+    visual2_GetRuntimeClassName,
+    visual2_GetTrustLevel,
+    /* IVisual2 */
+    visual2_get_ParentForTransform,
+    visual2_put_ParentForTransform,
+    visual2_get_RelativeOffsetAdjustment,
+    visual2_put_RelativeOffsetAdjustment,
+    visual2_get_RelativeSizeAdjustment,
+    visual2_put_RelativeSizeAdjustment,
+};
+
+/*
+ * IContainerVisual {02f6bc74-ed20-4773-afe6-d49b4a93db32}: get_Children only.
+ */
+DEFINE_COMPOSITION_OBJECT_IINSPECTABLE( container_visual, IContainerVisual, struct composition_visual,
+                                        object, IContainerVisual_iface )
+
+static HRESULT WINAPI container_visual_get_Children( IContainerVisual *iface, IVisualCollection **value )
+{
+    struct composition_visual *impl = impl_from_IContainerVisual( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!impl->children) return E_UNEXPECTED;
+    IVisualCollection_AddRef( (*value = &impl->children->IVisualCollection_iface) );
+    return S_OK;
+}
+
+static const struct IContainerVisualVtbl container_visual_vtbl =
+{
+    container_visual_QueryInterface,
+    container_visual_AddRef,
+    container_visual_Release,
+    /* IInspectable */
+    container_visual_GetIids,
+    container_visual_GetRuntimeClassName,
+    container_visual_GetTrustLevel,
+    /* IContainerVisual */
+    container_visual_get_Children,
+};
+
+/*
+ * ISpriteVisual {08e05581-1ad1-4f97-9757-402d76e4233b}: get_Brush, put_Brush.
+ * dcompi!ExternalTargetImpl<DesktopWindowTarget>::SetSystemBackdrop rva 0xc7872
+ * calls vtable offset 0x38 = slot 7 = put_Brush with the Mica fallback brush.
+ */
+DEFINE_COMPOSITION_OBJECT_IINSPECTABLE( sprite_visual, ISpriteVisual, struct composition_visual,
+                                        object, ISpriteVisual_iface )
+
+static HRESULT WINAPI sprite_visual_get_Brush( ISpriteVisual *iface, ICompositionBrush **value )
+{
+    struct composition_visual *impl = impl_from_ISpriteVisual( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if ((*value = impl->brush)) ICompositionBrush_AddRef( *value );
+    return S_OK;
+}
+
+/*
+ * FIXME: record-only.  Every brush is reduced to the one colour it would paint
+ * (composition_brush_resolve_color(): a CompositionColorBrush's Color, or the
+ * colour an effect brush's graph resolves to -- the Mica fallback colour on the
+ * App SDK's crossfade brush), and that colour is kept in @brush_color.  Painting
+ * it would mean giving the dcomp visual a surface, but the desktop-device
+ * surface path of dlls/dcomp is still a stub (desktop_device_CreateSurface,
+ * device.c:1161) and IDCompositionDevice2::CreateSurfaceFactory needs a D3D
+ * rendering device, which the App SDK never hands to this compositor (it passes
+ * NULL to CreateInteropCompositor); DirectComposition has no colour-brush
+ * content of its own.  The only brushes the App SDK puts here are the Mica
+ * fallback colour and its crossfade, so the cost of getting this wrong is a
+ * missing tint, not a missing window.
+ */
+static HRESULT WINAPI sprite_visual_put_Brush( ISpriteVisual *iface, ICompositionBrush *value )
+{
+    struct composition_visual *impl = impl_from_ISpriteVisual( iface );
+
+    FIXME( "iface %p, value %p semi-stub!\n", iface, value );
+
+    if (value) ICompositionBrush_AddRef( value );
+    if (impl->brush) ICompositionBrush_Release( impl->brush );
+    impl->brush = value;
+
+    impl->has_brush_color = value && composition_brush_resolve_color( value, &impl->brush_color );
+    if (impl->has_brush_color)
+        TRACE( "brush %p resolves to colour {%u, %u, %u, %u}.\n", value, impl->brush_color.A,
+               impl->brush_color.R, impl->brush_color.G, impl->brush_color.B );
+    else
+        TRACE( "brush %p resolves to no colour (transparent).\n", value );
+    return S_OK;
+}
+
+static const struct ISpriteVisualVtbl sprite_visual_vtbl =
+{
+    sprite_visual_QueryInterface,
+    sprite_visual_AddRef,
+    sprite_visual_Release,
+    /* IInspectable */
+    sprite_visual_GetIids,
+    sprite_visual_GetRuntimeClassName,
+    sprite_visual_GetTrustLevel,
+    /* ISpriteVisual */
+    sprite_visual_get_Brush,
+    sprite_visual_put_Brush,
+};
+
+HRESULT composition_visual_create( ICompositor *compositor, IDCompositionDesktopDevice *device,
+                                   enum composition_visual_kind kind, IInspectable **out )
+{
+    const struct composition_object_ops *ops;
+    struct composition_visual *impl;
+    IInspectable *default_iface;
+    HRESULT hr;
+
+    *out = NULL;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IVisual_iface.lpVtbl = &visual_vtbl;
+    impl->IVisual2_iface.lpVtbl = &visual2_vtbl;
+    impl->IContainerVisual_iface.lpVtbl = &container_visual_vtbl;
+    impl->ISpriteVisual_iface.lpVtbl = &sprite_visual_vtbl;
+    impl->kind = kind;
+
+    /* Windows.UI.Composition defaults (matching the public documentation): a
+     * visual is visible, fully opaque, unrotated and unscaled. */
+    impl->is_visible = TRUE;
+    impl->opacity = 1.0f;
+    impl->scale.X = impl->scale.Y = impl->scale.Z = 1.0f;
+    impl->rotation_axis.Z = 1.0f;
+    impl->orientation.W = 1.0f;
+    impl->transform_matrix.M11 = impl->transform_matrix.M22 = 1.0f;
+    impl->transform_matrix.M33 = impl->transform_matrix.M44 = 1.0f;
+
+    switch (kind)
+    {
+    case COMPOSITION_SPRITE_VISUAL:
+        ops = &sprite_visual_ops;
+        default_iface = (IInspectable *)&impl->ISpriteVisual_iface;
+        break;
+    case COMPOSITION_CONTAINER_VISUAL:
+        ops = &container_visual_ops;
+        default_iface = (IInspectable *)&impl->IContainerVisual_iface;
+        break;
+    default:
+        ops = &visual_ops;
+        default_iface = (IInspectable *)&impl->IVisual_iface;
+        break;
+    }
+
+    composition_object_init( &impl->object, ops, default_iface, compositor );
+
+    if (device && FAILED(hr = IDCompositionDesktopDevice_CreateVisual( device, &impl->dcomp_visual )))
+    {
+        WARN( "IDCompositionDevice2::CreateVisual failed, hr %#lx.\n", hr );
+        impl->dcomp_visual = NULL;
+    }
+
+    if (kind != COMPOSITION_VISUAL && FAILED(hr = visual_collection_create( compositor, impl, &impl->children )))
+    {
+        composition_object_release( &impl->object );
+        return hr;
+    }
+
+    TRACE( "created %s %p, inner dcomp visual %p.\n", debugstr_w( ops->class_name ), impl, impl->dcomp_visual );
+
+    *out = default_iface;
+    return S_OK;
+}
