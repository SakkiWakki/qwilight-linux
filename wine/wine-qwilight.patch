+static inline struct compositor_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct compositor_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct compositor_factory *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IInteropCompositorFactoryPartner ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IInteropCompositorFactoryPartner_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ICompositorFactoryCoreMessagingInterop ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositorFactoryCoreMessagingInterop_iface) );
+        return S_OK;
+    }
+
+    /* Deliberately refused: ICompositorFactorySupportsSwitcher
+     * {a4b0a797-3753-41ea-98fc-ddf484f0d7da} is what tells the Windows App SDK
+     * that this compositor can host its lifted visuals.  Measured with the
+     * Qwilight 2.0 beta (survey/impl-composition-exp-switcher.log): answering it
+     * makes dcompi.dll call ActivateInstance and QI the result, but it then
+     * takes the same in-process path either way (dwmcorei.dll + marshal.dll on
+     * top of dcomp.dll), so refusing it costs nothing and keeps the App SDK away
+     * from an interop compositor that cannot yet host anything. */
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
