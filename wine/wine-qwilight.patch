+/*
+ * The fallback resolver: the one colour a brush would paint.
+ *
+ * A colour brush is its Color.  An effect brush is walked through
+ * IGraphicsEffectD2D1Interop, depth first, sources in order: a
+ * CompositionEffectSourceParameter resolves to whatever brush is bound to its
+ * name on the effect brush, a flood (colour source) effect to its colour
+ * property, any other effect to the first of its sources that resolves.  So the
+ * App SDK's CrossFade(source1 = fallback colour brush, source2 = ...) resolves
+ * to source1's colour, which is exactly the Mica fallback it means to show.
+ *
+ * The depth limit exists because a brush can be bound to its own parameter.
+ */
+#define RESOLVE_MAX_DEPTH 8
+
+static BOOL resolve_brush( ICompositionBrush *brush, Color *color, unsigned int depth );
+
+static BYTE color_channel_from_float( FLOAT value )
+{
+    if (!(value > 0.0f)) return 0;
+    if (value >= 1.0f) return 255;
+    return (BYTE)(value * 255.0f + 0.5f);
+}
+
+/* A flood effect's colour is an IPropertyValue holding a float[4] (RGBA) or a
+ * float[3] (RGB); the property's own type is what identifies it, so the
+ * GRAPHICS_EFFECT_PROPERTY_MAPPING enum is not needed. */
+static BOOL resolve_flood_color( IGraphicsEffectD2D1Interop *interop, Color *color )
+{
+    UINT count = 0, i, size;
+    IPropertyValue *value;
+    PropertyType type;
+    FLOAT *floats;
+    BOOL found = FALSE;
+
+    if (FAILED(interop->lpVtbl->GetPropertyCount( interop, &count ))) return FALSE;
+
+    for (i = 0; i < count && !found; i++)
+    {
+        if (FAILED(interop->lpVtbl->GetProperty( interop, i, &value )) || !value) continue;
+        if (SUCCEEDED(IPropertyValue_get_Type( value, &type )) && type == PropertyType_SingleArray
+                && SUCCEEDED(IPropertyValue_GetSingleArray( value, &size, &floats )))
+        {
+            if (size == 3 || size == 4)
+            {
+                color->R = color_channel_from_float( floats[0] );
+                color->G = color_channel_from_float( floats[1] );
+                color->B = color_channel_from_float( floats[2] );
+                color->A = size == 4 ? color_channel_from_float( floats[3] ) : 255;
+                found = TRUE;
+            }
+            CoTaskMemFree( floats );
+        }
+        IPropertyValue_Release( value );
+    }
+    return found;
+}
+
+static BOOL resolve_effect_source( struct effect_brush *brush, IGraphicsEffectSource *source, Color *color,
+                                   unsigned int depth );
+
+static BOOL resolve_effect( struct effect_brush *brush, IGraphicsEffectD2D1Interop *interop, Color *color,
+                            unsigned int depth )
+{
+    IGraphicsEffectSource *source;
+    UINT count = 0, i;
+    GUID id;
+
+    if (SUCCEEDED(interop->lpVtbl->GetEffectId( interop, &id )))
+    {
+        TRACE( "effect %p, id %s, depth %u.\n", interop, debugstr_guid( &id ), depth );
+        if (IsEqualGUID( &id, &CLSID_D2D1Flood ) && resolve_flood_color( interop, color )) return TRUE;
+    }
+
+    if (FAILED(interop->lpVtbl->GetSourceCount( interop, &count ))) return FALSE;
+
+    for (i = 0; i < count; i++)
+    {
+        BOOL resolved;
+
+        if (FAILED(interop->lpVtbl->GetSource( interop, i, &source )) || !source) continue;
+        resolved = resolve_effect_source( brush, source, color, depth + 1 );
+        IGraphicsEffectSource_Release( source );
+        if (resolved) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL resolve_effect_source( struct effect_brush *brush, IGraphicsEffectSource *source, Color *color,
+                                   unsigned int depth )
+{
+    ICompositionEffectSourceParameter *parameter;
+    IGraphicsEffectD2D1Interop *interop;
+    struct effect_source_binding *binding;
+    BOOL resolved = FALSE;
+    HSTRING name;
+
+    if (depth > RESOLVE_MAX_DEPTH)
+    {
+        WARN( "effect graph deeper than %u at %p, giving up.\n", RESOLVE_MAX_DEPTH, source );
+        return FALSE;
+    }
+
+    if (SUCCEEDED(IGraphicsEffectSource_QueryInterface( source, &IID_ICompositionEffectSourceParameter,
+                                                        (void **)&parameter )))
+    {
+        if (SUCCEEDED(ICompositionEffectSourceParameter_get_Name( parameter, &name )))
+        {
+            binding = effect_brush_find_source( brush, name );
+            TRACE( "source parameter %s -> brush %p.\n", debugstr_hstring( name ), binding ? binding->brush : NULL );
+            if (binding && binding->brush) resolved = resolve_brush( binding->brush, color, depth + 1 );
+            WindowsDeleteString( name );
+        }
+        ICompositionEffectSourceParameter_Release( parameter );
+        return resolved;
+    }
+
+    if (SUCCEEDED(IGraphicsEffectSource_QueryInterface( source, &IID_IGraphicsEffectD2D1Interop, (void **)&interop )))
+    {
+        resolved = resolve_effect( brush, interop, color, depth );
+        interop->lpVtbl->Release( interop );
+        return resolved;
+    }
+
+    /* A foreign source (a CompositionSurfaceBrush, say) is not a colour. */
+    TRACE( "source %p is neither a parameter nor an effect.\n", source );
+    return FALSE;
+}
+
+static BOOL resolve_brush( ICompositionBrush *brush, Color *color, unsigned int depth )
+{
+    IGraphicsEffectD2D1Interop *interop;
+    ICompositionColorBrush *color_brush;
+    struct effect_brush *impl;
+    BOOL resolved = FALSE;
+
+    if (depth > RESOLVE_MAX_DEPTH)
+    {
+        WARN( "brush graph deeper than %u at %p, giving up.\n", RESOLVE_MAX_DEPTH, brush );
+        return FALSE;
+    }
+
+    /* Our own two brush classes are told apart by vtable identity, so that
+     * probing one for the other does not go through (and WARN in) the base
+     * QueryInterface every time a brush is set on a visual. */
+    if (composition_color_brush_get_color( brush, color )) return TRUE;
+
+    if (brush->lpVtbl == &effect_brush_brush_vtbl)
+    {
+        impl = impl_from_ICompositionBrush( brush );
+        if (impl->effect && SUCCEEDED(IGraphicsEffect_QueryInterface( impl->effect, &IID_IGraphicsEffectD2D1Interop,
+                                                                       (void **)&interop )))
+        {
+            resolved = resolve_effect( impl, interop, color, depth );
+            interop->lpVtbl->Release( interop );
+        }
+        else
+        {
+            /* No graph to walk: the first bound colour wins. */
+            struct effect_source_binding *binding;
+
+            FIXME( "effect %p has no IGraphicsEffectD2D1Interop, using the first bound brush.\n", impl->effect );
+            LIST_FOR_EACH_ENTRY( binding, &impl->sources, struct effect_source_binding, entry )
+            {
+                if (binding->brush && (resolved = resolve_brush( binding->brush, color, depth + 1 ))) break;
+            }
+        }
+        return resolved;
+    }
+
+    /* A foreign brush: only a colour brush can be read from the outside. */
+    if (SUCCEEDED(ICompositionBrush_QueryInterface( brush, &IID_ICompositionColorBrush, (void **)&color_brush )))
+    {
+        resolved = SUCCEEDED(ICompositionColorBrush_get_Color( color_brush, color ));
+        ICompositionColorBrush_Release( color_brush );
+        return resolved;
+    }
+
+    TRACE( "brush %p is neither a colour nor an effect brush.\n", brush );
+    return FALSE;
+}
+
+BOOL composition_brush_resolve_color( ICompositionBrush *brush, Color *color )
+{
+    BOOL resolved;
+
+    TRACE( "brush %p, color %p.\n", brush, color );
+
+    memset( color, 0, sizeof(*color) );
+    resolved = resolve_brush( brush, color, 0 );
+    TRACE( "brush %p -> %s {%u, %u, %u, %u}.\n", brush, resolved ? "colour" : "nothing",
+           color->A, color->R, color->G, color->B );
+    return resolved;
+}
+
+/*
+ * CompositionEffectFactory -- compiles an effect graph once so that brushes can
+ * be stamped out of it.  There is nothing to compile here, so it only keeps the
+ * IGraphicsEffect and reports a successful load.
+ */
+struct effect_factory
+{
+    struct composition_object object;   /* must be first: owns the refcount */
+    ICompositionEffectFactory ICompositionEffectFactory_iface;  /* the [default] interface */
+
+    IGraphicsEffect *effect;            /* strong */
+};
+
+static inline struct effect_factory *effect_factory_from_composition_object( struct composition_object *obj )
+{
+    return CONTAINING_RECORD( obj, struct effect_factory, object );
+}
+
+static HRESULT effect_factory_query_interface( struct composition_object *obj, REFIID iid, void **out )
+{
+    struct effect_factory *impl = effect_factory_from_composition_object( obj );
+
+    if (IsEqualGUID( iid, &IID_ICompositionEffectFactory ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositionEffectFactory_iface) );
+        return S_OK;
+    }
+
+    return E_NOINTERFACE;
+}
+
+static void effect_factory_destroy( struct composition_object *obj )
+{
+    struct effect_factory *impl = effect_factory_from_composition_object( obj );
+
+    if (impl->effect) IGraphicsEffect_Release( impl->effect );
+    free( impl );
+}
+
+static const struct composition_object_ops effect_factory_ops =
+{
+    RuntimeClass_Windows_UI_Composition_CompositionEffectFactory,
+    ARRAY_SIZE(RuntimeClass_Windows_UI_Composition_CompositionEffectFactory) - 1,
+    effect_factory_query_interface,
+    effect_factory_destroy,
+};
+
+/*
+ * ICompositionEffectFactory {be5624af-ba7e-4510-9850-41c0b4ff74df}: slot 6
+ * CreateBrush, slot 7 get_ExtendedError, slot 8 get_LoadStatus.  Order from
+ * include/windows.ui.composition.idl (the generated header), CreateBrush pinned
+ * by CreateCrossFadeEffectBrush's helper at wuceffectsi rva 0x375c4, which calls
+ * vtable offset 0x30 on the factory CreateEffectFactoryWithProperties returned.
+ */
+DEFINE_COMPOSITION_OBJECT_IINSPECTABLE( effect_factory, ICompositionEffectFactory, struct effect_factory,
+                                        object, ICompositionEffectFactory_iface )
+
+static HRESULT WINAPI effect_factory_CreateBrush( ICompositionEffectFactory *iface, ICompositionEffectBrush **result )
+{
+    struct effect_factory *impl = impl_from_ICompositionEffectFactory( iface );
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    if (!result) return E_POINTER;
+    return effect_brush_create( impl->object.compositor, impl->effect, result );
+}
+
+static HRESULT WINAPI effect_factory_get_ExtendedError( ICompositionEffectFactory *iface, HRESULT *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = S_OK;
+    return S_OK;
+}
+
+static HRESULT WINAPI effect_factory_get_LoadStatus( ICompositionEffectFactory *iface,
+                                                     CompositionEffectFactoryLoadStatus *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = CompositionEffectFactoryLoadStatus_Success;
+    return S_OK;
+}
+
+static const struct ICompositionEffectFactoryVtbl effect_factory_vtbl =
+{
+    effect_factory_QueryInterface,
+    effect_factory_AddRef,
+    effect_factory_Release,
+    /* IInspectable */
+    effect_factory_GetIids,
+    effect_factory_GetRuntimeClassName,
+    effect_factory_GetTrustLevel,
+    /* ICompositionEffectFactory */
+    effect_factory_CreateBrush,
+    effect_factory_get_ExtendedError,
+    effect_factory_get_LoadStatus,
+};
+
+/* The animatable property names are only traced: there is no animation engine
+ * to make them animatable in, and ICompositionObject::StartAnimation on the
+ * brush is record-only anyway (object.c). */
+static void trace_animatable_properties( IIterable_HSTRING *animatable )
+{
+    IIterator_HSTRING *iterator;
+    boolean has_current;
+    HSTRING name;
+
+    if (!animatable || !TRACE_ON(composition)) return;
+    if (FAILED(IIterable_HSTRING_First( animatable, &iterator ))) return;
+
+    while (SUCCEEDED(IIterator_HSTRING_get_HasCurrent( iterator, &has_current )) && has_current)
+    {
+        if (SUCCEEDED(IIterator_HSTRING_get_Current( iterator, &name )))
+        {
+            TRACE( "animatable property %s.\n", debugstr_hstring( name ) );
+            WindowsDeleteString( name );
+        }
+        if (FAILED(IIterator_HSTRING_MoveNext( iterator, &has_current )) || !has_current) break;
+    }
+    IIterator_HSTRING_Release( iterator );
+}
+
+HRESULT composition_effect_factory_create( ICompositor *compositor, IGraphicsEffect *effect,
+                                           IIterable_HSTRING *animatable, ICompositionEffectFactory **out )
+{
+    struct effect_factory *impl;
+    HSTRING name = NULL;
+
+    *out = NULL;
+
+    if (!effect) return E_INVALIDARG;
+
+    if (TRACE_ON(composition) && SUCCEEDED(IGraphicsEffect_get_Name( effect, &name )))
+    {
+        TRACE( "effect %p, name %s.\n", effect, debugstr_hstring( name ) );
+        WindowsDeleteString( name );
+    }
+    trace_animatable_properties( animatable );
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->ICompositionEffectFactory_iface.lpVtbl = &effect_factory_vtbl;
+    impl->effect = effect;
+    IGraphicsEffect_AddRef( impl->effect );
+    composition_object_init( &impl->object, &effect_factory_ops,
+                             (IInspectable *)&impl->ICompositionEffectFactory_iface, compositor );
+
+    TRACE( "created effect factory %p, effect %p.\n", impl, effect );
+
+    *out = &impl->ICompositionEffectFactory_iface;
+    return S_OK;
+}
