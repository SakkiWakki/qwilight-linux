+/* Shared name/value store.  Windows parses and merges header values; we keep
+ * every appended pair, in order, which is what a transport would replay. */
+HRESULT header_list_append( struct list *headers, HSTRING name, HSTRING value )
+{
+    struct header_entry *entry;
+    HRESULT hr;
+
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = WindowsDuplicateString( name, &entry->name )) ||
+        FAILED(hr = WindowsDuplicateString( value, &entry->value )))
+    {
+        WindowsDeleteString( entry->name );
+        free( entry );
+        return hr;
+    }
+
+    list_add_tail( headers, &entry->entry );
+    return S_OK;
+}
+
+void header_list_clear( struct list *headers )
+{
+    struct header_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, headers, struct header_entry, entry )
+    {
+        list_remove( &entry->entry );
+        WindowsDeleteString( entry->name );
+        WindowsDeleteString( entry->value );
+        free( entry );
+    }
+}
