+static HRESULT effect_brush_query_interface( struct composition_object *obj, REFIID iid, void **out )
+{
+    struct effect_brush *impl = effect_brush_from_composition_object( obj );
+
+    if (IsEqualGUID( iid, &IID_ICompositionEffectBrush ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositionEffectBrush_iface) );
+        return S_OK;
+    }
+
+    /* GetAnimationBrush (rva 0x31dee) asks for this before handing the brush on. */
+    if (IsEqualGUID( iid, &IID_ICompositionBrush ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositionBrush_iface) );
+        return S_OK;
+    }
+
+    return E_NOINTERFACE;
+}
