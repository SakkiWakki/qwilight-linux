+static void variable_set_value( struct variable2 *var, struct storyboard2 *sb, const double *value, BOOL *changed )
+{
+    double newval[WAM_MAX_DIM];
+    unsigned int i;
+    BOOL differs = FALSE;
+
+    for (i = 0; i < var->dim; i++)
+    {
+        double v = value[i];
+        if (var->has_lower && v < var->lower[i]) v = var->lower[i];
+        if (var->has_upper && v > var->upper[i]) v = var->upper[i];
+        newval[i] = v;
+        if (v != var->value[i]) differs = TRUE;
+    }
+    if (!differs) return;
+
+    memcpy( var->previous, var->value, sizeof(var->value) );
+    memcpy( var->value, newval, sizeof(var->value) );
+    *changed = TRUE;
+
+    if (var->handler)
+    {
+        IUIAnimationStoryboard2 *sbi = sb ? &sb->IUIAnimationStoryboard2_iface : NULL;
+        IUIAnimationVariableChangeHandler2_OnValueChanged( var->handler, sbi, &var->IUIAnimationVariable2_iface,
+                var->value, var->previous, var->dim );
+    }
+    if (var->integer_handler)
+    {
+        INT32 ni[WAM_MAX_DIM], pi[WAM_MAX_DIM];
+        BOOL idiff = FALSE;
+        for (i = 0; i < var->dim; i++)
+        {
+            ni[i] = (INT32)floor( var->value[i] + 0.5 );
+            pi[i] = (INT32)floor( var->previous[i] + 0.5 );
+            if (ni[i] != pi[i]) idiff = TRUE;
+        }
+        if (idiff)
+        {
+            IUIAnimationStoryboard2 *sbi = sb ? &sb->IUIAnimationStoryboard2_iface : NULL;
+            IUIAnimationVariableIntegerChangeHandler2_OnIntegerValueChanged( var->integer_handler, sbi,
+                    &var->IUIAnimationVariable2_iface, ni, pi, var->dim );
+        }
+    }
+}
+
+static INT32 variable_round( const struct variable2 *var, double v )
+{
+    switch (var->rounding)
+    {
+    case UI_ANIMATION_ROUNDING_FLOOR: return (INT32)floor( v );
+    case UI_ANIMATION_ROUNDING_CEILING: return (INT32)ceil( v );
+    default: return (INT32)floor( v + 0.5 );
+    }
+}
