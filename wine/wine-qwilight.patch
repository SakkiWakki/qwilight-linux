+ * here inspects it, and every user of this DLL so far only round-trips it. */
+#define DEFINE_RECORDED_PROPERTY( pfx, iface_type, impl_type, name, field )                        \
+    static HRESULT WINAPI pfx##_get_##name( iface_type *iface, IInspectable **value )              \
+    {                                                                                              \
+        impl_type *impl = impl_from_##iface_type( iface );                                         \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (!value) return E_POINTER;                                                              \
+        if ((*value = impl->field)) IInspectable_AddRef( *value );                                 \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_put_##name( iface_type *iface, IInspectable *value )               \
+    {                                                                                              \
+        impl_type *impl = impl_from_##iface_type( iface );                                         \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (value) IInspectable_AddRef( value );                                                   \
+        if (impl->field) IInspectable_Release( impl->field );                                      \
+        impl->field = value;                                                                       \
+        return S_OK;                                                                               \
+    }
