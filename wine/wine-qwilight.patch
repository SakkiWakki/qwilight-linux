+            case INPROC_SYNC_SEMAPHORE:
+                count = 1;
+                ioctl( waiter->sync->fd, NTSYNC_IOC_SEM_RELEASE, &count );
+                break;
+            case INPROC_SYNC_MUTEX:  /* never a waiter target */
