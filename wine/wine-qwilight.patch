+/* ---------------------------------------------------------------------- */
+/* DecimalFormatter */
+
+struct formatter
+{
+    INumberFormatter INumberFormatter_iface;
+    INumberFormatter2 INumberFormatter2_iface;
+    INumberFormatterOptions INumberFormatterOptions_iface;
+    INumberParser INumberParser_iface;
+    INumberRounderOption INumberRounderOption_iface;
+    ISignedZeroOption ISignedZeroOption_iface;
+    ISignificantDigitsOption ISignificantDigitsOption_iface;
+    LONG ref;
+    INT32 integer_digits;
+    INT32 fraction_digits;
+    INT32 significant_digits;
+    BOOL grouped;
+    BOOL point_always;
+    BOOL zero_signed;
+    INumberRounder *rounder;
+};
+
+static inline struct formatter *impl_from_INumberFormatter( INumberFormatter *iface )
+{
+    return CONTAINING_RECORD( iface, struct formatter, INumberFormatter_iface );
+}
+
+/* Build the decimal text: digits is the plain decimal representation (no sign) with
+ * optional '.', the options pad it. */
+static HRESULT formatter_build( struct formatter *impl, BOOL negative, const char *digits, HSTRING *result )
+{
+    char integer[64], fraction[400], out[512], *p = out;
+    const char *point = strchr( digits, '.' );
+    unsigned int int_len, frac_len, significant, i, n;
+
+    int_len = point ? point - digits : strlen( digits );
+    if (int_len >= sizeof(integer)) return E_INVALIDARG;
+    memcpy( integer, digits, int_len );
+    integer[int_len] = 0;
+    strcpy( fraction, point ? point + 1 : "" );
+    frac_len = strlen( fraction );
+
+    /* trailing zeros of the fraction carry no information */
+    while (frac_len && fraction[frac_len - 1] == '0') fraction[--frac_len] = 0;
+    /* leading zeros of the integer part neither */
+    while (int_len > 1 && integer[0] == '0') { memmove( integer, integer + 1, int_len-- ); }
+
+    /* minimum fraction digits */
+    while ((INT32)frac_len < impl->fraction_digits && frac_len < sizeof(fraction) - 1) fraction[frac_len++] = '0';
+    fraction[frac_len] = 0;
+
+    /* minimum significant digits: pad the fraction */
+    significant = frac_len + (strcmp( integer, "0" ) ? int_len : 0);
+    if (!strcmp( integer, "0" ))
+    {
+        for (i = 0; i < frac_len && fraction[i] == '0'; i++) significant--;
+    }
+    while ((INT32)significant < impl->significant_digits && frac_len < sizeof(fraction) - 1)
+    {
+        fraction[frac_len++] = '0';
+        significant++;
+    }
+    fraction[frac_len] = 0;
+
+    /* minimum integer digits */
+    n = impl->integer_digits > 0 ? impl->integer_digits : 0;
+    if (n >= sizeof(integer)) n = sizeof(integer) - 1;
+    if (int_len < n)
+    {
+        memmove( integer + (n - int_len), integer, int_len + 1 );
+        memset( integer, '0', n - int_len );
+        int_len = n;
+    }
+    if (!impl->integer_digits && !strcmp( integer, "0" ) && frac_len)
+    {
+        integer[0] = 0;
+        int_len = 0;
+    }
+
+    if (negative && !(impl->zero_signed == FALSE && !strcmp( integer, "0" ) && strspn( fraction, "0" ) == frac_len && frac_len))
+        *p++ = '-';
+    else if (negative && impl->zero_signed)
+        *p++ = '-';
+    for (i = 0; i < int_len; i++)
+    {
+        *p++ = integer[i];
+        if (impl->grouped && int_len - i - 1 && !((int_len - i - 1) % 3)) *p++ = ',';
+    }
+    if (frac_len || impl->point_always)
+    {
+        *p++ = '.';
+        memcpy( p, fraction, frac_len );
+        p += frac_len;
+    }
+    *p = 0;
+
+    {
+        WCHAR wide[512];
+        MultiByteToWideChar( CP_ACP, 0, out, -1, wide, ARRAY_SIZE(wide) );
+        return WindowsCreateString( wide, wcslen( wide ), result );
+    }
+}
+
+static HRESULT formatter_format_double( struct formatter *impl, double value, HSTRING *result )
+{
+    char digits[400];
+    BOOL negative;
+    HRESULT hr;
+
+    if (isnan( value )) return WindowsCreateString( L"NaN", 3, result );
+    if (isinf( value )) return WindowsCreateString( value < 0 ? L"-\x221e" : L"\x221e", value < 0 ? 2 : 1, result );
+
+    if (impl->rounder && FAILED(hr = INumberRounder_RoundDouble( impl->rounder, value, &value ))) return hr;
+    negative = signbit( value );
+    value = fabs( value );
+    /* shortest round-trip-ish representation, then expand exponent forms */
+    snprintf( digits, sizeof(digits), "%.15g", value );
+    if (strchr( digits, 'e' ))
+        snprintf( digits, sizeof(digits), "%.20f", value );
+    return formatter_build( impl, negative, digits, result );
+}
+
+static HRESULT formatter_format_int( struct formatter *impl, INT64 value, HSTRING *result )
+{
+    char digits[64];
+    HRESULT hr;
+
+    if (impl->rounder && FAILED(hr = INumberRounder_RoundInt64( impl->rounder, value, &value ))) return hr;
+    snprintf( digits, sizeof(digits), "%I64u", (UINT64)(value < 0 ? -value : value) );
+    return formatter_build( impl, value < 0, digits, result );
+}
+
+static HRESULT formatter_format_uint( struct formatter *impl, UINT64 value, HSTRING *result )
+{
+    char digits[64];
+    HRESULT hr;
+
+    if (impl->rounder && FAILED(hr = INumberRounder_RoundUInt64( impl->rounder, value, &value ))) return hr;
+    snprintf( digits, sizeof(digits), "%I64u", value );
+    return formatter_build( impl, FALSE, digits, result );
+}
