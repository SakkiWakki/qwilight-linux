+/* The IReference`1 instantiation a boxed value of this type also exposes, if any.
+ * Keep in sync with property_value_QueryInterface. */
+static const IID *property_value_reference_iid(PropertyType type)
+{
+    switch (type)
+    {
+    case PropertyType_UInt8:    return &IID_IReference_BYTE;
+    case PropertyType_Int16:    return &IID_IReference_INT16;
+    case PropertyType_Int32:    return &IID_IReference_INT32;
+    case PropertyType_UInt32:   return &IID_IReference_UINT32;
+    case PropertyType_Int64:    return &IID_IReference_INT64;
+    case PropertyType_UInt64:   return &IID_IReference_UINT64;
+    case PropertyType_Boolean:  return &IID_IReference_boolean;
+    case PropertyType_Single:   return &IID_IReference_FLOAT;
+    case PropertyType_Double:   return &IID_IReference_DOUBLE;
+    case PropertyType_DateTime: return &IID_IReference_DateTime;
+    case PropertyType_TimeSpan: return &IID_IReference_TimeSpan;
+    case PropertyType_Guid:     return &IID_IReference_GUID;
+    case PropertyType_Point:    return &IID_IReference_Point;
+    case PropertyType_Size:     return &IID_IReference_Size;
+    case PropertyType_Rect:     return &IID_IReference_Rect;
+    case PropertyType_String:   return &IID_IReference_HSTRING;
+    default: return NULL;
+    }
+}
+
+/* IInspectable::GetIids reports the interfaces the object implements, excluding
+ * IUnknown and IInspectable. */
 static HRESULT STDMETHODCALLTYPE property_value_GetIids(IPropertyValue *iface, ULONG *iid_count, IID **iids)
 {
-    FIXME("iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids);
-    return E_NOTIMPL;
+    struct property_value *impl = impl_from_IPropertyValue(iface);
+    const IID *reference_iid;
+    ULONG count = 2;
+    IID *array;
+
+    TRACE("iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids);
+
+    if (!iid_count || !iids)
+        return E_POINTER;
+
+    *iid_count = 0;
+    *iids = NULL;
+
+    reference_iid = property_value_reference_iid(impl->type);
+    if (reference_iid) count++;
+
+    if (!(array = CoTaskMemAlloc(count * sizeof(*array))))
+        return E_OUTOFMEMORY;
+
+    array[0] = IID_IPropertyValue;
+    array[1] = IID_IAgileObject;
+    if (reference_iid) array[2] = *reference_iid;
+
+    *iid_count = count;
+    *iids = array;
+    return S_OK;
 }
 
+/* PropertyType_XxxArray is PropertyType_Xxx | 1024 */
+#define PROPERTY_TYPE_ARRAY_FLAG (PropertyType_UInt8Array - PropertyType_UInt8)
