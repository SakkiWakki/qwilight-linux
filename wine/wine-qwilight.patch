+/* TEMP DIAG: on a critical section timeout, print the owner thread's instruction pointer and
+ * this thread's stack as module+RVA. Modules are resolved by walking the PEB module list without
+ * the loader lock (the owner may hold it). */
+static const WCHAR *crit_diag_module( const void *addr, ULONG_PTR *rva )
+{
+    LIST_ENTRY *head = &NtCurrentTeb()->Peb->LdrData->InLoadOrderModuleList, *entry;
+
+    for (entry = head->Flink; entry && entry != head; entry = entry->Flink)
+    {
+        LDR_DATA_TABLE_ENTRY *mod = CONTAINING_RECORD( entry, LDR_DATA_TABLE_ENTRY, InLoadOrderLinks );
+        if ((const char *)addr >= (const char *)mod->DllBase
+                && (const char *)addr < (const char *)mod->DllBase + mod->SizeOfImage)
+        {
+            *rva = (const char *)addr - (const char *)mod->DllBase;
+            return mod->BaseDllName.Buffer;
+        }
+    }
+    *rva = (ULONG_PTR)addr;
+    return L"?";
+}
+
+static void crit_section_timeout_diag( RTL_CRITICAL_SECTION *crit )
+{
+    static LONG count;
+    void *frames[24];
+    ULONG_PTR rva;
+    unsigned int i, n;
+    CLIENT_ID id;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE thread;
+    CONTEXT ctx;
+
+    if (InterlockedIncrement( &count ) > 40) return;
+
+    id.UniqueProcess = 0;
+    id.UniqueThread = crit->OwningThread;
+    InitializeObjectAttributes( &attr, NULL, 0, 0, NULL );
+    if (!NtOpenThread( &thread, THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, &attr, &id ))
+    {
+        memset( &ctx, 0, sizeof(ctx) );
+        ctx.ContextFlags = CONTEXT_CONTROL;
+        if (!NtGetContextThread( thread, &ctx ))
+        {
+#ifdef __x86_64__
+            const WCHAR *mod = crit_diag_module( (void *)ctx.Rip, &rva );
+            ERR( "TEMP DIAG: owner %04lx rip %p = %s+%#Ix rsp %p\n", HandleToULong(crit->OwningThread),
+                 (void *)ctx.Rip, debugstr_w(mod), rva, (void *)ctx.Rsp );
+#endif
+        }
+        NtClose( thread );
+    }
+    n = RtlCaptureStackBackTrace( 1, ARRAY_SIZE(frames), frames, NULL );
+    for (i = 0; i < n; i++)
+    {
+        const WCHAR *mod = crit_diag_module( frames[i], &rva );
+        ERR( "TEMP DIAG: waiter %04lx frame %u %p = %s+%#Ix\n", GetCurrentThreadId(), i, frames[i], debugstr_w(mod), rva );
+    }
+}
+
