+/* PowerManager reports the machine's real power state, taken from
+ * GetSystemPowerStatus() -- on Linux that is ntdll's NtPowerInformation(
+ * SystemBatteryState ), which reads /sys/class/power_supply.  A desktop with no
+ * battery is the baseline and yields EnergySaverStatus_Disabled /
+ * BatteryStatus_NotPresent / PowerSupplyStatus_Adequate / 100% / no discharge
+ * time, which is what a Windows desktop reports too.
+ *
+ * The values are not cached: the properties are cheap, they are read rarely
+ * (Microsoft.UI.Composition.SystemBackdrops.MicaController reads
+ * EnergySaverStatus once per SetSystemBackdropConfiguration), and caching would
+ * have to be invalidated by the events that are not raised (see below). */
+static BOOL get_power_status( SYSTEM_POWER_STATUS *status )
+{
+    if (GetSystemPowerStatus( status )) return TRUE;
+    WARN( "GetSystemPowerStatus failed, error %lu.\n", GetLastError() );
+    return FALSE;
+}
+
+static BOOL has_battery( const SYSTEM_POWER_STATUS *status )
+{
+    if (status->BatteryFlag == BATTERY_FLAG_UNKNOWN) return FALSE;
+    return !(status->BatteryFlag & BATTERY_FLAG_NO_BATTERY);
+}
+
+struct power_manager_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IPowerManagerStatics IPowerManagerStatics_iface;
+    LONG ref;
+
+    /* Nothing under Wine changes the power state behind the caller's back in a
+     * way we can observe, so registrations are given a token and dropped; the
+     * events are never raised.  Callers that care re-read the property. */
+    LONG next_token;
+};
+
+static inline struct power_manager_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct power_manager_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct power_manager_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IPowerManagerStatics ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IPowerManagerStatics_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
