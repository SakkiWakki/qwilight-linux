+/* dcomp.dll has no import library in this tree, so DCompositionCreateDevice3 is
+ * resolved by hand.  Doing it lazily also keeps windows.ui.composition.dll
+ * loadable in a prefix whose dcomp.dll is missing or native. */
+static HRESULT (WINAPI *pDCompositionCreateDevice3)( IUnknown *rendering_device, REFIID iid, void **device );
+
+static BOOL WINAPI load_dcomp( INIT_ONCE *once, void *param, void **context )
+{
+    HMODULE module;
+
+    if (!(module = LoadLibraryW( L"dcomp.dll" )))
+    {
+        WARN( "failed to load dcomp.dll, error %lu.\n", GetLastError() );
+        return TRUE;
+    }
+    pDCompositionCreateDevice3 = (void *)GetProcAddress( module, "DCompositionCreateDevice3" );
+    if (!pDCompositionCreateDevice3) WARN( "dcomp.dll has no DCompositionCreateDevice3.\n" );
+    return TRUE;
+}
+
+static HRESULT interop_compositor_create( IUnknown *rendering_device, IInteropCompositorPartnerCallback *callback,
+                                          IUnknown *message_session, REFIID iid, void **out )
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    struct interop_compositor *impl;
+    HRESULT hr;
+
+    *out = NULL;
+
+    InitOnceExecuteOnce( &once, load_dcomp, NULL, NULL );
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->ICompositor_iface.lpVtbl = &compositor_vtbl;
+    impl->IClosable_iface.lpVtbl = &compositor_closable_vtbl;
+    impl->ICompositor3_iface.lpVtbl = &compositor3_vtbl;
+    impl->ICompositorWithBlurredWallpaperBackdropBrush_iface.lpVtbl = &compositor_wallpaper_vtbl;
+    impl->IInteropCompositorPartner_iface.lpVtbl = &compositor_partner_vtbl;
+    impl->ICompositorPartner_iface.lpVtbl = &compositor_dcomp_partner_vtbl;
+    impl->ref = 1;
+
+    /* XAML passes a NULL rendering device here and hands its real D3D device to
+     * IDCompositionDevice2::CreateSurfaceFactory later; dcomp ignores the
+     * argument anyway. */
+    if (!pDCompositionCreateDevice3)
+        WARN( "no DirectComposition device: the compositor will refuse every IDCompositionDevice IID.\n" );
+    else if (FAILED(hr = pDCompositionCreateDevice3( rendering_device, &IID_IDCompositionDesktopDevice,
+                                                     (void **)&impl->device )))
+    {
+        WARN( "DCompositionCreateDevice3 failed, hr %#lx.\n", hr );
+        impl->device = NULL;
+    }
+
+    if ((impl->rendering_device = rendering_device)) IUnknown_AddRef( impl->rendering_device );
+    if ((impl->callback = callback)) IInteropCompositorPartnerCallback_AddRef( impl->callback );
+    if ((impl->message_session = message_session)) IUnknown_AddRef( impl->message_session );
+
+    TRACE( "created interop compositor %p, inner dcomp device %p.\n", impl, impl->device );
+
+    hr = ICompositor_QueryInterface( &impl->ICompositor_iface, iid, out );
+    ICompositor_Release( &impl->ICompositor_iface );
+    return hr;
+}
