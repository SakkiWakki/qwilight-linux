+    TRACE( "%p, %f, %p, %u, (%f, %f), (%f, %f), %p.\n", iface, duration, final_value, dimension, x1, y1, x2, y2, transition );
+    if (!final_value) return E_INVALIDARG;
+    if (FAILED(hr = library_make( T_BEZIER, dimension, duration, TRUE, final_value, transition, &t ))) return hr;
