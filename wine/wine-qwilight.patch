+/*
+ * Composition input sinks.
+ *
+ * Undocumented.  Microsoft.UI.Input.dll (WinUI 3) creates one per input site
+ * window (SystemInputSinkHelpers::CreateInputSinkForHwnd) and attaches it to a
+ * composition visual (SystemInputSinkHelpers::AttachInputSinkToVisual ->
+ * IVisualInternal on the system visual): on Windows the compositor then
+ * hit-tests pointer input against that visual and win32k delivers the input
+ * to the sink window, which is a 0x0 child of the window hosting the visual
+ * and never has a size of its own (WinUI only records UIA_HWNDWidth/Height
+ * properties on it).
+ *
+ * We have no composition hit testing, so the closest equivalent is to route
+ * the hardware mouse input a host window would receive to the sink window
+ * that is its child (get_composition_input_sink_window(), used by
+ * process_mouse_message()).  The sink covers the whole island, which is the
+ * whole host window in every WinUI 3 desktop layout.
+ */
+struct composition_input_sink
+{
+    HANDLE handle;
+    HWND hwnd;
+};
+
+static struct composition_input_sink composition_input_sinks[32];
+static pthread_mutex_t composition_input_sink_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* The 0xe8-byte parameter block: a size, then four 0x38-byte records of the
+ * form { UINT kind; UINT pad; UINT64 value; ... } where kind 2 means value is
+ * an HWND. */
+static HWND composition_input_sink_hwnd_from_params( const void *params )
+{
+    const UINT64 *block = params;
+    UINT64 size = block[0];
+    unsigned int i;
+
+    for (i = 0; 8 + i * 0x38 + 0x10 <= size && i < 4; i++)
+    {
+        const UINT *record = (const UINT *)((const char *)params + 8 + i * 0x38);
+        if (record[0] == 2 && record[2]) return UlongToHandle( record[2] );
+    }
+    return 0;
+}
+
+/* the composition input sink window hosted by hwnd, if any */
+static HWND get_composition_input_sink_child_by_class( HWND hwnd );
+
+HWND get_composition_input_sink_window( HWND hwnd )
+{
+    HWND ret = 0;
+    unsigned int i;
+
+    pthread_mutex_lock( &composition_input_sink_lock );
+    for (i = 0; i < ARRAY_SIZE(composition_input_sinks); i++)
+    {
+        HWND sink = composition_input_sinks[i].hwnd;
+        if (!sink || sink == hwnd) continue;
+        if (get_window_relative( sink, GW_OWNER ) || NtUserGetAncestor( sink, GA_PARENT ) != hwnd) continue;
+        ret = sink;
+        break;
+    }
+    pthread_mutex_unlock( &composition_input_sink_lock );
+    if (ret) return ret;
+    return get_composition_input_sink_child_by_class( hwnd );
+}
+
+/* The composition input sink window that receives the pointer input hitting
+ * the visuals of hwnd's island: Microsoft.InputStateManager's message-only
+ * window (the one sink it creates with NtCreateCompositionInputSink()), which
+ * maps the pointer to the island's input site from POINTER_INFO.hwndTarget and
+ * delivers the pointer frames over CoreMessaging.  NULL when there is none
+ * or it is hwnd's own child (then the child gets the messages directly). */
+HWND get_composition_input_sink_target( HWND hwnd )
+{
+    HWND ret = 0;
+    unsigned int i;
+
+    pthread_mutex_lock( &composition_input_sink_lock );
+    for (i = 0; i < ARRAY_SIZE(composition_input_sinks); i++)
+    {
+        HWND sink = composition_input_sinks[i].hwnd;
+        if (!sink || sink == hwnd || NtUserGetAncestor( sink, GA_PARENT ) == hwnd) continue;
+        ret = sink;
+        break;
+    }
+    pthread_mutex_unlock( &composition_input_sink_lock );
+    return ret;
+}
+
+static HWND get_composition_input_sink_child_by_class( HWND hwnd )
+{
+    static const WCHAR input_site_class[] = {'I','n','p','u','t','S','i','t','e','W','i','n','d','o','w','C','l','a','s','s',0};
+    HWND ret = 0, *list;
+    unsigned int i;
+
+    /* EXPERIMENT: WinUI 3 with the lifted (in-process) compositor never attaches
+     * its island input site to a system visual, so no sink is registered for
+     * it; look the input site window up by class instead. */
+    if ((list = list_window_children( hwnd )))
+    {
+        WCHAR buffer[64];
+        UNICODE_STRING name = { .Buffer = buffer, .MaximumLength = sizeof(buffer) };
+
+        for (i = 0; list[i]; i++)
+        {
+            name.Length = 0;
+            if (NtUserGetClassName( list[i], FALSE, &name ) && !wcscmp( buffer, input_site_class ))
+            {
+                ret = list[i];
+                break;
+            }
+        }
+        free( list );
+    }
+    return ret;
+}
+
+/**********************************************************************
+ *       NtCreateCompositionInputSink    (win32u.@)
+ */
+NTSTATUS WINAPI NtCreateCompositionInputSink( void *params, HANDLE *sink )
+{
+    static LONG next_sink;
+    unsigned int i;
+    HWND hwnd;
+
+    if (!params || !sink) return STATUS_INVALID_PARAMETER;
+
+    hwnd = composition_input_sink_hwnd_from_params( params );
+    FIXME( "params %p (size %u), sink %p, hwnd %p semi-stub\n", params, *(UINT *)params, sink, hwnd );
+    if (TRACE_ON(win))
+    {
+        const unsigned char *bytes = params;
+        for (i = 0; i < min( *(UINT *)params, 0xe8 ); i += 16)
+            TRACE( "  %03x: %02x %02x %02x %02x %02x %02x %02x %02x  %02x %02x %02x %02x %02x %02x %02x %02x\n", i,
+                   bytes[i], bytes[i + 1], bytes[i + 2], bytes[i + 3], bytes[i + 4], bytes[i + 5], bytes[i + 6], bytes[i + 7],
+                   bytes[i + 8], bytes[i + 9], bytes[i + 10], bytes[i + 11], bytes[i + 12], bytes[i + 13], bytes[i + 14], bytes[i + 15] );
+    }
+
+    *sink = ULongToHandle( 0xc1000000 | (InterlockedIncrement( &next_sink ) & 0xffff) );
+
+    pthread_mutex_lock( &composition_input_sink_lock );
+    for (i = 0; i < ARRAY_SIZE(composition_input_sinks); i++)
+    {
+        if (composition_input_sinks[i].handle) continue;
+        composition_input_sinks[i].handle = *sink;
+        composition_input_sinks[i].hwnd = hwnd;
+        break;
+    }
+    pthread_mutex_unlock( &composition_input_sink_lock );
+    if (i == ARRAY_SIZE(composition_input_sinks)) FIXME( "too many composition input sinks\n" );
+    return STATUS_SUCCESS;
+}
+
+/**********************************************************************
+ *       NtCloseCompositionInputSink    (win32u.@)
+ */
+NTSTATUS WINAPI NtCloseCompositionInputSink( HANDLE sink )
+{
+    unsigned int i;
+
+    TRACE( "sink %p\n", sink );
+
+    pthread_mutex_lock( &composition_input_sink_lock );
+    for (i = 0; i < ARRAY_SIZE(composition_input_sinks); i++)
+    {
+        if (composition_input_sinks[i].handle != sink) continue;
+        composition_input_sinks[i].handle = 0;
+        composition_input_sinks[i].hwnd = 0;
+    }
+    pthread_mutex_unlock( &composition_input_sink_lock );
+    return STATUS_SUCCESS;
+}
+
+/*
+ * Delegated input.
+ *
+ * DelegateInput() (user32 ordinal 2503) names a thread and a callback that get
+ * the first look at the hardware input of this process' composition input sink
+ * windows: Microsoft.InputStateManager.dll's DelegatedMasterInputThread reads
+ * each message's pointer through GetPointerInfo(), hit-tests it against the
+ * input sites it has registered, hands the resulting pointer frame to the
+ * owning island over CoreMessaging, and answers with an HDIOPTION telling what
+ * to do with the message itself.  process_mouse_message() forwards the pointer
+ * message to that thread (forward_delegated_input()), where peek_message()
+ * meets it as WM_WINE_DELEGATED_INPUT and process_delegated_input() runs the
+ * callback through user32.
+ */
+static struct
+{
+    DWORD thread_id;
+    UINT64 callback;
+    UINT64 context;
+    HWND hwnd;
+    DWORD flags;
+} delegated_input;
+static pthread_mutex_t delegated_input_lock = PTHREAD_MUTEX_INITIALIZER;
+
+struct delegated_message
+{
+    struct delegated_input_params params;
+};
+
+BOOL delegate_input( HWND hwnd, const struct delegate_input_params *params )
+{
+    TRACE( "hwnd %p, thread_id %04x, callback %s, context %s, flags %#x\n", hwnd, (UINT)params->thread_id,
+           wine_dbgstr_longlong(params->callback), wine_dbgstr_longlong(params->context), (UINT)params->flags );
+
+    pthread_mutex_lock( &delegated_input_lock );
+    delegated_input.thread_id = params->thread_id;
+    delegated_input.callback = params->callback;
+    delegated_input.context = params->context;
+    delegated_input.hwnd = hwnd;
+    delegated_input.flags = params->flags;
+    pthread_mutex_unlock( &delegated_input_lock );
+    return TRUE;
+}
+
+void undelegate_input(void)
+{
+    pthread_mutex_lock( &delegated_input_lock );
+    memset( &delegated_input, 0, sizeof(delegated_input) );
+    pthread_mutex_unlock( &delegated_input_lock );
+}
+
+/* Hand a pointer message for a composition input sink window to the delegate
+ * thread.  Returns FALSE when there is none (or it is this thread), and the
+ * caller delivers the message itself. */
+BOOL forward_delegated_input( const MSG *msg )
+{
+    struct delegated_message *delegated;
+    DWORD thread_id;
+
+    pthread_mutex_lock( &delegated_input_lock );
+    thread_id = delegated_input.thread_id;
+    if (!thread_id || thread_id == GetCurrentThreadId() || !delegated_input.callback)
+    {
+        pthread_mutex_unlock( &delegated_input_lock );
+        return FALSE;
+    }
+    if (!(delegated = calloc( 1, sizeof(*delegated) )))
+    {
+        pthread_mutex_unlock( &delegated_input_lock );
+        return FALSE;
+    }
+    delegated->params.callback = delegated_input.callback;
+    delegated->params.context = delegated_input.context;
+    delegated->params.msg = *msg;
+    pthread_mutex_unlock( &delegated_input_lock );
+
+    TRACE( "forwarding msg %#x for %p (pointer %#x) to thread %04x\n", msg->message, msg->hwnd,
+           (UINT)msg->wParam, (UINT)thread_id );
+
+    if (!NtUserPostThreadMessage( thread_id, WM_WINE_DELEGATED_INPUT, 0, (LPARAM)delegated ))
+    {
+        free( delegated );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* deliver a delegated message to its window once the delegate has decided about it */
+static void deliver_delegated_input( const MSG *msg, UINT option )
+{
+    TRACE( "msg %#x for %p, option %u\n", msg->message, msg->hwnd, option );
+
+    /* FIXME: the HDIOPTION values are unknown; Microsoft.InputStateManager
+     * initialises a queued message's option to 1 and uses 3 for a decision
+     * still pending.  Deliver everything for now. */
+    NtUserPostMessage( msg->hwnd, msg->message, msg->wParam, msg->lParam );
+}
+
+/* WM_WINE_DELEGATED_INPUT on the delegate thread */
+LRESULT process_delegated_input( LPARAM lparam )
+{
+    struct delegated_message *delegated = (struct delegated_message *)lparam;
+    void *ret_ptr;
+    ULONG ret_len;
+    LRESULT option = 0;
+
+    TRACE( "msg %#x for %p on thread %04x\n", delegated->params.msg.message, delegated->params.msg.hwnd,
+           (UINT)GetCurrentThreadId() );
+
+    if (!KeUserModeCallback( NtUserCallDelegatedInput, &delegated->params, sizeof(delegated->params),
+                             &ret_ptr, &ret_len ) && ret_len >= sizeof(option))
+        option = *(LRESULT *)ret_ptr;
+
+    TRACE( "callback returned option %#lx\n", (long)option );
+
+    deliver_delegated_input( &delegated->params.msg, option );
+    free( delegated );
+    return 0;
+}
+
+BOOL handle_delegated_input( HWND hwnd, const struct handle_delegated_input_params *params )
+{
+    FIXME( "hwnd %p, msg %p (message %#x), option %#x: releasing a deferred decision is not implemented\n",
+           hwnd, params->msg, params->msg ? params->msg->message : 0, params->option );
+    return TRUE;
+}
