+/* Reconstruct a D3D11 texture description from an existing wined3d texture, e.g. one
+ * opened from a shared handle. GDI compatibility cannot be recovered from the wined3d
+ * side; the importer does not get D3D11_RESOURCE_MISC_GDI_COMPATIBLE. */
+void d3d11_texture2d_desc_from_wined3d(D3D11_TEXTURE2D_DESC *desc, struct wined3d_texture *wined3d_texture)
+{
+    struct wined3d_resource *resource = wined3d_texture_get_resource(wined3d_texture);
+    struct wined3d_resource_desc wined3d_desc;
+    unsigned int level_count, sub_resource_count;
+
+    wined3d_resource_get_desc(resource, &wined3d_desc);
+    level_count = wined3d_texture_get_level_count(wined3d_texture);
+    sub_resource_count = wined3d_resource_get_sub_resource_count(resource);
+
+    desc->Width = wined3d_desc.width;
+    desc->Height = wined3d_desc.height;
+    desc->MipLevels = level_count;
+    desc->ArraySize = level_count ? sub_resource_count / level_count : 1;
+    desc->Format = dxgi_format_from_wined3dformat(wined3d_desc.format);
+    desc->SampleDesc.Count = wined3d_desc.multisample_type ? wined3d_desc.multisample_type : 1;
+    desc->SampleDesc.Quality = wined3d_desc.multisample_quality;
+    if (!(wined3d_desc.access & WINED3D_RESOURCE_ACCESS_GPU))
+        desc->Usage = D3D11_USAGE_STAGING;
+    else if (wined3d_desc.usage & WINED3DUSAGE_DYNAMIC)
+        desc->Usage = D3D11_USAGE_DYNAMIC;
+    else
+        desc->Usage = D3D11_USAGE_DEFAULT;
+    desc->BindFlags = d3d11_bind_flags_from_wined3d(wined3d_desc.bind_flags);
+    desc->CPUAccessFlags = 0;
+    if (wined3d_desc.access & WINED3D_RESOURCE_ACCESS_MAP_R)
+        desc->CPUAccessFlags |= D3D11_CPU_ACCESS_READ;
+    if (wined3d_desc.access & WINED3D_RESOURCE_ACCESS_MAP_W)
+        desc->CPUAccessFlags |= D3D11_CPU_ACCESS_WRITE;
+    desc->MiscFlags = 0;
+    /* SHARED and SHARED_KEYEDMUTEX are mutually exclusive in D3D11. */
+    if (wined3d_desc.usage & WINED3DUSAGE_SHARED_KEYED_MUTEX)
+        desc->MiscFlags |= D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX;
+    else if (wined3d_desc.usage & WINED3DUSAGE_SHARED)
+        desc->MiscFlags |= D3D11_RESOURCE_MISC_SHARED;
+    if (wined3d_desc.usage & WINED3DUSAGE_SHARED_NT_HANDLE)
+        desc->MiscFlags |= D3D11_RESOURCE_MISC_SHARED_NTHANDLE;
+    if (wined3d_desc.usage & WINED3DUSAGE_GENERATE_MIPMAPS)
+        desc->MiscFlags |= D3D11_RESOURCE_MISC_GENERATE_MIPS;
+    if (wined3d_desc.usage & WINED3DUSAGE_LEGACY_CUBEMAP)
+        desc->MiscFlags |= D3D11_RESOURCE_MISC_TEXTURECUBE;
+}
