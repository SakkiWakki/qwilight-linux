+static void send_mouse_input( DWORD flags, DWORD data, int x, int y )
+{
+    INPUT input = {.type = INPUT_MOUSE};
+    RECT rect = get_virtual_screen_rect();
+
+    input.mi.dwFlags = flags;
+    input.mi.mouseData = data;
+    if (flags & MOUSEEVENTF_ABSOLUTE)
+    {
+        input.mi.dx = MulDiv( x - rect.left, 65535, rect.right - rect.left - 1 );
+        input.mi.dy = MulDiv( y - rect.top, 65535, rect.bottom - rect.top - 1 );
+    }
+    SendInput( 1, &input, sizeof(input) );
+    empty_message_queue();
+}
