@@ -41,24 +96,68 @@ HRESULT WINAPI GetFontFallbackLanguageList(const WCHAR *lang, size_t buffer_leng
 
     if (!lang)
     {
-        if (!GetUserDefaultLocaleName(locale, LOCALE_NAME_MAX_LENGTH))
+        if (!GetUserDefaultLocaleName(locale, ARRAY_SIZE(locale)))
             return E_FAIL;
-
-        lang = locale;
     }
+    else if (!GetLocaleInfoEx(lang, LOCALE_SNAME, locale, ARRAY_SIZE(locale)))
+    {
+        return E_INVALIDARG;
+    }
+
+    list[0] = 0;
+    append_fallback_language_and_neutral(list, ARRAY_SIZE(list), locale);
+
+    if (GetUserDefaultLocaleName(locale, ARRAY_SIZE(locale)))
+        append_fallback_language_and_neutral(list, ARRAY_SIZE(list), locale);
+
+    for (i = 0; i < ARRAY_SIZE(fallback_tail); i++)
+        append_fallback_language(list, ARRAY_SIZE(list), fallback_tail[i]);
 
-    /* Return the original language as the fallback language list */
-    lang_length = wcslen(lang) + 1;
-    *required_buffer_length = lang_length;
-    if (buffer_length < lang_length)
+    TRACE("returning %s.\n", wine_dbgstr_w(list));
+
+    list_length = wcslen(list) + 1;
+    *required_buffer_length = list_length;
+    if (buffer_length < list_length)
         return E_NOT_SUFFICIENT_BUFFER;
 
-    memcpy(buffer, lang, lang_length * sizeof(WCHAR));
+    memcpy(buffer, list, list_length * sizeof(WCHAR));
