+    SYSTEM_POWER_STATUS status;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+
+    *value = 100;
+    if (get_power_status( &status ) && has_battery( &status )
+            && status.BatteryLifePercent != BATTERY_PERCENTAGE_UNKNOWN)
+        *value = status.BatteryLifePercent;
+
+    TRACE( "returning %d.\n", *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_add_RemainingChargePercentChanged( IPowerManagerStatics *iface,
+                                                                 __FIEventHandler_1_IInspectable *handler,
+                                                                 EventRegistrationToken *token )
+{
+    return statics_add_event( iface, "RemainingChargePercentChanged", handler, token );
+}
+
+static HRESULT WINAPI statics_remove_RemainingChargePercentChanged( IPowerManagerStatics *iface,
+                                                                    EventRegistrationToken token )
+{
+    return statics_remove_event( iface, "RemainingChargePercentChanged", token );
+}
+
+static HRESULT WINAPI statics_get_RemainingDischargeTime( IPowerManagerStatics *iface, TimeSpan *value )
+{
+    SYSTEM_POWER_STATUS status;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+
+    /* TimeSpan is in 100ns units; GetSystemPowerStatus reports seconds. */
+    value->Duration = 0;
+    if (get_power_status( &status ) && has_battery( &status )
+            && status.BatteryLifeTime != BATTERY_LIFE_UNKNOWN)
+        value->Duration = (INT64)status.BatteryLifeTime * 10000000;
+
+    TRACE( "returning %I64d.\n", value->Duration );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_add_RemainingDischargeTimeChanged( IPowerManagerStatics *iface,
+                                                                 __FIEventHandler_1_IInspectable *handler,
+                                                                 EventRegistrationToken *token )
+{
+    return statics_add_event( iface, "RemainingDischargeTimeChanged", handler, token );
+}
+
+static HRESULT WINAPI statics_remove_RemainingDischargeTimeChanged( IPowerManagerStatics *iface,
+                                                                    EventRegistrationToken token )
+{
+    return statics_remove_event( iface, "RemainingDischargeTimeChanged", token );
+}
+
+static const struct IPowerManagerStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    /* IInspectable */
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    /* IPowerManagerStatics */
+    statics_get_EnergySaverStatus,
+    statics_add_EnergySaverStatusChanged,
+    statics_remove_EnergySaverStatusChanged,
+    statics_get_BatteryStatus,
+    statics_add_BatteryStatusChanged,
+    statics_remove_BatteryStatusChanged,
+    statics_get_PowerSupplyStatus,
+    statics_add_PowerSupplyStatusChanged,
+    statics_remove_PowerSupplyStatusChanged,
+    statics_get_RemainingChargePercent,
+    statics_add_RemainingChargePercentChanged,
+    statics_remove_RemainingChargePercentChanged,
+    statics_get_RemainingDischargeTime,
+    statics_add_RemainingDischargeTimeChanged,
+    statics_remove_RemainingDischargeTimeChanged,
+};
+
+static struct power_manager_statics power_manager_statics =
+{
+    {&factory_vtbl},
+    {&statics_vtbl},
+    1,
+};
+
+static IActivationFactory *power_manager_factory = &power_manager_statics.IActivationFactory_iface;
+
+HRESULT WINAPI DllGetClassObject( REFCLSID clsid, REFIID riid, void **out )
+{
+    FIXME( "clsid %s, riid %s, out %p stub!\n", debugstr_guid( clsid ), debugstr_guid( riid ), out );
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+
+HRESULT WINAPI DllGetActivationFactory( HSTRING class_str, IActivationFactory **factory )
+{
+    const WCHAR *buffer = WindowsGetStringRawBuffer( class_str, NULL );
+
+    TRACE( "class %s, factory %p.\n", debugstr_hstring( class_str ), factory );
+
+    *factory = NULL;
+
+    if (!wcscmp( buffer, RuntimeClass_Windows_System_Power_PowerManager ))
+        IActivationFactory_QueryInterface( power_manager_factory, &IID_IActivationFactory, (void **)factory );
+
+    if (*factory) return S_OK;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
