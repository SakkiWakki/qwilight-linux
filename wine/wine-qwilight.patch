+/* Called from Commit() with dcomp_lock() held: snapshot the physical surface. */
+void dcomp_surface_commit(struct composition_surface *surface)
+{
+    struct composition_surface_factory *factory = impl_from_IDCompositionSurfaceFactory(surface->factory);
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *physical;
+    ID3D11Device *device;
+    HRESULT hr;
+
+    if (!surface->dirty || !surface->physical_surface)
+        return;
+    if (!IsEqualGUID(&factory->rendering_device_iid, &IID_IDXGIDevice))
+        return;
+    if (FAILED(IUnknown_QueryInterface(surface->physical_surface, &IID_ID3D11Texture2D, (void **)&physical)))
+        return;
+    ID3D11Texture2D_GetDevice(physical, &device);
+
+    if (!surface->committed_surface)
+    {
+        D3D11_TEXTURE2D_DESC desc;
+
+        ID3D11Texture2D_GetDesc(physical, &desc);
+        desc.MiscFlags &= ~(D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_NTHANDLE
+                | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX);
+        if (FAILED(hr = ID3D11Device_CreateTexture2D(device, &desc, NULL, &surface->committed_surface)))
+        {
+            ERR("Failed to create the committed copy, hr %#lx.\n", hr);
+            ID3D11Device_Release(device);
+            ID3D11Texture2D_Release(physical);
+            return;
+        }
+    }
+
+    ID3D11Device_GetImmediateContext(device, &context);
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)surface->committed_surface, (ID3D11Resource *)physical);
+    ID3D11DeviceContext_Release(context);
+    ID3D11Device_Release(device);
+    ID3D11Texture2D_Release(physical);
+    surface->dirty = FALSE;
+}
