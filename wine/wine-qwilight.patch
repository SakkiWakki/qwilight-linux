+    EnterCriticalSection( &This->manager->cs );
+    if (This->in_list) storyboard_jump_to_end( This, UI_ANIMATION_STORYBOARD_FINISHED );
+    LeaveCriticalSection( &This->manager->cs );
+    return S_OK;
+}
