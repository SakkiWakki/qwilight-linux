+/*
+ * There is no effect pipeline behind any of this: the compositor cannot run a
+ * D2D effect graph.  What these objects do is keep the graph description and
+ * the brushes bound to its source parameters, and reduce the whole thing to
+ * the one colour it would paint (composition_brush_resolve_color()), which is
+ * what the sprite visual records.
+ *
+ * The one caller so far is the Windows App SDK 2.4 Mica controller,
+ * wuceffectsi!SystemBackdropInternal::CreateCrossFadeEffectBrush (rva 0x3788c,
+ * reached from BaseController::InitializeNewCompositor -> Crossfade ->
+ * GetAnimationBrush), measured instruction by instruction in
+ * survey/impl-composition-effects.md:
+ *
+ *   effect = new EffectDescriptions::CrossFadeEffect      ; IGraphicsEffect + IGraphicsEffectD2D1Interop
+ *   effect->Name = L"Crossfade"
+ *   effect->Source1 = CompositionEffectSourceParameter(L"source1")   ; ICompositionEffectSourceParameterFactory slot 6 Create
+ *                     ->QueryInterface(IGraphicsEffectSource)
+ *   effect->Source2 = CompositionEffectSourceParameter(L"source2")
+ *   effect->Weight = 0.0f
+ *   factory = compositor->CreateEffectFactoryWithProperties(effect, { L"Crossfade.Weight" })  ; ICompositor slot 12
+ *   brush = factory->CreateBrush()                                   ; ICompositionEffectFactory slot 6
+ *   brush->QueryInterface(ICompositionObject2)->put_Comment(L"Crossfade")   ; slot 7
+ *   brush->SetSourceParameter(L"source1", brushA)                    ; ICompositionEffectBrush slot 7
+ *   brush->SetSourceParameter(L"source2", brushB)
+ *   (GetAnimationBrush sets both parameters again, then QIs ICompositionBrush)
+ *
+ * Every failure on that path is a C++/WinRT throw.  It is caught by
+ * InitializeNewCompositor (+0x31c), so the effect was a silently dropped Mica
+ * backdrop rather than a crash.
+ */
