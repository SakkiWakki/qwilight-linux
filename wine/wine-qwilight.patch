+/* Copy the IRandomAccessStream into a memory IStream. Media Foundation reads the source lazily,
+ * on its own threads, long after MediaSource.OpenAsync() returned; the app (Qwilight) disposes
+ * the .NET stream behind the IRandomAccessStream once its loader is done, so every later read
+ * fails with RO_E_CLOSED. Windows opens the source inside OpenAsync(); we cannot, so keep a copy. */
+static HRESULT media_source_snapshot( struct media_source *impl )
+{
+    IStream *src = NULL, *dst = NULL;
+    LARGE_INTEGER zero = {{0}};
+    STATSTG stat;
+    ULONG read, written, total = 0;
+    HRESULT hr;
+    char *buffer;
+
+    if (impl->snapshot || !impl->stream) return S_OK;
+    if (FAILED(hr = CreateStreamOverRandomAccessStream( impl->stream, &IID_IStream, (void **)&src )))
+    {
+        WARN( "No IStream over stream %p, hr %#lx.\n", impl->stream, hr );
+        return hr;
+    }
+    if (SUCCEEDED(IStream_Stat( src, &stat, STATFLAG_NONAME )) && stat.cbSize.QuadPart > 512 * 1024 * 1024)
+        FIXME( "Copying a %s-byte stream into memory.\n", wine_dbgstr_longlong( stat.cbSize.QuadPart ) );
+    if (FAILED(hr = CreateStreamOnHGlobal( NULL, TRUE, &dst ))) goto done;
+    if (!(buffer = malloc( 1 << 20 ))) { hr = E_OUTOFMEMORY; goto done; }
+    IStream_Seek( src, zero, STREAM_SEEK_SET, NULL );
+    for (;;)
+    {
+        read = 0;
+        hr = IStream_Read( src, buffer, 1 << 20, &read );
+        if (FAILED(hr) || !read) break;
+        if (FAILED(hr = IStream_Write( dst, buffer, read, &written ))) break;
+        total += read;
+    }
+    free( buffer );
+    if (SUCCEEDED(hr))
+    {
+        IStream_Seek( dst, zero, STREAM_SEEK_SET, NULL );
+        IStream_AddRef( impl->snapshot = dst );
+        TRACE( "source %p: %lu bytes copied from stream %p.\n", impl, total, impl->stream );
+    }
+    else WARN( "source %p: copy failed after %lu bytes, hr %#lx.\n", impl, total, hr );
+done:
+    if (dst) IStream_Release( dst );
+    if (src) IStream_Release( src );
+    return hr;
+}
+
+/* What Windows does inside OpenAsync(): resolve the media source once, to learn its duration. The
+ * player opens its own instance later. */
+static void media_source_open( struct media_source *impl )
+{
+    IMFSourceResolver *resolver = NULL;
+    IMFMediaSource *source = NULL;
+    IMFPresentationDescriptor *pd = NULL;
+    IMFByteStream *bytestream = NULL;
+    IUnknown *object = NULL;
+    MF_OBJECT_TYPE type;
+    HRESULT hr;
+
+    if (impl->opened) return;
+    impl->opened = TRUE;
+    if (FAILED(hr = MFStartup( MF_VERSION, MFSTARTUP_FULL ))) return;
+    if (FAILED(hr = MFCreateSourceResolver( &resolver ))) goto done;
+    if (impl->snapshot)
+    {
+        IStream *clone;
+        IMFAttributes *attributes;
+        const WCHAR *type_str = WindowsGetStringRawBuffer( impl->content_type, NULL ), *slash;
+        WCHAR url[64];
+
+        if (FAILED(hr = IStream_Clone( impl->snapshot, &clone ))) goto done;
+        hr = MFCreateMFByteStreamOnStream( clone, &bytestream );
+        IStream_Release( clone );
+        if (FAILED(hr)) goto done;
+        if (type_str && *type_str && SUCCEEDED(IMFByteStream_QueryInterface( bytestream, &IID_IMFAttributes, (void **)&attributes )))
+        {
+            IMFAttributes_SetString( attributes, &MF_BYTESTREAM_CONTENT_TYPE, type_str );
+            IMFAttributes_Release( attributes );
+        }
+        slash = type_str ? wcschr( type_str, '/' ) : NULL;
+        swprintf( url, ARRAY_SIZE(url), L"winrt-stream.%s", slash && slash[1] ? slash + 1 : L"bin" );
+        hr = IMFSourceResolver_CreateObjectFromByteStream( resolver, bytestream, url,
+                MF_RESOLUTION_MEDIASOURCE | MF_RESOLUTION_CONTENT_DOES_NOT_HAVE_TO_MATCH_EXTENSION_OR_MIME_TYPE, NULL, &type, &object );
+    }
+    else if (WindowsGetStringLen( impl->uri ))
+        hr = IMFSourceResolver_CreateObjectFromURL( resolver, WindowsGetStringRawBuffer( impl->uri, NULL ),
+                MF_RESOLUTION_MEDIASOURCE | MF_RESOLUTION_CONTENT_DOES_NOT_HAVE_TO_MATCH_EXTENSION_OR_MIME_TYPE, NULL, &type, &object );
+    else hr = E_FAIL;
+    if (FAILED(hr)) { WARN( "source %p: resolving failed, hr %#lx.\n", impl, hr ); goto done; }
+    if (FAILED(hr = IUnknown_QueryInterface( object, &IID_IMFMediaSource, (void **)&source ))) goto done;
+    if (SUCCEEDED(IMFMediaSource_CreatePresentationDescriptor( source, &pd )))
+    {
+        IMFPresentationDescriptor_GetUINT64( pd, &MF_PD_DURATION, &impl->duration );
+        IMFPresentationDescriptor_Release( pd );
+    }
+    IMFMediaSource_Shutdown( source );
+    TRACE( "source %p: duration %s (100 ns).\n", impl, wine_dbgstr_longlong( impl->duration ) );
+done:
+    if (source) IMFMediaSource_Release( source );
+    if (object) IUnknown_Release( object );
+    if (bytestream) IMFByteStream_Release( bytestream );
+    if (resolver) IMFSourceResolver_Release( resolver );
+    MFShutdown();
+}
