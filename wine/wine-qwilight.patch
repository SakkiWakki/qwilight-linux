+/* Guard rectangles clamp all rendering into the texture (draws and clears) to
+ * the rectangle. dcompi sets one around every BeginDraw() on a surface it
+ * sub-allocated from a shared atlas texture and hands the whole texture to
+ * the caller; XAML's alpha-mask rasteriser then Clear()s the D2D target it
+ * wraps around it, which must not reach the other atlas entries. */
+/* TEMP DIAG: WINE_GUARD_DUMP=<dir> writes the guarded texture as a BMP at SetGuardRect (before the
+ * draws) and RemoveGuardRect (after); WINE_GUARD_DUMP_TRIGGER gates on a file, _COUNT limits. */
+static void guard_debug_dump(struct d3d_device *device, ID3D11Texture2D *texture, const RECT *rect, const char *tag)
+{
+    static const char *dir; static BOOL checked;
+    static LONG count = -1; static LONG sequence;
+    DWORD seq;
+    if (!checked) { dir = getenv("WINE_GUARD_DUMP"); checked = TRUE; }
+    if (!dir) return;
+    {
+        const char *trigger = getenv("WINE_GUARD_DUMP_TRIGGER");
+        if (trigger && GetFileAttributesA(trigger) == INVALID_FILE_ATTRIBUTES) return;
+    }
+    if (count < 0) { const char *e = getenv("WINE_GUARD_DUMP_COUNT"); count = e ? atol(e) : 200; }
+    seq = InterlockedIncrement(&sequence);
+    if (seq > (DWORD)count) return;
+    guard_debug_dump_to(device, texture, rect, tag, dir);
+}
+
+static void guard_debug_dump_to(struct d3d_device *device, ID3D11Texture2D *texture, const RECT *rect, const char *tag, const char *dir)
+{
+    static LONG sequence;
+    BITMAPINFOHEADER bih = {sizeof(BITMAPINFOHEADER), 0, 0, 1, 32, BI_RGB};
+    BITMAPFILEHEADER file_header = {0x4d42};
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D *staging;
+    ID3D11DeviceContext *immediate;
+    D3D11_MAPPED_SUBRESOURCE map;
+    char path[MAX_PATH];
+    HANDLE file;
+    DWORD written, seq;
+    unsigned int x, y;
+    RECT r = {0, 0, 0, 0};
+
+    ID3D11Texture2D_GetDesc(texture, &desc);
+    if (desc.Width < 512) return;
+    if (desc.Format != DXGI_FORMAT_A8_UNORM && desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM) return;
+    if (getenv("WINE_GUARD_DUMP_A8ONLY") && desc.Format != DXGI_FORMAT_A8_UNORM) return;
+    seq = InterlockedIncrement(&sequence);
+    if (rect) r = *rect;
+
+    desc.MipLevels = 1; desc.ArraySize = 1; desc.SampleDesc.Count = 1; desc.SampleDesc.Quality = 0;
+    desc.Usage = D3D11_USAGE_STAGING; desc.BindFlags = 0; desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ; desc.MiscFlags = 0;
+    if (FAILED(ID3D11Device5_CreateTexture2D(&device->ID3D11Device5_iface, &desc, NULL, &staging))) return;
