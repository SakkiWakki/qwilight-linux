+/*
+ * Windows.Web.Http.HttpStringContent / HttpBufferContent
+ *
+ * One object serves both classes: they differ only in the payload they carry
+ * and in the runtime class name they report.
+ */
+enum content_kind
+{
+    CONTENT_STRING,
+    CONTENT_BUFFER,
+    CONTENT_BYTES,
+};
+
+struct http_content
+{
+    IHttpContent IHttpContent_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    enum content_kind kind;
+    HSTRING text;
+    IBuffer *buffer;
+    UINT32 offset;
+    UINT32 count;
+    void *data;             /* CONTENT_BYTES: a response body */
+    UINT32 size;
+    IHttpContentHeaderCollection *headers;
+    boolean closed;
+};
+
+
+
+static inline struct http_content *impl_from_IHttpContent( IHttpContent *iface )
+{
+    return CONTAINING_RECORD( iface, struct http_content, IHttpContent_iface );
+}
+
+/* The body as bytes; the caller frees. Strings are UTF-8 encoded. */
+HRESULT http_content_get_bytes( IHttpContent *iface, void **data, UINT32 *size )
+{
+    struct http_content *impl = impl_from_IHttpContent( iface );
+    *data = NULL; *size = 0;
+    switch (impl->kind)
+    {
+    case CONTENT_STRING:
+    {
+        UINT32 len = 0; const WCHAR *text = WindowsGetStringRawBuffer( impl->text, &len );
+        int n = WideCharToMultiByte( CP_UTF8, 0, text, len, NULL, 0, NULL, NULL );
+        if (!(*data = malloc( n ? n : 1 ))) return E_OUTOFMEMORY;
+        WideCharToMultiByte( CP_UTF8, 0, text, len, *data, n, NULL, NULL );
+        *size = n;
+        return S_OK;
+    }
+    case CONTENT_BUFFER:
+    {
+        IBufferByteAccess *access; byte *bytes; UINT32 len = 0; HRESULT hr;
+        if (!impl->buffer) return S_OK;
+        IBuffer_get_Length( impl->buffer, &len );
+        if (FAILED(hr = IBuffer_QueryInterface( impl->buffer, &IID_IBufferByteAccess, (void **)&access ))) return hr;
+        hr = IBufferByteAccess_Buffer( access, &bytes );
+        if (SUCCEEDED(hr))
+        {
+            UINT32 off = min( impl->offset, len ), cnt = min( impl->count, len - off );
+            if (!(*data = malloc( cnt ? cnt : 1 ))) hr = E_OUTOFMEMORY;
+            else { memcpy( *data, bytes + off, cnt ); *size = cnt; }
+        }
+        IBufferByteAccess_Release( access );
+        return hr;
+    }
+    default:
+        if (!(*data = malloc( impl->size ? impl->size : 1 ))) return E_OUTOFMEMORY;
+        memcpy( *data, impl->data, impl->size );
+        *size = impl->size;
+        return S_OK;
+    }
+}
+
+static HRESULT content_read_string_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    void *data; UINT32 size; HSTRING str = NULL; HRESULT hr; int n; WCHAR *wide;
+    if (FAILED(hr = http_content_get_bytes( (IHttpContent *)invoker, &data, &size ))) return hr;
+    {
+        const char *p = data; UINT32 len = size;
+        if (len >= 3 && !memcmp( p, "\xef\xbb\xbf", 3 )) { p += 3; len -= 3; }   /* UTF-8 BOM */
+        n = MultiByteToWideChar( CP_UTF8, 0, p, len, NULL, 0 );
+        if ((wide = malloc( (n + 1) * sizeof(WCHAR) )))
+        {
+            MultiByteToWideChar( CP_UTF8, 0, p, len, wide, n );
+            hr = WindowsCreateString( wide, n, &str );
+            free( wide );
+        }
+        else hr = E_OUTOFMEMORY;
+    }
+    free( data );
+    result->vt = VT_UI8;
+    result->uhVal.QuadPart = (ULONG_PTR)str;
+    return hr;
+}
+
+static HRESULT content_read_buffer_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    void *data; UINT32 size; IBuffer *buffer = NULL; HRESULT hr;
+    if (FAILED(hr = http_content_get_bytes( (IHttpContent *)invoker, &data, &size ))) return hr;
+    hr = http_buffer_create( data, size, &buffer );
+    free( data );
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)buffer;
+    return hr;
+}
+
+static HRESULT content_length_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    void *data; UINT32 size; HRESULT hr;
+    if (FAILED(hr = http_content_get_bytes( (IHttpContent *)invoker, &data, &size ))) return hr;
+    free( data );
+    result->vt = VT_UI8;
+    result->uhVal.QuadPart = size;
+    return S_OK;
+}
+
+static void wait_async_info( IUnknown *op )
+{
+    IAsyncInfo *info; AsyncStatus status;
+    if (FAILED(IUnknown_QueryInterface( op, &IID_IAsyncInfo, (void **)&info ))) return;
+    while (SUCCEEDED(IAsyncInfo_get_Status( info, &status )) && status == Started) Sleep( 1 );
+    IAsyncInfo_Release( info );
+}
+
+static HRESULT content_write_stream_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    IOutputStream *stream = (IOutputStream *)param;
+    IAsyncOperationWithProgress_UINT32_UINT32 *write_op = NULL;
+    IAsyncOperation_boolean *flush_op = NULL;
+    void *data; UINT32 size, written = 0; IBuffer *buffer = NULL; HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;   /* the stream may complete on another thread */
+    if (!stream) return E_INVALIDARG;
+    if (FAILED(hr = http_content_get_bytes( (IHttpContent *)invoker, &data, &size ))) return hr;
+    hr = http_buffer_create( data, size, &buffer );
+    free( data );
+    if (FAILED(hr)) return hr;
+    if (SUCCEEDED(hr = IOutputStream_WriteAsync( stream, buffer, &write_op )))
+    {
+        wait_async_info( (IUnknown *)write_op );
+        hr = IAsyncOperationWithProgress_UINT32_UINT32_GetResults( write_op, &written );
+        IAsyncOperationWithProgress_UINT32_UINT32_Release( write_op );
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(IOutputStream_FlushAsync( stream, &flush_op )))
+    {
+        wait_async_info( (IUnknown *)flush_op );
+        IAsyncOperation_boolean_Release( flush_op );
+    }
+    IBuffer_Release( buffer );
+    result->vt = VT_UI8;
+    result->uhVal.QuadPart = written;
+    return hr;
+}
+
+static HRESULT WINAPI content_QueryInterface( IHttpContent *iface, REFIID iid, void **out )
+{
+    struct http_content *impl = impl_from_IHttpContent( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IHttpContent ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IHttpContent_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IClosable_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI content_AddRef( IHttpContent *iface )
+{
+    struct http_content *impl = impl_from_IHttpContent( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI content_Release( IHttpContent *iface )
+{
+    struct http_content *impl = impl_from_IHttpContent( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->text );
+        if (impl->buffer) IBuffer_Release( impl->buffer );
+        if (impl->headers) IHttpContentHeaderCollection_Release( impl->headers );
+        free( impl->data );
+        free( impl );
+    }
+    return ref;
+}
