+    ID3D11DeviceContext_CopyResource(immediate, (ID3D11Resource *)staging, (ID3D11Resource *)texture);
+    if (SUCCEEDED(ID3D11DeviceContext_Map(immediate, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map)))
+    {
+        snprintf(path, sizeof(path), "%s\\%04lu-%s-t%p-%ux%u-r%ld_%ld_%ld_%ld.bmp", dir, seq, tag, texture,
+                desc.Width, desc.Height, r.left, r.top, r.right, r.bottom);
+        bih.biWidth = desc.Width;
+        bih.biHeight = -(LONG)desc.Height;
+        file_header.bfOffBits = sizeof(file_header) + sizeof(bih);
+        file_header.bfSize = file_header.bfOffBits + desc.Width * desc.Height * 4;
+        if ((file = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL)) != INVALID_HANDLE_VALUE)
+        {
+            DWORD *row = malloc(desc.Width * 4);
+            WriteFile(file, &file_header, sizeof(file_header), &written, NULL);
+            WriteFile(file, &bih, sizeof(bih), &written, NULL);
+            for (y = 0; y < desc.Height; ++y)
+            {
+                if (desc.Format == DXGI_FORMAT_A8_UNORM)
+                {
+                    const BYTE *src = (const BYTE *)map.pData + y * map.RowPitch;
+                    for (x = 0; x < desc.Width; ++x) row[x] = 0xff000000 | (src[x] * 0x010101);
+                    WriteFile(file, row, desc.Width * 4, &written, NULL);
+                }
+                else
+                    WriteFile(file, (const char *)map.pData + y * map.RowPitch, desc.Width * 4, &written, NULL);
+            }
+            free(row);
+            CloseHandle(file);
+        }
+        ID3D11DeviceContext_Unmap(immediate, (ID3D11Resource *)staging, 0);
+    }
+    ID3D11DeviceContext_Release(immediate);
+    ID3D11Texture2D_Release(staging);
+}
+
+/* last SetGuardRect per texture, for the RemoveGuardRect dump name */
+static struct { ID3D11Texture2D *texture; RECT rect; } guard_last[32];
+
+/* TEMP DIAG: WINE_MASK_DIAG=1 — every guard rect ever set (= every atlas tile dcompi rasterised)
+ * per texture, so draws can be checked against real tiles. */
+#define MASK_DIAG_TEXTURES 64
+#define MASK_DIAG_RECTS 8192
+/* keyed by size: the guard rects are set on the exporting device's texture object while the draws
+ * sample the importing device's object of the same shared atlas */
+static struct { unsigned int width, height, count; RECT *rects; } mask_diag_tiles[MASK_DIAG_TEXTURES];
+static int mask_diag_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) enabled = !!getenv("WINE_MASK_DIAG");
+    return enabled;
+}
+static void mask_diag_add_tile(ID3D11Texture2D *texture, const RECT *rect)
+{
+    unsigned int i, j;
+    D3D11_TEXTURE2D_DESC desc;
+    if (!mask_diag_enabled()) return;
+    ID3D11Texture2D_GetDesc(texture, &desc);
+    if (desc.Width < 1024) return;
+    wined3d_mutex_lock();
+    for (i = 0; i < MASK_DIAG_TEXTURES; ++i)
+        if ((mask_diag_tiles[i].width == desc.Width && mask_diag_tiles[i].height == desc.Height) || !mask_diag_tiles[i].width) break;
+    if (i == MASK_DIAG_TEXTURES) { wined3d_mutex_unlock(); return; }
+    if (!mask_diag_tiles[i].width)
+    {
+        mask_diag_tiles[i].width = desc.Width; mask_diag_tiles[i].height = desc.Height;
+        mask_diag_tiles[i].rects = calloc(MASK_DIAG_RECTS, sizeof(RECT));
+        mask_diag_tiles[i].count = 0;
+    }
+    for (j = 0; j < mask_diag_tiles[i].count; ++j)
+        if (EqualRect(&mask_diag_tiles[i].rects[j], rect)) break;
+    if (j == mask_diag_tiles[i].count && j < MASK_DIAG_RECTS) mask_diag_tiles[i].rects[mask_diag_tiles[i].count++] = *rect;
+    wined3d_mutex_unlock();
+}
+/* is [l,t,r,b] (atlas px) inside one recorded tile of the texture (1 px slack)? -1 = texture unknown */
+static int mask_diag_in_tile(unsigned int width, unsigned int height, float l, float t, float r, float b)
+{
+    unsigned int i, j; int res = -1;
+    wined3d_mutex_lock();
+    for (i = 0; i < MASK_DIAG_TEXTURES && mask_diag_tiles[i].width; ++i)
+        if (mask_diag_tiles[i].width == width && mask_diag_tiles[i].height == height)
+        {
+            res = 0;
+            for (j = 0; j < mask_diag_tiles[i].count; ++j)
+            {
+                const RECT *q = &mask_diag_tiles[i].rects[j];
+                if (l >= q->left - 1.5f && t >= q->top - 1.5f && r <= q->right + 1.5f && b <= q->bottom + 1.5f) { res = 1; break; }
+            }
+            break;
+        }
+    wined3d_mutex_unlock();
+    return res;
+}
+static void guard_last_set(ID3D11Texture2D *texture, const RECT *rect)
+{
+    unsigned int i;
+    for (i = 0; i < 32; ++i) if (guard_last[i].texture == texture) { guard_last[i].rect = *rect; return; }
+    for (i = 0; i < 32; ++i) if (!guard_last[i].texture) { guard_last[i].texture = texture; guard_last[i].rect = *rect; return; }
+}
+static const RECT *guard_last_get(ID3D11Texture2D *texture)
+{
+    unsigned int i;
+    for (i = 0; i < 32; ++i) if (guard_last[i].texture == texture) return &guard_last[i].rect;
+    return NULL;
+}
