+{
+    struct interaction_context *context = context_from_handle(handle);
+
+    unsigned int i;
+
+    TRACE("context %p, entries_count %u, pointer_count %u, pointer_info %p.\n",
+          context, entries_count, pointer_count, pointer_info);
+
+    if (!context) return E_HANDLE;
+    if (!entries_count || !pointer_count) return E_INVALIDARG;
+    if (!pointer_info) return E_POINTER;
+
+    for (i = 0; i < entries_count * pointer_count; i++)
+    {
+        const POINTER_INFO *info = &pointer_info[i];
+        if (info->pointerFlags & (POINTER_FLAG_WHEEL | POINTER_FLAG_HWHEEL))
+            wheel_to_manipulation(context, info);
+        else
+        {
+            static unsigned int once;
+            if (once++ < 3) FIXME("pointer flags %#x not handled, no output generated.\n", info->pointerFlags);
+        }
+    }
     return S_OK;
 }
