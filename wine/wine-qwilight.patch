+/* Storyboards fight for variables: a new storyboard takes its variables away from the ones playing. */
+static void manager_release_variables( struct manager2 *mgr, struct storyboard2 *sb )
+{
+    struct sb_transition *st, *other;
+    struct storyboard2 *old, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( old, next, &mgr->storyboards, struct storyboard2, entry )
+    {
+        BOOL conflict = FALSE;
+        if (old == sb) continue;
+        LIST_FOR_EACH_ENTRY( st, &sb->transitions, struct sb_transition, entry )
+        {
+            LIST_FOR_EACH_ENTRY( other, &old->transitions, struct sb_transition, entry )
+                if (other->variable == st->variable) conflict = TRUE;
+        }
+        if (conflict)
+        {
+            IUIAnimationStoryboard2_AddRef( &old->IUIAnimationStoryboard2_iface );
+            storyboard_set_status( old, UI_ANIMATION_STORYBOARD_TRUNCATED );
+            storyboard_unlist( old );
+            storyboard_set_status( old, UI_ANIMATION_STORYBOARD_READY );
+            IUIAnimationStoryboard2_Release( &old->IUIAnimationStoryboard2_iface );
+        }
+    }
+}
+
+static HRESULT WINAPI storyboard2_Schedule( IUIAnimationStoryboard2 *iface, double time_now, UI_ANIMATION_SCHEDULING_RESULT *result )
+{
+    struct storyboard2 *This = impl_from_IUIAnimationStoryboard2( iface );
+    struct manager2 *mgr = This->manager;
+    struct sb_transition *st;
+
+    TRACE( "%p, %f, %p.\n", iface, time_now, result );
+
+    if (This->status != UI_ANIMATION_STORYBOARD_BUILDING)
+    {
+        if (result) *result = UI_ANIMATION_SCHEDULING_ALREADY_SCHEDULED;
+        return S_OK;
+    }
+
+    EnterCriticalSection( &mgr->cs );
+    manager_release_variables( mgr, This );
+    storyboard_resolve( This );
+    This->start_time = time_now + This->skip_duration * 0.0;
+    This->elapsed = 0.0;
+    LIST_FOR_EACH_ENTRY( st, &This->transitions, struct sb_transition, entry )
+        st->variable->current = This;
+    IUIAnimationStoryboard2_AddRef( iface );
+    list_add_tail( &mgr->storyboards, &This->entry );
+    This->in_list = TRUE;
+    storyboard_set_status( This, UI_ANIMATION_STORYBOARD_SCHEDULED );
+    manager_update_status( mgr );
+    LeaveCriticalSection( &mgr->cs );
+
+    if (result) *result = UI_ANIMATION_SCHEDULING_SUCCEEDED;
+    return S_OK;
+}
+
+static void storyboard_jump_to_end( struct storyboard2 *This, UI_ANIMATION_STORYBOARD_STATUS status )
+{
+    struct sb_transition *st;
+    BOOL changed = FALSE;
+
+    IUIAnimationStoryboard2_AddRef( &This->IUIAnimationStoryboard2_iface );
+    LIST_FOR_EACH_ENTRY( st, &This->transitions, struct sb_transition, entry )
+    {
+        if (st->done) continue;
+        st->done = TRUE;
+        variable_set_value( st->variable, This, st->transition->end_value, &changed );
+    }
+    if (changed && This->handler)
+        IUIAnimationStoryboardEventHandler2_OnStoryboardUpdated( This->handler, &This->IUIAnimationStoryboard2_iface );
+    storyboard_set_status( This, status );
+    storyboard_unlist( This );
+    storyboard_set_status( This, UI_ANIMATION_STORYBOARD_READY );
+    manager_update_status( This->manager );
+    IUIAnimationStoryboard2_Release( &This->IUIAnimationStoryboard2_iface );
+}
