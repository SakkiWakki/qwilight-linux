+static HRESULT WINAPI statics_get_EnergySaverStatus( IPowerManagerStatics *iface, EnergySaverStatus *value )
+{
+    SYSTEM_POWER_STATUS status;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+
+    /* Battery saver only exists on a machine that has a battery; without one
+     * Windows reports Disabled, which is what MicaController wants to see
+     * (SetPowerSavingMode( status == On )). */
+    *value = EnergySaverStatus_Disabled;
+    if (get_power_status( &status ) && has_battery( &status )) *value = EnergySaverStatus_Off;
+
+    TRACE( "returning %d.\n", *value );
+    return S_OK;
+}
