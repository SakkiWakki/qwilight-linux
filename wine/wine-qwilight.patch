+/* The font fallback language list is a ';'-separated list of BCP-47 tags, most
+ * preferred first. Windows builds it from the user's language profile; we have
+ * none, so build it from the requested language, the user default locale, their
+ * neutral forms, en-US, and the CJK languages, so that a run of Hangul, kana or
+ * Han text still resolves to a sensible default font family rather than to the
+ * first Latin-only font. */
+static const WCHAR *const fallback_tail[] =
+{
+    L"en-US",
+    L"en",
+    L"ko-KR",
+    L"ja-JP",
+    L"zh-Hans-CN",
+    L"zh-Hant-TW",
+};
+
+/* Append entry to the ';'-separated list, skipping duplicates. All entries are
+ * canonicalized with LOCALE_SNAME or spelled canonically here, so a plain
+ * comparison is enough. */
+static void append_fallback_language(WCHAR *list, size_t capacity, const WCHAR *entry)
+{
+    size_t list_length = wcslen(list), entry_length = wcslen(entry);
+    const WCHAR *p, *end;
+
+    if (!entry_length) return;
+
+    for (p = list; *p; p = end + 1)
+    {
+        if (!(end = wcschr(p, ';'))) end = p + wcslen(p);
+        if ((size_t)(end - p) == entry_length && !wcsncmp(p, entry, entry_length)) return;
+        if (!*end) break;
+    }
+
+    if (list_length + !!list_length + entry_length + 1 > capacity) return;
+    if (list_length) list[list_length++] = ';';
+    wcscpy(list + list_length, entry);
+}
+
+/* The neutral form of a tag is the tag without its last subtag, e.g. en for
+ * en-US and zh-Hans for zh-Hans-CN. */
+static void append_fallback_language_and_neutral(WCHAR *list, size_t capacity, const WCHAR *tag)
+{
+    WCHAR neutral[LOCALE_NAME_MAX_LENGTH];
+    WCHAR *sep;
+
+    append_fallback_language(list, capacity, tag);
+
+    wcscpy(neutral, tag);
+    if ((sep = wcsrchr(neutral, '-')))
+    {
+        *sep = 0;
+        append_fallback_language(list, capacity, neutral);
+    }
+}
