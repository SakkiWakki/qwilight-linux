+/* ---------------------------------------------------------------------- */
+/* rounding */
+
+static double apply_rounding( double x, RoundingAlgorithm algorithm )
+{
+    double f, i;
+
+    switch (algorithm)
+    {
+    case RoundingAlgorithm_None: return x;
+    case RoundingAlgorithm_RoundDown: return floor( x );
+    case RoundingAlgorithm_RoundUp: return ceil( x );
+    case RoundingAlgorithm_RoundTowardsZero: return trunc( x );
+    case RoundingAlgorithm_RoundAwayFromZero: return x < 0 ? floor( x ) : ceil( x );
+    case RoundingAlgorithm_RoundHalfDown: return ceil( x - 0.5 );
+    case RoundingAlgorithm_RoundHalfUp: return floor( x + 0.5 );
+    case RoundingAlgorithm_RoundHalfTowardsZero: return x < 0 ? -floor( -x + 0.5 ) : ceil( x - 0.5 );
+    case RoundingAlgorithm_RoundHalfAwayFromZero: return round( x );
+    case RoundingAlgorithm_RoundHalfToEven: return rint( x );
+    case RoundingAlgorithm_RoundHalfToOdd:
+        f = modf( x, &i );
+        if (fabs( f ) == 0.5) return fmod( i, 2.0 ) ? i : i + (x < 0 ? -1.0 : 1.0);
+        return round( x );
+    }
+    return x;
+}
+
+/* round to the given number of significant digits */
+static double round_significant( double value, UINT32 digits, RoundingAlgorithm algorithm )
+{
+    double scale;
+    int magnitude;
+
+    if (!digits || value == 0.0 || !isfinite( value )) return value;
+    magnitude = (int)floor( log10( fabs( value ) ) );
+    scale = pow( 10.0, (int)digits - 1 - magnitude );
+    return apply_rounding( value * scale, algorithm ) / scale;
+}
+
+/* round to a multiple of increment */
+static double round_increment( double value, double increment, RoundingAlgorithm algorithm )
+{
+    if (increment <= 0.0 || !isfinite( value )) return value;
+    return apply_rounding( value / increment, algorithm ) * increment;
+}
+
+struct rounder
