+/* ---------------------------------------------------------------- property transforms
+ *
+ * Translate / scale / rotate / skew (2D and 3D): every interface is IUnknown followed by
+ * (SetXAnimation, SetX) pairs, so one object type with an indexed property array and one
+ * setter pair per index serves them all; the kind picks the IIDs and the matrix. */
+
+enum property_transform_kind
+{
+    TRANSFORM_TRANSLATE,    /* x, y */
+    TRANSFORM_SCALE,        /* sx, sy, cx, cy */
+    TRANSFORM_ROTATE,       /* angle, cx, cy */
+    TRANSFORM_SKEW,         /* ax, ay, cx, cy */
+    TRANSFORM_TRANSLATE_3D, /* x, y, z */
+    TRANSFORM_SCALE_3D,     /* sx, sy, sz, cx, cy, cz */
+    TRANSFORM_ROTATE_3D,    /* angle, axis x, y, z, cx, cy, cz */
+};
+
+struct composition_property_transform
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    enum property_transform_kind kind;
+    float prop[7];
+};
