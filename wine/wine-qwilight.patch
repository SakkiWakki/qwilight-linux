+/* Wrap a wined3d resource opened from a shared handle (one reference, no parent) in a
+ * D3D11 resource object and return the requested interface. Consumes the reference. */
+static HRESULT d3d_device_wrap_shared_resource(struct d3d_device *device,
+        struct wined3d_resource *wined3d_resource, REFIID iid, void **out)
+{
+    struct wined3d_resource_desc wined3d_desc;
+    struct wined3d_texture *wined3d_texture;
+    struct d3d_texture2d *texture;
+    D3D11_TEXTURE2D_DESC desc;
+    HRESULT hr;
+
+    wined3d_mutex_lock();
+    wined3d_resource_get_desc(wined3d_resource, &wined3d_desc);
+
+    if (wined3d_desc.resource_type != WINED3D_RTYPE_TEXTURE_2D)
+    {
+        FIXME("Unhandled shared resource type %#x.\n", wined3d_desc.resource_type);
+        if (wined3d_desc.resource_type == WINED3D_RTYPE_BUFFER)
+            ERR("Leaking shared wined3d buffer %p.\n", wined3d_resource);
+        else
+            wined3d_texture_decref(wined3d_texture_from_resource(wined3d_resource));
+        wined3d_mutex_unlock();
+        return E_NOTIMPL;
+    }
+
+    wined3d_texture = wined3d_texture_from_resource(wined3d_resource);
+    d3d11_texture2d_desc_from_wined3d(&desc, wined3d_texture);
+    wined3d_mutex_unlock();
+
+    TRACE("Opened %ux%u, format %#x, levels %u, layers %u, bind %#x, misc %#x.\n", desc.Width, desc.Height,
+            desc.Format, desc.MipLevels, desc.ArraySize, desc.BindFlags, desc.MiscFlags);
+
+    /* d3d_texture2d_create() sets itself as parent and takes its own reference. */
+    hr = d3d_texture2d_create(device, &desc, wined3d_texture, NULL, &texture);
+    wined3d_mutex_lock();
+    wined3d_texture_decref(wined3d_texture);
+    wined3d_mutex_unlock();
+    if (FAILED(hr))
+    {
+        WARN("Failed to create texture object for shared resource, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    hr = ID3D11Texture2D_QueryInterface(&texture->ID3D11Texture2D_iface, iid, out);
+    ID3D11Texture2D_Release(&texture->ID3D11Texture2D_iface);
+    if (FAILED(hr))
+        WARN("Shared resource does not support %s, hr %#lx.\n", debugstr_guid(iid), hr);
+
+    return hr;
+}
+
+static HRESULT d3d_device_open_shared_resource(struct d3d_device *device, HANDLE handle,
+        uint32_t flags, REFIID iid, void **out)
+{
+    struct wined3d_resource *wined3d_resource;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    wined3d_mutex_lock();
+    hr = wined3d_device_open_shared_resource(device->wined3d_device, handle, flags, &wined3d_resource);
+    wined3d_mutex_unlock();
+    if (FAILED(hr))
+    {
+        WARN("Failed to open shared resource from handle %p, flags %#x, hr %#lx.\n", handle, flags, hr);
+        return hr;
+    }
+
+    return d3d_device_wrap_shared_resource(device, wined3d_resource, iid, out);
+}
