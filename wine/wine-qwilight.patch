+static HRESULT STDMETHODCALLTYPE internal_get_stream( IWineMediaSourceInternal *iface, IUnknown **stream, HSTRING *content_type )
+{
+    struct media_source *impl = impl_from_IWineMediaSourceInternal( iface );
+
+    *stream = NULL;
+    if (content_type) *content_type = NULL;
+    if (!impl->stream) return S_FALSE;
+    media_source_snapshot( impl );
+    if (impl->snapshot)
+    {
+        IStream *clone;
+        /* a private clone: several players may open the same source */
+        if (SUCCEEDED(IStream_Clone( impl->snapshot, &clone ))) *stream = (IUnknown *)clone;
+        else { *stream = (IUnknown *)impl->snapshot; IUnknown_AddRef( *stream ); }
+    }
+    else { *stream = impl->stream; IUnknown_AddRef( *stream ); }
+    if (content_type) WindowsDuplicateString( impl->content_type, content_type );
+    return S_OK;
+}
