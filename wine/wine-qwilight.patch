+/* The value an animated property settles at: animations are not run, the property jumps to
+ * the animation's end value (or its first value when it has no end). */
+static BOOL dcomp_animation_get_value(IDCompositionAnimation *animation, float *value)
+{
+    struct composition_animation *impl;
+
+    if (!animation || animation->lpVtbl != &animation_vtbl)
+    {
+        FIXME("Animation %p is not one of ours.\n", animation);
+        return FALSE;
+    }
+    impl = impl_from_IDCompositionAnimation(animation);
+    if (!impl->has_value) return FALSE;
