+/*
+ * Visual.
+ */
+static HRESULT composition_visual_query_interface( struct composition_object *obj, REFIID iid, void **out )
+{
+    struct composition_visual *impl = composition_visual_from_composition_object( obj );
+    unsigned int i;
+
+    if (IsEqualGUID( iid, &IID_IVisual ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IVisual_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IVisual2 ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IVisual2_iface) );
+        return S_OK;
+    }
+
+    if (impl->kind != COMPOSITION_VISUAL && IsEqualGUID( iid, &IID_IContainerVisual ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IContainerVisual_iface) );
+        return S_OK;
+    }
+
+    if (impl->kind == COMPOSITION_SPRITE_VISUAL && IsEqualGUID( iid, &IID_ISpriteVisual ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ISpriteVisual_iface) );
+        return S_OK;
+    }
+
+    /* The interop face: hand out the inner DirectComposition visual, so that a
+     * dcomp target (target.c) can be rooted at this WinRT visual and so that
+     * FrameworkUdk's private visual helpers reach a real dcomp object. */
+    for (i = 0; i < ARRAY_SIZE(dcomp_visual_iids); i++)
+    {
+        if (!IsEqualGUID( iid, dcomp_visual_iids[i] )) continue;
+        if (!impl->dcomp_visual) break;
+        TRACE( "forwarding %s to the inner dcomp visual %p.\n", debugstr_guid( iid ), impl->dcomp_visual );
+        return IDCompositionVisual2_QueryInterface( impl->dcomp_visual, iid, out );
+    }
+
+    return E_NOINTERFACE;
+}
+
+static void composition_visual_destroy( struct composition_object *obj )
+{
+    struct composition_visual *impl = composition_visual_from_composition_object( obj );
+
+    if (impl->children)
+    {
+        impl->children->owner = NULL;
+        composition_object_release( &impl->children->object );
+    }
+    if (impl->brush) ICompositionBrush_Release( impl->brush );
+    if (impl->clip) ICompositionClip_Release( impl->clip );
+    if (impl->parent_for_transform) IVisual_Release( impl->parent_for_transform );
+    if (impl->dcomp_visual) IDCompositionVisual2_Release( impl->dcomp_visual );
+    free( impl );
+}
