+/* Windows.System.DispatcherQueue
+ *
+ * The queue is a real, thread-affine object: CreateDispatcherQueueController() with
+ * DQTYPE_THREAD_CURRENT binds it to the calling thread, GetDispatcherQueueForCurrentThread()
+ * and IDispatcherQueueStatics::GetForCurrentThread() find it again from that thread, and
+ * TryEnqueue() posts to a message-only window owned by that thread so the callback runs from
+ * the thread's own message loop. This is what the Windows App SDK's CoreMessagingXP.dll
+ * (Microsoft::UI::Dispatching::DispatcherQueue::EnsureSystemDispatcherQueue) expects: it
+ * calls the flat GetDispatcherQueueForCurrentThread() first and, only if that yields NULL,
+ * creates a controller with DQTYPE_THREAD_CURRENT.
+ */
+
+struct dispatcher_queue
+{
+    IDispatcherQueue IDispatcherQueue_iface;
+    IDispatcherQueue2 IDispatcherQueue2_iface;
+    LONG ref;
+
+    struct list entry;      /* in thread_queues, while thread_id is set */
+    DWORD thread_id;        /* owning thread, 0 when unbound or shut down */
+    HWND hwnd;              /* message-only window on the owning thread */
+    LONG token;             /* next event registration token */
