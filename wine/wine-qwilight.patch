+/* The 2D affine part of a transform object.  A 3D matrix is reduced to its x/y rows and the
+ * translation; a real perspective or z rotation is not representable and gets a WARN. */
+static BOOL dcomp_transform_get_matrix_ex(IUnknown *unknown, D2D_MATRIX_3X2_F *matrix, unsigned int depth);
+
+BOOL dcomp_transform_get_matrix(IUnknown *unknown, D2D_MATRIX_3X2_F *matrix)
+{
+    if (!unknown)
+        return FALSE;
+
+    if (((IDCompositionMatrixTransform *)unknown)->lpVtbl == &matrix_transform_vtbl)
+    {
+        *matrix = impl_from_IDCompositionMatrixTransform((IDCompositionMatrixTransform *)unknown)->matrix;
+        return TRUE;
+    }
+    if (((IDCompositionMatrixTransform3D *)unknown)->lpVtbl == &matrix_transform_3d_vtbl)
+    {
+        const D3DMATRIX *m = &impl_from_IDCompositionMatrixTransform3D((IDCompositionMatrixTransform3D *)unknown)->matrix;
+
+        matrix->_11 = m->m[0][0];
+        matrix->_12 = m->m[0][1];
+        matrix->_21 = m->m[1][0];
+        matrix->_22 = m->m[1][1];
+        matrix->_31 = m->m[3][0];
+        matrix->_32 = m->m[3][1];
+        if (m->m[0][3] || m->m[1][3] || m->m[2][3] || m->m[3][3] != 1.0f || m->m[0][2] || m->m[1][2])
+            WARN("Non-affine 3D matrix reduced to its 2D part.\n");
+        return TRUE;
+    }
+    return dcomp_transform_get_matrix_ex(unknown, matrix, 0);
+}
