+/* Windows.System.Threading.ThreadPoolTimer
+ *
+ * A timer is backed by a Win32 thread pool timer (TP_TIMER) in the default pool, so the
+ * elapsed handler runs on a pool thread. The object keeps a reference to itself while
+ * the timer is armed; that reference is released by a finalizer work item which runs on
+ * a pool thread once the timer can no longer fire (after Cancel(), or after a one-shot
+ * timer elapsed), waits for in-flight callbacks, closes the TP_TIMER and invokes the
+ * TimerDestroyedHandler exactly once. Doing that on a separate pool thread rather than
+ * inline lets Cancel() be called from inside the elapsed handler without deadlocking on
+ * WaitForThreadpoolTimerCallbacks(). */
+
+enum timer_state
+{
+    TIMER_STATE_ARMED,
+    TIMER_STATE_DONE,
+};
+
+struct threadpool_timer
+{
+    IThreadPoolTimer IThreadPoolTimer_iface;
+    LONG refcount;
+
+    ITimerElapsedHandler *handler;
+    ITimerDestroyedHandler *destroyed;
+    TimeSpan delay;
+    TimeSpan period;
+    BOOL periodic;
+
+    TP_TIMER *tp_timer;
+    TP_WORK *finalizer;
+    LONG state;
+};
+
+static inline struct threadpool_timer *impl_from_IThreadPoolTimer(IThreadPoolTimer *iface)
+{
+    return CONTAINING_RECORD(iface, struct threadpool_timer, IThreadPoolTimer_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE threadpool_timer_QueryInterface(IThreadPoolTimer *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualIID(iid, &IID_IThreadPoolTimer)
+            || IsEqualIID(iid, &IID_IInspectable)
+            || IsEqualIID(iid, &IID_IAgileObject)
+            || IsEqualIID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        IUnknown_AddRef((IUnknown *)*out);
+        return S_OK;
+    }
+
+    *out = NULL;
+    WARN("Unsupported interface %s.\n", debugstr_guid(iid));
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE threadpool_timer_AddRef(IThreadPoolTimer *iface)
+{
+    struct threadpool_timer *timer = impl_from_IThreadPoolTimer(iface);
+    ULONG refcount = InterlockedIncrement(&timer->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE threadpool_timer_Release(IThreadPoolTimer *iface)
+{
+    struct threadpool_timer *timer = impl_from_IThreadPoolTimer(iface);
+    ULONG refcount = InterlockedDecrement(&timer->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        /* The finalizer has already closed the pool objects and released the handlers
+         * unless creation failed before the timer was armed. */
+        if (timer->tp_timer) CloseThreadpoolTimer(timer->tp_timer);
+        if (timer->finalizer) CloseThreadpoolWork(timer->finalizer);
+        if (timer->handler) ITimerElapsedHandler_Release(timer->handler);
+        if (timer->destroyed) ITimerDestroyedHandler_Release(timer->destroyed);
+        free(timer);
+    }
+
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE threadpool_timer_GetIids(IThreadPoolTimer *iface, ULONG *iid_count, IID **iids)
+{
+    FIXME("iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids);
+
+    return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE threadpool_timer_GetRuntimeClassName(IThreadPoolTimer *iface, HSTRING *class_name)
+{
+    TRACE("iface %p, class_name %p.\n", iface, class_name);
+
+    return WindowsCreateString(RuntimeClass_Windows_System_Threading_ThreadPoolTimer,
+            ARRAY_SIZE(RuntimeClass_Windows_System_Threading_ThreadPoolTimer) - 1, class_name);
+}
+
