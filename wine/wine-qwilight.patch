+/* Approximate geometry combination: both inputs are flattened, then their figures
+ * are emitted together under a fill mode that yields the requested result for
+ * simple, nested or disjoint shapes (e.g. a border ring = outer EXCLUDE inner).
+ * Real boolean operations on overlapping outlines are not implemented. */
+/* Clip one flattened (all-line) figure against an axis-aligned rectangle
+ * (Sutherland-Hodgman) and emit the result. */
+static void d2d_figure_clip_rect_emit(const struct d2d_figure *figure, const D2D1_RECT_F *rect,
+        ID2D1SimplifiedGeometrySink *sink)
+{
+    D2D1_POINT_2F *in, *out, *tmp;
+    size_t i, j, n = 0, m, cap = figure->vertex_count + 8;
+    unsigned int edge;
+
+    if (!(in = malloc(cap * 2 * sizeof(*in) * 2))) return;
+    out = in + cap * 2;
+    for (i = 0; i < figure->vertex_count; ++i)
+        if (figure->vertex_types[i] != D2D_VERTEX_TYPE_NONE) in[n++] = figure->vertices[i];
+
+    for (edge = 0; edge < 4 && n; ++edge)
+    {
+        m = 0;
+        for (i = 0; i < n; ++i)
+        {
+            D2D1_POINT_2F cur = in[i], prev = in[(i + n - 1) % n];
+            float dc, dp; /* signed distance inside (>= 0 is inside) */
+            switch (edge)
+            {
+                case 0: dc = cur.x - rect->left; dp = prev.x - rect->left; break;
+                case 1: dc = rect->right - cur.x; dp = rect->right - prev.x; break;
+                case 2: dc = cur.y - rect->top; dp = prev.y - rect->top; break;
+                default: dc = rect->bottom - cur.y; dp = rect->bottom - prev.y; break;
+            }
+            if (dc >= 0.0f)
+            {
+                if (dp < 0.0f && m < cap * 2)
+                {
+                    float t = dp / (dp - dc);
+                    out[m].x = prev.x + (cur.x - prev.x) * t; out[m].y = prev.y + (cur.y - prev.y) * t; ++m;
+                }
+                if (m < cap * 2) out[m++] = cur;
+            }
+            else if (dp >= 0.0f && m < cap * 2)
+            {
+                float t = dp / (dp - dc);
+                out[m].x = prev.x + (cur.x - prev.x) * t; out[m].y = prev.y + (cur.y - prev.y) * t; ++m;
+            }
+        }
+        tmp = in; in = out; out = tmp; n = m;
+    }
+
+    /* drop consecutive duplicates */
+    for (i = 0, j = 0; i < n; ++i)
+        if (!j || fabsf(in[i].x - in[j - 1].x) > 1e-4f || fabsf(in[i].y - in[j - 1].y) > 1e-4f) in[j++] = in[i];
+    n = j;
+    if (n >= 3)
+    {
+        ID2D1SimplifiedGeometrySink_BeginFigure(sink, in[0], D2D1_FIGURE_BEGIN_FILLED);
+        ID2D1SimplifiedGeometrySink_AddLines(sink, in + 1, n - 1);
+        ID2D1SimplifiedGeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+    }
+    free(in < out ? in : out);
+}
+
+/* If the geometry is an axis-aligned rectangle (a rectangle geometry, optionally under a
+ * scale/translate transform), return its rectangle. */
+static BOOL d2d_geometry_get_aligned_rect(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, D2D1_RECT_F *rect)
+{
+    ID2D1RectangleGeometry *rectangle;
+    D2D1_RECT_F r;
+    float x0, y0, x1, y1;
+
+    if (FAILED(ID2D1Geometry_QueryInterface(geometry, &IID_ID2D1RectangleGeometry, (void **)&rectangle)))
+        return FALSE;
+    ID2D1RectangleGeometry_GetRect(rectangle, &r);
+    ID2D1RectangleGeometry_Release(rectangle);
+    if (transform)
+    {
+        if (transform->_12 != 0.0f || transform->_21 != 0.0f) return FALSE;
+        x0 = r.left * transform->_11 + transform->_31; x1 = r.right * transform->_11 + transform->_31;
+        y0 = r.top * transform->_22 + transform->_32; y1 = r.bottom * transform->_22 + transform->_32;
+        r.left = min(x0, x1); r.right = max(x0, x1); r.top = min(y0, y1); r.bottom = max(y0, y1);
+    }
+    *rect = r;
+    return TRUE;
+}
