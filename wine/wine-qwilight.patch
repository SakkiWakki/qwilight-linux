+    INTERACTION_CONFIGURATION_FLAGS flags = context->config_flags[INTERACTION_ID_MANIPULATION - 1];
+    float chars_x = context->mouse_wheel[MOUSE_WHEEL_PARAMETER_CHAR_TRANSLATION_X];
