+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * These two classes are system-private: no public Windows SDK declares them,
+ * and they exist only so that the Windows App SDK's FrameworkUdk can reach the
+ * OS input stack.  Microsoft.InputStateManager.dll fail-fasts if it cannot get
+ * them (InputRootConfigurationProxy::OnHostWindowIdChanged), so they have to
+ * exist even though Wine has no composition input sink to hang them off.
+ *
+ * The chain, reconstructed from Microsoft.Internal.FrameworkUdk.dll 2.4 with
+ * its public PDB (all rvas in survey/impl-input-site.md):
+ *
+ *   InputStateManager!InputRootConfigurationProxy::OnHostWindowIdChanged
+ *     -> udk!InputPrivates_InputSite_GetForInputSink( sink_handle, &site )
+ *          -> PlatformFunctionsBase<15>::GetInputSite (vtable slot 23)
+ *               wraps the sink handle in its own CInputSiteVisualAdapter,
+ *               which is a Windows.UI.Composition.IVisual, then
+ *               RoGetActivationFactory( L"Windows.UI.Internal.Input.InputSite",
+ *                                       IInputSiteStatics )
+ *               and calls slot 6 with that visual.
+ *     -> udk!InputPrivates_GetActivationConfiguration( site, &config )
+ *          -> PlatformFunctionsBase<15>::GetActivationConfiguration (slot 24)
+ *               site->QueryInterface( {cfb32fa7-5399-5f3d-82ba-9641f106ffcd} ),
+ *               RoGetActivationFactory( L"Windows.UI.Internal.Input.
+ *                                        ActivationConfigurationInputObject" ),
+ *               slot 6 with that, then wraps the result in its own
+ *               CActivationConfiguration adapter.
+ *   InputRootConfigurationProxy::OnActivatePolicyChanged / OnEatPolicyChanged
+ *     then drive that adapter, which forwards to slots 7 and 9 of the object
+ *     this file returns.  Every one of those is FAIL_FAST-on-failure.
+ *
+ * We record the policies and do nothing else.  Input still reaches WinUI 3
+ * through the window messages it also handles on its InputSiteWindowClass
+ * child window (see survey/small-stubs.md section C); routing real input
+ * through a composition input sink would need the sink itself, which
+ * win32u only pretends to have (NtCreateCompositionInputSink).
+ */
+
+#include <stddef.h>
+#include <stdarg.h>
+#include <stdlib.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "winstring.h"
+#include "objbase.h"
+
+#include "initguid.h"
+#include "activation.h"
+
+#define WIDL_using_Windows_Foundation
+#include "windows.foundation.h"
+#define WIDL_using_Windows_UI_Internal_Input
+#include "windows.ui.internal.input.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(inputsite);
+
+#define DEFINE_IINSPECTABLE_( pfx, iface_type, impl_type, impl_from, iface_mem, expr )             \
+    static inline impl_type *impl_from( iface_type *iface )                                        \
+    {                                                                                              \
+        return CONTAINING_RECORD( iface, impl_type, iface_mem );                                   \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out )        \
+    {                                                                                              \
+        impl_type *impl = impl_from( iface );                                                      \
+        return IInspectable_QueryInterface( (IInspectable *)(expr), iid, out );                    \
+    }                                                                                              \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface )                                          \
+    {                                                                                              \
+        impl_type *impl = impl_from( iface );                                                      \
+        return IInspectable_AddRef( (IInspectable *)(expr) );                                      \
+    }                                                                                              \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                         \
+    {                                                                                              \
+        impl_type *impl = impl_from( iface );                                                      \
+        return IInspectable_Release( (IInspectable *)(expr) );                                     \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *iid_count, IID **iids )         \
+    {                                                                                              \
+        impl_type *impl = impl_from( iface );                                                      \
+        return IInspectable_GetIids( (IInspectable *)(expr), iid_count, iids );                    \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *class_name )      \
+    {                                                                                              \
+        impl_type *impl = impl_from( iface );                                                      \
+        return IInspectable_GetRuntimeClassName( (IInspectable *)(expr), class_name );             \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *trust_level )        \
+    {                                                                                              \
+        impl_type *impl = impl_from( iface );                                                      \
+        return IInspectable_GetTrustLevel( (IInspectable *)(expr), trust_level );                  \
+    }
+#define DEFINE_IINSPECTABLE( pfx, iface_type, impl_type, base_iface )                              \
+    DEFINE_IINSPECTABLE_( pfx, iface_type, impl_type, impl_from_##iface_type, iface_type##_iface, &impl->base_iface )
+
+/* The one instance interface the FrameworkUdk asks the site for.  Its name is
+ * not in any symbol we have; the udk only ever uses it as the argument of
+ * IActivationConfigurationInputObjectStatics::GetForInputObject, so it is
+ * presumably Windows.UI.Internal.Input.IInputObject.  Answering the QI with
+ * the site itself is enough. */
+DEFINE_GUID(IID_input_object, 0xcfb32fa7,0x5399,0x5f3d,0x82,0xba,0x96,0x41,0xf1,0x06,0xff,0xcd);
+
+/*
+ * ActivationConfigurationInputObject instance.
+ *
+ * IID unknown (the statics hand the raw pointer to a WRL ComPtr, it is never
+ * queried), so instead of inventing a GUID the vtable is spelled out here.
+ * Slots 6-9 are the ones udk!CActivationConfiguration calls, verified against
+ * its forwarding thunks at udk rva 0x81820/0x818e0/0x81880/0x81940.
+ */
+struct activation_configuration;
+
+struct activation_configuration_vtbl
+{
+    /* IInspectable */
+    HRESULT (WINAPI *QueryInterface)( struct activation_configuration *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( struct activation_configuration *iface );
+    ULONG (WINAPI *Release)( struct activation_configuration *iface );
+    HRESULT (WINAPI *GetIids)( struct activation_configuration *iface, ULONG *iid_count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( struct activation_configuration *iface, HSTRING *class_name );
+    HRESULT (WINAPI *GetTrustLevel)( struct activation_configuration *iface, TrustLevel *trust_level );
+    /* IActivationConfigurationInputObject */
+    HRESULT (WINAPI *get_ActivatePolicy)( struct activation_configuration *iface, INT32 *value );
+    HRESULT (WINAPI *put_ActivatePolicy)( struct activation_configuration *iface, INT32 value );
+    HRESULT (WINAPI *get_EatPolicy)( struct activation_configuration *iface, INT32 *value );
+    HRESULT (WINAPI *put_EatPolicy)( struct activation_configuration *iface, INT32 value );
+};
+
+struct activation_configuration
+{
+    const struct activation_configuration_vtbl *vtbl;
+    LONG ref;
+
+    IInspectable *object;
+    INT32 activate_policy;
+    INT32 eat_policy;
+};
+
+static HRESULT WINAPI configuration_QueryInterface( struct activation_configuration *impl, REFIID iid, void **out )
+{
+    TRACE( "impl %p, iid %s, out %p.\n", impl, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        impl->vtbl->AddRef( impl );
+        *out = impl;
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI configuration_AddRef( struct activation_configuration *impl )
+{
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "impl %p, ref %lu.\n", impl, ref );
+    return ref;
+}
+
+static ULONG WINAPI configuration_Release( struct activation_configuration *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "impl %p, ref %lu.\n", impl, ref );
+
+    if (!ref)
+    {
+        if (impl->object) IInspectable_Release( impl->object );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI configuration_GetIids( struct activation_configuration *impl, ULONG *iid_count, IID **iids )
+{
+    FIXME( "impl %p, iid_count %p, iids %p stub!\n", impl, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI configuration_GetRuntimeClassName( struct activation_configuration *impl, HSTRING *class_name )
+{
+    TRACE( "impl %p, class_name %p.\n", impl, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_UI_Internal_Input_ActivationConfigurationInputObject,
+                                ARRAY_SIZE(RuntimeClass_Windows_UI_Internal_Input_ActivationConfigurationInputObject) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI configuration_GetTrustLevel( struct activation_configuration *impl, TrustLevel *trust_level )
+{
+    TRACE( "impl %p, trust_level %p.\n", impl, trust_level );
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+/* The policies are two enums the input root pushes down whenever XAML changes
+ * how the site should treat activation clicks.  Nothing under Wine consumes
+ * them; record them so a read-back is at least consistent. */
+static HRESULT WINAPI configuration_get_ActivatePolicy( struct activation_configuration *impl, INT32 *value )
+{
+    TRACE( "impl %p, value %p.\n", impl, value );
+    if (!value) return E_POINTER;
+    *value = impl->activate_policy;
+    return S_OK;
+}
+
+static HRESULT WINAPI configuration_put_ActivatePolicy( struct activation_configuration *impl, INT32 value )
+{
+    TRACE( "impl %p, value %d.\n", impl, value );
+    impl->activate_policy = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI configuration_get_EatPolicy( struct activation_configuration *impl, INT32 *value )
+{
+    TRACE( "impl %p, value %p.\n", impl, value );
+    if (!value) return E_POINTER;
+    *value = impl->eat_policy;
+    return S_OK;
+}
+
+static HRESULT WINAPI configuration_put_EatPolicy( struct activation_configuration *impl, INT32 value )
+{
+    TRACE( "impl %p, value %d.\n", impl, value );
+    impl->eat_policy = value;
+    return S_OK;
+}
+
+static const struct activation_configuration_vtbl configuration_vtbl =
+{
+    configuration_QueryInterface,
+    configuration_AddRef,
+    configuration_Release,
+    /* IInspectable */
+    configuration_GetIids,
+    configuration_GetRuntimeClassName,
+    configuration_GetTrustLevel,
+    /* IActivationConfigurationInputObject */
+    configuration_get_ActivatePolicy,
+    configuration_put_ActivatePolicy,
+    configuration_get_EatPolicy,
+    configuration_put_EatPolicy,
+};
+
+static HRESULT activation_configuration_create( IInspectable *object, IInspectable **out )
+{
+    struct activation_configuration *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->vtbl = &configuration_vtbl;
+    impl->ref = 1;
+    if ((impl->object = object)) IInspectable_AddRef( impl->object );
+
+    TRACE( "created %p for object %p.\n", impl, object );
+    *out = (IInspectable *)impl;
+    return S_OK;
+}
+
+/*
+ * InputSite instance.  Nothing calls a method on it: the FrameworkUdk hands it
+ * to InputStateManager as an IUnknown and later QIs it for IID_input_object.
+ */
+struct input_site
+{
+    IInspectable IInspectable_iface;
+    LONG ref;
+
+    IInspectable *visual;
+};
+
+static inline struct input_site *impl_from_IInspectable( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct input_site, IInspectable_iface );
+}
+
+static HRESULT WINAPI site_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct input_site *impl = impl_from_IInspectable( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_input_object ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = &impl->IInspectable_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI site_AddRef( IInspectable *iface )
+{
+    struct input_site *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI site_Release( IInspectable *iface )
+{
+    struct input_site *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->visual) IInspectable_Release( impl->visual );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI site_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
