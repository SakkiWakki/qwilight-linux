+static void effect_brush_destroy( struct composition_object *obj )
+{
+    struct effect_brush *impl = effect_brush_from_composition_object( obj );
+    struct effect_source_binding *binding, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( binding, next, &impl->sources, struct effect_source_binding, entry )
+    {
+        list_remove( &binding->entry );
+        if (binding->brush) ICompositionBrush_Release( binding->brush );
+        WindowsDeleteString( binding->name );
+        free( binding );
+    }
+    if (impl->effect) IGraphicsEffect_Release( impl->effect );
+    free( impl );
+}
