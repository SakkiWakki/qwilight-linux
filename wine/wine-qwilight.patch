+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(composition);
+
+
+/*
+ * The "interop compositor".  One COM object with two faces:
+ *
+ *  - the WinRT face (ICompositor, IClosable, IInteropCompositorPartner), which
+ *    is what the Windows App SDK's lifted compositor (dcompi.dll) and
+ *    Microsoft.UI.Windowing.Core.dll ask for, and
+ *  - the DirectComposition face (IDCompositionDevice, IDCompositionDevice2/3,
+ *    IDCompositionDesktopDevice and the private *Partner interfaces), which is
+ *    forwarded to an inner dcomp.dll desktop device created here.
+ *
+ * Forwarding hands out the inner device's own pointer, so COM identity is not
+ * preserved across the two halves: a QueryInterface(ICompositor) on a returned
+ * IDCompositionDevice* will fail.  That is fine for the App SDK's usage
+ * pattern, which always starts a QI from the WinRT face it was handed by
+ * CreateInteropCompositor (see survey/xaml-compositor.md section 2.5), but it
+ * is the first thing to suspect if a caller ever loses its way back.
+ */
+struct interop_compositor
+{
+    ICompositor ICompositor_iface;                              /* default; owns the refcount */
+    IClosable IClosable_iface;
+    ICompositor3 ICompositor3_iface;
+    ICompositorWithBlurredWallpaperBackdropBrush ICompositorWithBlurredWallpaperBackdropBrush_iface;
+    IInteropCompositorPartner IInteropCompositorPartner_iface;
+    ICompositorPartner ICompositorPartner_iface;
+    LONG ref;
+
+    IUnknown *rendering_device;                     /* what the caller passed; NULL from XAML */
+    IInteropCompositorPartnerCallback *callback;    /* AddRef'ed, may be NULL */
+    IUnknown *message_session;                      /* CoreMessaging session, recorded only */
+    IDCompositionDesktopDevice *device;             /* the inner dcomp device */
+    BOOL dirty;
+    BOOL closed;
+};
+
+/* Every IID the inner dcomp device may be able to answer.  Anything in this
+ * list is forwarded verbatim; dcomp itself decides what it supports, so a
+ * refusal here is a refusal by construction (which is what makes the
+ * Microsoft.UI.Windowing.Core title-bar probe report "not supported" instead of
+ * throwing: IDCompositionDesktopDevicePartner6 {ca67b562-...} is not one of the
+ * IIDs dcomp's device_QueryInterface() accepts). */
+static const IID *dcomp_device_iids[] =
+{
+    &IID_IDCompositionDevice,
+    &IID_IDCompositionDevice2,
+    &IID_IDCompositionDevice3,
+    &IID_IDCompositionDesktopDevice,
+    &IID_IDCompositionDesktopDevicePartner,
+    &IID_IDCompositionDesktopDevicePartner2,
+    &IID_IDCompositionDesktopDevicePartner3,
+    &IID_IDCompositionDesktopDevicePartner4,
+    &IID_IDCompositionDesktopDevicePartner5,
+    &IID_IDCompositionDesktopDevicePartner6,
+    &IID_IDCompositionDeviceInternal,
+};
+
+static inline struct interop_compositor *impl_from_ICompositor( ICompositor *iface )
+{
+    return CONTAINING_RECORD( iface, struct interop_compositor, ICompositor_iface );
+}
+
+static HRESULT WINAPI compositor_QueryInterface( ICompositor *iface, REFIID iid, void **out )
+{
+    struct interop_compositor *impl = impl_from_ICompositor( iface );
+    unsigned int i;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_ICompositor ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositor_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IClosable_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ICompositor3 ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositor3_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ICompositorWithBlurredWallpaperBackdropBrush ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositorWithBlurredWallpaperBackdropBrush_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IInteropCompositorPartner ))
+    {
+        *out = &impl->IInteropCompositorPartner_iface;
+        IUnknown_AddRef( (IUnknown *)*out );
+        return S_OK;
+    }
+
+    /* Every FrameworkUdk PlatformFunctions helper that takes an ICompositor *
+     * QueryInterfaces it for this first (udk 0x758c0, IID at udk .rdata
+     * 0xac790); the Mica backdrop reaches it through
+     * DCompPrivates_OpenAndAttachSharedTarget. */
+    if (IsEqualGUID( iid, &IID_ICompositorPartner ))
+    {
+        *out = &impl->ICompositorPartner_iface;
+        IUnknown_AddRef( (IUnknown *)*out );
+        return S_OK;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(dcomp_device_iids); i++)
+    {
+        if (!IsEqualGUID( iid, dcomp_device_iids[i] )) continue;
+        if (!impl->device) break;
+        TRACE( "forwarding %s to the inner dcomp device %p.\n", debugstr_guid( iid ), impl->device );
+        return IDCompositionDesktopDevice_QueryInterface( impl->device, iid, out );
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI compositor_AddRef( ICompositor *iface )
+{
+    struct interop_compositor *impl = impl_from_ICompositor( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static void interop_compositor_close( struct interop_compositor *impl )
+{
+    if (impl->closed) return;
+    impl->closed = TRUE;
+
+    if (impl->callback)
+    {
+        IInteropCompositorPartnerCallback_Release( impl->callback );
+        impl->callback = NULL;
+    }
+    if (impl->message_session)
+    {
+        IUnknown_Release( impl->message_session );
+        impl->message_session = NULL;
+    }
+    if (impl->rendering_device)
+    {
+        IUnknown_Release( impl->rendering_device );
+        impl->rendering_device = NULL;
+    }
+    if (impl->device)
+    {
+        IDCompositionDesktopDevice_Release( impl->device );
+        impl->device = NULL;
+    }
+}
+
+static ULONG WINAPI compositor_Release( ICompositor *iface )
+{
+    struct interop_compositor *impl = impl_from_ICompositor( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        interop_compositor_close( impl );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI compositor_GetIids( ICompositor *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI compositor_GetRuntimeClassName( ICompositor *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_UI_Composition_Compositor,
+                                ARRAY_SIZE(RuntimeClass_Windows_UI_Composition_Compositor) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI compositor_GetTrustLevel( ICompositor *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+/* The 24 ICompositor factory methods, in the IDL's vtable order (slots 6..29).
+ * None of them is reached while the Windows App SDK sets its compositor up; the
+ * lifted Microsoft.UI.Composition objects that XAML actually builds its tree
+ * from are created by dcompi.dll's switcher proxy, which forwards here only
+ * once it starts building visuals. */
+#define COMPOSITOR_STUB( name, args, fmt, ... )                                                    \
+    static HRESULT WINAPI compositor_##name args                                                   \
+    {                                                                                              \
+        FIXME( "iface %p, " fmt " stub!\n", iface, ## __VA_ARGS__ );                                \
+        if (result) *result = NULL;                                                                \
+        return E_NOTIMPL;                                                                          \
+    }
+
+COMPOSITOR_STUB( CreateColorKeyFrameAnimation,
+                 ( ICompositor *iface, IColorKeyFrameAnimation **result ), "result %p", result )
+COMPOSITOR_STUB( CreateCubicBezierEasingFunction,
+                 ( ICompositor *iface, Vector2 point1, Vector2 point2, ICubicBezierEasingFunction **result ),
+                 "result %p", result )
+COMPOSITOR_STUB( CreateExpressionAnimation,
+                 ( ICompositor *iface, IExpressionAnimation **result ), "result %p", result )
+COMPOSITOR_STUB( CreateExpressionAnimationWithExpression,
+                 ( ICompositor *iface, HSTRING expression, IExpressionAnimation **result ),
+                 "expression %s, result %p", debugstr_hstring( expression ), result )
+COMPOSITOR_STUB( CreateInsetClip, ( ICompositor *iface, IInsetClip **result ), "result %p", result )
+COMPOSITOR_STUB( CreateInsetClipWithInsets,
+                 ( ICompositor *iface, FLOAT left, FLOAT top, FLOAT right, FLOAT bottom, IInsetClip **result ),
+                 "result %p", result )
+COMPOSITOR_STUB( CreateLinearEasingFunction,
+                 ( ICompositor *iface, ILinearEasingFunction **result ), "result %p", result )
+COMPOSITOR_STUB( CreatePropertySet,
+                 ( ICompositor *iface, ICompositionPropertySet **result ), "result %p", result )
+COMPOSITOR_STUB( CreateQuaternionKeyFrameAnimation,
+                 ( ICompositor *iface, IQuaternionKeyFrameAnimation **result ), "result %p", result )
+COMPOSITOR_STUB( CreateScalarKeyFrameAnimation,
+                 ( ICompositor *iface, IScalarKeyFrameAnimation **result ), "result %p", result )
+COMPOSITOR_STUB( CreateScopedBatch,
+                 ( ICompositor *iface, CompositionBatchTypes type, ICompositionScopedBatch **result ),
+                 "type %d, result %p", type, result )
+COMPOSITOR_STUB( CreateSurfaceBrush,
+                 ( ICompositor *iface, ICompositionSurfaceBrush **result ), "result %p", result )
+COMPOSITOR_STUB( CreateSurfaceBrushWithSurface,
+                 ( ICompositor *iface, ICompositionSurface *surface, ICompositionSurfaceBrush **result ),
+                 "surface %p, result %p", surface, result )
+COMPOSITOR_STUB( CreateTargetForCurrentView,
+                 ( ICompositor *iface, ICompositionTarget **result ), "result %p", result )
+COMPOSITOR_STUB( CreateVector2KeyFrameAnimation,
+                 ( ICompositor *iface, IVector2KeyFrameAnimation **result ), "result %p", result )
+COMPOSITOR_STUB( CreateVector3KeyFrameAnimation,
+                 ( ICompositor *iface, IVector3KeyFrameAnimation **result ), "result %p", result )
+COMPOSITOR_STUB( CreateVector4KeyFrameAnimation,
+                 ( ICompositor *iface, IVector4KeyFrameAnimation **result ), "result %p", result )
+COMPOSITOR_STUB( GetCommitBatch,
+                 ( ICompositor *iface, CompositionBatchTypes type, ICompositionCommitBatch **result ),
+                 "type %d, result %p", type, result )
+
+#undef COMPOSITOR_STUB
+
+/* The two real ones.  MicaController::GetFallbackBrushOverride (wuceffectsi.dll
+ * rva 0x2a1b0) calls CreateColorBrushWithColor as soon as CompositionCapabilities
+ * says effects are unsupported, and throws on any failure. */
+static HRESULT WINAPI compositor_CreateColorBrush( ICompositor *iface, ICompositionColorBrush **result )
+{
+    static const Color transparent;
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    if (!result) return E_POINTER;
+    return composition_color_brush_create( iface, transparent, result );
+}
+
+static HRESULT WINAPI compositor_CreateColorBrushWithColor( ICompositor *iface, Color color,
+                                                            ICompositionColorBrush **result )
+{
+    TRACE( "iface %p, color {%u, %u, %u, %u}, result %p.\n", iface, color.A, color.R, color.G, color.B, result );
+
+    if (!result) return E_POINTER;
+    return composition_color_brush_create( iface, color, result );
+}
+
+/*
+ * The two effect factories.  wuceffectsi!SystemBackdropInternal::CreateCrossFadeEffectBrush
+ * (rva 0x3788c, from BaseController::Crossfade -> GetAnimationBrush) builds a
+ * CrossFadeEffect whose two sources are CompositionEffectSourceParameters
+ * "source1"/"source2" and calls vtable offset 0x60 = slot 12 =
+ * CreateEffectFactoryWithProperties(effect, { L"Crossfade.Weight" }) on the
+ * system compositor (0x37c22), then ICompositionEffectFactory::CreateBrush.
+ * A failure is a C++/WinRT throw that InitializeNewCompositor catches, which
+ * silently drops the Mica backdrop.  See effect.c.
+ */
+static HRESULT WINAPI compositor_CreateEffectFactory( ICompositor *iface, IGraphicsEffect *effect,
+                                                      ICompositionEffectFactory **result )
+{
+    TRACE( "iface %p, effect %p, result %p.\n", iface, effect, result );
+
+    if (!result) return E_POINTER;
+    return composition_effect_factory_create( iface, effect, NULL, result );
+}
+
+static HRESULT WINAPI compositor_CreateEffectFactoryWithProperties( ICompositor *iface, IGraphicsEffect *effect,
+                                                                    IIterable_HSTRING *animatable,
+                                                                    ICompositionEffectFactory **result )
+{
+    TRACE( "iface %p, effect %p, animatable %p, result %p.\n", iface, effect, animatable, result );
+
+    if (!result) return E_POINTER;
+    return composition_effect_factory_create( iface, effect, animatable, result );
+}
+
+/*
+ * The two visual factories.  dcompi.dll's
+ * ExternalTargetImpl<DesktopWindowTarget>::EnsureSystemBackdropVisual (rva
+ * 0xc68a6) calls CreateSpriteVisual on the *system* compositor as the first step
+ * of Window.SystemBackdrop = MicaBackdrop and treats a failure as fatal
+ * (__LINE__ 0x179); see visual.c for the rest of that sequence.  Nothing has
+ * asked for CreateContainerVisual yet, but it is the same object with one fewer
+ * interface, so it costs nothing to answer.
+ */
+static HRESULT WINAPI compositor_CreateContainerVisual( ICompositor *iface, IContainerVisual **result )
+{
+    struct interop_compositor *impl = impl_from_ICompositor( iface );
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    if (!result) return E_POINTER;
+    return composition_visual_create( iface, impl->device, COMPOSITION_CONTAINER_VISUAL,
+                                      (IInspectable **)result );
+}
+
+static HRESULT WINAPI compositor_CreateSpriteVisual( ICompositor *iface, ISpriteVisual **result )
+{
+    struct interop_compositor *impl = impl_from_ICompositor( iface );
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    if (!result) return E_POINTER;
+    return composition_visual_create( iface, impl->device, COMPOSITION_SPRITE_VISUAL,
+                                      (IInspectable **)result );
+}
+
+static const struct ICompositorVtbl compositor_vtbl =
+{
+    compositor_QueryInterface,
+    compositor_AddRef,
+    compositor_Release,
+    /* IInspectable */
+    compositor_GetIids,
+    compositor_GetRuntimeClassName,
+    compositor_GetTrustLevel,
+    /* ICompositor */
+    compositor_CreateColorKeyFrameAnimation,
+    compositor_CreateColorBrush,
+    compositor_CreateColorBrushWithColor,
+    compositor_CreateContainerVisual,
+    compositor_CreateCubicBezierEasingFunction,
+    compositor_CreateEffectFactory,
+    compositor_CreateEffectFactoryWithProperties,
+    compositor_CreateExpressionAnimation,
+    compositor_CreateExpressionAnimationWithExpression,
+    compositor_CreateInsetClip,
+    compositor_CreateInsetClipWithInsets,
+    compositor_CreateLinearEasingFunction,
+    compositor_CreatePropertySet,
+    compositor_CreateQuaternionKeyFrameAnimation,
+    compositor_CreateScalarKeyFrameAnimation,
+    compositor_CreateScopedBatch,
+    compositor_CreateSpriteVisual,
+    compositor_CreateSurfaceBrush,
+    compositor_CreateSurfaceBrushWithSurface,
+    compositor_CreateTargetForCurrentView,
+    compositor_CreateVector2KeyFrameAnimation,
+    compositor_CreateVector3KeyFrameAnimation,
+    compositor_CreateVector4KeyFrameAnimation,
+    compositor_GetCommitBatch,
+};
+
+/* ICompositor3 {c9dd8ef0-6eb1-4e3c-a658-675d9c64d4ab}: CreateHostBackdropBrush only.
+ * wuceffectsi's acrylic/host backdrop asks the system compositor for it while an
+ * unconstrained popup (flyout, toast) gets its backdrop; without it XAML reported
+ * "Call failed" and the popup never opened. */
+DEFINE_IINSPECTABLE( compositor3, ICompositor3, struct interop_compositor, ICompositor_iface )
+
+static HRESULT WINAPI compositor3_CreateHostBackdropBrush( ICompositor3 *iface, ICompositionBackdropBrush **result )
+{
