+/* Every request below is handed to the filter when the client has one -- that
+ * is what Windows does, and it is the seam a real transport plugs into -- and
+ * otherwise completes with WINE_HTTP_E_NO_TRANSPORT.  The built-in filter
+ * itself has no transport either, so today both paths fail the same way. */
+static HRESULT client_send( struct http_client *impl, IHttpRequestMessage *request,
+        IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **operation )
+{
+    IHttpRequestHeaderCollection *headers = NULL;
+    HRESULT hr;
+
+    if (!request) return WINE_HTTP_E_NO_TRANSPORT;
+
+    /* Windows merges the client's default headers into the request before the filter sees it. */
+    if (impl->default_request_headers && SUCCEEDED(IHttpRequestMessage_get_Headers( request, &headers )) && headers)
+    {
+        struct list *defaults = request_headers_get_list( impl->default_request_headers );
+        struct list *own = request_headers_get_list( headers );
+        struct header_entry *entry, *mine;
+        IHttpProductInfoHeaderValueCollection *ua_default = NULL, *ua_request = NULL;
+        IHttpCredentialsHeaderValue *auth = NULL;
+
+        if (defaults && own) LIST_FOR_EACH_ENTRY( entry, defaults, struct header_entry, entry )
+        {
+            BOOL present = FALSE;
+            LIST_FOR_EACH_ENTRY( mine, own, struct header_entry, entry )
+                if (!_wcsicmp( WindowsGetStringRawBuffer( mine->name, NULL ), WindowsGetStringRawBuffer( entry->name, NULL ) )) { present = TRUE; break; }
+            if (!present) header_list_append( own, entry->name, entry->value );
+        }
+        if (SUCCEEDED(IHttpRequestHeaderCollection_get_UserAgent( impl->default_request_headers, &ua_default )) && ua_default)
+        {
+            struct list *dl = product_info_collection_get_list( ua_default );
+            if (dl && !list_empty( dl ) && SUCCEEDED(IHttpRequestHeaderCollection_get_UserAgent( headers, &ua_request )) && ua_request)
+            {
+                struct list *rl = product_info_collection_get_list( ua_request );
+                if (rl && list_empty( rl )) LIST_FOR_EACH_ENTRY( entry, dl, struct header_entry, entry ) header_list_append( rl, entry->name, entry->value );
+                IHttpProductInfoHeaderValueCollection_Release( ua_request );
+            }
+            IHttpProductInfoHeaderValueCollection_Release( ua_default );
+        }
+        if (SUCCEEDED(IHttpRequestHeaderCollection_get_Authorization( impl->default_request_headers, &auth )) && auth)
+        {
+            IHttpCredentialsHeaderValue *own_auth = NULL;
+            if (SUCCEEDED(IHttpRequestHeaderCollection_get_Authorization( headers, &own_auth )) && !own_auth)
+                IHttpRequestHeaderCollection_put_Authorization( headers, auth );
+            if (own_auth) IHttpCredentialsHeaderValue_Release( own_auth );
+            IHttpCredentialsHeaderValue_Release( auth );
+        }
+        IHttpRequestHeaderCollection_Release( headers );
+    }
+
+    if (impl->filter) hr = IHttpFilter_SendRequestAsync( impl->filter, request, operation );
+    else hr = transport_send( (IUnknown *)&impl->IHttpClient_iface, request, operation );
+    return hr;
+}
