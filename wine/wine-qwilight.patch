 {
-    FIXME("iface %p, class_name %p stub!\n", iface, class_name);
-    return E_NOTIMPL;
+    struct property_value *impl = impl_from_IPropertyValue(iface);
+    const WCHAR *name = property_value_type_name(impl->type);
+    WCHAR buffer[96];
+
+    TRACE("iface %p, class_name %p\n", iface, class_name);
+
+    if (!name) return E_NOTIMPL;
+    swprintf(buffer, ARRAY_SIZE(buffer), (impl->type & PROPERTY_TYPE_ARRAY_FLAG) ? L"Windows.Foundation.IReferenceArray`1<%s>"
