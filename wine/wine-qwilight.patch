+static HRESULT input_site_create( IInspectable *visual, IInspectable **out )
+{
+    struct input_site *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_iface.lpVtbl = &site_vtbl;
+    impl->ref = 1;
+    if ((impl->visual = visual)) IInspectable_AddRef( impl->visual );
+
+    TRACE( "created %p for visual %p.\n", impl, visual );
+    *out = &impl->IInspectable_iface;
+    return S_OK;
+}
+
+/*
+ * The two activation factories.  Both classes are static-only as far as the
+ * App SDK is concerned, so ActivateInstance is refused.
+ */
+struct input_site_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IInputSiteStatics IInputSiteStatics_iface;
+    LONG ref;
+};
+
+static inline struct input_site_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct input_site_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI site_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct input_site_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IInputSiteStatics ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IInputSiteStatics_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI site_factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI site_factory_Release( IActivationFactory *iface )
