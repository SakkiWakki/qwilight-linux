+static HRESULT WINAPI storyboard2_Conclude( IUIAnimationStoryboard2 *iface )
+{
+    struct storyboard2 *This = impl_from_IUIAnimationStoryboard2( iface );
+    TRACE( "%p.\n", iface );
+    EnterCriticalSection( &This->manager->cs );
+    if (This->in_list) storyboard_jump_to_end( This, UI_ANIMATION_STORYBOARD_FINISHED );
+    LeaveCriticalSection( &This->manager->cs );
+    return S_OK;
+}
