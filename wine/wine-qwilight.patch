+    memset( waiter, 0, sizeof(*waiter) );
+    waiter->device_fd = get_inproc_device_fd();
+    waiter->owner     = getpid();
+    waiter->callback  = callback;
+    waiter->private   = private;
+    waiter->obj_fd    = -1;
+    waiter->alert_fd  = -1;
