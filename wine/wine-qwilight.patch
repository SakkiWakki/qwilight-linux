+    var->dim = dimension;
+    memcpy( var->value, initial_value, dimension * sizeof(double) );
+    memcpy( var->previous, initial_value, dimension * sizeof(double) );
+    memcpy( var->final, initial_value, dimension * sizeof(double) );
+    EnterCriticalSection( &This->cs );
+    list_add_tail( &This->variables, &var->entry );
+    LeaveCriticalSection( &This->cs );
+    *variable = &var->IUIAnimationVariable2_iface;
+    return S_OK;
