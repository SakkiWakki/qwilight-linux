+static HRESULT WINAPI manager2_EstimateNextEventTime( IUIAnimationManager2 *iface, double *seconds )
+{
+    struct manager2 *This = impl_from_IUIAnimationManager2( iface );
+    struct storyboard2 *sb;
+    struct sb_transition *st;
+    double best = -1.0;
+
+    TRACE( "%p, %p.\n", iface, seconds );
+
+    if (!seconds) return E_POINTER;
+    EnterCriticalSection( &This->cs );
+    LIST_FOR_EACH_ENTRY( sb, &This->storyboards, struct storyboard2, entry )
+    {
+        LIST_FOR_EACH_ENTRY( st, &sb->transitions, struct sb_transition, entry )
+        {
+            double at = sb->elapsed < st->start ? st->start : st->end;
+            double dt = at - sb->elapsed;
+            if (st->done) continue;
+            if (dt < 0.0) dt = 0.0;
+            if (sb->elapsed >= st->start && sb->elapsed < st->end) dt = 0.0;   /* animating: next frame */
+            if (best < 0.0 || dt < best) best = dt;
+        }
+    }
+    LeaveCriticalSection( &This->cs );
+    *seconds = best < 0.0 ? UI_ANIMATION_SECONDS_EVENTUALLY : best;
+    return S_OK;
+}
