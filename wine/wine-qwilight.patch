+static HRESULT storyboard_add( struct storyboard2 *This, IUIAnimationVariable2 *variable,
+        IUIAnimationTransition2 *transition, int start_keyframe, int end_keyframe )
+{
+    struct variable2 *var = unsafe_variable( variable );
+    struct transition2 *t = unsafe_transition( transition );
+    struct sb_transition *st;
+
+    if (!var || !t) return E_INVALIDARG;
+    if (This->status != UI_ANIMATION_STORYBOARD_BUILDING) return UI_E_STORYBOARD_ACTIVE;
+    if (var->dim != t->dim) return E_INVALIDARG;
+    if (t->scheduled) return UI_E_TRANSITION_ALREADY_USED;
+    if (!(st = calloc( 1, sizeof(*st) ))) return E_OUTOFMEMORY;
+    st->transition = t;
+    st->variable = var;
+    st->start_keyframe = start_keyframe;
+    st->end_keyframe = end_keyframe;
+    IUIAnimationTransition2_AddRef( transition );
+    IUIAnimationVariable2_AddRef( variable );
+    list_add_tail( &This->transitions, &st->entry );
+    This->transition_count++;
+    return S_OK;
+}
