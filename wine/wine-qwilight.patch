+HRESULT create_transform_group(IUnknown **members, UINT count, BOOL is_3d, void **out)
+{
+    struct composition_transform_group *object;
+    UINT i;
+
+    if (!out || (count && !members))
+        return E_INVALIDARG;
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    if (count && !(object->members = calloc(count, sizeof(*object->members))))
+    {
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+    object->IUnknown_iface.lpVtbl = &transform_group_vtbl;
+    object->ref = 1;
+    object->is_3d = is_3d;
+    object->count = count;
+    for (i = 0; i < count; ++i)
+        if ((object->members[i] = members[i])) IUnknown_AddRef(members[i]);
+    *out = &object->IUnknown_iface;
+    return S_OK;
+}
