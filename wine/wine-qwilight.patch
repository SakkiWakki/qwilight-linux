+static HRESULT WINAPI effect_brush_SetSourceParameter( ICompositionEffectBrush *iface, HSTRING name,
+                                                       ICompositionBrush *source )
+{
+    struct effect_brush *impl = impl_from_ICompositionEffectBrush( iface );
+    struct effect_source_binding *binding;
+    HRESULT hr;
+
+    TRACE( "iface %p, name %s, source %p.\n", iface, debugstr_hstring( name ), source );
+
+    if (!(binding = effect_brush_find_source( impl, name )))
+    {
+        if (!(binding = calloc( 1, sizeof(*binding) ))) return E_OUTOFMEMORY;
+        if (FAILED(hr = WindowsDuplicateString( name, &binding->name )))
+        {
