+static void CALLBACK threadpool_timer_callback(TP_CALLBACK_INSTANCE *instance, void *context, TP_TIMER *tp_timer)
+{
+    struct threadpool_timer *timer = context;
+    HRESULT hr;
+
+    TRACE("timer %p, tp_timer %p.\n", timer, tp_timer);
+
+    if (timer->state != TIMER_STATE_ARMED)
+        return;
+
+    hr = ITimerElapsedHandler_Invoke(timer->handler, &timer->IThreadPoolTimer_iface);
+    if (FAILED(hr)) WARN("Elapsed handler for timer %p returned %#lx.\n", timer, hr);
+
+    if (!timer->periodic)
+        threadpool_timer_finish(timer);
+}
+
+static void CALLBACK threadpool_timer_finalize(TP_CALLBACK_INSTANCE *instance, void *context, TP_WORK *work)
+{
+    struct threadpool_timer *timer = context;
+    HRESULT hr;
+
+    TRACE("timer %p, work %p.\n", timer, work);
+
+    /* Runs on its own pool thread, so waiting here is safe even when Cancel() was called
+     * from inside the elapsed handler. */
+    WaitForThreadpoolTimerCallbacks(timer->tp_timer, TRUE);
+    CloseThreadpoolTimer(timer->tp_timer);
+    timer->tp_timer = NULL;
+
+    ITimerElapsedHandler_Release(timer->handler);
+    timer->handler = NULL;
+
+    if (timer->destroyed)
+    {
+        hr = ITimerDestroyedHandler_Invoke(timer->destroyed, &timer->IThreadPoolTimer_iface);
+        if (FAILED(hr)) WARN("Destroyed handler for timer %p returned %#lx.\n", timer, hr);
+        ITimerDestroyedHandler_Release(timer->destroyed);
+        timer->destroyed = NULL;
+    }
+
+    /* Closing the work object from its own callback is allowed. */
+    CloseThreadpoolWork(work);
+    timer->finalizer = NULL;
+
+    IThreadPoolTimer_Release(&timer->IThreadPoolTimer_iface);
+}
+
+static HRESULT threadpool_timer_create(ITimerElapsedHandler *handler, TimeSpan interval, BOOL periodic,
+        ITimerDestroyedHandler *destroyed, IThreadPoolTimer **ret)
+{
+    struct threadpool_timer *timer;
+    LARGE_INTEGER due;
+    FILETIME due_time;
+    DWORD period_ms = 0;
+
+    *ret = NULL;
+
+    if (!handler)
+        return E_INVALIDARG;
+
+    if (periodic)
+    {
+        /* A period of zero would be a one-shot timer for SetThreadpoolTimer(). */
+        if (interval.Duration <= 0)
+            return E_INVALIDARG;
+        period_ms = (interval.Duration + 9999) / 10000;
+        if (!period_ms) period_ms = 1;
+    }
+    else if (interval.Duration < 0)
+    {
+        interval.Duration = 0;
+    }
+
+    if (!(timer = calloc(1, sizeof(*timer))))
+        return E_OUTOFMEMORY;
+
+    timer->IThreadPoolTimer_iface.lpVtbl = &threadpool_timer_vtbl;
+    timer->refcount = 1;
+    timer->periodic = periodic;
+    if (periodic)
+        timer->period = interval;
+    timer->delay = interval;
+    timer->state = TIMER_STATE_ARMED;
+
+    if (!(timer->tp_timer = CreateThreadpoolTimer(threadpool_timer_callback, timer, NULL))
+            || !(timer->finalizer = CreateThreadpoolWork(threadpool_timer_finalize, timer, NULL)))
+    {
+        WARN("Failed to create thread pool objects, error %lu.\n", GetLastError());
+        IThreadPoolTimer_Release(&timer->IThreadPoolTimer_iface);
+        return E_FAIL;
+    }
+
+    ITimerElapsedHandler_AddRef((timer->handler = handler));
+    if (destroyed)
+        ITimerDestroyedHandler_AddRef((timer->destroyed = destroyed));
+
+    /* Reference held while armed, released by the finalizer. */
+    IThreadPoolTimer_AddRef(&timer->IThreadPoolTimer_iface);
+    IThreadPoolTimer_AddRef((*ret = &timer->IThreadPoolTimer_iface));
+    IThreadPoolTimer_Release(&timer->IThreadPoolTimer_iface);
+
+    /* Negative due time is relative to now, in 100 ns units like TimeSpan. */
+    due.QuadPart = -interval.Duration;
+    due_time.dwLowDateTime = due.LowPart;
+    due_time.dwHighDateTime = due.HighPart;
+    SetThreadpoolTimer(timer->tp_timer, &due_time, period_ms, 0);
+
+    return S_OK;
+}
