+static HRESULT STDMETHODCALLTYPE effect_group_QueryInterface(IDCompositionEffectGroup *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDCompositionEffect)
+            || IsEqualGUID(iid, &IID_IDCompositionEffectGroup))
+    {
+        IDCompositionEffectGroup_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE effect_group_AddRef(IDCompositionEffectGroup *iface)
+{
+    struct composition_effect_group *group = impl_from_IDCompositionEffectGroup(iface);
+    ULONG ref = InterlockedIncrement(&group->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG STDMETHODCALLTYPE effect_group_Release(IDCompositionEffectGroup *iface)
+{
+    struct composition_effect_group *group = impl_from_IDCompositionEffectGroup(iface);
+    ULONG ref = InterlockedDecrement(&group->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    if (!ref)
+    {
+        if (group->transform_3d) IUnknown_Release(group->transform_3d);
+        free(group);
+    }
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE effect_group_SetOpacity(IDCompositionEffectGroup *iface, float opacity)
+{
+    struct composition_effect_group *group = impl_from_IDCompositionEffectGroup(iface);
+
+    TRACE("iface %p, opacity %f.\n", iface, opacity);
+    dcomp_lock();
+    group->opacity = opacity;
+    dcomp_unlock();
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE effect_group_SetOpacityAnimation(IDCompositionEffectGroup *iface,
+        IDCompositionAnimation *animation)
+{
+    float value;
+
+    TRACE("iface %p, animation %p.\n", iface, animation);
+    if (!animation) return E_INVALIDARG;
+    if (!dcomp_animation_get_value(animation, &value)) return S_OK;
+    return effect_group_SetOpacity(iface, value);
+}
+
+static HRESULT STDMETHODCALLTYPE effect_group_SetTransform3D(IDCompositionEffectGroup *iface,
+        IDCompositionTransform3D *transform)
+{
+    struct composition_effect_group *group = impl_from_IDCompositionEffectGroup(iface);
+
+    TRACE("iface %p, transform %p.\n", iface, transform);
+    dcomp_lock();
+    if (transform) IDCompositionTransform3D_AddRef(transform);
+    if (group->transform_3d) IUnknown_Release(group->transform_3d);
+    group->transform_3d = (IUnknown *)transform;
+    dcomp_unlock();
+    return S_OK;
+}
+
+static const struct IDCompositionEffectGroupVtbl effect_group_vtbl =
+{
+    effect_group_QueryInterface,
+    effect_group_AddRef,
+    effect_group_Release,
+    effect_group_SetOpacityAnimation,
+    effect_group_SetOpacity,
+    effect_group_SetTransform3D,
+};
+
+HRESULT create_effect_group(IDCompositionEffectGroup **group)
+{
+    struct composition_effect_group *object;
+
+    if (!group)
+        return E_INVALIDARG;
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IDCompositionEffectGroup_iface.lpVtbl = &effect_group_vtbl;
+    object->ref = 1;
+    object->opacity = 1.0f;
+    *group = &object->IDCompositionEffectGroup_iface;
+    return S_OK;
+}
+
+/* The opacity an effect object applies, 1 for anything else. */
+float dcomp_effect_get_opacity(IUnknown *unknown)
+{
+    if (!unknown || ((IDCompositionEffectGroup *)unknown)->lpVtbl != &effect_group_vtbl)
+        return 1.0f;
+    return impl_from_IDCompositionEffectGroup((IDCompositionEffectGroup *)unknown)->opacity;
+}
+
+/* ---------------------------------------------------------------- animation */
+
+static HRESULT STDMETHODCALLTYPE animation_QueryInterface(IDCompositionAnimation *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDCompositionAnimation))
+    {
+        IDCompositionAnimation_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE animation_AddRef(IDCompositionAnimation *iface)
+{
+    struct composition_animation *animation = impl_from_IDCompositionAnimation(iface);
+    ULONG ref = InterlockedIncrement(&animation->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG STDMETHODCALLTYPE animation_Release(IDCompositionAnimation *iface)
+{
+    struct composition_animation *animation = impl_from_IDCompositionAnimation(iface);
+    ULONG ref = InterlockedDecrement(&animation->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    if (!ref)
+        free(animation);
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE animation_Reset(IDCompositionAnimation *iface)
+{
+    struct composition_animation *animation = impl_from_IDCompositionAnimation(iface);
+
+    TRACE("iface %p.\n", iface);
+    animation->has_value = FALSE;
+    animation->ended = FALSE;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE animation_SetAbsoluteBeginTime(IDCompositionAnimation *iface, LARGE_INTEGER time)
+{
+    TRACE("iface %p, time %I64d.\n", iface, time.QuadPart);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE animation_AddCubic(IDCompositionAnimation *iface, double offset,
+        float constant, float linear, float quadratic, float cubic)
+{
+    struct composition_animation *animation = impl_from_IDCompositionAnimation(iface);
+
+    TRACE("iface %p, offset %f, coefficients %f %f %f %f.\n", iface, offset, constant, linear, quadratic, cubic);
+    if (animation->ended) return E_INVALIDARG;
+    /* the last segment's constant term wins until End() gives the real end value */
+    animation->has_value = TRUE;
+    animation->value = constant;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE animation_AddSinusoidal(IDCompositionAnimation *iface, double offset,
+        float bias, float amplitude, float frequency, float phase)
+{
+    struct composition_animation *animation = impl_from_IDCompositionAnimation(iface);
+
+    TRACE("iface %p, offset %f, bias %f, amplitude %f, frequency %f, phase %f.\n", iface, offset, bias,
+          amplitude, frequency, phase);
+    if (animation->ended) return E_INVALIDARG;
+    animation->has_value = TRUE;
+    animation->value = bias;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE animation_AddRepeat(IDCompositionAnimation *iface, double offset, double duration)
+{
+    TRACE("iface %p, offset %f, duration %f.\n", iface, offset, duration);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE animation_End(IDCompositionAnimation *iface, double offset, float value)
+{
+    struct composition_animation *animation = impl_from_IDCompositionAnimation(iface);
+
+    TRACE("iface %p, offset %f, value %f.\n", iface, offset, value);
+    if (animation->ended) return E_INVALIDARG;
+    animation->has_value = TRUE;
+    animation->value = value;
+    animation->ended = TRUE;
+    return S_OK;
+}
+
+static const struct IDCompositionAnimationVtbl animation_vtbl =
+{
+    animation_QueryInterface,
+    animation_AddRef,
+    animation_Release,
+    animation_Reset,
+    animation_SetAbsoluteBeginTime,
+    animation_AddCubic,
+    animation_AddSinusoidal,
+    animation_AddRepeat,
+    animation_End,
+};
+
+HRESULT create_animation(IDCompositionAnimation **animation)
+{
+    struct composition_animation *object;
+
+    if (!animation)
+        return E_INVALIDARG;
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+    object->IDCompositionAnimation_iface.lpVtbl = &animation_vtbl;
+    object->ref = 1;
+    *animation = &object->IDCompositionAnimation_iface;
+    return S_OK;
+}
+
+/* The composite matrix of the objects above (called from dcomp_transform_get_matrix()). */
+static BOOL dcomp_transform_get_matrix_ex(IUnknown *unknown, D2D_MATRIX_3X2_F *matrix, unsigned int depth)
+{
+    if (!unknown || depth > 16)
+        return FALSE;
+    if (((IUnknown *)unknown)->lpVtbl == (const IUnknownVtbl *)&property_transform_vtbl)
+        return property_transform_get_matrix(impl_from_property_transform(unknown), matrix);
+    if (unknown->lpVtbl == &transform_group_vtbl)
+    {
+        struct composition_transform_group *group = impl_from_transform_group(unknown);
+        D2D_MATRIX_3X2_F m;
+        UINT i;
+
+        matrix->_11 = matrix->_22 = 1.0f;
+        matrix->_12 = matrix->_21 = matrix->_31 = matrix->_32 = 0.0f;
+        for (i = 0; i < group->count; ++i)
+        {
+            if (!group->members[i]) continue;
+            if (!dcomp_transform_get_matrix(group->members[i], &m)
+                    && !dcomp_transform_get_matrix_ex(group->members[i], &m, depth + 1))
+            {
+                WARN("Group member %p is not one of our transforms.\n", group->members[i]);
+                continue;
+            }
+            transform_matrix_multiply(matrix, matrix, &m);
+        }
+        return TRUE;
+    }
+    if (((IDCompositionEffectGroup *)unknown)->lpVtbl == &effect_group_vtbl)
+    {
+        struct composition_effect_group *group = impl_from_IDCompositionEffectGroup((IDCompositionEffectGroup *)unknown);
+        if (!group->transform_3d)
+            return FALSE;
+        return dcomp_transform_get_matrix(group->transform_3d, matrix)
+                || dcomp_transform_get_matrix_ex(group->transform_3d, matrix, depth + 1);
+    }
+    return FALSE;
+}
