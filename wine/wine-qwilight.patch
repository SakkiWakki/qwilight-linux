+    TRACE("iface %p, value %p.\n", iface, value);
+
+    *value = timer->period;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE threadpool_timer_get_Delay(IThreadPoolTimer *iface, TimeSpan *value)
+{
+    struct threadpool_timer *timer = impl_from_IThreadPoolTimer(iface);
+
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    *value = timer->delay;
+    return S_OK;
+}
+
+/* Called at most once per timer, from any thread. Disarms the TP timer and queues the
+ * finalizer, which owns the "armed" reference from now on. */
+static void threadpool_timer_finish(struct threadpool_timer *timer)
+{
+    if (InterlockedCompareExchange(&timer->state, TIMER_STATE_DONE, TIMER_STATE_ARMED) != TIMER_STATE_ARMED)
+        return;
+
+    SetThreadpoolTimer(timer->tp_timer, NULL, 0, 0);
+    SubmitThreadpoolWork(timer->finalizer);
+}
+
+static HRESULT STDMETHODCALLTYPE threadpool_timer_Cancel(IThreadPoolTimer *iface)
+{
+    struct threadpool_timer *timer = impl_from_IThreadPoolTimer(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    threadpool_timer_finish(timer);
+    return S_OK;
+}
