+static HRESULT WINAPI content_TryComputeLength( IHttpContent *iface, UINT64 *length, boolean *succeeded )
+{
+    struct http_content *impl = impl_from_IHttpContent( iface );
+    UINT32 len = 0;
+
+    TRACE( "iface %p, length %p, succeeded %p.\n", iface, length, succeeded );
+
+    if (!length || !succeeded) return E_POINTER;
+
+    if (impl->kind == CONTENT_BUFFER) len = impl->count;
+    else if (impl->kind == CONTENT_BYTES) len = impl->size;
+    else WindowsGetStringRawBuffer( impl->text, &len );
