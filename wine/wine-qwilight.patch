+/*
+ * The Windows.UI.Composition.Compositor activation factory.
+ */
+struct compositor_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IInteropCompositorFactoryPartner IInteropCompositorFactoryPartner_iface;
+    ICompositorFactoryCoreMessagingInterop ICompositorFactoryCoreMessagingInterop_iface;
+    LONG ref;
+};
