--- a/dlls/bcp47mrm/main.c
+++ b/dlls/bcp47mrm/main.c
@@ -1,7 +1,7 @@
 /*
  * BCP-47 multilingual resource management
  *
- * Copyright 2026 Claude for the Wine project
+ * Copyright 2026 for the Wine project
  *
  * This library is free software; you can redistribute it and/or
  * modify it under the terms of the GNU Lesser General Public
@@ -58,3 +58,65 @@ BOOL WINAPI IsWellFormedTag( const WCHAR *tag )
 
     return subtag_len && subtag_len <= 8;
 }
+
+/* Distance between two BCP-47 tags: 0 is an exact match, 1 is unrelated. Tags
+ * sharing the primary language subtag are close, the more subtags they share
+ * after it the closer. */
+static double language_distance( const WCHAR *a, const WCHAR *b )
+{
+    unsigned int common = 0, total = 0;
+    const WCHAR *pa = a, *pb = b;
+
+    if (!wcsicmp( a, b )) return 0.0;
+
+    for (;;)
+    {
+        const WCHAR *ea = wcschr( pa, '-' ), *eb = wcschr( pb, '-' );
+        size_t la = ea ? (size_t)(ea - pa) : wcslen( pa ), lb = eb ? (size_t)(eb - pb) : wcslen( pb );
+
+        if (!total && (la != lb || wcsnicmp( pa, pb, la ))) return 1.0;  /* primary language differs */
+        if (la == lb && !wcsnicmp( pa, pb, la )) common++;
+        else break;
+        total++;
+        if (!ea || !eb) break;
+        pa = ea + 1;
+        pb = eb + 1;
+    }
+    /* same language, differing or missing region / script: closer than unrelated */
+    return common > 1 ? 0.1 : 0.2;
+}
+
+/***********************************************************************
+ *      GetDistanceOfClosestLanguageInList (bcp47mrm.@)
+ */
+HRESULT WINAPI GetDistanceOfClosestLanguageInList( const WCHAR *language, const WCHAR *list, WCHAR delimiter,
+                                                   double *closest )
+{
+    double best = 1.0;
+    const WCHAR *p = list;
+
+    TRACE( "language %s, list %s, delimiter %s, closest %p.\n", debugstr_w( language ), debugstr_w( list ),
+           debugstr_wn( &delimiter, 1 ), closest );
+
+    if (!language || !list || !closest) return E_INVALIDARG;
+
+    while (*p)
+    {
+        const WCHAR *end = wcschr( p, delimiter );
+        size_t len = end ? (size_t)(end - p) : wcslen( p );
+        WCHAR tag[128];
+
+        if (len && len < ARRAY_SIZE(tag))
+        {
+            double d;
+            memcpy( tag, p, len * sizeof(WCHAR) );
+            tag[len] = 0;
+            if ((d = language_distance( language, tag )) < best) best = d;
+        }
+        if (!end) break;
+        p = end + 1;
+    }
+
+    *closest = best;
+    return S_OK;
+}
