+static void wined3d_cs_exec_set_guard_rect(struct wined3d_cs *cs, const void *data)
+{
+    const struct wined3d_cs_set_guard_rect *op = data;
+    struct wined3d_texture *texture = op->texture;
+
+    texture->async.guard_rect = op->rect;
+    texture->async.guard_rect_set = op->set;
+    /* The scissor state of any context rendering into this texture is stale now. */
+    device_invalidate_state(cs->c.device, STATE_RASTERIZER);
+    device_invalidate_state(cs->c.device, STATE_SCISSORRECT);
+}
+
+void wined3d_cs_emit_set_guard_rect(struct wined3d_cs *cs, struct wined3d_texture *texture, const RECT *rect)
+{
+    struct wined3d_cs_set_guard_rect *op;
+
+    op = wined3d_device_context_require_space(&cs->c, sizeof(*op), WINED3D_CS_QUEUE_DEFAULT);
+    op->opcode = WINED3D_CS_OP_SET_GUARD_RECT;
+    op->texture = texture;
+    if (rect)
+        op->rect = *rect;
+    else
+        SetRectEmpty(&op->rect);
+    op->set = !!rect;
+
+    wined3d_device_context_submit(&cs->c, WINED3D_CS_QUEUE_DEFAULT);
+}
