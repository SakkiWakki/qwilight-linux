+
+#include "private.h"
+#include "robuffer.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(http);
+
+/*
+ * Windows.Web.Http.HttpMethod
+ */
+struct http_method
+{
+    IHttpMethod IHttpMethod_iface;
+    LONG ref;
+
+    HSTRING method;
+};
+
+static inline struct http_method *impl_from_IHttpMethod( IHttpMethod *iface )
+{
+    return CONTAINING_RECORD( iface, struct http_method, IHttpMethod_iface );
+}
+
+static HRESULT WINAPI method_QueryInterface( IHttpMethod *iface, REFIID iid, void **out )
+{
+    struct http_method *impl = impl_from_IHttpMethod( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IHttpMethod ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IHttpMethod_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI method_AddRef( IHttpMethod *iface )
+{
+    struct http_method *impl = impl_from_IHttpMethod( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI method_Release( IHttpMethod *iface )
+{
+    struct http_method *impl = impl_from_IHttpMethod( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->method );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI method_GetIids( IHttpMethod *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI method_GetRuntimeClassName( IHttpMethod *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Web_Http_HttpMethod,
+                                ARRAY_SIZE(RuntimeClass_Windows_Web_Http_HttpMethod) - 1, class_name );
+}
+
+static HRESULT WINAPI method_GetTrustLevel( IHttpMethod *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI method_get_Method( IHttpMethod *iface, HSTRING *value )
+{
+    struct http_method *impl = impl_from_IHttpMethod( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl->method, value );
+}
+
+static const struct IHttpMethodVtbl method_vtbl =
+{
+    method_QueryInterface,
+    method_AddRef,
+    method_Release,
+    /* IInspectable */
+    method_GetIids,
+    method_GetRuntimeClassName,
+    method_GetTrustLevel,
+    /* IHttpMethod */
+    method_get_Method,
+};
+
+HRESULT http_method_create( HSTRING method, IHttpMethod **out )
+{
+    struct http_method *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IHttpMethod_iface.lpVtbl = &method_vtbl;
+    impl->ref = 1;
+
+    if (FAILED(hr = WindowsDuplicateString( method, &impl->method )))
+    {
+        free( impl );
+        return hr;
+    }
+
+    *out = &impl->IHttpMethod_iface;
+    TRACE( "created HttpMethod %p (%s).\n", *out, debugstr_hstring( method ) );
+    return S_OK;
+}
+
+static HRESULT http_method_create_from_wstr( const WCHAR *verb, IHttpMethod **out )
+{
+    HSTRING str;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsCreateString( verb, wcslen( verb ), &str ))) return hr;
+    hr = http_method_create( str, out );
+    WindowsDeleteString( str );
+    return hr;
+}
+
+/*
+ * Windows.Web.Http.HttpMethod activation factory + statics
+ */
+struct method_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IHttpMethodFactory IHttpMethodFactory_iface;
+    IHttpMethodStatics IHttpMethodStatics_iface;
+    LONG ref;
+};
+
+static inline struct method_factory *method_factory_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct method_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI method_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct method_factory *impl = method_factory_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IActivationFactory_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IHttpMethodFactory ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IHttpMethodFactory_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IHttpMethodStatics ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IHttpMethodStatics_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI method_factory_AddRef( IActivationFactory *iface )
+{
+    struct method_factory *impl = method_factory_from_IActivationFactory( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI method_factory_Release( IActivationFactory *iface )
+{
+    struct method_factory *impl = method_factory_from_IActivationFactory( iface );
+    return InterlockedDecrement( &impl->ref );
+}
+
+static HRESULT WINAPI method_factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI method_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Web_Http_HttpMethod,
+                                ARRAY_SIZE(RuntimeClass_Windows_Web_Http_HttpMethod) - 1, class_name );
+}
+
+static HRESULT WINAPI method_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI method_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* HttpMethod has no default constructor. */
+    WARN( "iface %p, instance %p: not activatable.\n", iface, instance );
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl method_factory_vtbl =
+{
+    method_factory_QueryInterface,
+    method_factory_AddRef,
+    method_factory_Release,
+    /* IInspectable */
+    method_factory_GetIids,
+    method_factory_GetRuntimeClassName,
+    method_factory_GetTrustLevel,
+    /* IActivationFactory */
+    method_factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( method_create_factory, IHttpMethodFactory, struct method_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI method_create_factory_Create( IHttpMethodFactory *iface, HSTRING method, IHttpMethod **value )
+{
+    TRACE( "iface %p, method %s, value %p.\n", iface, debugstr_hstring( method ), value );
+    if (!value) return E_POINTER;
+    return http_method_create( method, value );
+}
+
+static const struct IHttpMethodFactoryVtbl method_create_factory_vtbl =
+{
+    method_create_factory_QueryInterface,
+    method_create_factory_AddRef,
+    method_create_factory_Release,
+    /* IInspectable */
+    method_create_factory_GetIids,
+    method_create_factory_GetRuntimeClassName,
+    method_create_factory_GetTrustLevel,
+    /* IHttpMethodFactory */
+    method_create_factory_Create,
+};
+
+DEFINE_IINSPECTABLE( method_statics, IHttpMethodStatics, struct method_factory, IActivationFactory_iface )
+
+/* Windows hands out a per-verb singleton here.  A fresh object per call is
+ * indistinguishable to every caller seen so far (the value is read through
+ * IHttpMethod::get_Method, never compared by identity) and needs no locking. */
+#define DEFINE_METHOD_STATIC( name, verb )                                                         \
+    static HRESULT WINAPI method_statics_get_##name( IHttpMethodStatics *iface, IHttpMethod **value ) \
+    {                                                                                              \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (!value) return E_POINTER;                                                              \
+        return http_method_create_from_wstr( verb, value );                                        \
+    }
+
+DEFINE_METHOD_STATIC( Delete, L"DELETE" )
+DEFINE_METHOD_STATIC( Get, L"GET" )
+DEFINE_METHOD_STATIC( Head, L"HEAD" )
+DEFINE_METHOD_STATIC( Options, L"OPTIONS" )
+DEFINE_METHOD_STATIC( Patch, L"PATCH" )
+DEFINE_METHOD_STATIC( Post, L"POST" )
+DEFINE_METHOD_STATIC( Put, L"PUT" )
+
+static const struct IHttpMethodStaticsVtbl method_statics_vtbl =
+{
+    method_statics_QueryInterface,
+    method_statics_AddRef,
+    method_statics_Release,
+    /* IInspectable */
+    method_statics_GetIids,
+    method_statics_GetRuntimeClassName,
+    method_statics_GetTrustLevel,
+    /* IHttpMethodStatics */
+    method_statics_get_Delete,
+    method_statics_get_Get,
+    method_statics_get_Head,
+    method_statics_get_Options,
