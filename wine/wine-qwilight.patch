+static HRESULT http_content_create( enum content_kind kind, struct http_content **out )
+{
+    struct http_content *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IHttpContent_iface.lpVtbl = &content_vtbl;
+    impl->IClosable_iface.lpVtbl = &content_closable_vtbl;
+    impl->ref = 1;
+    impl->kind = kind;
+
+    if (FAILED(hr = content_headers_create( &impl->headers )))
+    {
+        free( impl );
+        return hr;
+    }
+
+    *out = impl;
+    return S_OK;
+}
+
+static HRESULT http_string_content_create( HSTRING text, HSTRING media_type, IHttpContent **out )
+{
+    struct http_content *impl;
+    HRESULT hr;
+
+    if (FAILED(hr = http_content_create( CONTENT_STRING, &impl ))) return hr;
+    if (FAILED(hr = WindowsDuplicateString( text, &impl->text )))
+    {
+        IHttpContent_Release( &impl->IHttpContent_iface );
+        return hr;
+    }
+
+    /* The media type belongs in Content-Type; record it as a plain header until
+     * HttpMediaTypeHeaderValue exists. */
+    if (media_type)
+    {
+        HSTRING name;
+
+        if (SUCCEEDED(WindowsCreateString( L"Content-Type", ARRAY_SIZE(L"Content-Type") - 1, &name )))
+        {
+            IHttpContentHeaderCollection_Append( impl->headers, name, media_type );
+            WindowsDeleteString( name );
+        }
+    }
+
+    *out = &impl->IHttpContent_iface;
+    TRACE( "created HttpStringContent %p.\n", *out );
+    return S_OK;
+}
+
+static HRESULT http_buffer_content_create( IBuffer *buffer, UINT32 offset, UINT32 count, IHttpContent **out )
+{
+    struct http_content *impl;
+    HRESULT hr;
+
+    if (FAILED(hr = http_content_create( CONTENT_BUFFER, &impl ))) return hr;
+    if ((impl->buffer = buffer)) IBuffer_AddRef( impl->buffer );
+    impl->offset = offset;
+    impl->count = count;
+
+    *out = &impl->IHttpContent_iface;
+    TRACE( "created HttpBufferContent %p.\n", *out );
+    return S_OK;
+}
+
+HRESULT http_bytes_content_create( const void *data, UINT32 size, IHttpContent **out )
+{
+    struct http_content *impl;
+    HRESULT hr;
+
+    if (FAILED(hr = http_content_create( CONTENT_BYTES, &impl ))) return hr;
+    if (!(impl->data = malloc( size ? size : 1 )))
+    {
+        IHttpContent_Release( &impl->IHttpContent_iface );
+        return E_OUTOFMEMORY;
+    }
+    if (size) memcpy( impl->data, data, size );
+    impl->size = size;
+    *out = &impl->IHttpContent_iface;
+    TRACE( "created byte content %p, %u bytes.\n", *out, size );
+    return S_OK;
+}
