+/* Take the error the thread currently holds, if any. */
+static HRESULT take_restricted_error_(int line, HRESULT *error, BSTR *description)
+{
+    BSTR restricted_description = NULL, capability_sid = NULL;
+    IRestrictedErrorInfo *info = NULL;
+    HRESULT hr;
+
+    *error = 0xdeadbeef;
+    *description = NULL;
+
+    hr = GetRestrictedErrorInfo(&info);
+    if (hr != S_OK)
+    {
+        ok_(__FILE__, line)(!info, "Got unexpected info %p.\n", info);
+        return hr;
+    }
+
+    hr = IRestrictedErrorInfo_GetErrorDetails(info, description, error, &restricted_description, &capability_sid);
+    ok_(__FILE__, line)(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    SysFreeString(restricted_description);
+    SysFreeString(capability_sid);
+    IRestrictedErrorInfo_Release(info);
+    return S_OK;
+}
+#define take_restricted_error(a, b) take_restricted_error_(__LINE__, a, b)
+
+static void test_RoTransformError(void)
+{
+    HRESULT hr, error;
+    BSTR description;
+    HSTRING message;
+    BOOL ret;
+
+    RoClearError();
+
+    /* With nothing stored, the transform originates the new error. */
+    ret = RoTransformError(S_OK, E_FAIL, NULL);
+    ok(ret, "Got unexpected ret %d.\n", ret);
+    hr = take_restricted_error(&error, &description);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(error == E_FAIL, "Got unexpected error %#lx.\n", error);
+    SysFreeString(description);
+
+    /* A matching error is replaced and keeps its description. */
+    RoOriginateErrorW(E_FAIL, 0, L"boom");
+    ret = RoTransformError(E_FAIL, E_ACCESSDENIED, NULL);
+    ok(ret, "Got unexpected ret %d.\n", ret);
+    hr = take_restricted_error(&error, &description);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(error == E_ACCESSDENIED, "Got unexpected error %#lx.\n", error);
+    ok(!lstrcmpW(description, L"boom"), "Got unexpected description %s.\n", wine_dbgstr_w(description));
+    SysFreeString(description);
+
+    /* An unrelated error is left alone. */
+    RoOriginateErrorW(E_FAIL, 0, L"boom");
+    ret = RoTransformError(E_NOTIMPL, E_ACCESSDENIED, NULL);
+    ok(!ret, "Got unexpected ret %d.\n", ret);
+    hr = take_restricted_error(&error, &description);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(error == E_FAIL, "Got unexpected error %#lx.\n", error);
+    SysFreeString(description);
+
+    /* A success code is never originated. */
+    ret = RoTransformError(S_OK, S_OK, NULL);
+    ok(!ret, "Got unexpected ret %d.\n", ret);
+    hr = take_restricted_error(&error, &description);
+    ok(hr == S_FALSE, "Got unexpected hr %#lx.\n", hr);
+
+    /* An explicit message replaces the stored one. */
+    hr = WindowsCreateString(L"transformed", 11, &message);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    RoOriginateErrorW(E_FAIL, 0, L"boom");
+    ret = RoTransformError(E_FAIL, E_ACCESSDENIED, message);
+    ok(ret, "Got unexpected ret %d.\n", ret);
+    WindowsDeleteString(message);
+    hr = take_restricted_error(&error, &description);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(error == E_ACCESSDENIED, "Got unexpected error %#lx.\n", error);
+    ok(!lstrcmpW(description, L"transformed"), "Got unexpected description %s.\n", wine_dbgstr_w(description));
+    SysFreeString(description);
+
+    /* And the wide variant. */
+    RoOriginateErrorW(E_FAIL, 0, L"boom");
+    ret = RoTransformErrorW(E_FAIL, E_ACCESSDENIED, 0, L"rpc unavailable");
+    ok(ret, "Got unexpected ret %d.\n", ret);
+    hr = take_restricted_error(&error, &description);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(error == E_ACCESSDENIED, "Got unexpected error %#lx.\n", error);
+    ok(!lstrcmpW(description, L"rpc unavailable"), "Got unexpected description %s.\n", wine_dbgstr_w(description));
+    SysFreeString(description);
+
+    RoClearError();
+}
+
+static void test_RoGetMatchingRestrictedErrorInfo(void)
+{
+    BSTR description = NULL, restricted_description = NULL, capability_sid = NULL;
+    IRestrictedErrorInfo *info;
+    HRESULT hr, error;
+
+    RoClearError();
+
+    info = (void *)0xdeadbeef;
+    hr = RoGetMatchingRestrictedErrorInfo(E_FAIL, &info);
+    ok(hr == S_FALSE, "Got unexpected hr %#lx.\n", hr);
+    ok(!info, "Got unexpected info %p.\n", info);
+
+    hr = RoGetMatchingRestrictedErrorInfo(E_FAIL, NULL);
+    ok(hr == E_INVALIDARG, "Got unexpected hr %#lx.\n", hr);
+
+    RoOriginateErrorW(E_FAIL, 0, L"match me");
+
+    info = (void *)0xdeadbeef;
+    hr = RoGetMatchingRestrictedErrorInfo(E_ACCESSDENIED, &info);
+    ok(hr == S_FALSE, "Got unexpected hr %#lx.\n", hr);
+    ok(!info, "Got unexpected info %p.\n", info);
+
+    info = NULL;
+    hr = RoGetMatchingRestrictedErrorInfo(E_FAIL, &info);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!!info, "Got unexpected info %p.\n", info);
+
+    hr = IRestrictedErrorInfo_GetErrorDetails(info, &description, &error, &restricted_description, &capability_sid);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(error == E_FAIL, "Got unexpected error %#lx.\n", error);
+    ok(!lstrcmpW(description, L"match me"), "Got unexpected description %s.\n", wine_dbgstr_w(description));
+    SysFreeString(description);
+    SysFreeString(restricted_description);
+    SysFreeString(capability_sid);
+    IRestrictedErrorInfo_Release(info);
+
+    /* A match hands the error over and clears it. */
+    info = (void *)0xdeadbeef;
+    hr = RoGetMatchingRestrictedErrorInfo(E_FAIL, &info);
+    ok(hr == S_FALSE, "Got unexpected hr %#lx.\n", hr);
+    ok(!info, "Got unexpected info %p.\n", info);
+}
