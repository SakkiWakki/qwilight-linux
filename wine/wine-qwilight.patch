+static LRESULT CALLBACK dispatcher_queue_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    IDispatcherQueueHandler *callback;
+    HRESULT hr;
+
+    if (msg != WM_WINE_DISPATCHER_QUEUE_INVOKE) return DefWindowProcW( hwnd, msg, wparam, lparam );
+
+    callback = (IDispatcherQueueHandler *)lparam;
+    TRACE( "hwnd %p, invoking callback %p.\n", hwnd, callback );
+    if (FAILED(hr = IDispatcherQueueHandler_Invoke( callback ))) WARN( "callback %p returned %#lx.\n", callback, hr );
