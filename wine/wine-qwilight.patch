+/* Create a queue and, when thread_id is non-zero, bind it to that thread. Only the calling
+ * thread can be bound, as the message-only window has to be created on it. */
+static HRESULT dispatcher_queue_create( DWORD thread_id, IDispatcherQueue **out )
+{
+    struct dispatcher_queue *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IDispatcherQueue_iface.lpVtbl = &dispatcher_queue_vtbl;
+    impl->IDispatcherQueue2_iface.lpVtbl = &dispatcher_queue2_vtbl;
+    impl->ref = 1;
+
+    if (thread_id)
+    {
+        assert( thread_id == GetCurrentThreadId() );
+        if (!(impl->hwnd = dispatcher_queue_create_window()))
+        {
+            free( impl );
+            return HRESULT_FROM_WIN32( GetLastError() );
+        }
+        impl->thread_id = thread_id;
+        EnterCriticalSection( &queue_cs );
+        list_add_head( &thread_queues, &impl->entry );
+        LeaveCriticalSection( &queue_cs );
+    }
+
+    TRACE( "created IDispatcherQueue %p for thread %#lx.\n", &impl->IDispatcherQueue_iface, thread_id );
+    *out = &impl->IDispatcherQueue_iface;
+    return S_OK;
+}
+
+/* Returns the queue bound to the calling thread, AddRef'ed, or NULL when the thread has none. */
+static IDispatcherQueue *dispatcher_queue_for_current_thread(void)
+{
+    DWORD thread_id = GetCurrentThreadId();
+    struct dispatcher_queue *impl;
+    IDispatcherQueue *queue = NULL;
+
+    EnterCriticalSection( &queue_cs );
+    LIST_FOR_EACH_ENTRY( impl, &thread_queues, struct dispatcher_queue, entry )
+    {
+        if (impl->thread_id != thread_id) continue;
+        queue = &impl->IDispatcherQueue_iface;
+        IDispatcherQueue_AddRef( queue );
+        break;
+    }
+    LeaveCriticalSection( &queue_cs );
+
+    return queue;
+}
