+int is_inproc_sync( struct object *obj )
+{
+    return obj->ops == &inproc_sync_ops;
+}
+
+/* non-blocking wait on an inproc sync from the server thread; consumes the signal like a waiter.
+ * returns 1 if signaled, 0 if not, -1 on error */
+int inproc_sync_try_wait( struct object *obj )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    struct ntsync_wait_args args = {0};
+    int ret;
+
+    assert( obj->ops == &inproc_sync_ops );
+
+    args.timeout = 0;  /* absolute CLOCK_MONOTONIC time in the past: poll only */
+    args.objs    = (uintptr_t)&sync->fd;
+    args.count   = 1;
+    args.owner   = getpid();
+    args.index   = ~0u;
+
+    do { ret = ioctl( get_inproc_device_fd(), NTSYNC_IOC_WAIT_ANY, &args ); }
+    while (ret < 0 && errno == EINTR);
+
+    if (!ret) return args.index == 0;
+    if (errno == ETIMEDOUT) return 0;
+    return -1;
+}
+
+/*
+ * Server-side waiters on inproc syncs.
+ *
+ * The server never observes signals on an inproc sync (the client sets it through the
+ * ntsync ioctl), so anything that needs to run server code when such an object becomes
+ * signaled (wait completion packets) blocks a helper thread in NTSYNC_IOC_WAIT_ANY on the
+ * object instead. The helper touches nothing but its own file descriptors: when the wait
+ * returns it writes the waiter pointer to a pipe that the main loop polls, and the
+ * callback runs on the main thread. A per-waiter manual-reset event in the wait's alert
+ * slot cancels it.
+ */
+
+struct inproc_waiter
+{
+    int                    device_fd;  /* ntsync device */
+    int                    obj_fd;     /* dup of the target fd, closed by the thread */
+    int                    alert_fd;   /* dup of the cancel event fd, closed by the thread */
+    unsigned int           owner;      /* owner id passed to the wait */
+    struct inproc_sync    *sync;       /* target sync (referenced) */
+    struct inproc_sync    *alert;      /* cancel event (referenced) */
+    int                    cancelled;  /* set by the main thread */
+    int                    error;      /* errno from the wait, or 0 */
+    unsigned int           index;      /* wait result index */
+    inproc_waiter_callback callback;
+    void                  *private;
+};
+
+struct inproc_waiter_queue
+{
+    struct object  obj;         /* object header */
+    struct fd     *fd;          /* read end of the notification pipe */
+    int            pipe_write;  /* write end, used by helper threads */
+};
+
+static void inproc_waiter_queue_dump( struct object *obj, int verbose );
+static void inproc_waiter_queue_destroy( struct object *obj );
+static void inproc_waiter_queue_poll_event( struct fd *fd, int event );
+
+static const struct object_ops inproc_waiter_queue_ops =
+{
+    .size    = sizeof(struct inproc_waiter_queue),
+    .type    = &no_type,
+    .dump    = inproc_waiter_queue_dump,
+    .destroy = inproc_waiter_queue_destroy,
+};
+
+static const struct fd_ops inproc_waiter_queue_fd_ops =
+{
+    .poll_event = inproc_waiter_queue_poll_event,
+};
+
+static struct inproc_waiter_queue *waiter_queue;
+
+static void inproc_waiter_queue_dump( struct object *obj, int verbose )
+{
+    struct inproc_waiter_queue *queue = (struct inproc_waiter_queue *)obj;
+    fprintf( stderr, "Inproc waiter queue fd=%p\n", queue->fd );
+}
+
+static void inproc_waiter_queue_destroy( struct object *obj )
+{
+    struct inproc_waiter_queue *queue = (struct inproc_waiter_queue *)obj;
+    if (queue->fd) release_object( queue->fd );
+    close( queue->pipe_write );
+}
+
+static void free_inproc_waiter( struct inproc_waiter *waiter )
+{
+    release_object( waiter->alert );
+    release_object( waiter->sync );
+    free( waiter );
