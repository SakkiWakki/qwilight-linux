+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(composition);
+
+struct composition_capabilities
+{
+    ICompositionCapabilities ICompositionCapabilities_iface;
+    LONG ref;
+    LONG next_token;
+};
+
+static inline struct composition_capabilities *impl_from_ICompositionCapabilities( ICompositionCapabilities *iface )
+{
+    return CONTAINING_RECORD( iface, struct composition_capabilities, ICompositionCapabilities_iface );
+}
+
+static HRESULT WINAPI capabilities_QueryInterface( ICompositionCapabilities *iface, REFIID iid, void **out )
+{
+    struct composition_capabilities *impl = impl_from_ICompositionCapabilities( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_ICompositionCapabilities ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositionCapabilities_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI capabilities_AddRef( ICompositionCapabilities *iface )
+{
+    struct composition_capabilities *impl = impl_from_ICompositionCapabilities( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI capabilities_Release( ICompositionCapabilities *iface )
+{
+    struct composition_capabilities *impl = impl_from_ICompositionCapabilities( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI capabilities_GetIids( ICompositionCapabilities *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI capabilities_GetRuntimeClassName( ICompositionCapabilities *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_UI_Composition_CompositionCapabilities,
+                                ARRAY_SIZE(RuntimeClass_Windows_UI_Composition_CompositionCapabilities) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI capabilities_GetTrustLevel( ICompositionCapabilities *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+/* The capabilities never change under Wine, so the handler is recorded, given a
+ * token and then dropped: firing the event would only make callers re-query the
+ * two constants below. */
+static HRESULT WINAPI capabilities_add_Changed( ICompositionCapabilities *iface,
+                                                ITypedEventHandler_CompositionCapabilities_IInspectable *handler,
+                                                EventRegistrationToken *token )
+{
+    struct composition_capabilities *impl = impl_from_ICompositionCapabilities( iface );
+
+    FIXME( "iface %p, handler %p, token %p semi-stub!\n", iface, handler, token );
+
+    if (!token) return E_POINTER;
+    token->value = InterlockedIncrement( &impl->next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI capabilities_remove_Changed( ICompositionCapabilities *iface, EventRegistrationToken token )
+{
+    FIXME( "iface %p, token %#I64x semi-stub!\n", iface, token.value );
+    return S_OK;
+}
+
+static HRESULT WINAPI capabilities_get_AreEffectsSupported( ICompositionCapabilities *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI capabilities_get_AreEffectsFast( ICompositionCapabilities *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const struct ICompositionCapabilitiesVtbl capabilities_vtbl =
+{
+    capabilities_QueryInterface,
+    capabilities_AddRef,
+    capabilities_Release,
+    /* IInspectable */
+    capabilities_GetIids,
+    capabilities_GetRuntimeClassName,
+    capabilities_GetTrustLevel,
+    /* ICompositionCapabilities: order measured from wuceffectsi.dll */
+    capabilities_get_AreEffectsSupported,
+    capabilities_get_AreEffectsFast,
+    capabilities_add_Changed,
+    capabilities_remove_Changed,
+};
+
+HRESULT composition_capabilities_create( ICompositionCapabilities **out )
+{
+    struct composition_capabilities *impl;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->ICompositionCapabilities_iface.lpVtbl = &capabilities_vtbl;
+    impl->ref = 1;
+
+    TRACE( "created CompositionCapabilities %p.\n", impl );
+    *out = &impl->ICompositionCapabilities_iface;
+    return S_OK;
+}
+
+struct capabilities_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    ICompositionCapabilitiesStatics ICompositionCapabilitiesStatics_iface;
+    LONG ref;
+};
+
+static inline struct capabilities_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct capabilities_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI capabilities_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct capabilities_factory *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+            || IsEqualGUID( iid, &IID_IInspectable )
+            || IsEqualGUID( iid, &IID_IAgileObject )
+            || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ICompositionCapabilitiesStatics ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositionCapabilitiesStatics_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI capabilities_factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI capabilities_factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI capabilities_factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI capabilities_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
