+static void append_header_line( WCHAR **buffer, SIZE_T *len, SIZE_T *cap, const WCHAR *name, const WCHAR *value )
+{
+    SIZE_T need = wcslen( name ) + 2 + (value ? wcslen( value ) : 0) + 3;
+    if (*len + need > *cap)
+    {
+        SIZE_T ncap = max( *cap * 2, *len + need + 256 );
+        WCHAR *n = realloc( *buffer, ncap * sizeof(WCHAR) );
+        if (!n) return;
+        *buffer = n; *cap = ncap;
+    }
+    *len += swprintf( *buffer + *len, *cap - *len, L"%s: %s\r\n", name, value ? value : L"" );
+}
+
+static void append_header_list( WCHAR **buffer, SIZE_T *len, SIZE_T *cap, struct list *headers )
+{
+    struct header_entry *entry;
+    LIST_FOR_EACH_ENTRY( entry, headers, struct header_entry, entry )
+        append_header_line( buffer, len, cap, WindowsGetStringRawBuffer( entry->name, NULL ), WindowsGetStringRawBuffer( entry->value, NULL ) );
+}
+
+/* Collect the request line pieces and the raw header block from the WinRT objects. */
+static HRESULT transport_collect_headers( IHttpRequestMessage *request, WCHAR **headers_out )
+{
+    IHttpRequestHeaderCollection *headers = NULL;
+    IHttpContent *content = NULL;
+    WCHAR *buffer = NULL;
+    SIZE_T len = 0, cap = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = IHttpRequestMessage_get_Headers( request, &headers ))) return hr;
+    {
+        struct list *list;
+        IHttpProductInfoHeaderValueCollection *ua = NULL;
+        IHttpCredentialsHeaderValue *auth = NULL;
+
+        if ((list = request_headers_get_list( headers ))) append_header_list( &buffer, &len, &cap, list );
+        if (SUCCEEDED(IHttpRequestHeaderCollection_get_UserAgent( headers, &ua )) && ua)
+        {
+            struct list *products = product_info_collection_get_list( ua );
+            struct header_entry *entry;
+            WCHAR value[1024] = L"";
+            SIZE_T vlen = 0;
+            if (products) LIST_FOR_EACH_ENTRY( entry, products, struct header_entry, entry )
+            {
+                const WCHAR *s = WindowsGetStringRawBuffer( entry->value, NULL );
+                if (vlen + wcslen( s ) + 2 >= ARRAY_SIZE(value)) break;
+                if (vlen) value[vlen++] = ' ';
+                wcscpy( value + vlen, s ); vlen += wcslen( s );
+            }
+            if (vlen) append_header_line( &buffer, &len, &cap, L"User-Agent", value );
+            IHttpProductInfoHeaderValueCollection_Release( ua );
+        }
+        if (SUCCEEDED(IHttpRequestHeaderCollection_get_Authorization( headers, &auth )) && auth)
+        {
+            HSTRING scheme = NULL, token = NULL;
+            WCHAR value[2048];
+            IHttpCredentialsHeaderValue_get_Scheme( auth, &scheme );
+            IHttpCredentialsHeaderValue_get_Token( auth, &token );
+            swprintf( value, ARRAY_SIZE(value), L"%s %s", WindowsGetStringRawBuffer( scheme, NULL ), WindowsGetStringRawBuffer( token, NULL ) );
+            append_header_line( &buffer, &len, &cap, L"Authorization", value );
+            WindowsDeleteString( scheme ); WindowsDeleteString( token );
+            IHttpCredentialsHeaderValue_Release( auth );
+        }
+        IHttpRequestHeaderCollection_Release( headers );
+    }
+    if (SUCCEEDED(IHttpRequestMessage_get_Content( request, &content )) && content)
+    {
+        IHttpContentHeaderCollection *cheaders = NULL;
+        if (SUCCEEDED(IHttpContent_get_Headers( content, &cheaders )) && cheaders)
+        {
+            struct list *list = content_headers_get_list( cheaders );
+            if (list) append_header_list( &buffer, &len, &cap, list );
+            IHttpContentHeaderCollection_Release( cheaders );
+        }
+        IHttpContent_Release( content );
+    }
+    *headers_out = buffer;
+    return S_OK;
+}
