+static ULONG WINAPI storyboard2_Release( IUIAnimationStoryboard2 *iface )
+{
+    struct storyboard2 *This = impl_from_IUIAnimationStoryboard2( iface );
+    ULONG ref = InterlockedDecrement( &This->ref );
+
+    if (!ref)
+    {
+        struct sb_transition *st, *next;
+        LIST_FOR_EACH_ENTRY_SAFE( st, next, &This->transitions, struct sb_transition, entry )
+        {
+            list_remove( &st->entry );
+            st->transition->scheduled = FALSE;
+            IUIAnimationTransition2_Release( &st->transition->IUIAnimationTransition2_iface );
+            IUIAnimationVariable2_Release( &st->variable->IUIAnimationVariable2_iface );
+            free( st );
+        }
+        if (This->tag_object) IUnknown_Release( This->tag_object );
+        if (This->handler) IUIAnimationStoryboardEventHandler2_Release( This->handler );
+        IUIAnimationManager2_Release( &This->manager->IUIAnimationManager2_iface );
+        free( This );
+    }
+    return ref;
+}
