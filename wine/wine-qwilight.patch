+    if (chars_x <= 0.0f) chars_x = 40.0f;
+    if (chars_y <= 0.0f) chars_y = 40.0f;
+    if ((info->pointerFlags & POINTER_FLAG_HWHEEL) && (flags & INTERACTION_CONFIGURATION_FLAG_MANIPULATION_TRANSLATION_X))
+        dx = -notches * lines * chars_x;
+    else if ((info->pointerFlags & POINTER_FLAG_WHEEL) && (flags & INTERACTION_CONFIGURATION_FLAG_MANIPULATION_TRANSLATION_Y))
+        dy = notches * lines * chars_y;
+    else if ((info->pointerFlags & POINTER_FLAG_WHEEL) && (flags & INTERACTION_CONFIGURATION_FLAG_MANIPULATION_TRANSLATION_X))
