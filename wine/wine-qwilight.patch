+    if (waiter_queue) return waiter_queue;
+
+    if (pipe( fd ) == -1)
+    {
+        file_set_error();
+        return NULL;
+    }
+    fcntl( fd[0], F_SETFD, FD_CLOEXEC );
+    fcntl( fd[1], F_SETFD, FD_CLOEXEC );
+    fcntl( fd[0], F_SETFL, O_NONBLOCK );
+
+    if (!(queue = alloc_object( &inproc_waiter_queue_ops )))
+    {
+        close( fd[0] );
+        close( fd[1] );
+        return NULL;
+    }
+    queue->pipe_write = fd[1];
+    if (!(queue->fd = create_anonymous_fd( &inproc_waiter_queue_fd_ops, fd[0], &queue->obj, 0 )))
+    {
+        release_object( queue );
+        return NULL;
+    }
+    set_fd_events( queue->fd, POLLIN );
+    make_object_permanent( &queue->obj );
+    waiter_queue = queue;
+    return queue;
+}
+
+/* helper thread: touches only its own fds and the pipe */
+static void *inproc_waiter_thread( void *arg )
+{
+    struct inproc_waiter *waiter = arg;
+    struct ntsync_wait_args args = {0};
+    int pipe_write = waiter_queue->pipe_write;
+    int ret;
+
+    args.timeout = ~(__u64)0;
+    args.objs    = (uintptr_t)&waiter->obj_fd;
+    args.count   = 1;
+    args.owner   = waiter->owner;
+    args.index   = ~0u;
+    args.alert   = waiter->alert_fd;
+
+    do { ret = ioctl( waiter->device_fd, NTSYNC_IOC_WAIT_ANY, &args ); }
+    while (ret < 0 && errno == EINTR);
+
+    waiter->error = ret < 0 ? errno : 0;
+    waiter->index = args.index;
+
+    close( waiter->obj_fd );
+    close( waiter->alert_fd );
+
+    /* a pointer-sized write is below PIPE_BUF and therefore atomic */
+    do { ret = write( pipe_write, &waiter, sizeof(waiter) ); }
+    while (ret < 0 && errno == EINTR);
+    return NULL;
+}
+
+struct inproc_waiter *create_inproc_waiter( struct object *obj, inproc_waiter_callback callback, void *private )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    struct inproc_waiter *waiter;
+    pthread_attr_t attr;
+    pthread_t thread;
