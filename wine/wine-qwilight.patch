+    impl->backface_visibility = value;
+    if (!impl->dcomp_visual) return S_OK;
+    /* CompositionBackfaceVisibility {Inherit, Hidden, Visible} vs
+     * DCOMPOSITION_BACKFACE_VISIBILITY {VISIBLE, HIDDEN}; Inherit is dcomp's
+     * default, which is VISIBLE. */
+    return visual_record_dcomp_result( "SetBackFaceVisibility",
+            IDCompositionVisual2_SetBackFaceVisibility( impl->dcomp_visual,
+                    value == CompositionBackfaceVisibility_Hidden ? DCOMPOSITION_BACKFACE_VISIBILITY_HIDDEN
+                                                                  : DCOMPOSITION_BACKFACE_VISIBILITY_VISIBLE ) );
