+static HRESULT client_send_uri( struct http_client *impl, const WCHAR *method_name, IUriRuntimeClass *uri, IHttpContent *content,
+        IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **operation )
+{
+    IHttpRequestMessage *request = NULL;
+    IHttpMethod *method = NULL;
+    HSTRING name;
+    HRESULT hr;
+
+    if (!uri) return E_INVALIDARG;
+    if (FAILED(hr = WindowsCreateString( method_name, wcslen( method_name ), &name ))) return hr;
+    hr = http_method_create( name, &method );
+    WindowsDeleteString( name );
+    if (FAILED(hr)) return hr;
+    hr = request_message_create( method, uri, &request );
+    IHttpMethod_Release( method );
+    if (FAILED(hr)) return hr;
+    if (content) IHttpRequestMessage_put_Content( request, content );
+    hr = client_send( impl, request, operation );
+    IHttpRequestMessage_Release( request );
+    return hr;
+}
