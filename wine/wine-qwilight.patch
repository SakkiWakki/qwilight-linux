+static HRESULT WINAPI dispatcher_queue_TryEnqueueWithPriority( IDispatcherQueue *iface, DispatcherQueuePriority priority,
+                                                               IDispatcherQueueHandler *callback, boolean *result )
+{
+    struct dispatcher_queue *impl = impl_from_IDispatcherQueue( iface );
+    HWND hwnd;
+
+    TRACE( "iface %p, priority %d, callback %p, result %p.\n", iface, priority, callback, result );
+
+    if (!result) return E_POINTER;
+    *result = FALSE;
+    if (!callback) return E_INVALIDARG;
+
+    EnterCriticalSection( &queue_cs );
+    hwnd = impl->hwnd;
+    LeaveCriticalSection( &queue_cs );
+
+    /* A queue that is not bound to a thread has nothing to run the callback on. Windows returns
+     * FALSE from TryEnqueue() once the queue has shut down, rather than failing. */
+    if (!hwnd)
+    {
+        WARN( "iface %p is not bound to a thread, dropping callback %p.\n", iface, callback );
+        return S_OK;
+    }
+
+    if (priority != DispatcherQueuePriority_Normal)
+        FIXME( "priority %d not implemented, running the callback at normal priority.\n", priority );
+
+    IDispatcherQueueHandler_AddRef( callback );
+    if (!PostMessageW( hwnd, WM_WINE_DISPATCHER_QUEUE_INVOKE, 0, (LPARAM)callback ))
+    {
+        WARN( "failed to post to hwnd %p, error %lu.\n", hwnd, GetLastError() );
+        IDispatcherQueueHandler_Release( callback );
+        return S_OK;
+    }
+
+    *result = TRUE;
+    return S_OK;
