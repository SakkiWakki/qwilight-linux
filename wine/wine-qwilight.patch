+static HRESULT transition_create( enum transition_kind kind, UINT dim, double duration, BOOL duration_known,
+        const double *final, struct transition2 **out )
+{
+    struct transition2 *t;
+
+    if (!out) return E_POINTER;
+    if (dim < 1 || dim > WAM_MAX_DIM) return E_INVALIDARG;
+    if (!(t = calloc( 1, sizeof(*t) ))) return E_OUTOFMEMORY;
+    t->IUIAnimationTransition2_iface.lpVtbl = &transition2_vtbl;
+    t->ref = 1;
+    t->kind = kind;
+    t->dim = dim;
+    t->duration = duration;
+    t->duration_known = duration_known;
+    if (final) memcpy( t->final, final, dim * sizeof(*final) );
+    *out = t;
+    return S_OK;
+}
