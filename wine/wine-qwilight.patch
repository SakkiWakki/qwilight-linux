+            IDCompositionVisual2_SetBorderMode( impl->dcomp_visual,
+                    value == CompositionBorderMode_Soft ? DCOMPOSITION_BORDER_MODE_SOFT
+                  : value == CompositionBorderMode_Hard ? DCOMPOSITION_BORDER_MODE_HARD
