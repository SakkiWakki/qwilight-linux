new file mode 100644
index 00000000..3c9e4cd6
--- /dev/null
+++ b/dlls/windows.ui.composition/brush.c
@@ -0,0 +1,299 @@
+/*
+ * Windows.UI.Composition brushes.
+ *
+ * Copyright (C) 2026 Wine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(composition);
+
+/*
+ * CompositionColorBrush — record-only.
+ *
+ * The Windows App SDK's SystemBackdrops implementation reaches this through
+ * MicaController::GetFallbackBrushOverride (wuceffectsi.dll rva 0x2a1b0), which
+ * is taken whenever CompositionCapabilities reports that effects are not
+ * supported.  It calls ICompositor::CreateColorBrush(Color), immediately
+ * QueryInterfaces the result for ICompositionBrush {ab0d7608-30c0-40e9-b568-
+ * b60a6bd1fb46} (the guid at wuceffectsi rva 0x4ff90, loaded at rva 0x2a21c) and
+ * hands the brush to BaseController::Crossfade, which reads its
+ * ICompositionObject2::Comment and then puts it on the XAML targets.  Nothing
+ * ever asks this object to draw.
+ */
+struct color_brush
+{
+    struct composition_object object;   /* must be first: owns the refcount */
+    ICompositionColorBrush ICompositionColorBrush_iface;   /* the [default] interface */
+    ICompositionBrush ICompositionBrush_iface;
+
+    Color color;
+};
+
+static inline struct color_brush *color_brush_from_composition_object( struct composition_object *obj )
+{
+    return CONTAINING_RECORD( obj, struct color_brush, object );
+}
+
+static HRESULT color_brush_query_interface( struct composition_object *obj, REFIID iid, void **out )
+{
+    struct color_brush *impl = color_brush_from_composition_object( obj );
+
+    if (IsEqualGUID( iid, &IID_ICompositionColorBrush ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositionColorBrush_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ICompositionBrush ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositionBrush_iface) );
+        return S_OK;
+    }
+
+    return E_NOINTERFACE;
+}
+
+static void color_brush_destroy( struct composition_object *obj )
+{
+    free( color_brush_from_composition_object( obj ) );
+}
+
+static const struct composition_object_ops color_brush_ops =
+{
+    RuntimeClass_Windows_UI_Composition_CompositionColorBrush,
+    ARRAY_SIZE(RuntimeClass_Windows_UI_Composition_CompositionColorBrush) - 1,
+    color_brush_query_interface,
+    color_brush_destroy,
+};
+
+/*
+ * ICompositionColorBrush {2b264c5e-bf35-4831-8642-cf70c20fff2f}: get_Color,
+ * put_Color.  Order verified against mingw-w64's windows.ui.composition.h and
+ * against Microsoft.UI.Composition.ICompositionColorBrush in the shipped
+ * Microsoft.UI.winmd (slot 6 get_Color, slot 7 put_Color).
+ */
+DEFINE_COMPOSITION_OBJECT_IINSPECTABLE( color_brush, ICompositionColorBrush, struct color_brush,
+                                        object, ICompositionColorBrush_iface )
+
+static HRESULT WINAPI color_brush_get_Color( ICompositionColorBrush *iface, Color *value )
+{
+    struct color_brush *impl = impl_from_ICompositionColorBrush( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->color;
+    return S_OK;
+}
+
+static HRESULT WINAPI color_brush_put_Color( ICompositionColorBrush *iface, Color value )
+{
+    struct color_brush *impl = impl_from_ICompositionColorBrush( iface );
+
+    TRACE( "iface %p, value {%u, %u, %u, %u}.\n", iface, value.A, value.R, value.G, value.B );
+
+    impl->color = value;
+    return S_OK;
+}
+
+static const struct ICompositionColorBrushVtbl color_brush_vtbl =
+{
+    color_brush_QueryInterface,
+    color_brush_AddRef,
+    color_brush_Release,
+    /* IInspectable */
+    color_brush_GetIids,
+    color_brush_GetRuntimeClassName,
+    color_brush_GetTrustLevel,
+    /* ICompositionColorBrush */
+    color_brush_get_Color,
+    color_brush_put_Color,
+};
+
+/* ICompositionBrush {ab0d7608-30c0-40e9-b568-b60a6bd1fb46} has no members of its
+ * own; it is the base every brush is passed around as. */
+DEFINE_COMPOSITION_OBJECT_IINSPECTABLE( composition_brush, ICompositionBrush, struct color_brush,
+                                        object, ICompositionBrush_iface )
+
+static const struct ICompositionBrushVtbl composition_brush_vtbl =
+{
+    composition_brush_QueryInterface,
+    composition_brush_AddRef,
+    composition_brush_Release,
+    /* IInspectable */
+    composition_brush_GetIids,
+    composition_brush_GetRuntimeClassName,
+    composition_brush_GetTrustLevel,
+};
+
+/* effect.c's fallback resolver: read a colour brush's colour without a
+ * QueryInterface, so that probing a brush that is not one stays silent. */
+BOOL composition_color_brush_get_color( ICompositionBrush *iface, Color *color )
+{
+    if (iface->lpVtbl != &composition_brush_vtbl) return FALSE;
+    *color = impl_from_ICompositionBrush( iface )->color;
+    return TRUE;
+}
+
+HRESULT composition_color_brush_create( ICompositor *compositor, Color color, ICompositionColorBrush **out )
+{
+    struct color_brush *impl;
+
+    *out = NULL;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->ICompositionColorBrush_iface.lpVtbl = &color_brush_vtbl;
+    impl->ICompositionBrush_iface.lpVtbl = &composition_brush_vtbl;
+    impl->color = color;
+    composition_object_init( &impl->object, &color_brush_ops,
+                             (IInspectable *)&impl->ICompositionColorBrush_iface, compositor );
+
+    TRACE( "created color brush %p, color {%u, %u, %u, %u}.\n", impl, color.A, color.R, color.G, color.B );
+
+    *out = &impl->ICompositionColorBrush_iface;
+    return S_OK;
+}
+
+/*
+ * CompositionBackdropBrush: what ICompositor3::CreateHostBackdropBrush() hands out.
+ * The App SDK's acrylic backdrop (wuceffectsi!SystemBackdropInternal) asks the system
+ * compositor for ICompositor3 while building the backdrop of an unconstrained popup
+ * (flyouts, toasts); E_NOINTERFACE there surfaced as RoReportUnhandledError
+ * "Call failed" on the XAML thread and the popup never opened. Nothing draws this
+ * brush: the popup's background stays whatever is behind it.
+ */
+struct backdrop_brush
+{
+    struct composition_object object;   /* must be first: owns the refcount */
+    ICompositionBackdropBrush ICompositionBackdropBrush_iface;   /* the [default] interface */
+    ICompositionBrush ICompositionBrush_iface;
+};
+
+static inline struct backdrop_brush *backdrop_brush_from_composition_object( struct composition_object *obj )
+{
+    return CONTAINING_RECORD( obj, struct backdrop_brush, object );
+}
+
+static HRESULT backdrop_brush_query_interface( struct composition_object *obj, REFIID iid, void **out )
+{
+    struct backdrop_brush *impl = backdrop_brush_from_composition_object( obj );
+
+    if (IsEqualGUID( iid, &IID_ICompositionBackdropBrush ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositionBackdropBrush_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_ICompositionBrush ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->ICompositionBrush_iface) );
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+
+static void backdrop_brush_destroy( struct composition_object *obj )
+{
+    free( backdrop_brush_from_composition_object( obj ) );
+}
+
+static const struct composition_object_ops backdrop_brush_ops =
+{
+    RuntimeClass_Windows_UI_Composition_CompositionBackdropBrush,
+    ARRAY_SIZE(RuntimeClass_Windows_UI_Composition_CompositionBackdropBrush) - 1,
+    backdrop_brush_query_interface,
+    backdrop_brush_destroy,
+};
+
+DEFINE_COMPOSITION_OBJECT_IINSPECTABLE( backdrop_brush, ICompositionBackdropBrush, struct backdrop_brush,
+                                        object, ICompositionBackdropBrush_iface )
+
+static const struct ICompositionBackdropBrushVtbl backdrop_brush_vtbl =
+{
+    backdrop_brush_QueryInterface,
+    backdrop_brush_AddRef,
+    backdrop_brush_Release,
+    /* IInspectable */
+    backdrop_brush_GetIids,
+    backdrop_brush_GetRuntimeClassName,
+    backdrop_brush_GetTrustLevel,
+};
+
+/* ICompositionBrush on the backdrop brush: forwarded to the default interface (the
+ * color brush already owns the impl_from_ICompositionBrush name the macro would make). */
+static inline IInspectable *backdrop_brush_default_iface( ICompositionBrush *iface )
+{
+    struct backdrop_brush *impl = CONTAINING_RECORD( iface, struct backdrop_brush, ICompositionBrush_iface );
+    return (IInspectable *)&impl->ICompositionBackdropBrush_iface;
+}
+
+static HRESULT WINAPI backdrop_brush_brush_QueryInterface( ICompositionBrush *iface, REFIID iid, void **out )
+{
+    return IInspectable_QueryInterface( backdrop_brush_default_iface( iface ), iid, out );
+}
+
+static ULONG WINAPI backdrop_brush_brush_AddRef( ICompositionBrush *iface )
+{
+    return IInspectable_AddRef( backdrop_brush_default_iface( iface ) );
+}
+
+static ULONG WINAPI backdrop_brush_brush_Release( ICompositionBrush *iface )
+{
+    return IInspectable_Release( backdrop_brush_default_iface( iface ) );
+}
+
+static HRESULT WINAPI backdrop_brush_brush_GetIids( ICompositionBrush *iface, ULONG *iid_count, IID **iids )
+{
+    return IInspectable_GetIids( backdrop_brush_default_iface( iface ), iid_count, iids );
+}
+
+static HRESULT WINAPI backdrop_brush_brush_GetRuntimeClassName( ICompositionBrush *iface, HSTRING *class_name )
+{
+    return IInspectable_GetRuntimeClassName( backdrop_brush_default_iface( iface ), class_name );
+}
+
+static HRESULT WINAPI backdrop_brush_brush_GetTrustLevel( ICompositionBrush *iface, TrustLevel *trust_level )
+{
+    return IInspectable_GetTrustLevel( backdrop_brush_default_iface( iface ), trust_level );
+}
+
+static const struct ICompositionBrushVtbl backdrop_brush_brush_vtbl =
+{
+    backdrop_brush_brush_QueryInterface,
+    backdrop_brush_brush_AddRef,
+    backdrop_brush_brush_Release,
+    /* IInspectable */
+    backdrop_brush_brush_GetIids,
+    backdrop_brush_brush_GetRuntimeClassName,
+    backdrop_brush_brush_GetTrustLevel,
+};
+
+HRESULT composition_backdrop_brush_create( ICompositor *compositor, ICompositionBackdropBrush **out )
+{
+    struct backdrop_brush *impl;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->ICompositionBackdropBrush_iface.lpVtbl = &backdrop_brush_vtbl;
+    impl->ICompositionBrush_iface.lpVtbl = &backdrop_brush_brush_vtbl;
+    composition_object_init( &impl->object, &backdrop_brush_ops,
+                             (IInspectable *)&impl->ICompositionBackdropBrush_iface, compositor );
+    TRACE( "created backdrop brush %p.\n", impl );
+    *out = &impl->ICompositionBackdropBrush_iface;
+    return S_OK;
+}
diff --git a/dlls/windows.ui.composition/capabilities.c b/dlls/windows.ui.composition/capabilities.c
new file mode 100644
index 00000000..3ea569d3
--- /dev/null
+++ b/dlls/windows.ui.composition/capabilities.c
@@ -0,0 +1,294 @@
+/*
+ * Windows.UI.Composition.CompositionCapabilities
+ *
+ * Copyright (C) 2026 Wine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
