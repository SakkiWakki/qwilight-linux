 }
 
+/* Both functions return a delimiter-separated BCP-47 language list. We have no
+ * per-user or per-application language profile, so return the user's default
+ * locale, which is what the WinRT ApplicationLanguages/GlobalizationPreferences
+ * stubs report as well. */
+static HRESULT get_default_language_list(WCHAR delim, HSTRING *langs)
+{
+    WCHAR locale[LOCALE_NAME_MAX_LENGTH];
+
+    if (!langs) return E_INVALIDARG;
+    *langs = NULL;
+    if (!GetUserDefaultLocaleName(locale, ARRAY_SIZE(locale))) return E_FAIL;
+    return WindowsCreateString(locale, wcslen(locale), langs);
+}
+
 HRESULT WINAPI GetUserLanguages(WCHAR delim, HSTRING *langs)
 {
-    FIXME("%lc, %p\n", delim, langs);
-    return S_OK;
+    FIXME("%lc, %p semi-stub.\n", delim, langs);
+    return get_default_language_list(delim, langs);
+}
+
+/* The first argument is a null context pointer in every caller seen so far
+ * (Microsoft.Internal.FrameworkUdk.dll from the Windows App SDK 2.4 passes 0). */
+HRESULT WINAPI GetApplicationLanguages(void *context, WCHAR delim, HSTRING *langs)
+{
+    FIXME("context %p, delim %lc, langs %p semi-stub.\n", context, delim, langs);
+    return get_default_language_list(delim, langs);
+}
+
+/* The MUI form of a BCP-47 tag is the tag itself for every language we can
+ * report, so hand back a copy of the list. flags is 0 in every caller seen. */
+HRESULT WINAPI LanguageListAsMuiForm(WCHAR delim, HSTRING list, DWORD flags, HSTRING *out)
+{
+    FIXME("delim %lc, list %s, flags %#lx, out %p semi-stub.\n", delim, debugstr_hstring(list), flags, out);
+
+    if (!out) return E_INVALIDARG;
+    return WindowsDuplicateString(list, out);
 }
