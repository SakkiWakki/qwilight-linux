+static void transform_matrix_multiply(D2D_MATRIX_3X2_F *out, const D2D_MATRIX_3X2_F *a, const D2D_MATRIX_3X2_F *b)
+{
+    D2D_MATRIX_3X2_F r;
+
+    r._11 = a->_11 * b->_11 + a->_12 * b->_21;
+    r._12 = a->_11 * b->_12 + a->_12 * b->_22;
+    r._21 = a->_21 * b->_11 + a->_22 * b->_21;
+    r._22 = a->_21 * b->_12 + a->_22 * b->_22;
+    r._31 = a->_31 * b->_11 + a->_32 * b->_21 + b->_31;
+    r._32 = a->_31 * b->_12 + a->_32 * b->_22 + b->_32;
+    *out = r;
+}
+
+static BOOL property_transform_get_matrix(struct composition_property_transform *t, D2D_MATRIX_3X2_F *m)
+{
+    const float *p = t->prop;
+    float c, s, tx, ty;
+
+    m->_11 = m->_22 = 1.0f;
+    m->_12 = m->_21 = m->_31 = m->_32 = 0.0f;
+    switch (t->kind)
+    {
+        case TRANSFORM_TRANSLATE:
+        case TRANSFORM_TRANSLATE_3D:
+            m->_31 = p[0];
+            m->_32 = p[1];
+            if (t->kind == TRANSFORM_TRANSLATE_3D && p[2]) WARN("Z offset %f ignored.\n", p[2]);
+            return TRUE;
+        case TRANSFORM_SCALE:
+            m->_11 = p[0];
+            m->_22 = p[1];
+            m->_31 = p[2] * (1.0f - p[0]);
+            m->_32 = p[3] * (1.0f - p[1]);
+            return TRUE;
+        case TRANSFORM_SCALE_3D:
+            m->_11 = p[0];
+            m->_22 = p[1];
+            m->_31 = p[3] * (1.0f - p[0]);
+            m->_32 = p[4] * (1.0f - p[1]);
+            return TRUE;
+        case TRANSFORM_ROTATE:
+        case TRANSFORM_ROTATE_3D:
+        {
+            float angle = p[0], cx, cy;
+            if (t->kind == TRANSFORM_ROTATE_3D)
+            {
+                if (p[1] || p[2]) WARN("Rotation about a non-z axis (%f %f %f) reduced to z.\n", p[1], p[2], p[3]);
+                if (p[3] < 0.0f) angle = -angle;
+                cx = p[4];
+                cy = p[5];
+            }
+            else
+            {
+                cx = p[1];
+                cy = p[2];
+            }
+            c = cosf(angle * (float)M_PI / 180.0f);
+            s = sinf(angle * (float)M_PI / 180.0f);
+            m->_11 = c;
+            m->_12 = s;
+            m->_21 = -s;
+            m->_22 = c;
+            m->_31 = cx - cx * c + cy * s;
+            m->_32 = cy - cx * s - cy * c;
+            return TRUE;
+        }
+        case TRANSFORM_SKEW:
+            tx = tanf(p[0] * (float)M_PI / 180.0f);
+            ty = tanf(p[1] * (float)M_PI / 180.0f);
+            m->_12 = ty;
+            m->_21 = tx;
+            m->_31 = -p[3] * tx;
+            m->_32 = -p[2] * ty;
+            return TRUE;
+    }
+    return FALSE;
+}
