+/*
+ * Pointer messages for a composition input sink window.
+ *
+ * GetPointerInfo() returns the pointer's latest state, and the frame ids the
+ * sink's consumer (Microsoft.InputStateManager) reads from it must match the
+ * message it is handling: Windows coalesces WM_POINTERUPDATE and keeps the
+ * two in step.  A pointer message posted to another thread's window is not
+ * coalesced, so each one carries its own snapshot of the pointer, installed as
+ * the thread's pointer state while the window procedure runs, and an update
+ * that a newer update has overtaken is dropped.
+ */
+struct sink_pointer_message
+{
+    struct pointer pointer;     /* snapshot taken when the message was posted */
+    MSG msg;
+    LONG generation;
+    /* Wheel messages: the sink's thread hands the message on to this window
+     * (WinUI's input site, on the UI thread) synchronously once it reaches it
+     * in its queue, so that the wheel is injected after every pointer update
+     * that preceded it: InputStateManager fail-fasts on a frame id that goes
+     * backwards, and the input site injects wheels with the current one. */
+    HWND forward_hwnd;
+    BOOL forwarded;
+};
+
+static LONG sink_pointer_update_generation;
+
+BOOL post_sink_pointer_message( HWND target, const MSG *msg, HWND forward_hwnd )
+{
+    struct sink_pointer_message *block;
+    struct pointer *pointer;
+    UINT32 id = GET_POINTERID_WPARAM( msg->wParam );
+
+    if (!(block = calloc( 1, sizeof(*block) ))) return FALSE;
+    block->msg = *msg;
+    block->forward_hwnd = forward_hwnd;
+
+    pthread_mutex_lock( &pointer_lock );
+    if ((pointer = find_pointer( id ))) block->pointer = *pointer;
+    pthread_mutex_unlock( &pointer_lock );
+    if (!pointer)
+    {
+        free( block );
+        return FALSE;
+    }
+    list_init( &block->pointer.entry );
+    if (msg->message == WM_POINTERUPDATE) block->generation = InterlockedIncrement( &sink_pointer_update_generation );
+
+    TRACE( "posting pointer message %#x for %p (pointer %u, frame %u) to sink window %p\n", msg->message,
+           msg->hwnd, id, (UINT)block->pointer.info.frameId, target );
+
+    if (!NtUserPostMessage( target, WM_WINE_SINK_POINTER, 0, (LPARAM)block ))
+    {
+        free( block );
+        return FALSE;
+    }
     return TRUE;
 }
+
+/* WM_WINE_SINK_POINTER on the sink window's thread */
+LRESULT process_sink_pointer_message( HWND hwnd, LPARAM lparam )
+{
+    struct sink_pointer_message *block = (struct sink_pointer_message *)lparam;
+    struct user_thread_info *thread_info = get_user_thread_info();
+    const MSG *msg = &block->msg;
+
+    if (msg->message == WM_POINTERUPDATE && block->generation != ReadNoFence( &sink_pointer_update_generation ))
+    {
+        TRACE( "dropping stale pointer update (frame %u) for %p\n", (UINT)block->pointer.info.frameId, hwnd );
+        free( block );
+        return 0;
+    }
+
+    if (block->forwarded)
+    {
+        /* second stage, on the forward window's thread */
+        TRACE( "forwarding pointer message %#x (frame %u) to %p\n", msg->message, (UINT)block->pointer.info.frameId, hwnd );
+        thread_info->pointer_snapshot = &block->pointer;
+        send_message( hwnd, msg->message, msg->wParam, msg->lParam );
+        thread_info->pointer_snapshot = NULL;
+        return 0;
+    }
+    if (block->forward_hwnd)
+    {
+        block->forwarded = TRUE;
+        send_message( block->forward_hwnd, WM_WINE_SINK_POINTER, 0, (LPARAM)block );
+        free( block );
+        return 0;
+    }
+    TRACE( "dispatching pointer message %#x (frame %u) to %p\n", msg->message, (UINT)block->pointer.info.frameId, hwnd );
+
+    thread_info->pointer_snapshot = &block->pointer;
+    send_message( hwnd, msg->message, msg->wParam, msg->lParam );
+    thread_info->pointer_snapshot = NULL;
+    free( block );
+    return 0;
+}
