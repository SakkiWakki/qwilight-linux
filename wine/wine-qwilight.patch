+/* TEMP DIAG: WINE_DRAW_DIAG=<trigger file> reports, while the trigger exists, every draw on the
+ * immediate context (render target, shaders, vertex/constant buffers, SRVs, samplers) and the data
+ * written to mapped vertex/constant buffers. */
+static BOOL draw_diag_active(void)
+{
+    static const char *trigger;
+    static BOOL checked, active;
+    static DWORD last_check;
+    DWORD now;
+
+    if (!checked) { trigger = getenv("WINE_DRAW_DIAG"); checked = TRUE; }
+    if (!trigger) return FALSE;
+    now = GetTickCount();
+    if (now - last_check > 50)
+    {
+        active = GetFileAttributesA(trigger) != INVALID_FILE_ATTRIBUTES;
+        last_check = now;
+    }
+    return active;
+}
+
+static const char *draw_diag_resource(struct wined3d_resource *resource, char *buf, size_t size)
+{
+    struct wined3d_resource_desc desc;
+    void *parent;
+
+    if (!resource) { snprintf(buf, size, "none"); return buf; }
+    wined3d_resource_get_desc(resource, &desc);
+    parent = wined3d_resource_get_parent(resource);
+    if (desc.resource_type == WINED3D_RTYPE_TEXTURE_2D && parent)
+        snprintf(buf, size, "tex %p %ux%u fmt %#x bind %#x", &((struct d3d_texture2d *)parent)->ID3D11Texture2D_iface,
+                desc.width, desc.height, desc.format, desc.bind_flags);
+    else if (desc.resource_type == WINED3D_RTYPE_BUFFER && parent)
+        snprintf(buf, size, "buf %p size %u bind %#x", &((struct d3d_buffer *)parent)->ID3D11Buffer_iface, desc.size, desc.bind_flags);
+    else
+        snprintf(buf, size, "res %p type %u", resource, desc.resource_type);
+    return buf;
+}
