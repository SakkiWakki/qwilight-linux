+static HRESULT WINAPI storyboard2_AddKeyframeAtOffset( IUIAnimationStoryboard2 *iface, UI_ANIMATION_KEYFRAME existing,
+        double offset, UI_ANIMATION_KEYFRAME *keyframe )
