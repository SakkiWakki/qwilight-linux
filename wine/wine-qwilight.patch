+    if (!(sb = calloc( 1, sizeof(*sb) ))) return E_OUTOFMEMORY;
+    sb->IUIAnimationStoryboard2_iface.lpVtbl = &storyboard2_vtbl;
+    sb->ref = 1;
+    sb->manager = mgr;
