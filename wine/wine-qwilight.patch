+            output.arguments.manipulation.delta.translationX = dx;
+            output.arguments.manipulation.delta.translationY = dy;
+            output.arguments.manipulation.cumulative.translationX = dx;
+            output.arguments.manipulation.cumulative.translationY = dy;
+            output.arguments.manipulation.veolcity.velocityX = dx / WHEEL_INERTIA_MS;
+            output.arguments.manipulation.veolcity.velocityY = dy / WHEEL_INERTIA_MS;
+            context->callback(context->callback_data, &output);
+            context->last_output = output;
+            context->has_output = TRUE;
+            context->in_interaction = TRUE;
+            return;
+        }
+    }
+    output.interactionFlags = INTERACTION_FLAG_BEGIN;
+    context->callback(context->callback_data, &output);
+    output.interactionFlags = INTERACTION_FLAG_NONE;
+    output.arguments.manipulation.delta.translationX = dx;
+    output.arguments.manipulation.delta.translationY = dy;
+    output.arguments.manipulation.cumulative.translationX = dx;
+    output.arguments.manipulation.cumulative.translationY = dy;
+    output.arguments.manipulation.veolcity.velocityX = dx / WHEEL_INERTIA_MS;
+    output.arguments.manipulation.veolcity.velocityY = dy / WHEEL_INERTIA_MS;
