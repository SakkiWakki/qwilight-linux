+/* the DPI a screen coordinate is expressed in for a given awareness context.
+ * Wine scales coordinates of DPI unaware threads only, everything else uses
+ * the raw, physical coordinates. */
+static UINT screen_dpi_from_context( DPI_AWARENESS_CONTEXT context )
+{
+    UINT value = get_ntuser_dpi_context( context );
+
+    if (!is_valid_dpi_awareness_context( value, 0 )) return 0;
+    if (NTUSER_DPI_CONTEXT_GET_AWARENESS( value ) == DPI_AWARENESS_UNAWARE) return USER_DEFAULT_SCREEN_DPI;
+    return system_dpi ? system_dpi : USER_DEFAULT_SCREEN_DPI;
+}
+
+/***********************************************************************
+ *              User32ConvertPointBetweenDpiContexts   (USER32.@)
+ *
+ * Undocumented, exported by ordinal 2557 only (NtUserConvertPoint?). Converts a
+ * screen point expressed in the "from" DPI awareness context into the "to" one.
+ * Microsoft.UI.Windowing.Core's CTitleBar::ClientToWindowUnvirtualized and
+ * CTitleBar::WindowUnvirtualizedToClient call it while handling mouse input over
+ * the caption buttons.
+ */
+BOOL WINAPI User32ConvertPointBetweenDpiContexts( POINT *point, DPI_AWARENESS_CONTEXT to,
+                                                  DPI_AWARENESS_CONTEXT from )
+{
+    UINT dpi_to, dpi_from;
+
+    TRACE( "point %p, to %p, from %p\n", point, to, from );
+
+    if (!point)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (!(dpi_to = screen_dpi_from_context( to )) || !(dpi_from = screen_dpi_from_context( from )))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (dpi_to != dpi_from)
+    {
+        point->x = MulDiv( point->x, dpi_to, dpi_from );
+        point->y = MulDiv( point->y, dpi_to, dpi_from );
+    }
+    return TRUE;
+}
