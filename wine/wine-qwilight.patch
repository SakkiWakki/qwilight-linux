+static HRESULT visual_collection_create( ICompositor *compositor, struct composition_visual *owner,
+                                         struct visual_collection **out )
+{
+    struct visual_collection *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IVisualCollection_iface.lpVtbl = &visual_collection_vtbl;
+    impl->owner = owner;
+    list_init( &impl->children );
+    composition_object_init( &impl->object, &visual_collection_ops,
+                             (IInspectable *)&impl->IVisualCollection_iface, compositor );
+    *out = impl;
+    return S_OK;
+}
