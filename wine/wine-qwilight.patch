+/* These objects only record their properties; the compositor (device.c do_composite()) reads
+ * them back through dcomp_clip_get_rect() / dcomp_transform_get_matrix().  Animations are
+ * not supported: the animated setters fail with E_NOTIMPL. */
+
+#include <stdarg.h>
+#include <math.h>
+
+#define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "dcomp_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/* ---------------------------------------------------------------- rectangle clip */
+
+struct composition_rectangle_clip
+{
+    IDCompositionRectangleClip IDCompositionRectangleClip_iface;
+    LONG ref;
+    D2D_RECT_F rect;
+    float radius[8]; /* top-left x/y, top-right x/y, bottom-left x/y, bottom-right x/y */
+};
+
+static const struct IDCompositionRectangleClipVtbl rectangle_clip_vtbl;
+
+static inline struct composition_rectangle_clip *impl_from_IDCompositionRectangleClip(IDCompositionRectangleClip *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_rectangle_clip, IDCompositionRectangleClip_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE rectangle_clip_QueryInterface(IDCompositionRectangleClip *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown)
+            || IsEqualGUID(iid, &IID_IDCompositionClip)
+            || IsEqualGUID(iid, &IID_IDCompositionRectangleClip))
+    {
+        IDCompositionRectangleClip_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE rectangle_clip_AddRef(IDCompositionRectangleClip *iface)
+{
+    struct composition_rectangle_clip *clip = impl_from_IDCompositionRectangleClip(iface);
+    ULONG ref = InterlockedIncrement(&clip->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG STDMETHODCALLTYPE rectangle_clip_Release(IDCompositionRectangleClip *iface)
+{
+    struct composition_rectangle_clip *clip = impl_from_IDCompositionRectangleClip(iface);
+    ULONG ref = InterlockedDecrement(&clip->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    if (!ref)
+        free(clip);
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE rectangle_clip_animation(IDCompositionRectangleClip *iface,
+        IDCompositionAnimation *animation)
+{
+    FIXME("iface %p, animation %p stub!\n", iface, animation);
+    return E_NOTIMPL;
+}
+
+#define RECTANGLE_CLIP_SETTER(name, field) \
+    static HRESULT STDMETHODCALLTYPE rectangle_clip_##name(IDCompositionRectangleClip *iface, float value) \
+    { \
+        struct composition_rectangle_clip *clip = impl_from_IDCompositionRectangleClip(iface); \
+        TRACE("iface %p, value %f.\n", iface, value); \
+        dcomp_lock(); \
+        clip->field = value; \
+        dcomp_unlock(); \
+        return S_OK; \
+    }
+RECTANGLE_CLIP_SETTER(SetLeft, rect.left)
+RECTANGLE_CLIP_SETTER(SetTop, rect.top)
+RECTANGLE_CLIP_SETTER(SetRight, rect.right)
+RECTANGLE_CLIP_SETTER(SetBottom, rect.bottom)
+RECTANGLE_CLIP_SETTER(SetTopLeftRadiusX, radius[0])
+RECTANGLE_CLIP_SETTER(SetTopLeftRadiusY, radius[1])
+RECTANGLE_CLIP_SETTER(SetTopRightRadiusX, radius[2])
+RECTANGLE_CLIP_SETTER(SetTopRightRadiusY, radius[3])
+RECTANGLE_CLIP_SETTER(SetBottomLeftRadiusX, radius[4])
+RECTANGLE_CLIP_SETTER(SetBottomLeftRadiusY, radius[5])
+RECTANGLE_CLIP_SETTER(SetBottomRightRadiusX, radius[6])
+RECTANGLE_CLIP_SETTER(SetBottomRightRadiusY, radius[7])
+#undef RECTANGLE_CLIP_SETTER
+
+static const struct IDCompositionRectangleClipVtbl rectangle_clip_vtbl =
+{
+    rectangle_clip_QueryInterface,
+    rectangle_clip_AddRef,
+    rectangle_clip_Release,
+    rectangle_clip_animation,
+    rectangle_clip_SetLeft,
+    rectangle_clip_animation,
+    rectangle_clip_SetTop,
+    rectangle_clip_animation,
+    rectangle_clip_SetRight,
+    rectangle_clip_animation,
+    rectangle_clip_SetBottom,
+    rectangle_clip_animation,
+    rectangle_clip_SetTopLeftRadiusX,
+    rectangle_clip_animation,
+    rectangle_clip_SetTopLeftRadiusY,
+    rectangle_clip_animation,
+    rectangle_clip_SetTopRightRadiusX,
+    rectangle_clip_animation,
+    rectangle_clip_SetTopRightRadiusY,
+    rectangle_clip_animation,
+    rectangle_clip_SetBottomLeftRadiusX,
+    rectangle_clip_animation,
+    rectangle_clip_SetBottomLeftRadiusY,
+    rectangle_clip_animation,
+    rectangle_clip_SetBottomRightRadiusX,
+    rectangle_clip_animation,
+    rectangle_clip_SetBottomRightRadiusY,
+};
+
+HRESULT create_rectangle_clip(IDCompositionRectangleClip **clip)
+{
+    struct composition_rectangle_clip *object;
+
+    if (!clip)
+        return E_INVALIDARG;
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->IDCompositionRectangleClip_iface.lpVtbl = &rectangle_clip_vtbl;
+    object->ref = 1;
+    /* A fresh clip clips nothing: DirectComposition's default is an infinite rectangle. */
+    object->rect.left = object->rect.top = -INFINITY;
+    object->rect.right = object->rect.bottom = INFINITY;
+    *clip = &object->IDCompositionRectangleClip_iface;
+    return S_OK;
+}
+
+BOOL dcomp_clip_get_rect(IUnknown *unknown, D2D_RECT_F *rect)
+{
+    struct composition_rectangle_clip *clip;
+
+    if (!unknown || ((IDCompositionRectangleClip *)unknown)->lpVtbl != &rectangle_clip_vtbl)
+        return FALSE;
+    clip = impl_from_IDCompositionRectangleClip((IDCompositionRectangleClip *)unknown);
+    *rect = clip->rect;
+    if (clip->radius[0] || clip->radius[1] || clip->radius[2] || clip->radius[3]
+            || clip->radius[4] || clip->radius[5] || clip->radius[6] || clip->radius[7])
+        WARN("Rounded corners are ignored.\n");
+    return TRUE;
+}
+
+/* ---------------------------------------------------------------- 2D matrix transform */
+
+struct composition_matrix_transform
+{
+    IDCompositionMatrixTransform IDCompositionMatrixTransform_iface;
+    LONG ref;
+    D2D_MATRIX_3X2_F matrix;
+};
+
+static const struct IDCompositionMatrixTransformVtbl matrix_transform_vtbl;
+
+static inline struct composition_matrix_transform *impl_from_IDCompositionMatrixTransform(IDCompositionMatrixTransform *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_matrix_transform, IDCompositionMatrixTransform_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE matrix_transform_QueryInterface(IDCompositionMatrixTransform *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown)
+            || IsEqualGUID(iid, &IID_IDCompositionEffect)
+            || IsEqualGUID(iid, &IID_IDCompositionTransform3D)
+            || IsEqualGUID(iid, &IID_IDCompositionTransform)
+            || IsEqualGUID(iid, &IID_IDCompositionMatrixTransform))
+    {
+        IDCompositionMatrixTransform_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE matrix_transform_AddRef(IDCompositionMatrixTransform *iface)
+{
+    struct composition_matrix_transform *transform = impl_from_IDCompositionMatrixTransform(iface);
+    ULONG ref = InterlockedIncrement(&transform->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    return ref;
+}
+
+static ULONG STDMETHODCALLTYPE matrix_transform_Release(IDCompositionMatrixTransform *iface)
+{
+    struct composition_matrix_transform *transform = impl_from_IDCompositionMatrixTransform(iface);
+    ULONG ref = InterlockedDecrement(&transform->ref);
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    if (!ref)
+        free(transform);
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE matrix_transform_SetMatrix(IDCompositionMatrixTransform *iface,
+        const D2D_MATRIX_3X2_F *matrix)
+{
+    struct composition_matrix_transform *transform = impl_from_IDCompositionMatrixTransform(iface);
+
+    TRACE("iface %p, matrix {%f %f %f %f %f %f}.\n", iface, matrix->_11, matrix->_12, matrix->_21,
+            matrix->_22, matrix->_31, matrix->_32);
+
+    dcomp_lock();
+    transform->matrix = *matrix;
+    dcomp_unlock();
+    return S_OK;
