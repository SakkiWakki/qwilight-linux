+/* dlls/dcomp implements only part of IDCompositionVisual (SetCompositeMode, for
+ * one, is still E_NOTIMPL).  A WinRT property setter that fails is an
+ * uncatchable C++/WinRT throw in every App SDK caller, and the value is recorded
+ * here either way, so a dcomp refusal is downgraded to a WARN. */
+static HRESULT visual_record_dcomp_result( const char *what, HRESULT hr )
+{
+    if (FAILED(hr)) WARN( "dcomp %s failed, hr %#lx; recorded only.\n", what, hr );
+    return S_OK;
+}
