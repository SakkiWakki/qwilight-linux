+static HRESULT d2d_geometry_combine_approx(ID2D1Geometry *geometry, ID2D1Geometry *other,
+        D2D1_COMBINE_MODE combine_mode, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        ID2D1SimplifiedGeometrySink *sink)
+{
+    ID2D1PathGeometry *a = NULL, *b = NULL;
+    struct d2d_geometry *ga, *gb;
+    D2D1_FILL_MODE fill_mode;
+    BOOL emit_a = TRUE;
+    D2D1_RECT_F clip;
+    HRESULT hr;
+    size_t i;
+
+    if (tolerance <= 0.0f)
+        tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+
+    /* Exact case that the XAML compositor needs: intersection of a text/element surface rectangle
+     * with a (rounded) clip path. Clip the flattened path against the rectangle. The old
+     * assumption "the second geometry lies inside the first" emitted the whole clip shape and made
+     * XAML sample its atlas far outside the element's tile. */
+    if (combine_mode == D2D1_COMBINE_MODE_INTERSECT)
+    {
+        if (d2d_geometry_get_aligned_rect(geometry, NULL, &clip))
+        {
+            if (FAILED(hr = d2d_geometry_get_simplified(other, transform, tolerance, &b))) goto done;
+            gb = unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)b);
+            TRACE("Clipping %lu figures of %p against rectangle %s.\n", (unsigned long)gb->u.path.figure_count, other, debug_d2d_rect_f(&clip));
+            ID2D1SimplifiedGeometrySink_SetFillMode(sink, gb->u.path.fill_mode);
+            for (i = 0; i < gb->u.path.figure_count; ++i)
+                d2d_figure_clip_rect_emit(&gb->u.path.figures[i], &clip, sink);
+            goto done;
+        }
+        if (d2d_geometry_get_aligned_rect(other, transform, &clip))
+        {
+            if (FAILED(hr = d2d_geometry_get_simplified(geometry, NULL, tolerance, &a))) goto done;
+            ga = unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)a);
+            TRACE("Clipping %lu figures of %p against transformed rectangle %s.\n", (unsigned long)ga->u.path.figure_count, geometry, debug_d2d_rect_f(&clip));
+            ID2D1SimplifiedGeometrySink_SetFillMode(sink, ga->u.path.fill_mode);
+            for (i = 0; i < ga->u.path.figure_count; ++i)
+                d2d_figure_clip_rect_emit(&ga->u.path.figures[i], &clip, sink);
+            goto done;
+        }
+    }
+
+    FIXME("Approximating combine mode %#x; only exact for simple, nested or disjoint geometries.\n", combine_mode);
+
+    if (FAILED(hr = d2d_geometry_get_simplified(geometry, NULL, tolerance, &a)))
+        goto done;
+    if (FAILED(hr = d2d_geometry_get_simplified(other, transform, tolerance, &b)))
+        goto done;
+    ga = unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)a);
+    gb = unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)b);
+
+    switch (combine_mode)
+    {
+        case D2D1_COMBINE_MODE_UNION:
+            fill_mode = D2D1_FILL_MODE_WINDING;
+            break;
+        case D2D1_COMBINE_MODE_INTERSECT:
+            /* Assume the second geometry lies inside the first. */
+            fill_mode = gb->u.path.fill_mode;
+            emit_a = FALSE;
+            break;
+        case D2D1_COMBINE_MODE_XOR:
+        case D2D1_COMBINE_MODE_EXCLUDE:
+            fill_mode = D2D1_FILL_MODE_ALTERNATE;
+            break;
+        default:
+            hr = E_INVALIDARG;
+            goto done;
+    }
+
+    ID2D1SimplifiedGeometrySink_SetFillMode(sink, fill_mode);
+    if (emit_a)
+    {
+        for (i = 0; i < ga->u.path.figure_count; ++i)
+            d2d_figure_simplify(&ga->u.path.figures[i], D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES, NULL, tolerance, sink);
+    }
+    for (i = 0; i < gb->u.path.figure_count; ++i)
+        d2d_figure_simplify(&gb->u.path.figures[i], D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES, NULL, tolerance, sink);
+
+done:
+    if (b) ID2D1PathGeometry_Release(b);
+    if (a) ID2D1PathGeometry_Release(a);
+    return hr;
+}
