+static HRESULT device_internal_set_commit_completion_event(struct composition_device *device, HANDLE event)
+{
+    HANDLE dup = NULL;
+
+    if (event && !DuplicateHandle(GetCurrentProcess(), event, GetCurrentProcess(), &dup, 0, FALSE,
+                                  DUPLICATE_SAME_ACCESS))
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    dcomp_lock();
+    if (device->commit_completion_event)
+        CloseHandle(device->commit_completion_event);
+    device->commit_completion_event = dup;
+    {
+        struct completion_event_entry *e, *found = NULL;
+        LIST_FOR_EACH_ENTRY(e, &completion_events, struct completion_event_entry, entry)
+            if (e->device == device) found = e;
+        if (!dup)
+        {
+            if (found) { list_remove(&found->entry); free(found); }
+        }
+        else if (found) found->event = dup;
+        else if ((e = calloc(1, sizeof(*e))))
+        {
+            e->device = device;
+            e->event = dup;
+            list_add_tail(&completion_events, &e->entry);
+        }
+    }
+    dcomp_unlock();
+    return S_OK;
+}
