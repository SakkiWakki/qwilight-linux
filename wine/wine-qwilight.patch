+static void draw_diag_vertices(struct d3d11_device_context *context, unsigned int count, unsigned int start, int base, BOOL indexed);
+static const void *draw_diag_shadow(ID3D11Resource *resource, unsigned int *size);
+static int mask_diag_enabled(void);
+static int mask_diag_in_tile(unsigned int width, unsigned int height, float l, float t, float r, float b);
+static void guard_debug_dump_to(struct d3d_device *device, ID3D11Texture2D *texture, const RECT *rect, const char *tag, const char *dir);
