+/* Runs on the thread pool: performs the request and builds the response. */
+static HRESULT transport_send_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    IHttpRequestMessage *request = (IHttpRequestMessage *)param;
+    struct response_message *response = NULL;
+    IHttpContent *content = NULL;
+    IHttpMethod *method = NULL;
+    IUriRuntimeClass *uri = NULL;
+    HSTRING method_str = NULL, uri_str = NULL;
+    URL_COMPONENTS uc = { sizeof(uc) };
+    WCHAR host[256], path[4096];
+    WCHAR *headers = NULL, *raw_headers = NULL;
+    HINTERNET session, connect = NULL, req = NULL;
+    void *body = NULL;
+    UINT32 body_size = 0;
+    BYTE *data = NULL;
+    SIZE_T data_size = 0, data_cap = 0;
+    DWORD status = 0, size, avail, read, flags;
+    HRESULT hr = E_FAIL;
+    BOOL ok;
+
+    if (!called_async) return STATUS_PENDING;   /* do the network work on the pool thread */
+    if (!request) return WINE_HTTP_E_NO_TRANSPORT;
+
+    if (FAILED(IHttpRequestMessage_get_Method( request, &method )) || !method
+            || FAILED(IHttpMethod_get_Method( method, &method_str ))) { hr = E_INVALIDARG; goto done; }
+    if (FAILED(IHttpRequestMessage_get_RequestUri( request, &uri )) || !uri
+            || FAILED(IUriRuntimeClass_get_AbsoluteUri( uri, &uri_str ))) { hr = E_INVALIDARG; goto done; }
+
+    uc.lpszHostName = host; uc.dwHostNameLength = ARRAY_SIZE(host);
+    uc.lpszUrlPath = path; uc.dwUrlPathLength = ARRAY_SIZE(path);
+    uc.dwSchemeLength = 1; uc.dwExtraInfoLength = 1;  /* combine path and query below */
+    if (!WinHttpCrackUrl( WindowsGetStringRawBuffer( uri_str, NULL ), 0, 0, &uc ))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        WARN( "bad url %s, hr %#lx.\n", debugstr_hstring( uri_str ), hr );
+        goto done;
+    }
+    if (uc.dwExtraInfoLength && uc.lpszExtraInfo)
+    {
+        SIZE_T plen = wcslen( path );
+        if (plen + uc.dwExtraInfoLength + 1 < ARRAY_SIZE(path)) lstrcpynW( path + plen, uc.lpszExtraInfo, uc.dwExtraInfoLength + 1 );
+    }
+
+    TRACE( "%s %s\n", debugstr_hstring( method_str ), debugstr_hstring( uri_str ) );
+
+    if (!(session = transport_session())) { hr = HRESULT_FROM_WIN32( GetLastError() ); goto done; }
+    if (!(connect = WinHttpConnect( session, host, uc.nPort, 0 ))) { hr = HRESULT_FROM_WIN32( GetLastError() ); goto done; }
+    flags = uc.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0;
+    if (!(req = WinHttpOpenRequest( connect, WindowsGetStringRawBuffer( method_str, NULL ), path, NULL,
+            WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, flags )))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        goto done;
+    }
+    {
+        DWORD decompression = WINHTTP_DECOMPRESSION_FLAG_ALL;
+        WinHttpSetOption( req, WINHTTP_OPTION_DECOMPRESSION, &decompression, sizeof(decompression) );
+    }
+
+    if (FAILED(hr = transport_collect_headers( request, &headers ))) goto done;
+    if (headers && *headers && !WinHttpAddRequestHeaders( req, headers, -1, WINHTTP_ADDREQ_FLAG_ADD | WINHTTP_ADDREQ_FLAG_REPLACE ))
+        WARN( "adding headers failed, error %lu.\n", GetLastError() );
+
+    if (SUCCEEDED(IHttpRequestMessage_get_Content( request, &content )) && content)
+    {
+        if (FAILED(hr = http_content_get_bytes( content, &body, &body_size ))) goto done;
+    }
+
+    ok = WinHttpSendRequest( req, WINHTTP_NO_ADDITIONAL_HEADERS, 0, body, body_size, body_size, 0 );
+    if (ok) ok = WinHttpReceiveResponse( req, NULL );
+    if (!ok)
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        WARN( "request to %s failed, hr %#lx.\n", debugstr_hstring( uri_str ), hr );
+        goto done;
+    }
+
+    size = sizeof(status);
+    WinHttpQueryHeaders( req, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX,
+            &status, &size, WINHTTP_NO_HEADER_INDEX );
+
+    if (FAILED(hr = response_message_create( request, &response ))) goto done;
+    response->status = status;
+
+    size = 0;
+    WinHttpQueryHeaders( req, WINHTTP_QUERY_STATUS_TEXT, WINHTTP_HEADER_NAME_BY_INDEX, NULL, &size, WINHTTP_NO_HEADER_INDEX );
+    if (size && (raw_headers = malloc( size )))
+    {
+        if (WinHttpQueryHeaders( req, WINHTTP_QUERY_STATUS_TEXT, WINHTTP_HEADER_NAME_BY_INDEX, raw_headers, &size, WINHTTP_NO_HEADER_INDEX ))
+            WindowsCreateString( raw_headers, wcslen( raw_headers ), &response->reason );
+        free( raw_headers ); raw_headers = NULL;
+    }
+
+    /* body */
+    for (;;)
+    {
+        avail = 0;
+        if (!WinHttpQueryDataAvailable( req, &avail )) break;
+        if (!avail) break;
+        if (data_size + avail > data_cap)
+        {
+            SIZE_T ncap = max( data_cap * 2, data_size + avail + 65536 );
+            BYTE *n = realloc( data, ncap );
+            if (!n) { hr = E_OUTOFMEMORY; goto done; }
+            data = n; data_cap = ncap;
+        }
+        read = 0;
+        if (!WinHttpReadData( req, data + data_size, avail, &read )) break;
+        if (!read) break;
+        data_size += read;
+    }
+    if (FAILED(hr = http_bytes_content_create( data, data_size, &response->content ))) goto done;
+
+    /* headers: all into the response collection, entity headers also into the content's */
+    size = 0;
+    WinHttpQueryHeaders( req, WINHTTP_QUERY_RAW_HEADERS_CRLF, WINHTTP_HEADER_NAME_BY_INDEX, NULL, &size, WINHTTP_NO_HEADER_INDEX );
+    if (size && (raw_headers = malloc( size ))
+            && WinHttpQueryHeaders( req, WINHTTP_QUERY_RAW_HEADERS_CRLF, WINHTTP_HEADER_NAME_BY_INDEX, raw_headers, &size, WINHTTP_NO_HEADER_INDEX ))
+    {
+        IHttpContentHeaderCollection *cheaders = NULL;
+        WCHAR *line = raw_headers, *next, *colon;
+        IHttpContent_get_Headers( response->content, &cheaders );
+        while (line && *line)
+        {
+            if ((next = wcsstr( line, L"\r\n" ))) { *next = 0; next += 2; }
+            if ((colon = wcschr( line, ':' )))
+            {
+                HSTRING name, value;
+                WCHAR *v = colon + 1;
+                *colon = 0;
+                while (*v == ' ') ++v;
+                if (SUCCEEDED(WindowsCreateString( line, wcslen( line ), &name )) && SUCCEEDED(WindowsCreateString( v, wcslen( v ), &value )))
+                {
+                    IHttpResponseHeaderCollection_Append( response->headers, name, value );
+                    if (cheaders && !_wcsnicmp( line, L"Content-", 8 ) && !_wcsicmp( line, L"Content-Type" ))
+                        IHttpContentHeaderCollection_Append( cheaders, name, value );
+                    else if (cheaders && !_wcsnicmp( line, L"Content-", 8 ))
+                        IHttpContentHeaderCollection_TryAppendWithoutValidation( cheaders, name, value, &(boolean){0} );
+                    WindowsDeleteString( name ); WindowsDeleteString( value );
+                }
+            }
+            line = next;
+        }
+        if (cheaders) IHttpContentHeaderCollection_Release( cheaders );
+    }
+
+    TRACE( "%s -> status %lu, %Iu bytes.\n", debugstr_hstring( uri_str ), status, data_size );
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)&response->IHttpResponseMessage_iface;
+    response = NULL;
+    hr = S_OK;
+
+done:
+    if (response) IHttpResponseMessage_Release( &response->IHttpResponseMessage_iface );
+    free( raw_headers );
+    free( data );
+    free( body );
+    free( headers );
+    if (req) WinHttpCloseHandle( req );
+    if (connect) WinHttpCloseHandle( connect );
+    if (content) IHttpContent_Release( content );
+    WindowsDeleteString( uri_str );
+    WindowsDeleteString( method_str );
+    if (uri) IUriRuntimeClass_Release( uri );
+    if (method) IHttpMethod_Release( method );
+    return hr;
+}
+
+HRESULT transport_send( IUnknown *invoker, IHttpRequestMessage *request,
+        IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **operation )
+{
+    return async_operation_response_create_impl( invoker, (IUnknown *)request, transport_send_callback, operation );
+}
diff --git a/dlls/wined3d/shared.c b/dlls/wined3d/shared.c
new file mode 100644
index 00000000..bf31120d
--- /dev/null
+++ b/dlls/wined3d/shared.c
@@ -0,0 +1,951 @@
+/*
+ * Cross-device shared resources (DXGI shared handles, keyed mutexes).
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "wined3d_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d_shared);
+
+/* A shared resource is one GL texture object (or, later, one buffer object)
+ * adopted by N wined3d textures, one per device. The devices may belong to
+ * different struct wined3d instances (each DXGI factory creates its own), so
+ * the registry below is process-global and keyed by the adapter LUID.
+ *
+ * The share handles handed to applications are real d3dkmt objects, created
+ * through gdi32's D3DKMT* exports and backed by wineserver: NT handles come
+ * from D3DKMTShareObjects() on a dummy standard allocation, KMT handles are
+ * that allocation's global handle. The allocation's private runtime data
+ * carries a blob with the registry id, so an open only has to validate the
+ * handle and look the entry up. Cross-process sharing would need
+ * EXT_external_objects on the unix side and is refused. */
+
+#define WINED3D_SHARED_BLOB_MAGIC   0x53443357 /* 'W3DS' */
+#define WINED3D_SHARED_BLOB_VERSION 1
+#define WINED3D_SHARED_SYSMEM_SIZE  0x1000
+
+struct wined3d_shared_blob
+{
+    uint32_t magic;
+    uint32_t version;
+    uint64_t id;
+    uint32_t process_id;
+    uint32_t layer_count;
+    uint32_t level_count;
+    uint32_t mutex_global;          /* KMT handle of the keyed mutex, non-NT sharing only. */
+    struct wined3d_resource_desc desc;
+};
+
+struct list wined3d_shared_resources = LIST_INIT(wined3d_shared_resources);
+LONG wined3d_shared_resource_count;
+static uint64_t wined3d_shared_next_id = 1;
+
+static CRITICAL_SECTION wined3d_shared_cs;
+static CRITICAL_SECTION_DEBUG wined3d_shared_cs_debug =
+{
+    0, 0, &wined3d_shared_cs,
+    {&wined3d_shared_cs_debug.ProcessLocksList, &wined3d_shared_cs_debug.ProcessLocksList},
+    0, 0, {(DWORD_PTR)(__FILE__ ": wined3d_shared_cs")}
+};
+static CRITICAL_SECTION wined3d_shared_cs = {&wined3d_shared_cs_debug, -1, 0, 0, 0, 0};
+
+void wined3d_shared_lock(void)
+{
+    EnterCriticalSection(&wined3d_shared_cs);
+}
+
+void wined3d_shared_unlock(void)
+{
+    LeaveCriticalSection(&wined3d_shared_cs);
+}
+
+/* One d3dkmt device per adapter per process, created lazily and never
+ * destroyed (like the root GL contexts, adapters outlive devices). */
+struct wined3d_shared_kmt_device
+{
+    LUID luid;
+    D3DKMT_HANDLE device;
+};
+
+static struct wined3d_shared_kmt_device *kmt_devices;
+static SIZE_T kmt_device_count, kmt_device_size;
+
+static D3DKMT_HANDLE wined3d_shared_get_kmt_device(const struct wined3d_adapter *adapter)
+{
+    D3DKMT_CREATEDEVICE create_device_desc = {{0}};
+    const LUID *luid = &adapter->luid;
+    D3DKMT_HANDLE device = 0;
+    NTSTATUS status;
+    SIZE_T i;
+
+    wined3d_shared_lock();
+
+    for (i = 0; i < kmt_device_count; ++i)
+    {
+        if (kmt_devices[i].luid.LowPart == luid->LowPart && kmt_devices[i].luid.HighPart == luid->HighPart)
+        {
+            device = kmt_devices[i].device;
+            goto done;
+        }
+    }
+
+    if (!wined3d_array_reserve((void **)&kmt_devices, &kmt_device_size, kmt_device_count + 1, sizeof(*kmt_devices)))
+        goto done;
+
+    create_device_desc.hAdapter = adapter->kmt_adapter;
+    if ((status = D3DKMTCreateDevice(&create_device_desc)))
+    {
+        ERR("Failed to create a d3dkmt device for adapter %p, status %#lx.\n", adapter, status);
+        goto done;
+    }
+    device = create_device_desc.hDevice;
+    TRACE("Created d3dkmt device %#x for adapter LUID %08lx:%08lx.\n", device, luid->HighPart, luid->LowPart);
+
+    kmt_devices[kmt_device_count].luid = *luid;
+    kmt_devices[kmt_device_count].device = device;
+    ++kmt_device_count;
+
+done:
+    wined3d_shared_unlock();
+    return device;
+}
+
+static struct wined3d_shared_resource *wined3d_shared_resource_find(uint64_t id)
+{
+    struct wined3d_shared_resource *shared;
+
+    LIST_FOR_EACH_ENTRY(shared, &wined3d_shared_resources, struct wined3d_shared_resource, entry)
+    {
+        if (shared->id == id)
+            return shared;
+    }
+
+    return NULL;
+}
+
+/* Registers the exporting texture. Called from the backend's texture init
+ * when the texture is created with WINED3DUSAGE_SHARED. */
+HRESULT wined3d_shared_resource_create(struct wined3d_texture *texture)
+{
+    const struct wined3d_resource *resource = &texture->resource;
+    struct wined3d_shared_resource *shared;
+
+    if (!(shared = calloc(1, sizeof(*shared))))
+        return E_OUTOFMEMORY;
+
+    shared->ref = 1;
+    shared->adapter_luid = resource->device->adapter->luid;
+    shared->desc.resource_type = resource->type;
+    shared->desc.format = resource->format->id;
+    shared->desc.multisample_type = resource->multisample_type;
+    shared->desc.multisample_quality = resource->multisample_quality;
+    shared->desc.usage = resource->usage;
+    shared->desc.bind_flags = resource->bind_flags;
+    shared->desc.access = resource->access;
+    shared->desc.width = resource->width;
+    shared->desc.height = resource->height;
+    shared->desc.depth = resource->depth;
+    shared->desc.size = resource->size;
+    shared->layer_count = texture->layer_count;
+    shared->level_count = texture->level_count;
+    shared->exporter = texture;
+    list_init(&shared->users);
+
+    wined3d_shared_lock();
+    shared->id = wined3d_shared_next_id++;
+    list_add_tail(&wined3d_shared_resources, &shared->entry);
+    InterlockedIncrement(&wined3d_shared_resource_count);
+    wined3d_shared_unlock();
+
+    texture->shared = shared;
+
+    TRACE("Created shared resource %p, id %s, for texture %p (%ux%u, %s, usage %s).\n",
+            shared, wine_dbgstr_longlong(shared->id), texture, resource->width, resource->height,
+            debug_d3dformat(resource->format->id), debug_d3dusage(resource->usage));
+
+    return WINED3D_OK;
+}
+
+static ULONG wined3d_shared_resource_incref(struct wined3d_shared_resource *shared)
+{
+    ULONG refcount = InterlockedIncrement(&shared->ref);
+
+    TRACE("%p increasing refcount to %lu.\n", shared, refcount);
+
+    return refcount;
+}
+
+ULONG wined3d_shared_resource_decref(struct wined3d_shared_resource *shared)
+{
+    ULONG refcount;
+
+    wined3d_shared_lock();
+    refcount = InterlockedDecrement(&shared->ref);
+    TRACE("%p decreasing refcount to %lu.\n", shared, refcount);
+    if (!refcount)
+    {
+        list_remove(&shared->entry);
+        InterlockedDecrement(&wined3d_shared_resource_count);
+    }
+    wined3d_shared_unlock();
+
+    if (!refcount)
+    {
+        if (shared->gl_name)
+            WARN("Shared resource %p destroyed with GL texture %u still allocated.\n", shared, shared->gl_name);
+        if (!list_empty(&shared->users))
+            ERR("Shared resource %p destroyed with users.\n", shared);
+        if (shared->kmt_sysmem)
+            VirtualFree(shared->kmt_sysmem, 0, MEM_RELEASE);
+        free(shared);
+    }
+
+    return refcount;
+}
+
+static HRESULT hresult_from_kmt_status(NTSTATUS status)
+{
+    switch (status)
+    {
+        case STATUS_SUCCESS:
+            return S_OK;
+        case STATUS_NO_MEMORY:
+            return E_OUTOFMEMORY;
+        case STATUS_TIMEOUT:
+            return WAIT_TIMEOUT;
+        case STATUS_ABANDONED:
+            return WAIT_ABANDONED;
+        default:
+            return E_INVALIDARG;
+    }
+}
+
+static bool wined3d_shared_resource_is_nt(const struct wined3d_shared_resource *shared)
+{
+    return !!(shared->desc.usage & WINED3DUSAGE_SHARED_NT_HANDLE);
+}
+
+static bool wined3d_shared_resource_has_keyed_mutex(const struct wined3d_shared_resource *shared)
+{
+    return !!(shared->desc.usage & WINED3DUSAGE_SHARED_KEYED_MUTEX);
+}
+
+static void wined3d_shared_blob_init(struct wined3d_shared_blob *blob, const struct wined3d_shared_resource *shared)
+{
+    memset(blob, 0, sizeof(*blob));
+    blob->magic = WINED3D_SHARED_BLOB_MAGIC;
+    blob->version = WINED3D_SHARED_BLOB_VERSION;
+    blob->id = shared->id;
+    blob->process_id = GetCurrentProcessId();
+    blob->layer_count = shared->layer_count;
+    blob->level_count = shared->level_count;
+    blob->mutex_global = shared->kmt_mutex_global;
+    blob->desc = shared->desc;
+}
+
+static void wined3d_shared_texture_destroy_kmt(struct wined3d_texture *texture)
+{
+    D3DKMT_HANDLE kmt_device;
+
+    if (texture->shared_kmt_mutex)
+    {
+        D3DKMT_DESTROYKEYEDMUTEX destroy_mutex = {.hKeyedMutex = texture->shared_kmt_mutex};
+
+        /* Destroying an owned mutex abandons it. */
+        D3DKMTDestroyKeyedMutex(&destroy_mutex);
+        texture->shared_kmt_mutex = 0;
+        texture->shared_mutex_owned = false;
+    }
+
+    if (texture->shared_kmt_sync)
+    {
+        D3DKMT_DESTROYSYNCHRONIZATIONOBJECT destroy_sync = {.hSyncObject = texture->shared_kmt_sync};
+
+        D3DKMTDestroySynchronizationObject(&destroy_sync);
+        texture->shared_kmt_sync = 0;
+    }
+
+    if (texture->shared_kmt_resource && (kmt_device = wined3d_shared_get_kmt_device(texture->resource.device->adapter)))
+    {
+        D3DKMT_DESTROYALLOCATION2 destroy_alloc = {.hDevice = kmt_device, .hResource = texture->shared_kmt_resource};
+
+        D3DKMTDestroyAllocation2(&destroy_alloc);
+        texture->shared_kmt_resource = 0;
+    }
+}
+
+/* Creates the exporting texture's d3dkmt objects on first use. Application
+ * thread, under wined3d_mutex. */
+static HRESULT wined3d_shared_resource_ensure_kmt(struct wined3d_texture *texture)
+{
+    struct wined3d_shared_resource *shared = texture->shared;
+    D3DKMT_CREATESTANDARDALLOCATION standard_alloc = {0};
+    D3DKMT_CREATEALLOCATION create_alloc = {0};
+    D3DDDI_ALLOCATIONINFO alloc_info = {0};
+    struct wined3d_shared_blob blob;
+    D3DKMT_HANDLE kmt_device;
+    NTSTATUS status;
+    bool nt;
+
+    if (texture->shared_kmt_resource)
+        return S_OK;
+
+    if (texture->flags & WINED3D_TEXTURE_SHARED_IMPORT)
+    {
+        ERR("Imported texture %p has no d3dkmt resource.\n", texture);
+        return E_FAIL;
+    }
+
+    if (!(kmt_device = wined3d_shared_get_kmt_device(texture->resource.device->adapter)))
+        return E_FAIL;
+
+    nt = wined3d_shared_resource_is_nt(shared);
+
+    if (wined3d_shared_resource_has_keyed_mutex(shared))
+    {
+        D3DKMT_CREATESYNCHRONIZATIONOBJECT2 create_sync = {0};
+        D3DKMT_CREATEKEYEDMUTEX2 create_mutex = {0};
+
+        create_mutex.Flags.NtSecuritySharing = nt;
+        if ((status = D3DKMTCreateKeyedMutex2(&create_mutex)))
+        {
+            ERR("Failed to create a keyed mutex, status %#lx.\n", status);
+            return hresult_from_kmt_status(status);
+        }
+        texture->shared_kmt_mutex = create_mutex.hKeyedMutex;
+        shared->kmt_mutex_global = create_mutex.hSharedHandle;
+
+        create_sync.hDevice = kmt_device;
+        create_sync.Info.Type = D3DDDI_SYNCHRONIZATION_MUTEX;
+        create_sync.Info.Flags.Shared = 1;
+        create_sync.Info.Flags.NtSecuritySharing = nt;
+        if ((status = D3DKMTCreateSynchronizationObject2(&create_sync)))
+        {
+            ERR("Failed to create a synchronization object, status %#lx.\n", status);
+            wined3d_shared_texture_destroy_kmt(texture);
+            return hresult_from_kmt_status(status);
+        }
+        texture->shared_kmt_sync = create_sync.hSyncObject;
+    }
+
+    if (!shared->kmt_sysmem && !(shared->kmt_sysmem = VirtualAlloc(NULL, WINED3D_SHARED_SYSMEM_SIZE,
+            MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE)))
+    {
+        wined3d_shared_texture_destroy_kmt(texture);
+        return E_OUTOFMEMORY;
+    }
+
+    wined3d_shared_blob_init(&blob, shared);
+
+    standard_alloc.Type = D3DKMT_STANDARDALLOCATIONTYPE_EXISTINGHEAP;
+    standard_alloc.ExistingHeapData.Size = WINED3D_SHARED_SYSMEM_SIZE;
+    alloc_info.pSystemMem = shared->kmt_sysmem;
+
+    create_alloc.hDevice = kmt_device;
+    create_alloc.pPrivateRuntimeData = &blob;
+    create_alloc.PrivateRuntimeDataSize = sizeof(blob);
+    create_alloc.pStandardAllocation = &standard_alloc;
+    create_alloc.NumAllocations = 1;
+    create_alloc.pAllocationInfo = &alloc_info;
+    create_alloc.Flags.CreateResource = 1;
+    create_alloc.Flags.CreateShared = 1;
+    create_alloc.Flags.ExistingSysMem = 1;
+    create_alloc.Flags.StandardAllocation = 1;
+    create_alloc.Flags.NtSecuritySharing = nt;
+    if ((status = D3DKMTCreateAllocation2(&create_alloc)))
+    {
+        ERR("Failed to create the d3dkmt allocation, status %#lx.\n", status);
+        wined3d_shared_texture_destroy_kmt(texture);
+        return hresult_from_kmt_status(status);
+    }
+    texture->shared_kmt_resource = create_alloc.hResource;
+    shared->kmt_global = create_alloc.hGlobalShare;
+    shared->kmt_created = true;
+
+    TRACE("Shared resource %p: d3dkmt resource %#x, global %#x, mutex %#x (global %#x), sync %#x.\n",
+            shared, texture->shared_kmt_resource, shared->kmt_global, texture->shared_kmt_mutex,
+            shared->kmt_mutex_global, texture->shared_kmt_sync);
+
+    return S_OK;
+}
+
+/* Application thread, from wined3d_texture_cleanup(): the texture is going
+ * away, drop the exporter link and the d3dkmt objects. The keyed mutex has
+ * to be destroyed on an application thread: wineserver tracks the owning
+ * thread, and abandoning it from the CS thread would be refused. */
+void wined3d_shared_resource_texture_destroy(struct wined3d_texture *texture)
+{
+    struct wined3d_shared_resource *shared = texture->shared;
+
+    TRACE("texture %p, shared %p.\n", texture, shared);
+
+    wined3d_shared_lock();
+    if (shared->exporter == texture)
+        shared->exporter = NULL;
+    wined3d_shared_unlock();
+
+    wined3d_shared_texture_destroy_kmt(texture);
+}
+
+/* CS thread, after the texture's GPU resources were unloaded. */
+void wined3d_shared_resource_texture_destroy_object(struct wined3d_texture *texture)
+{
+    struct wined3d_shared_resource *shared = texture->shared;
+    struct wined3d_shared_user *user = &texture->shared_user;
+
+    TRACE("texture %p, shared %p.\n", texture, shared);
+
+    wined3d_shared_lock();
+    if (!list_empty(&user->entry))
+    {
+        /* The backend couldn't unload (no context, d3d not initialised);
+         * the GL objects are leaked, but keep the bookkeeping straight. */
+        WARN("Texture %p still uses shared GL texture %u.\n", texture, shared->gl_name);
+        list_remove(&user->entry);
+        list_init(&user->entry);
+        user->sync = NULL;
+        if (!--shared->gl_name_users)
+            shared->gl_name = 0;
+    }
+    wined3d_shared_unlock();
+
+    texture->shared = NULL;
+    wined3d_shared_resource_decref(shared);
+}
+
+static void init_shared_resource_path(const WCHAR *name, UNICODE_STRING *str, WCHAR *buffer, SIZE_T buffer_size)
+{
+    static const WCHAR base_named_objects[] = L"\\BaseNamedObjects\\";
+    static const WCHAR sessions[] = L"\\Sessions\\";
+    ULONG session = NtCurrentTeb()->Peb->SessionId;
+    WCHAR session_id[16], *p = session_id + ARRAY_SIZE(session_id) - 1;
+    SIZE_T len = 0;
+
+    *p = 0;
+    do
+    {
+        *--p = '0' + session % 10;
+        session /= 10;
+    } while (session);
+    memmove(session_id, p, (wcslen(p) + 1) * sizeof(WCHAR));
+
+    buffer[0] = 0;
+    wcscpy(buffer, sessions);
+    len += wcslen(sessions);
+    wcscpy(buffer + len, session_id);
+    len += wcslen(session_id);
+    wcscpy(buffer + len, base_named_objects);
+    len += wcslen(base_named_objects);
+    if (len + wcslen(name) + 1 > buffer_size)
+    {
+        WARN("Name %s too long.\n", debugstr_w(name));
+        buffer[0] = 0;
+        len = 0;
+    }
+    else
+    {
+        wcscpy(buffer + len, name);
+        len += wcslen(name);
+    }
+
+    str->Buffer = buffer;
+    str->Length = len * sizeof(WCHAR);
+    str->MaximumLength = str->Length + sizeof(WCHAR);
+}
+
+HRESULT CDECL wined3d_resource_create_shared_handle(struct wined3d_resource *resource,
+        const SECURITY_ATTRIBUTES *attributes, DWORD access, const WCHAR *name, HANDLE *handle)
+{
+    struct wined3d_shared_resource *shared;
+    UNICODE_STRING name_str = {0};
+    D3DKMT_HANDLE handles[3];
+    OBJECT_ATTRIBUTES attr;
+    WCHAR buffer[MAX_PATH * 2];
+    struct wined3d_texture *texture;
+    unsigned int count = 1;
+    NTSTATUS status;
+    HRESULT hr;
+
+    TRACE("resource %p, attributes %p, access %#lx, name %s, handle %p.\n",
+            resource, attributes, access, debugstr_w(name), handle);
+
+    if (resource->type == WINED3D_RTYPE_BUFFER)
+    {
+        FIXME("Buffers are not supported.\n");
+        return E_NOTIMPL;
+    }
+    texture = texture_from_resource(resource);
+
+    if (!(shared = texture->shared))
+    {
+        if (resource->usage & WINED3DUSAGE_SHARED)
+        {
+            FIXME("Cross-device sharing is only implemented for the OpenGL backend.\n");
+            return E_NOTIMPL;
+        }
+        WARN("Resource %p is not shared.\n", resource);
+        return E_INVALIDARG;
+    }
+
+    if (!wined3d_shared_resource_is_nt(shared))
+    {
+        WARN("Resource %p is not shared with NT handles.\n", resource);
+        return E_INVALIDARG;
+    }
+
+    if (FAILED(hr = wined3d_shared_resource_ensure_kmt(texture)))
+        return hr;
+
+    handles[0] = texture->shared_kmt_resource;
+    if (wined3d_shared_resource_has_keyed_mutex(shared))
+    {
+        handles[1] = texture->shared_kmt_mutex;
+        handles[2] = texture->shared_kmt_sync;
+        count = 3;
+    }
+
+    if (name)
+        init_shared_resource_path(name, &name_str, buffer, ARRAY_SIZE(buffer));
+    InitializeObjectAttributes(&attr, name ? &name_str : NULL,
+            OBJ_CASE_INSENSITIVE | (attributes && attributes->bInheritHandle ? OBJ_INHERIT : 0),
+            NULL, attributes ? attributes->lpSecurityDescriptor : NULL);
+
+    if ((status = D3DKMTShareObjects(count, handles, &attr, access, handle)))
+    {
+        WARN("Failed to share the d3dkmt objects, status %#lx.\n", status);
+        return status == STATUS_OBJECT_NAME_COLLISION ? HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS) : E_INVALIDARG;
+    }
+
+    TRACE("Created NT handle %p for shared resource %p.\n", *handle, shared);
+
+    return S_OK;
+}
+
+HRESULT CDECL wined3d_resource_get_shared_handle(struct wined3d_resource *resource, HANDLE *handle)
+{
+    struct wined3d_shared_resource *shared;
+    struct wined3d_texture *texture;
+    HRESULT hr;
+
+    TRACE("resource %p, handle %p.\n", resource, handle);
+
+    if (resource->type == WINED3D_RTYPE_BUFFER)
+    {
+        FIXME("Buffers are not supported.\n");
+        return E_NOTIMPL;
+    }
+    texture = texture_from_resource(resource);
+
+    if (!(shared = texture->shared))
+    {
+        if (resource->usage & WINED3DUSAGE_SHARED)
+        {
+            FIXME("Cross-device sharing is only implemented for the OpenGL backend.\n");
+            return E_NOTIMPL;
+        }
+        *handle = NULL;
+        return S_OK;
+    }
+
+    if (wined3d_shared_resource_is_nt(shared))
+    {
+        WARN("Resource %p is shared with NT handles.\n", resource);
+        return E_INVALIDARG;
+    }
+
+    if (FAILED(hr = wined3d_shared_resource_ensure_kmt(texture)))
+        return hr;
+
+    *handle = (HANDLE)(ULONG_PTR)shared->kmt_global;
+    TRACE("Returning KMT handle %p for shared resource %p.\n", *handle, shared);
+
+    return S_OK;
+}
+
+HRESULT CDECL wined3d_device_open_shared_resource(struct wined3d_device *device, HANDLE handle,
+        uint32_t flags, struct wined3d_resource **resource)
+{
+    D3DKMT_HANDLE kmt_device, kmt_resource = 0, kmt_mutex = 0, kmt_sync = 0;
+    struct wined3d_shared_resource *shared = NULL;
+    struct wined3d_texture *texture, *exporter;
+    struct wined3d_shared_blob blob;
+    unsigned int sub_count, i;
+    NTSTATUS status;
+    HRESULT hr;
+
+    TRACE("device %p, handle %p, flags %#x, resource %p.\n", device, handle, flags, resource);
+
+    if (device->adapter->adapter_ops != &wined3d_adapter_gl_ops)
+    {
+        FIXME("Cross-device sharing is only implemented for the OpenGL backend.\n");
+        return E_NOTIMPL;
+    }
+
+    if (!handle)
+        return E_INVALIDARG;
+
+    if (!(kmt_device = wined3d_shared_get_kmt_device(device->adapter)))
+        return E_FAIL;
+
+    if (flags & WINED3D_OPEN_SHARED_RESOURCE_NT_HANDLE)
+    {
+        D3DKMT_QUERYRESOURCEINFOFROMNTHANDLE query = {0};
+        D3DKMT_OPENRESOURCEFROMNTHANDLE open = {0};
+        D3DDDI_OPENALLOCATIONINFO2 alloc_info = {0};
+        UINT64 driver_data;
+
+        query.hDevice = kmt_device;
+        query.hNtHandle = handle;
+        if ((status = D3DKMTQueryResourceInfoFromNtHandle(&query)))
+        {
+            WARN("Failed to query NT handle %p, status %#lx.\n", handle, status);
+            return E_INVALIDARG;
+        }
+        if (query.PrivateRuntimeDataSize != sizeof(blob))
+        {
+            WARN("NT handle %p has runtime data size %u, not a wined3d resource.\n",
+                    handle, query.PrivateRuntimeDataSize);
+            return E_INVALIDARG;
+        }
+
+        open.hDevice = kmt_device;
+        open.hNtHandle = handle;
+        open.NumAllocations = 1;
+        open.pOpenAllocationInfo2 = &alloc_info;
+        open.PrivateRuntimeDataSize = sizeof(blob);
+        open.pPrivateRuntimeData = &blob;
+        open.TotalPrivateDriverDataBufferSize = sizeof(driver_data);
+        open.pTotalPrivateDriverDataBuffer = &driver_data;
+        if ((status = D3DKMTOpenResourceFromNtHandle(&open)))
+        {
+            WARN("Failed to open NT handle %p, status %#lx.\n", handle, status);
+            return E_INVALIDARG;
+        }
+        kmt_resource = open.hResource;
+        kmt_mutex = open.hKeyedMutex;
+        kmt_sync = open.hSyncObject;
+    }
+    else
+    {
+        D3DKMT_HANDLE global = (D3DKMT_HANDLE)(ULONG_PTR)handle;
+        D3DKMT_QUERYRESOURCEINFO query = {0};
+        D3DDDI_OPENALLOCATIONINFO alloc_info = {0};
+        D3DKMT_OPENRESOURCE open = {0};
+
+        if ((ULONG_PTR)handle != global)
+        {
+            WARN("Handle %p is not a KMT handle.\n", handle);
+            return E_INVALIDARG;
+        }
+
+        query.hDevice = kmt_device;
+        query.hGlobalShare = global;
+        if ((status = D3DKMTQueryResourceInfo(&query)))
+        {
+            WARN("Failed to query KMT handle %#x, status %#lx.\n", global, status);
+            return E_INVALIDARG;
+        }
+        if (query.PrivateRuntimeDataSize != sizeof(blob))
+        {
+            WARN("KMT handle %#x has runtime data size %u, not a wined3d resource.\n",
+                    global, query.PrivateRuntimeDataSize);
+            return E_INVALIDARG;
+        }
+
+        open.hDevice = kmt_device;
+        open.hGlobalShare = global;
+        open.NumAllocations = 1;
+        open.pOpenAllocationInfo = &alloc_info;
+        open.pPrivateRuntimeData = &blob;
+        open.PrivateRuntimeDataSize = sizeof(blob);
+        if ((status = D3DKMTOpenResource(&open)))
+        {
+            WARN("Failed to open KMT handle %#x, status %#lx.\n", global, status);
+            return E_INVALIDARG;
+        }
+        kmt_resource = open.hResource;
+    }
+
+    if (blob.magic != WINED3D_SHARED_BLOB_MAGIC || blob.version != WINED3D_SHARED_BLOB_VERSION)
+    {
+        WARN("Handle %p is not a wined3d shared resource (magic %#x, version %u).\n",
+                handle, blob.magic, blob.version);
+        hr = E_INVALIDARG;
+        goto fail;
+    }
+    if (blob.process_id != GetCurrentProcessId())
+    {
+        WARN("Handle %p was created by process %#x; cross-process sharing is not supported.\n",
+                handle, blob.process_id);
+        hr = E_INVALIDARG;
+        goto fail;
+    }
+
+    if (!(flags & WINED3D_OPEN_SHARED_RESOURCE_NT_HANDLE) && blob.mutex_global)
+    {
+        D3DKMT_OPENKEYEDMUTEX2 open_mutex = {0};
+
+        open_mutex.hSharedHandle = blob.mutex_global;
+        if ((status = D3DKMTOpenKeyedMutex2(&open_mutex)))
+        {
+            WARN("Failed to open keyed mutex %#x, status %#lx.\n", blob.mutex_global, status);
+            hr = E_INVALIDARG;
+            goto fail;
+        }
+        kmt_mutex = open_mutex.hKeyedMutex;
+    }
+
+    wined3d_shared_lock();
+    if ((shared = wined3d_shared_resource_find(blob.id)))
+    {
+        if (shared->adapter_luid.LowPart != device->adapter->luid.LowPart
+                || shared->adapter_luid.HighPart != device->adapter->luid.HighPart)
+        {
+            WARN("Shared resource %p belongs to adapter LUID %08lx:%08lx, device %p is on %08lx:%08lx.\n",
+                    shared, shared->adapter_luid.HighPart, shared->adapter_luid.LowPart, device,
+                    device->adapter->luid.HighPart, device->adapter->luid.LowPart);
+            shared = NULL;
+        }
+        else
+        {
+            wined3d_shared_resource_incref(shared);
+        }
+    }
+    else
+    {
+        WARN("Shared resource id %s not found; it may have been destroyed.\n", wine_dbgstr_longlong(blob.id));
+    }
+    exporter = shared ? shared->exporter : NULL;
+    wined3d_shared_unlock();
+
+    if (!shared)
+    {
+        hr = E_INVALIDARG;
+        goto fail;
+    }
+
+    /* Make sure the exporting device has allocated (and cleared) the GL
+     * object, and fenced it, before the importer can adopt it. The exporter
+     * may already be gone; then another importer holds the object. */
+    if (exporter)
+    {
+        struct wined3d_device *exporter_device = exporter->resource.device;
+
+        TRACE("Preloading exporter %p on device %p.\n", exporter, exporter_device);
+        wined3d_cs_emit_preload_resource(exporter_device->cs, &exporter->resource);
+        wined3d_device_context_flush(&exporter_device->cs->c);
+        wined3d_cs_finish(exporter_device->cs, WINED3D_CS_QUEUE_DEFAULT);
+    }
+
+    if (FAILED(hr = wined3d_texture_create(device, &blob.desc, blob.layer_count, blob.level_count,
+            WINED3D_TEXTURE_CREATE_SHARED_IMPORT, NULL, NULL, &wined3d_null_parent_ops, &texture)))
+    {
+        WARN("Failed to create the importing texture, hr %#lx.\n", hr);
+        wined3d_shared_resource_decref(shared);
+        goto fail;
+    }
+
+    texture->shared = shared;
+    texture->flags |= WINED3D_TEXTURE_SHARED_IMPORT;
+    texture->shared_kmt_resource = kmt_resource;
+    texture->shared_kmt_mutex = kmt_mutex;
+    texture->shared_kmt_sync = kmt_sync;
+
+    /* The GL object holds the content; never let wined3d clear or upload
+     * over it from this texture's point of view. */
+    sub_count = texture->layer_count * texture->level_count;
+    for (i = 0; i < sub_count; ++i)
+        texture->sub_resources[i].locations = WINED3D_LOCATION_TEXTURE_RGB;
+
+    TRACE("Opened shared resource %p (exporter %p) as texture %p on device %p, "
+            "d3dkmt resource %#x, mutex %#x, sync %#x.\n",
+            shared, exporter, texture, device, kmt_resource, kmt_mutex, kmt_sync);
+
+    *resource = &texture->resource;
+    return S_OK;
+
+fail:
+    if (kmt_mutex)
+    {
+        D3DKMT_DESTROYKEYEDMUTEX destroy_mutex = {.hKeyedMutex = kmt_mutex};
+        D3DKMTDestroyKeyedMutex(&destroy_mutex);
+    }
+    if (kmt_sync)
+    {
+        D3DKMT_DESTROYSYNCHRONIZATIONOBJECT destroy_sync = {.hSyncObject = kmt_sync};
+        D3DKMTDestroySynchronizationObject(&destroy_sync);
+    }
+    if (kmt_resource)
+    {
+        D3DKMT_DESTROYALLOCATION2 destroy_alloc = {.hDevice = kmt_device, .hResource = kmt_resource};
+        D3DKMTDestroyAllocation2(&destroy_alloc);
+    }
+    return hr;
+}
+
+HRESULT CDECL wined3d_device_open_shared_resource_by_name(struct wined3d_device *device,
+        const WCHAR *name, DWORD access, struct wined3d_resource **resource)
+{
+    D3DKMT_OPENNTHANDLEFROMNAME open_name = {0};
+    UNICODE_STRING name_str;
+    OBJECT_ATTRIBUTES attr;
+    WCHAR buffer[MAX_PATH * 2];
+    NTSTATUS status;
+    HRESULT hr;
+
+    TRACE("device %p, name %s, access %#lx, resource %p.\n", device, debugstr_w(name), access, resource);
+
+    if (!name)
+        return E_INVALIDARG;
+
+    init_shared_resource_path(name, &name_str, buffer, ARRAY_SIZE(buffer));
+    InitializeObjectAttributes(&attr, &name_str, OBJ_CASE_INSENSITIVE, NULL, NULL);
+    open_name.dwDesiredAccess = access;
+    open_name.pObjAttrib = &attr;
+    if ((status = D3DKMTOpenNtHandleFromName(&open_name)))
+    {
+        WARN("Failed to open %s, status %#lx.\n", debugstr_w(name), status);
+        return status == STATUS_OBJECT_NAME_NOT_FOUND ? HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND) : E_INVALIDARG;
+    }
+
+    hr = wined3d_device_open_shared_resource(device, open_name.hNtHandle,
+            WINED3D_OPEN_SHARED_RESOURCE_NT_HANDLE, resource);
+    CloseHandle(open_name.hNtHandle);
+
+    return hr;
+}
+
+static HRESULT wined3d_resource_get_keyed_mutex_texture(struct wined3d_resource *resource,
+        struct wined3d_texture **texture)
+{
+    struct wined3d_texture *t;
+    HRESULT hr;
+
+    if (resource->type == WINED3D_RTYPE_BUFFER)
+        return E_INVALIDARG;
+    t = texture_from_resource(resource);
+
+    if (!t->shared)
+    {
+        if (resource->usage & WINED3DUSAGE_SHARED_KEYED_MUTEX)
+        {
+            FIXME("Keyed mutexes are only implemented for the OpenGL backend.\n");
+            return E_NOTIMPL;
+        }
+        WARN("Resource %p has no keyed mutex.\n", resource);
+        return E_INVALIDARG;
+    }
+
+    if (!wined3d_shared_resource_has_keyed_mutex(t->shared))
+    {
+        WARN("Resource %p has no keyed mutex.\n", resource);
+        return E_INVALIDARG;
+    }
+
+    if (!t->shared_kmt_mutex && FAILED(hr = wined3d_shared_resource_ensure_kmt(t)))
+        return hr;
+    if (!t->shared_kmt_mutex)
+    {
+        ERR("Resource %p has no d3dkmt keyed mutex.\n", resource);
+        return E_INVALIDARG;
+    }
+
+    *texture = t;
+    return S_OK;
+}
+
+HRESULT CDECL wined3d_resource_acquire_keyed_mutex(struct wined3d_resource *resource,
+        uint64_t key, DWORD timeout_ms)
+{
+    D3DKMT_ACQUIREKEYEDMUTEX2 acquire = {0};
+    struct wined3d_texture *texture;
+    LARGE_INTEGER timeout;
+    NTSTATUS status;
+    HRESULT hr;
+
+    TRACE("resource %p, key %s, timeout_ms %lu.\n", resource, wine_dbgstr_longlong(key), timeout_ms);
+
+    if (FAILED(hr = wined3d_resource_get_keyed_mutex_texture(resource, &texture)))
+        return hr;
+
+    if (texture->shared_mutex_owned)
+    {
+        WARN("Resource %p already owns its keyed mutex.\n", resource);
+        return E_INVALIDARG;
+    }
+
+    acquire.hKeyedMutex = texture->shared_kmt_mutex;
+    acquire.Key = key;
+    if (timeout_ms != INFINITE)
+    {
+        timeout.QuadPart = -(LONGLONG)timeout_ms * 10000;
+        acquire.pTimeout = &timeout;
+    }
+
+    status = D3DKMTAcquireKeyedMutex2(&acquire);
+    hr = hresult_from_kmt_status(status);
+    if (hr == S_OK)
+    {
+        texture->shared_mutex_owned = true;
+        /* The releasing device fenced its work; the next use of the texture
+         * on this device waits for those fences (shared->epoch changed). */
+    }
+    else if (hr != WAIT_TIMEOUT && hr != WAIT_ABANDONED)
+    {
+        WARN("Failed to acquire keyed mutex %#x, status %#lx.\n", texture->shared_kmt_mutex, status);
+    }
+
+    TRACE("Returning %#lx.\n", hr);
+    return hr;
+}
+
+HRESULT CDECL wined3d_resource_release_keyed_mutex(struct wined3d_resource *resource, uint64_t key)
+{
+    D3DKMT_RELEASEKEYEDMUTEX2 release = {0};
+    struct wined3d_device *device;
+    struct wined3d_texture *texture;
+    NTSTATUS status;
+    HRESULT hr;
+
+    TRACE("resource %p, key %s.\n", resource, wine_dbgstr_longlong(key));
+
+    if (FAILED(hr = wined3d_resource_get_keyed_mutex_texture(resource, &texture)))
+        return hr;
+
+    if (!texture->shared_mutex_owned)
+    {
+        WARN("Resource %p doesn't own its keyed mutex.\n", resource);
+        return E_INVALIDARG;
+    }
+
+    /* Fence our work on the shared object before the mutex changes hands
+     * (the flush op signals the shared resources), and make sure the fence
+     * exists before the kernel release is visible to other devices. */
+    device = resource->device;
+    wined3d_device_context_flush(&device->cs->c);
+    wined3d_cs_finish(device->cs, WINED3D_CS_QUEUE_DEFAULT);
+
+    release.hKeyedMutex = texture->shared_kmt_mutex;
+    release.Key = key;
+    if ((status = D3DKMTReleaseKeyedMutex2(&release)))
+    {
+        WARN("Failed to release keyed mutex %#x, status %#lx.\n", texture->shared_kmt_mutex, status);
+        return E_INVALIDARG;
+    }
+    texture->shared_mutex_owned = false;
+
+    return S_OK;
+}
