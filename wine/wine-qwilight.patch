+
+/**********************************************************************
+ *  MUI (multilingual user interface) alternate resource modules.
+ *
+ * A language-neutral module carries a "MUI" resource describing which
+ * resource types live in a per-language satellite file
+ * <dir>\<language>\<name>.mui. Lookups that fail in the module itself are
+ * retried in the satellite for the user's UI language, then for the
+ * module's ultimate fallback language.
+ */
+
+struct mui_resource
+{
+    ULONG signature;   /* 0xfecdfecd */
+    ULONG size;
+    ULONG version;
+    ULONG reserved;
+    ULONG file_type;
+    ULONG system_attributes;
+    ULONG fallback_location;
+    ULONG service_checksum[4];
+    ULONG checksum[4];
+    ULONG reserved2[6];
+    ULONG main_name_types_offset;
+    ULONG main_name_types_length;
+    ULONG main_id_types_offset;
+    ULONG main_id_types_length;
+    ULONG mui_name_types_offset;
+    ULONG mui_name_types_length;
+    ULONG mui_id_types_offset;
+    ULONG mui_id_types_length;
+    ULONG language_offset;
+    ULONG language_length;
+    ULONG fallback_language_offset;
+    ULONG fallback_language_length;
+};
+
+#define MUI_SIGNATURE 0xfecdfecd
+
+struct mui_alternate
+{
+    struct list entry;
+    HMODULE module;
+    HMODULE alternate;   /* NULL if the module has no usable satellite */
+    SIZE_T alternate_size;
+};
+
+static struct list mui_alternates = LIST_INIT( mui_alternates );
+
+static RTL_CRITICAL_SECTION mui_section;
+static RTL_CRITICAL_SECTION_DEBUG mui_critsect_debug =
+{
+    0, 0, &mui_section,
+    { &mui_critsect_debug.ProcessLocksList, &mui_critsect_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": mui_section") }
+};
+static RTL_CRITICAL_SECTION mui_section = { &mui_critsect_debug, -1, 0, 0, 0, 0 };
+
+static BOOL is_not_found_status( NTSTATUS status )
+{
+    return status == STATUS_RESOURCE_DATA_NOT_FOUND || status == STATUS_RESOURCE_TYPE_NOT_FOUND
+            || status == STATUS_RESOURCE_NAME_NOT_FOUND || status == STATUS_RESOURCE_LANG_NOT_FOUND;
+}
+
+/* Fetch the module's MUI resource, if it has one. */
+static const struct mui_resource *get_mui_resource( HMODULE hmod )
+{
+    static const WCHAR muiW[] = {'M','U','I',0};
+    const IMAGE_RESOURCE_DIRECTORY *root, *dir;
+    const IMAGE_RESOURCE_DATA_ENTRY *entry;
+    const struct mui_resource *mui;
+    ULONG size;
+
+    if (!(root = RtlImageDirectoryEntryToData( hmod, TRUE, IMAGE_DIRECTORY_ENTRY_RESOURCE, &size ))) return NULL;
+    if (size < sizeof(*root)) return NULL;
+    if (!(dir = find_entry_by_name( root, muiW, root, TRUE ))) return NULL;
+    if (!(dir = find_first_entry( dir, root, TRUE ))) return NULL;
+    if (!(entry = (const IMAGE_RESOURCE_DATA_ENTRY *)find_first_entry( dir, root, FALSE ))) return NULL;
+    if (entry->Size < sizeof(*mui)) return NULL;
+    mui = (const struct mui_resource *)((const char *)hmod + entry->OffsetToData);
+    if (mui->signature != MUI_SIGNATURE || mui->size < sizeof(*mui) || mui->size > entry->Size) return NULL;
+    return mui;
+}
+
+/* Try <dir>\<lang>\<name>.mui for one language. */
+static HMODULE load_mui_file( const UNICODE_STRING *module_path, const WCHAR *lang )
+{
+    static const WCHAR muiW[] = {'.','m','u','i',0};
+    const WCHAR *name, *p;
+    UNICODE_STRING str;
+    DWORD flags = DONT_RESOLVE_DLL_REFERENCES;
+    HMODULE module = NULL;
+    SIZE_T dir_len, lang_len, name_len;
+    WCHAR *path;
+
+    if (!lang || !lang[0]) return NULL;
+    name = module_path->Buffer;
+    for (p = module_path->Buffer; p < module_path->Buffer + module_path->Length / sizeof(WCHAR); p++)
+        if (*p == '\\' || *p == '/') name = p + 1;
+    dir_len = name - module_path->Buffer;
+    name_len = module_path->Buffer + module_path->Length / sizeof(WCHAR) - name;
+    lang_len = wcslen( lang );
+
+    if (!(path = RtlAllocateHeap( GetProcessHeap(), 0,
+            (dir_len + lang_len + 1 + name_len + ARRAY_SIZE(muiW)) * sizeof(WCHAR) )))
+        return NULL;
+    memcpy( path, module_path->Buffer, dir_len * sizeof(WCHAR) );
+    memcpy( path + dir_len, lang, lang_len * sizeof(WCHAR) );
+    path[dir_len + lang_len] = '\\';
+    memcpy( path + dir_len + lang_len + 1, name, name_len * sizeof(WCHAR) );
+    memcpy( path + dir_len + lang_len + 1 + name_len, muiW, sizeof(muiW) );
+    RtlInitUnicodeString( &str, path );
+
+    if (LdrLoadDll( NULL, &flags, &str, &module )) module = NULL;
+    TRACE( "%s -> %p\n", debugstr_w(path), module );
+    RtlFreeHeap( GetProcessHeap(), 0, path );
+    return module;
+}
+
+static HMODULE load_alternate_module( HMODULE hmod )
+{
+    static const WCHAR en_usW[] = {'e','n','-','U','S',0};
+    const struct mui_resource *mui;
+    LDR_DATA_TABLE_ENTRY *mod;
+    WCHAR user_lang[LOCALE_NAME_MAX_LENGTH];
+    WCHAR fallback[LOCALE_NAME_MAX_LENGTH];
+    UNICODE_STRING str;
+    HMODULE alternate;
+    LANGID lang_id;
+    ULONG len;
+
+    if (!(mui = get_mui_resource( hmod ))) return NULL;
+    if (!mui->mui_id_types_length && !mui->mui_name_types_length) return NULL;
+    if (LdrFindEntryForAddress( hmod, &mod )) return NULL;
+
+    fallback[0] = 0;
+    len = mui->fallback_language_length / sizeof(WCHAR);
+    if (mui->fallback_language_offset && len && len < ARRAY_SIZE(fallback)
+            && mui->fallback_language_offset + mui->fallback_language_length <= mui->size)
+    {
+        memcpy( fallback, (const char *)mui + mui->fallback_language_offset, len * sizeof(WCHAR) );
+        fallback[len] = 0;
+    }
+
+    user_lang[0] = 0;
+    str.Buffer = user_lang;
+    str.Length = 0;
+    str.MaximumLength = sizeof(user_lang);
+    if (!NtQueryDefaultUILanguage( &lang_id ) && !RtlLcidToLocaleName( lang_id, &str, 0, FALSE ))
+        user_lang[str.Length / sizeof(WCHAR)] = 0;
+    else
+        user_lang[0] = 0;
+
+    TRACE( "module %p %s: user language %s, fallback %s\n", hmod, debugstr_us(&mod->FullDllName),
+           debugstr_w(user_lang), debugstr_w(fallback) );
+
+    if ((alternate = load_mui_file( &mod->FullDllName, user_lang ))) return alternate;
+    if (wcsicmp( fallback, user_lang ) && (alternate = load_mui_file( &mod->FullDllName, fallback ))) return alternate;
+    if (wcsicmp( en_usW, user_lang ) && wcsicmp( en_usW, fallback )
+            && (alternate = load_mui_file( &mod->FullDllName, en_usW ))) return alternate;
+    return NULL;
+}
+
+/* Get the satellite module for hmod, loading it on first use. */
+static HMODULE get_alternate_module( HMODULE hmod )
+{
+    struct mui_alternate *alt;
+    HMODULE ret = NULL;
+
+    if (is_data_file_module( hmod )) return NULL;
+
+    RtlEnterCriticalSection( &mui_section );
+    LIST_FOR_EACH_ENTRY( alt, &mui_alternates, struct mui_alternate, entry )
+    {
+        if (alt->module == hmod)
+        {
+            ret = alt->alternate;
+            goto done;
+        }
+    }
+    if (!(alt = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*alt) ))) goto done;
+    alt->module = hmod;
+    alt->alternate = NULL;
+    alt->alternate_size = 0;
+    list_add_head( &mui_alternates, &alt->entry );
+    RtlLeaveCriticalSection( &mui_section );
+
+    /* Loading can take the loader lock; do it outside our own lock. */
+    ret = load_alternate_module( hmod );
+
+    RtlEnterCriticalSection( &mui_section );
+    if (ret)
+    {
+        alt->alternate = ret;
+        alt->alternate_size = RtlImageNtHeader( ret )->OptionalHeader.SizeOfImage;
+    }
+done:
+    RtlLeaveCriticalSection( &mui_section );
+    return ret;
+}
+
+/* The module whose image contains a resource entry: hmod, or its loaded satellite. */
+static HMODULE get_entry_module( HMODULE hmod, const void *entry )
+{
+    struct mui_alternate *alt;
+    HMODULE ret = hmod;
+
+    RtlEnterCriticalSection( &mui_section );
+    LIST_FOR_EACH_ENTRY( alt, &mui_alternates, struct mui_alternate, entry )
+    {
+        if (alt->module == hmod && alt->alternate
+                && (const char *)entry >= (const char *)alt->alternate
+                && (const char *)entry < (const char *)alt->alternate + alt->alternate_size)
+        {
+            ret = alt->alternate;
+            break;
+        }
+    }
+    RtlLeaveCriticalSection( &mui_section );
+    return ret;
+}
