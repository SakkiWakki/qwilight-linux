+/* Every operation below completes immediately with WINE_HTTP_E_NO_TRANSPORT.
+ * The Windows.Web.Http object graph is implemented; the transport is not.
+ * Completing with an error (rather than failing the *Async call itself) is what
+ * a caller expects: CsWinRT turns the Error status into a thrown exception on
+ * await, exactly as a real connection failure would.
+ *
+ * The HSTRING results are always NULL, so carrying them in the PROPVARIANT's
+ * punkVal slot -- the same pointer width -- keeps one macro for every type. */
+static HRESULT no_transport_callback( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    FIXME( "no HTTP transport yet, completing with %#lx.\n", (HRESULT)WINE_HTTP_E_NO_TRANSPORT );
+    return WINE_HTTP_E_NO_TRANSPORT;
+}
