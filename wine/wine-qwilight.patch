 HRESULT WINAPI RoReportUnhandledError(IRestrictedErrorInfo *info)
 {
-    FIXME("(%p): stub\n", info);
+    BSTR description = NULL, restricted_description = NULL, capability_sid = NULL;
+    HRESULT error = S_OK;
+
+    FIXME("(%p): semi-stub\n", info);
+
+    /* Windows hands this to WER / the language runtime's unhandled-exception
+     * policy; we only make the error visible, and continue like a handler that
+     * marked it handled. */
+    if (info && SUCCEEDED(IRestrictedErrorInfo_GetErrorDetails(info, &description, &error,
+            &restricted_description, &capability_sid)))
+    {
+        ERR("unhandled error %#lx, description %s, restricted description %s.\n",
+                error, debugstr_w(description), debugstr_w(restricted_description));
+        SysFreeString(description);
+        SysFreeString(restricted_description);
+        SysFreeString(capability_sid);
+    }
+    dump_current_stack();
     return S_OK;
 }
 
