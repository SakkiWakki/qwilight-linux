+/* EnableMouseInPointerForThread(), user32 ordinal 2561, is what WinUI 3 uses:
+ * it turns mouse input into WM_POINTER* messages for the calling thread only. */
+static void test_EnableMouseInPointerForThread(void)
+{
+    WNDCLASSW cls = {.lpfnWndProc = pointer_msg_proc, .lpszClassName = L"test_pointer_thread"};
+    HWND hwnd, child1, child2;
+    POINTER_INFO *info;
+    RECT rect;
+    BOOL ret;
+
+    if (!pEnableMouseInPointerForThread)
+    {
+        win_skip( "EnableMouseInPointerForThread is not available\n" );
+        return;
+    }
+
+    cls.hInstance = GetModuleHandleW( NULL );
+    cls.hCursor = LoadCursorW( 0, (const WCHAR *)IDC_ARROW );
+    RegisterClassW( &cls );
+
+    hwnd = CreateWindowW( L"test_pointer_thread", L"test", WS_POPUP | WS_VISIBLE, 100, 100, 400, 300,
+                          0, 0, cls.hInstance, NULL );
+    ok( !!hwnd, "CreateWindowW failed, error %lu\n", GetLastError() );
+    child1 = CreateWindowW( L"test_pointer_thread", L"child1", WS_CHILD | WS_VISIBLE, 0, 0, 200, 300,
+                            hwnd, 0, cls.hInstance, NULL );
+    child2 = CreateWindowW( L"test_pointer_thread", L"child2", WS_CHILD | WS_VISIBLE, 200, 0, 200, 300,
+                            hwnd, 0, cls.hInstance, NULL );
+    ok( !!child1 && !!child2, "CreateWindowW failed, error %lu\n", GetLastError() );
+    SetForegroundWindow( hwnd );
+    empty_message_queue();
+    GetWindowRect( hwnd, &rect );
+
+    ret = pIsMouseInPointerEnabled();
+    ok( !ret, "IsMouseInPointerEnabled returned %u\n", ret );
+
+    memset( pointer_msg_count, 0, sizeof(pointer_msg_count) );
+    send_mouse_input( MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE, 0, rect.left + 50, rect.top + 50 );
+    ok( !pointer_msg_count[WM_POINTERUPDATE - 0x240], "got %u WM_POINTERUPDATE before enabling\n",
+        pointer_msg_count[WM_POINTERUPDATE - 0x240] );
+
+    ret = pEnableMouseInPointerForThread();
+    ok( ret, "EnableMouseInPointerForThread failed, error %lu\n", GetLastError() );
+    ret = pIsMouseInPointerEnabled();
+    ok( ret, "IsMouseInPointerEnabled returned %u\n", ret );
+
+    /* entering a window sends WM_POINTERENTER before the first WM_POINTERUPDATE */
+    memset( pointer_msg_count, 0, sizeof(pointer_msg_count) );
+    memset( pointer_msg_info, 0, sizeof(pointer_msg_info) );
+    send_mouse_input( MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE, 0, rect.left + 60, rect.top + 60 );
+    ok( pointer_msg_count[WM_POINTERENTER - 0x240] == 1, "got %u WM_POINTERENTER\n",
+        pointer_msg_count[WM_POINTERENTER - 0x240] );
+    ok( pointer_msg_count[WM_POINTERUPDATE - 0x240] >= 1, "got %u WM_POINTERUPDATE\n",
+        pointer_msg_count[WM_POINTERUPDATE - 0x240] );
+    info = &pointer_msg_info[WM_POINTERENTER - 0x240];
+    ok( info->hwndTarget == child1, "got hwndTarget %p, expected %p\n", info->hwndTarget, child1 );
+    ok( info->pointerType == PT_MOUSE, "got pointerType %u\n", info->pointerType );
+    ok( info->ptPixelLocation.x == rect.left + 60 && info->ptPixelLocation.y == rect.top + 60,
+        "got ptPixelLocation %s\n", wine_dbgstr_point( &info->ptPixelLocation ) );
+
+    /* moving to another window leaves the previous one */
+    memset( pointer_msg_count, 0, sizeof(pointer_msg_count) );
+    memset( pointer_msg_info, 0, sizeof(pointer_msg_info) );
+    send_mouse_input( MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE, 0, rect.left + 260, rect.top + 60 );
+    ok( pointer_msg_count[WM_POINTERLEAVE - 0x240] == 1, "got %u WM_POINTERLEAVE\n",
+        pointer_msg_count[WM_POINTERLEAVE - 0x240] );
+    ok( pointer_msg_count[WM_POINTERENTER - 0x240] == 1, "got %u WM_POINTERENTER\n",
+        pointer_msg_count[WM_POINTERENTER - 0x240] );
+    ok( pointer_msg_info[WM_POINTERLEAVE - 0x240].hwndTarget == child1, "got hwndTarget %p, expected %p\n",
+        pointer_msg_info[WM_POINTERLEAVE - 0x240].hwndTarget, child1 );
+    ok( pointer_msg_info[WM_POINTERENTER - 0x240].hwndTarget == child2, "got hwndTarget %p, expected %p\n",
+        pointer_msg_info[WM_POINTERENTER - 0x240].hwndTarget, child2 );
+
+    memset( pointer_msg_count, 0, sizeof(pointer_msg_count) );
+    memset( pointer_msg_info, 0, sizeof(pointer_msg_info) );
+    send_mouse_input( MOUSEEVENTF_LEFTDOWN, 0, 0, 0 );
+    send_mouse_input( MOUSEEVENTF_LEFTUP, 0, 0, 0 );
+    ok( pointer_msg_count[WM_POINTERDOWN - 0x240] == 1, "got %u WM_POINTERDOWN\n",
+        pointer_msg_count[WM_POINTERDOWN - 0x240] );
+    ok( pointer_msg_count[WM_POINTERUP - 0x240] == 1, "got %u WM_POINTERUP\n",
+        pointer_msg_count[WM_POINTERUP - 0x240] );
+    info = &pointer_msg_info[WM_POINTERDOWN - 0x240];
+    ok( (info->pointerFlags & (POINTER_FLAG_DOWN | POINTER_FLAG_FIRSTBUTTON)) ==
+        (POINTER_FLAG_DOWN | POINTER_FLAG_FIRSTBUTTON), "got pointerFlags %#x\n", info->pointerFlags );
+    ok( info->ButtonChangeType == POINTER_CHANGE_FIRSTBUTTON_DOWN, "got ButtonChangeType %u\n",
+        info->ButtonChangeType );
+    info = &pointer_msg_info[WM_POINTERUP - 0x240];
+    ok( (info->pointerFlags & POINTER_FLAG_UP) == POINTER_FLAG_UP, "got pointerFlags %#x\n",
+        info->pointerFlags );
+    ok( info->ButtonChangeType == POINTER_CHANGE_FIRSTBUTTON_UP, "got ButtonChangeType %u\n",
+        info->ButtonChangeType );
+
+    /* the wheel delta goes to POINTER_INFO.InputData, not to the pointer flags */
+    memset( pointer_msg_count, 0, sizeof(pointer_msg_count) );
+    memset( pointer_msg_info, 0, sizeof(pointer_msg_info) );
+    send_mouse_input( MOUSEEVENTF_WHEEL, (DWORD)-WHEEL_DELTA, 0, 0 );
+    ok( pointer_msg_count[WM_POINTERWHEEL - 0x240] == 1, "got %u WM_POINTERWHEEL\n",
+        pointer_msg_count[WM_POINTERWHEEL - 0x240] );
+    info = &pointer_msg_info[WM_POINTERWHEEL - 0x240];
+    ok( info->InputData == -WHEEL_DELTA, "got InputData %d\n", info->InputData );
+    ok( (info->pointerFlags & POINTER_FLAG_WHEEL) == POINTER_FLAG_WHEEL, "got pointerFlags %#x\n",
+        info->pointerFlags );
+    memset( pointer_msg_count, 0, sizeof(pointer_msg_count) );
+    memset( pointer_msg_info, 0, sizeof(pointer_msg_info) );
+    send_mouse_input( MOUSEEVENTF_HWHEEL, WHEEL_DELTA, 0, 0 );
+    ok( pointer_msg_count[WM_POINTERHWHEEL - 0x240] == 1, "got %u WM_POINTERHWHEEL\n",
+        pointer_msg_count[WM_POINTERHWHEEL - 0x240] );
+    info = &pointer_msg_info[WM_POINTERHWHEEL - 0x240];
+    ok( info->InputData == WHEEL_DELTA, "got InputData %d\n", info->InputData );
+    ok( (info->pointerFlags & POINTER_FLAG_HWHEEL) == POINTER_FLAG_HWHEEL, "got pointerFlags %#x\n",
+        info->pointerFlags );
+
+    DestroyWindow( hwnd );
+    UnregisterClassW( L"test_pointer_thread", cls.hInstance );
+}
