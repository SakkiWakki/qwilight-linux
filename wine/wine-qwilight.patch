+/* IDCompositionDeviceInternal {6b556968-2d25-11e2-99f6-8bc36088709b}.
+ *
+ * The name is dcompi.dll's own (it implements the interface on
+ * DirectComposition::CDevice); the method list and order are read off that DLL's
+ * ??_7CDevice@DirectComposition@@6BIDCompositionDeviceInternal2@@@ vtable.  Only
+ * SetCommitCompletionEvent() matters here: Microsoft.Internal.FrameworkUdk.dll's
+ * DCompPrivates_SetCommitCompletionEvent() QIs the device for this IID and calls it, and
+ * dwmcorei!CDCompDevice::Create() - the XAML render thread's DirectComposition device -
+ * fails and drops the device entirely if that fails, which is why the WinUI 3 window stayed
+ * black. */
+
+static HRESULT STDMETHODCALLTYPE device_internal_QueryInterface(IDCompositionDeviceInternal *iface,
