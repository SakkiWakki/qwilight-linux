+/* Map an axis-aligned rectangle through a translate + scale matrix. */
+static void dcomp_transform_rect(const D2D_MATRIX_3X2_F *m, float left, float top, float right, float bottom, RECT *out)
+{
+    float x0 = left * m->_11 + m->_31, x1 = right * m->_11 + m->_31;
+    float y0 = top * m->_22 + m->_32, y1 = bottom * m->_22 + m->_32;
+
+    out->left = (int)floorf(min(x0, x1));
+    out->top = (int)floorf(min(y0, y1));
+    out->right = (int)ceilf(max(x0, x1));
+    out->bottom = (int)ceilf(max(y0, y1));
+}
