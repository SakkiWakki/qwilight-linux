+static HRESULT WINAPI manager2_GetVariableFromTag( IUIAnimationManager2 *iface, IUnknown *object, UINT id,
+        IUIAnimationVariable2 **variable )
+{
+    struct manager2 *This = impl_from_IUIAnimationManager2( iface );
+    struct variable2 *var;
+
+    TRACE( "%p, %p, %u, %p.\n", iface, object, id, variable );
+
+    if (!variable) return E_POINTER;
+    *variable = NULL;
+    EnterCriticalSection( &This->cs );
+    LIST_FOR_EACH_ENTRY( var, &This->variables, struct variable2, entry )
+    {
+        if (var->tag_object == object && var->tag_id == id)
+        {
+            *variable = &var->IUIAnimationVariable2_iface;
+            IUIAnimationVariable2_AddRef( *variable );
+            break;
+        }
+    }
+    LeaveCriticalSection( &This->cs );
+    return *variable ? S_OK : UI_E_VALUE_NOT_DETERMINED;
+}
