+
 struct activatable_class_data
 {
     ULONG size;
@@ -469,12 +472,130 @@ HRESULT WINAPI RoGetAgileReference(enum AgileReferenceOptions option, REFIID rii
     return S_OK;
 }
 
+#define STOWED_EXCEPTION_INFORMATION_V1_SIGNATURE 0x53453031 /* "SE01" */
+#define STOWED_EXCEPTION_INFORMATION_V2_SIGNATURE 0x53453032 /* "SE02" */
+
+/* Public layout of a stowed exception, as the callers of
+ * RoFailFastWithErrorContextInternal2() build it. */
+struct stowed_exception_information
+{
+    ULONG size;
+    ULONG signature;
+    HRESULT result;
+    ULONG form_and_thread_id; /* exception form: 2 bits, thread id: 30 bits */
+    union
+    {
+        struct  /* form 1: binary */
+        {
+            void *exception_address;
+            ULONG stack_trace_word_size;
+            ULONG stack_trace_words;
+            void *stack_trace;
+        };
+        struct  /* form 2: text */
+        {
+            WCHAR *error_text;
+        };
+    };
+    ULONG nested_exception_type;
+    void *nested_exception;
+};
+
+/* Say what a fail fast is about before the process goes down: the HRESULT, the
+ * thread's originated error and every stowed exception handed to us. The
+ * caller-supplied pointers are not ours and may be malformed, so read them
+ * defensively - this runs when things are already broken. */
+
+static void dump_frame(const char *prefix, ULONG index, void *pc)
+{
+    void *base = NULL;
+    WCHAR name[MAX_PATH];
+    const WCHAR *file = name;
+
+    RtlPcToFileHeader(pc, &base);
+    if (base && GetModuleFileNameW(base, name, ARRAY_SIZE(name)))
+    {
+        const WCHAR *p = wcsrchr(name, '\\');
+        if (p) file = p + 1;
+        ERR("%s%lu: %p = %s+%#lx\n", prefix, index, pc, debugstr_w(file), (ULONG)((char *)pc - (char *)base));
+    }
+    else ERR("%s%lu: %p\n", prefix, index, pc);
+}
+
+static void dump_current_stack(void)
+{
+    void *frames[48];
+    ULONG i, count = RtlCaptureStackBackTrace(1, ARRAY_SIZE(frames), frames, NULL);
+    for (i = 0; i < count; i++) dump_frame("      frame ", i, frames[i]);
+}
+
+static void dump_error_context(HRESULT error, ULONG exception_count, void **exceptions)
+{
+    BSTR description = NULL, restricted_description = NULL, capability_sid = NULL;
+    IRestrictedErrorInfo *info;
+    HRESULT stored;
+    ULONG i;
+
+    ERR("fail fast, error %#lx, %lu stowed exception(s).\n", error, exception_count);
+
+    if (GetRestrictedErrorInfo(&info) == S_OK)
+    {
+        if (SUCCEEDED(IRestrictedErrorInfo_GetErrorDetails(info, &description, &stored,
+                &restricted_description, &capability_sid)))
+        {
+            ERR("    originated error %#lx, description %s, restricted description %s.\n",
+                stored, debugstr_w(description), debugstr_w(restricted_description));
+            SysFreeString(description);
+            SysFreeString(restricted_description);
+            SysFreeString(capability_sid);
+        }
+        IRestrictedErrorInfo_Release(info);
+    }
+
+    __TRY
+    {
+        for (i = 0; exceptions && i < exception_count; i++)
+        {
+            const struct stowed_exception_information *stowed = exceptions[i];
+
+            if (!stowed)
+                continue;
+            if (stowed->signature != STOWED_EXCEPTION_INFORMATION_V1_SIGNATURE
+                    && stowed->signature != STOWED_EXCEPTION_INFORMATION_V2_SIGNATURE)
+            {
+                ERR("    stowed exception %lu at %p, unrecognised signature %#lx.\n", i, stowed,
+                    stowed->signature);
+                continue;
+            }
+            ERR("    stowed exception %lu: result %#lx, thread %#lx, form %lu, address %p, "
+                "nested type %#lx, nested %p.\n", i, stowed->result, stowed->form_and_thread_id >> 2,
