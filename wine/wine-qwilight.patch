+    case PropertyType_UInt32:   return L"UInt32";
+    case PropertyType_Int64:    return L"Int64";
+    case PropertyType_UInt64:   return L"UInt64";
+    case PropertyType_Single:   return L"Single";
+    case PropertyType_Double:   return L"Double";
+    case PropertyType_Char16:   return L"Char16";
+    case PropertyType_Boolean:  return L"Boolean";
+    case PropertyType_String:   return L"String";
+    case PropertyType_Guid:     return L"Guid";
+    case PropertyType_DateTime: return L"Windows.Foundation.DateTime";
+    case PropertyType_TimeSpan: return L"Windows.Foundation.TimeSpan";
+    case PropertyType_Point:    return L"Windows.Foundation.Point";
+    case PropertyType_Size:     return L"Windows.Foundation.Size";
