+    if (FAILED(hr = IDXGISwapChain4_GetBuffer(&swapchain->IDXGISwapChain4_iface, 0,
+            &IID_ID3D11Texture2D, (void **)&back_buffer)))
+    {
+        WARN("Failed to get back buffer 0, hr %#lx.\n", hr);
+        return;
+    }
+    ID3D11Texture2D_GetDesc(back_buffer, &desc);
+
+    if (*slot && SUCCEEDED(IDXGISurface_QueryInterface(*slot, &IID_ID3D11Texture2D, (void **)&presented)))
+    {
+        ID3D11Texture2D_GetDesc(presented, &presented_desc);
+        if (presented_desc.Width != desc.Width || presented_desc.Height != desc.Height
+                || presented_desc.Format != desc.Format)
+        {
+            ID3D11Texture2D_Release(presented);
+            presented = NULL;
+        }
+    }
+    if (!presented && *slot)
+    {
+        IDXGISurface_Release(*slot);
+        *slot = NULL;
+    }
+
+    if (FAILED(hr = IWineDXGIDevice_QueryInterface(swapchain->device, &IID_ID3D11Device, (void **)&device)))
+    {
+        WARN("Failed to get the D3D11 device, hr %#lx.\n", hr);
+        goto done;
+    }
+
+    if (!presented)
+    {
+        desc.MipLevels = 1;
+        desc.ArraySize = 1;
+        desc.Usage = D3D11_USAGE_DEFAULT;
+        desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        desc.CPUAccessFlags = 0;
+        /* dcomp's GPU compositor samples it from the compositing device, which is
+         * usually not this one (Win2D renders on its own device). */
+        desc.MiscFlags = D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_NTHANDLE;
+        if (FAILED(hr = ID3D11Device_CreateTexture2D(device, &desc, NULL, &presented)))
+        {
+            WARN("Failed to create the presented surface, hr %#lx.\n", hr);
+            goto done;
+        }
+        if (FAILED(hr = ID3D11Texture2D_QueryInterface(presented, &IID_IDXGISurface, (void **)&surface)))
+        {
+            WARN("Failed to get the presented surface's IDXGISurface, hr %#lx.\n", hr);
+            goto done;
+        }
+        *slot = surface;
+        TRACE("Created presented surface %p (slot %u, %ux%u, format %#x) for swapchain %p.\n",
+                surface, swapchain->presented_index, desc.Width, desc.Height, desc.Format, swapchain);
+    }
+
+    ID3D11Device_GetImmediateContext(device, &context);
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)presented, (ID3D11Resource *)back_buffer);
+    IDXGISwapChain4_SetPrivateDataInterface(&swapchain->IDXGISwapChain4_iface,
+            &GUID_wine_dxgi_presented_surface, (IUnknown *)*slot);
+    /* The compositor is woken from d3d11_swapchain_present() once the copy and its fence
+     * have gone through the command stream (dxgi_wake_compositor()). */
+    {
+        /* TEMP DIAG: the game's own present cadence, reported every 2 s */
+        {
+            static LARGE_INTEGER freq;
+            static LONGLONG last, report_start, min_i, max_i, sum_i;
+            static unsigned int n, over15, over25;
+            LARGE_INTEGER now;
+            if (!freq.QuadPart) QueryPerformanceFrequency(&freq);
+            QueryPerformanceCounter(&now);
+            if (last)
+            {
+                LONGLONG d = now.QuadPart - last;
+                double ms = d * 1000.0 / freq.QuadPart;
+                if (!n || d < min_i) min_i = d;
+                if (d > max_i) max_i = d;
+                sum_i += d; n++;
+                if (ms > 12.0) over15++;
+                if (ms > 20.0) over25++;
+            }
+            last = now.QuadPart;
+            if (!report_start) report_start = now.QuadPart;
+            if ((now.QuadPart - report_start) * 1000 / freq.QuadPart >= 2000)
+            {
+                FIXME("game present stats: %u presents/2s, interval avg %.2f min %.2f max %.2f ms, >12 ms %u, >20 ms %u.\n",
+                        n, n ? sum_i * 1000.0 / freq.QuadPart / n : 0.0, min_i * 1000.0 / freq.QuadPart, max_i * 1000.0 / freq.QuadPart, over15, over25);
+                n = over15 = over25 = 0; sum_i = max_i = min_i = 0; report_start = now.QuadPart;
+            }
+        }
+    }
+
+done:
+    if (context)
+        ID3D11DeviceContext_Release(context);
+    if (device)
+        ID3D11Device_Release(device);
+    if (presented)
+        ID3D11Texture2D_Release(presented);
+    ID3D11Texture2D_Release(back_buffer);
+}
