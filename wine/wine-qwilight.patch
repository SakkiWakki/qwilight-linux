+static void storyboard_set_status( struct storyboard2 *sb, UI_ANIMATION_STORYBOARD_STATUS status )
+{
+    UI_ANIMATION_STORYBOARD_STATUS previous = sb->status;
+
+    if (previous == status) return;
+    sb->status = status;
+    TRACE( "storyboard %p: %d -> %d.\n", sb, previous, status );
+    if (sb->handler)
+        IUIAnimationStoryboardEventHandler2_OnStoryboardStatusChanged( sb->handler, &sb->IUIAnimationStoryboard2_iface,
+                status, previous );
+}
