+static HRESULT WINAPI manager2_Update( IUIAnimationManager2 *iface, double time_now, UI_ANIMATION_UPDATE_RESULT *result )
+{
+    struct manager2 *This = impl_from_IUIAnimationManager2( iface );
+    struct storyboard2 *sb, *next;
+    BOOL changed = FALSE;
+
+    TRACE( "%p, %f, %p.\n", iface, time_now, result );
+
+    EnterCriticalSection( &This->cs );
+    This->last_time = time_now;
+    This->has_time = TRUE;
+    if (!This->paused)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( sb, next, &This->storyboards, struct storyboard2, entry )
+        {
+            /* the storyboard may unlist itself (and drop its list reference) while updating */
+            IUIAnimationStoryboard2_AddRef( &sb->IUIAnimationStoryboard2_iface );
+            if (storyboard_update( sb, time_now )) changed = TRUE;
+            next = LIST_ENTRY( This->storyboards.next, struct storyboard2, entry );
+            if (sb->in_list) next = LIST_ENTRY( sb->entry.next, struct storyboard2, entry );
+            IUIAnimationStoryboard2_Release( &sb->IUIAnimationStoryboard2_iface );
+            if (&next->entry == &This->storyboards) break;
+        }
+    }
+    manager_update_status( This );
+    LeaveCriticalSection( &This->cs );
+
+    if (result) *result = changed ? UI_ANIMATION_UPDATE_VARIABLES_CHANGED : UI_ANIMATION_UPDATE_NO_CHANGE;
+    return S_OK;
+}
