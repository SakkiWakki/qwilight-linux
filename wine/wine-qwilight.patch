+static void draw_diag_vertices(struct d3d11_device_context *context, unsigned int count, unsigned int start, int base, BOOL indexed)
+{
+    struct wined3d_device_context *ctx = context->wined3d_context;
+    struct wined3d_buffer *vb = NULL, *ib;
+    unsigned int vb_offset = 0, stride = 0, ib_offset = 0, vb_size = 0, ib_size = 0, i, j, n, idx_size;
+    enum wined3d_format_id ib_format = 0;
+    const unsigned char *vdata, *idata = NULL;
+    unsigned int ids[16], nids = 0;
+    char line[1024];
+
+    wined3d_device_context_get_stream_source(ctx, 0, &vb, &vb_offset, &stride);
+    if (!vb || !stride) return;
+    vdata = draw_diag_shadow((ID3D11Resource *)&((struct d3d_buffer *)wined3d_resource_get_parent(wined3d_buffer_get_resource(vb)))->ID3D11Buffer_iface, &vb_size);
+    if (!vdata) { FIXME("DRAW   (no vertex shadow)\n"); return; }
+    if (indexed)
