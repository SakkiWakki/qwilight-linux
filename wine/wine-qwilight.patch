+HRESULT http_client_create( IHttpFilter *filter, IHttpClient **out )
+{
+    struct http_client *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IHttpClient_iface.lpVtbl = &client_vtbl;
+    impl->IClosable_iface.lpVtbl = &client_closable_vtbl;
+    impl->ref = 1;
+
+    if (FAILED(hr = request_headers_create( &impl->default_request_headers )))
+    {
+        free( impl );
+        return hr;
+    }
+    if ((impl->filter = filter)) IHttpFilter_AddRef( impl->filter );
+
+    *out = &impl->IHttpClient_iface;
+    TRACE( "created HttpClient %p, filter %p.\n", *out, filter );
+    return S_OK;
