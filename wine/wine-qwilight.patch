+ *   [0..2] QueryInterface / AddRef / Release  (NestedWinRtImplements thunks)
+ *   [3]    ?GetRoot@Partner@VisualTarget@... (IVisual **)
+ *   [4]    ?SetRoot@Partner@VisualTarget@... (IVisual *)
+ * and entry [5] starts the second vtable of the same COMDAT (the
+ * ICompositionTargetPartner {11171de2-...} face), so the interface ends at [4].
+ * FrameworkUdk's DCompPrivates_OpenAndAttachSharedTarget_Impl (udk 0x397c0)
+ * calls exactly vtable offset 0x20 = slot 4 with the IVisual * it was passed.
+ *
+ * FIXME: the IID could not be recovered.  dcompi resolves it through a runtime
+ * {GUID, this-offset} table (the QueryInterface at dcompi 0x4d160), not through
+ * an inline __uuidof comparison, and it is not in the C++/WinRT guid_v table
+ * (survey/beta.dcompi.guids.txt).  Nothing QueryInterfaces the object -- udk
+ * stores the raw pointer and dcompi keeps it at DesktopWindowTarget+0x128 --
+ * so the object below answers IUnknown and WARNs on everything else.
+ */
+typedef struct IVisualTargetPartner IVisualTargetPartner;
+typedef struct IVisualTargetPartnerVtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)( IVisualTargetPartner *This, REFIID iid, void **out );
+    ULONG (STDMETHODCALLTYPE *AddRef)( IVisualTargetPartner *This );
+    ULONG (STDMETHODCALLTYPE *Release)( IVisualTargetPartner *This );
+    HRESULT (STDMETHODCALLTYPE *GetRoot)( IVisualTargetPartner *This, IVisual **root );
+    HRESULT (STDMETHODCALLTYPE *SetRoot)( IVisualTargetPartner *This, IVisual *root );
+} IVisualTargetPartnerVtbl;
+struct IVisualTargetPartner
+{
+    CONST_VTBL IVisualTargetPartnerVtbl *lpVtbl;
+};
+
+/*
+ * ICompositorPartner {9cbd9312-070d-4588-9bf3-bbf528cf3e84} -- the private
+ * IUnknown-based face of Windows.UI.Composition.Compositor that FrameworkUdk's
+ * PlatformFunctions use for every "shared DirectComposition object" operation.
+ *
+ * Evidence:
+ *  - the IID is the one FrameworkUdk QueryInterfaces the ICompositor for
+ *    (udk .rdata 0xac790, used by the shared helper at udk 0x758c0 that every
+ *    PlatformFunctionsBase compositor shim funnels through), and it is named
+ *    "ICompositorPartner" in dcompi's C++/WinRT guid_v table
+ *    (survey/beta.dcompi.guids.txt, survey/guidnames.txt).
+ *  - the slot layout is dcompi's own implementation of it,
+ *    ??_7?$heap_implements@UCompositor@...Switcher@@...producer_convert@...
+ *    UICompositorPartner@2345@X@ at rva 0x2315a0 (survey/dcompi24.map); the next
+ *    vtable in that COMDAT run starts at 0x231620, so the interface is exactly
+ *    16 slots.  Named slots come from the symbols in that vtable:
+ *      [6] Compositor::HintSize   [7] Compositor::DisableDebugCounters
+ *      [8] Compositor::OpenSharedResourceHandle
+ *      [11] Compositor::OpenSharedVisualFromHandle
+ *      [15] Compositor::SetCompositionCommittedListener
+ *    the rest are folded "return E_NOTIMPL" stubs, so only their arity is known.
+ *  - the three slots we care about are pinned from the caller side, by the
+ *    trampolines the PlatformFunctionsBase shims pass to udk 0x758c0:
+ *      CreateSharedVisual        (udk 0x7b6f0) -> udk 0x79420 -> offset 0x28 = [5]
+ *      OpenSharedResourceHandle  (udk 0x7f710) -> udk 0x79440 -> offset 0x40 = [8]
+ *      OpenSharedTargetFromHandle(udk 0x7f7d0) -> udk 0x79460 -> offset 0x48 = [9]
+ *    and their prototypes come from the mangled PlatformFunctionsBase names in
+ *    survey/beta.udk.map.
+ */
+typedef struct ICompositorPartner ICompositorPartner;
+typedef struct ICompositorPartnerVtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)( ICompositorPartner *This, REFIID iid, void **out );
+    ULONG (STDMETHODCALLTYPE *AddRef)( ICompositorPartner *This );
+    ULONG (STDMETHODCALLTYPE *Release)( ICompositorPartner *This );
+    HRESULT (STDMETHODCALLTYPE *Unknown3)( ICompositorPartner *This, void *unknown, void **out );
+    HRESULT (STDMETHODCALLTYPE *Unknown4)( ICompositorPartner *This, void **out );
+    HRESULT (STDMETHODCALLTYPE *CreateSharedVisual)( ICompositorPartner *This, IVisual **visual );
+    HRESULT (STDMETHODCALLTYPE *HintSize)( ICompositorPartner *This, UINT width, UINT height );
+    HRESULT (STDMETHODCALLTYPE *DisableDebugCounters)( ICompositorPartner *This );
+    HRESULT (STDMETHODCALLTYPE *OpenSharedResourceHandle)( ICompositorPartner *This,
+                                                           ICompositionObject *object, HANDLE *handle );
+    HRESULT (STDMETHODCALLTYPE *OpenSharedTargetFromHandle)( ICompositorPartner *This, HANDLE handle,
+                                                             IVisualTargetPartner **target );
+    HRESULT (STDMETHODCALLTYPE *Unknown10)( ICompositorPartner *This, void *unknown, void **out );
+    HRESULT (STDMETHODCALLTYPE *OpenSharedVisualFromHandle)( ICompositorPartner *This, HANDLE handle,
+                                                             IVisual **visual );
+    HRESULT (STDMETHODCALLTYPE *Unknown12)( ICompositorPartner *This, void *unknown, void **out );
+    HRESULT (STDMETHODCALLTYPE *Unknown13)( ICompositorPartner *This, void *unknown, void **out );
+    HRESULT (STDMETHODCALLTYPE *Unknown14)( ICompositorPartner *This, void **out );
+    HRESULT (STDMETHODCALLTYPE *SetCompositionCommittedListener)( ICompositorPartner *This, IUnknown *listener );
+} ICompositorPartnerVtbl;
+struct ICompositorPartner
+{
+    CONST_VTBL ICompositorPartnerVtbl *lpVtbl;
+};
+
+/* dcomp's private visual interface (dlls/dcomp/dcomp_private_iface.idl,
+ * survey/impl-presentation.md section 2.3).  Listed only so a QueryInterface for
+ * it on one of our visuals is forwarded to the inner dcomp visual rather than
+ * refused; we never call its methods. */
+DEFINE_GUID(IID_IDCompositionVisualUnknown, 0x2c4eef28,0x1bc0,0x4736,0xb7,0xdd,0xb6,0x26,0x92,0xf9,0xbd,0x67);
+
+/* visual.c: Visual / ContainerVisual / SpriteVisual, each backed by a real
+ * DirectComposition visual created on @device (which may be NULL). */
+enum composition_visual_kind
+{
+    COMPOSITION_VISUAL,
+    COMPOSITION_CONTAINER_VISUAL,
+    COMPOSITION_SPRITE_VISUAL,
+};
+
+extern HRESULT composition_visual_create( ICompositor *compositor, IDCompositionDesktopDevice *device,
+                                          enum composition_visual_kind kind, IInspectable **out );
+/* The inner IDCompositionVisual of any visual that follows the interop pattern,
+ * i.e. that answers a QueryInterface for IID_IDCompositionVisual.  NULL if it
+ * does not (a foreign IVisual, or one created without a dcomp device). */
+extern IDCompositionVisual *composition_visual_get_dcomp_visual( IVisual *iface );
+
+/* target.c */
+extern HRESULT composition_visual_target_create( IDCompositionDesktopDevice *device, HANDLE shared_visual_handle,
+                                                 IVisualTargetPartner **out );
+
+
+#endif /* __WINE_WINDOWS_UI_COMPOSITION_PRIVATE_H */
diff --git a/dlls/windows.ui.composition/target.c b/dlls/windows.ui.composition/target.c
new file mode 100644
index 00000000..8704a98b
--- /dev/null
+++ b/dlls/windows.ui.composition/target.c
@@ -0,0 +1,196 @@
+/*
+ * Windows.UI.Composition shared visual targets.
+ *
+ * Copyright (C) 2026 Wine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(composition);
+
+/*
+ * The object ICompositorPartner::OpenSharedTargetFromHandle() hands back: a
+ * DirectComposition target opened from a shared visual handle, wearing the App
+ * SDK's IVisualTargetPartner face.
+ *
+ * The whole point of it is the last step of the Mica backdrop handoff
+ * (visual.c's file comment): FrameworkUdk's DCompPrivates_OpenAndAttachSharedTarget
+ * (udk 0x397c0) opens a target from the handle the lifted
+ * SystemVisualProxyVisualPrivate created, then SetRoot()s the system sprite
+ * visual into it.  dlls/dcomp already implements both halves of that -- the
+ * handle comes from DCompositionCreateSharedVisualHandle() and
+ * IDCompositionDesktopDevicePartner::CreateFromSharedVisualHandle(handle,
+ * IID_IDCompositionTarget, ...) makes a target whose SetRoot() publishes the
+ * root through the wineserver (dlls/dcomp/target.c
+ * shared_visual_target_set_root()), where do_composite() picks it up when it
+ * walks a visual carrying the same handle -- so this is pure glue, and no change
+ * to dlls/dcomp was needed.
+ */
+struct visual_target
+{
+    IVisualTargetPartner IVisualTargetPartner_iface;
+    LONG ref;
+
+    IDCompositionTarget *dcomp_target;
+    IVisual *root;                      /* strong, mirrors dcomp_target's root */
+};
+
+static struct visual_target *impl_from_IVisualTargetPartner( IVisualTargetPartner *iface )
+{
+    return CONTAINING_RECORD( iface, struct visual_target, IVisualTargetPartner_iface );
+}
+
+static HRESULT STDMETHODCALLTYPE visual_target_QueryInterface( IVisualTargetPartner *iface, REFIID iid, void **out )
+{
+    struct visual_target *impl = impl_from_IVisualTargetPartner( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+
+    /* IVisualTargetPartner's own IID could not be recovered from the shipped
+     * binaries (see the private.h comment); nothing asks for it, so refuse
+     * loudly rather than guess. */
+    if (IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        *out = &impl->IVisualTargetPartner_iface;
+        IUnknown_AddRef( (IUnknown *)*out );
+        return S_OK;
+    }
+
+    if (impl->dcomp_target && (IsEqualGUID( iid, &IID_IDCompositionTarget )))
+    {
+        TRACE( "forwarding %s to the inner dcomp target %p.\n", debugstr_guid( iid ), impl->dcomp_target );
+        return IDCompositionTarget_QueryInterface( impl->dcomp_target, iid, out );
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE visual_target_AddRef( IVisualTargetPartner *iface )
+{
+    struct visual_target *impl = impl_from_IVisualTargetPartner( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG STDMETHODCALLTYPE visual_target_Release( IVisualTargetPartner *iface )
+{
+    struct visual_target *impl = impl_from_IVisualTargetPartner( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->root) IVisual_Release( impl->root );
+        if (impl->dcomp_target) IDCompositionTarget_Release( impl->dcomp_target );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_target_GetRoot( IVisualTargetPartner *iface, IVisual **root )
+{
+    struct visual_target *impl = impl_from_IVisualTargetPartner( iface );
+
+    TRACE( "iface %p, root %p.\n", iface, root );
+
+    if (!root) return E_POINTER;
+    if ((*root = impl->root)) IVisual_AddRef( *root );
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_target_SetRoot( IVisualTargetPartner *iface, IVisual *root )
+{
+    struct visual_target *impl = impl_from_IVisualTargetPartner( iface );
+    IDCompositionVisual *dcomp_root = NULL;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, root %p.\n", iface, root );
+
+    if (root && !(dcomp_root = composition_visual_get_dcomp_visual( root )))
+    {
+        WARN( "root %p is not backed by a DirectComposition visual.\n", root );
+        return E_INVALIDARG;
+    }
+
+    if (impl->dcomp_target) hr = IDCompositionTarget_SetRoot( impl->dcomp_target, dcomp_root );
+    if (dcomp_root) IDCompositionVisual_Release( dcomp_root );
+    if (FAILED(hr)) return hr;
+
+    if (root) IVisual_AddRef( root );
+    if (impl->root) IVisual_Release( impl->root );
+    impl->root = root;
+    return S_OK;
+}
+
+static const IVisualTargetPartnerVtbl visual_target_vtbl =
+{
+    visual_target_QueryInterface,
+    visual_target_AddRef,
+    visual_target_Release,
+    /* IVisualTargetPartner */
+    visual_target_GetRoot,
+    visual_target_SetRoot,
+};
+
+HRESULT composition_visual_target_create( IDCompositionDesktopDevice *device, HANDLE shared_visual_handle,
+                                          IVisualTargetPartner **out )
+{
+    IDCompositionDesktopDevicePartner *partner;
+    struct visual_target *impl;
+    HRESULT hr;
+
+    *out = NULL;
+
+    if (!device) return E_NOTIMPL;
+    if (!shared_visual_handle) return E_INVALIDARG;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVisualTargetPartner_iface.lpVtbl = &visual_target_vtbl;
+    impl->ref = 1;
+
+    /* CreateFromSharedVisualHandle lives on the private partner face of the
+     * device; dlls/dcomp answers that IID (device.c device_QueryInterface). */
+    if (FAILED(hr = IDCompositionDesktopDevice_QueryInterface( device, &IID_IDCompositionDesktopDevicePartner,
+                                                               (void **)&partner )))
+    {
+        WARN( "the inner dcomp device has no IDCompositionDesktopDevicePartner, hr %#lx.\n", hr );
+        visual_target_Release( &impl->IVisualTargetPartner_iface );
+        return hr;
+    }
+
+    hr = partner->lpVtbl->CreateFromSharedVisualHandle( partner, shared_visual_handle, &IID_IDCompositionTarget,
+                                                        (void **)&impl->dcomp_target );
+    IUnknown_Release( (IUnknown *)partner );
+    if (FAILED(hr))
+    {
+        WARN( "CreateFromSharedVisualHandle(%p) failed, hr %#lx.\n", shared_visual_handle, hr );
+        visual_target_Release( &impl->IVisualTargetPartner_iface );
+        return hr;
+    }
+
+    TRACE( "created visual target %p from shared visual handle %p, inner dcomp target %p.\n",
+           impl, shared_visual_handle, impl->dcomp_target );
+
+    *out = &impl->IVisualTargetPartner_iface;
+    return S_OK;
+}
diff --git a/dlls/windows.ui.composition/visual.c b/dlls/windows.ui.composition/visual.c
new file mode 100644
index 00000000..68acf194
--- /dev/null
+++ b/dlls/windows.ui.composition/visual.c
@@ -0,0 +1,967 @@
+/*
+ * Windows.UI.Composition visuals.
+ *
+ * Copyright (C) 2026 Wine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdlib.h>
+#include "private.h"
+
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(composition);
+
+/*
+ * Visual / ContainerVisual / SpriteVisual.
+ *
+ * One C type serves all three: SpriteVisual derives from ContainerVisual derives
+ * from Visual, so the only differences are which IIDs QueryInterface answers and
+ * which runtime class name the object reports.
+ *
+ * Each of these owns a *real* DirectComposition visual, created on the interop
+ * compositor's inner dcomp device, and QueryInterface hands that inner visual out
+ * for the IDCompositionVisual IIDs -- the same interop pattern the compositor
+ * object already uses for the device (compositor.c).  That is what makes the
+ * Windows App SDK's shared-visual handoff work:
+ *
+ *   Microsoft.UI.Xaml.Window.SystemBackdrop = MicaBackdrop
+ *     -> dcompi!DesktopWindowTarget::Internal::put_SystemBackdrop        (rva 0xc6040)
+ *     -> dcompi!ExternalTargetImpl<DesktopWindowTarget>::SetSystemBackdrop (rva 0xc7740)
+ *          brush->QueryInterface(ICompositionObject) -> get_Compositor()
+ *     -> dcompi!ExternalTargetImpl<...>::EnsureSystemBackdropVisual      (rva 0xc6684)
+ *          MakeAndInitialize<SystemVisualProxyVisualPrivate>(liftedCompositor)
+ *              -> DCompPrivates_CreateSharedVisualHandle() -> dcomp!DCompositionCreateSharedVisualHandle
+ *          compositor->CreateSpriteVisual(&sprite)              ; rva 0xc68a6, ICompositor slot 22
+ *          sprite->QueryInterface(IVisual, &visual)             ; rva 0xc68f9, IID at dcompi 0x258a28
+ *          visual->put_Size({w, h})                             ; rva 0xc698b, IVisual slot 36 (offset 0x120)
+ *          handle = proxy->GetHandle()
+ *          DCompPrivates_OpenAndAttachSharedTarget(compositor, visual, handle, &target)  ; rva 0xc6a16
+ *     -> back in SetSystemBackdrop: sprite->put_Brush(brush)    ; rva 0xc7865, ISpriteVisual slot 7
+ *
+ * so the sprite visual has to be a DirectComposition visual that a dcomp target
+ * can be rooted at (target.c), and put_Brush has to not fail.
+ */
+
+struct visual_collection;
+
+struct composition_visual
+{
+    struct composition_object object;   /* must be first: owns the refcount */
+
+    IVisual IVisual_iface;
+    IVisual2 IVisual2_iface;
+    IContainerVisual IContainerVisual_iface;    /* container and sprite only */
+    ISpriteVisual ISpriteVisual_iface;          /* sprite only */
+
+    enum composition_visual_kind kind;
+
+    /* the DirectComposition visual this wraps; NULL if the compositor was built
+     * without a dcomp device (a prefix with no or a native dcomp.dll) */
+    IDCompositionVisual2 *dcomp_visual;
+
+    struct visual_collection *children;         /* container and sprite only, strong */
+
+    ICompositionBrush *brush;                   /* sprite only, strong */
+    Color brush_color;                          /* what @brush resolves to, if has_brush_color */
+    BOOL has_brush_color;
+    ICompositionClip *clip;                     /* strong */
+
+    Vector2 anchor_point;
+    Vector3 center_point;
+    Vector3 offset;
+    Vector3 rotation_axis;
+    Vector3 scale;
+    Vector2 size;
+    Quaternion orientation;
+    Matrix4x4 transform_matrix;
+    FLOAT opacity;
+    FLOAT rotation_angle;
+    IVisual *parent_for_transform;              /* IVisual2, strong */
+    Vector3 relative_offset_adjustment;         /* IVisual2 */
+    Vector2 relative_size_adjustment;           /* IVisual2 */
+    boolean is_visible;
+    CompositionBackfaceVisibility backface_visibility;
+    CompositionBorderMode border_mode;
+    CompositionCompositeMode composite_mode;
+};
+
+/*
+ * VisualCollection: ContainerVisual::Children.  Keeps the ordered list of child
+ * IVisual * and mirrors every change onto the owner's DirectComposition visual
+ * with AddVisual()/RemoveVisual()/RemoveAllVisuals().
+ */
+struct visual_collection_entry
+{
+    struct list entry;
+    IVisual *visual;                            /* strong */
+};
+
+struct visual_collection
+{
+    struct composition_object object;           /* must be first: owns the refcount */
+    IVisualCollection IVisualCollection_iface;
+
+    /* Weak: the owner holds the only strong reference to its collection and
+     * clears this before it releases it, so the collection can never outlive a
+     * dangling owner. */
+    struct composition_visual *owner;
+    struct list children;
+    INT32 count;
+};
+
+static struct composition_visual *composition_visual_from_composition_object( struct composition_object *obj )
+{
+    return CONTAINING_RECORD( obj, struct composition_visual, object );
+}
+
+static struct visual_collection *visual_collection_from_composition_object( struct composition_object *obj )
+{
+    return CONTAINING_RECORD( obj, struct visual_collection, object );
+}
+
+/* Every IID an inner dcomp visual may be able to answer; anything in this list
+ * is forwarded verbatim, so dcomp decides what it supports (dlls/dcomp/visual.c
+ * visual_QueryInterface()).  IDCompositionVisual is the one the shared-visual
+ * target needs; the private {2c4eef28-...} one is what FrameworkUdk's
+ * SetVisualSize/SetVisualRelativeSize/SetTransparentForInput use. */
+static const IID *dcomp_visual_iids[] =
+{
+    &IID_IDCompositionVisual,
+    &IID_IDCompositionVisual2,
+    &IID_IDCompositionVisualUnknown,
+};
+
+IDCompositionVisual *composition_visual_get_dcomp_visual( IVisual *iface )
+{
+    IDCompositionVisual *visual;
+
+    if (!iface) return NULL;
+    if (FAILED(IVisual_QueryInterface( iface, &IID_IDCompositionVisual, (void **)&visual )))
+    {
+        WARN( "IVisual %p has no IDCompositionVisual.\n", iface );
+        return NULL;
+    }
+    return visual;
+}
+
+/*
+ * VisualCollection.
+ */
+static HRESULT visual_collection_query_interface( struct composition_object *obj, REFIID iid, void **out )
+{
+    struct visual_collection *impl = visual_collection_from_composition_object( obj );
+
+    if (IsEqualGUID( iid, &IID_IVisualCollection ))
+    {
+        IInspectable_AddRef( (*(IInspectable **)out = (IInspectable *)&impl->IVisualCollection_iface) );
+        return S_OK;
+    }
+
+    return E_NOINTERFACE;
+}
+
+static void visual_collection_destroy( struct composition_object *obj )
+{
+    struct visual_collection *impl = visual_collection_from_composition_object( obj );
+    struct visual_collection_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &impl->children, struct visual_collection_entry, entry )
+    {
+        list_remove( &entry->entry );
+        IVisual_Release( entry->visual );
+        free( entry );
+    }
+    free( impl );
+}
+
+static const struct composition_object_ops visual_collection_ops =
+{
+    RuntimeClass_Windows_UI_Composition_VisualCollection,
+    ARRAY_SIZE(RuntimeClass_Windows_UI_Composition_VisualCollection) - 1,
+    visual_collection_query_interface,
+    visual_collection_destroy,
+};
+
+DEFINE_COMPOSITION_OBJECT_IINSPECTABLE( visual_collection, IVisualCollection, struct visual_collection,
+                                        object, IVisualCollection_iface )
+
+static struct visual_collection_entry *visual_collection_find( struct visual_collection *impl, IVisual *visual )
+{
+    struct visual_collection_entry *entry;
+
+    LIST_FOR_EACH_ENTRY( entry, &impl->children, struct visual_collection_entry, entry )
+        if (entry->visual == visual) return entry;
+    return NULL;
+}
+
+/* Insert @child into the list at @pos and, if both sides have a dcomp visual
+ * behind them, mirror it with IDCompositionVisual::AddVisual(). */
+static HRESULT visual_collection_insert( struct visual_collection *impl, IVisual *child,
+                                         struct list *pos, BOOL insert_above, IVisual *sibling )
+{
+    struct visual_collection_entry *entry;
+    IDCompositionVisual *dcomp_child, *dcomp_sibling = NULL;
+    HRESULT hr = S_OK;
+
+    if (!child) return E_INVALIDARG;
+    if (!impl->owner) return RO_E_CLOSED;
+    if (visual_collection_find( impl, child )) return E_INVALIDARG;
+
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    entry->visual = child;
+    IVisual_AddRef( child );
+    list_add_before( pos, &entry->entry );
+    impl->count++;
+
+    if (impl->owner->dcomp_visual && (dcomp_child = composition_visual_get_dcomp_visual( child )))
+    {
+        if (sibling) dcomp_sibling = composition_visual_get_dcomp_visual( sibling );
+        hr = IDCompositionVisual2_AddVisual( impl->owner->dcomp_visual, dcomp_child, insert_above, dcomp_sibling );
+        if (dcomp_sibling) IDCompositionVisual_Release( dcomp_sibling );
+        IDCompositionVisual_Release( dcomp_child );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI visual_collection_get_Count( IVisualCollection *iface, INT32 *value )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_collection_InsertAbove( IVisualCollection *iface, IVisual *child, IVisual *sibling )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    struct visual_collection_entry *ref;
+
+    TRACE( "iface %p, child %p, sibling %p.\n", iface, child, sibling );
+
+    if (!(ref = visual_collection_find( impl, sibling ))) return E_INVALIDARG;
+    /* the list runs bottom to top, so "above sibling" is the position after it */
+    return visual_collection_insert( impl, child, ref->entry.next, TRUE, sibling );
+}
+
+static HRESULT WINAPI visual_collection_InsertAtBottom( IVisualCollection *iface, IVisual *child )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+
+    TRACE( "iface %p, child %p.\n", iface, child );
+
+    return visual_collection_insert( impl, child, list_head( &impl->children ) ? list_head( &impl->children )
+                                                                              : &impl->children,
+                                     FALSE, NULL );
+}
+
+static HRESULT WINAPI visual_collection_InsertAtTop( IVisualCollection *iface, IVisual *child )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+
+    TRACE( "iface %p, child %p.\n", iface, child );
+
+    return visual_collection_insert( impl, child, &impl->children, TRUE, NULL );
+}
+
+static HRESULT WINAPI visual_collection_InsertBelow( IVisualCollection *iface, IVisual *child, IVisual *sibling )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    struct visual_collection_entry *ref;
+
+    TRACE( "iface %p, child %p, sibling %p.\n", iface, child, sibling );
+
+    if (!(ref = visual_collection_find( impl, sibling ))) return E_INVALIDARG;
+    return visual_collection_insert( impl, child, &ref->entry, FALSE, sibling );
+}
+
+static HRESULT WINAPI visual_collection_Remove( IVisualCollection *iface, IVisual *child )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    struct visual_collection_entry *entry;
+    IDCompositionVisual *dcomp_child;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, child %p.\n", iface, child );
+
+    if (!(entry = visual_collection_find( impl, child ))) return E_INVALIDARG;
+
+    if (impl->owner && impl->owner->dcomp_visual && (dcomp_child = composition_visual_get_dcomp_visual( child )))
+    {
+        hr = IDCompositionVisual2_RemoveVisual( impl->owner->dcomp_visual, dcomp_child );
+        IDCompositionVisual_Release( dcomp_child );
+    }
+
+    list_remove( &entry->entry );
+    impl->count--;
+    IVisual_Release( entry->visual );
+    free( entry );
+    return hr;
+}
+
+static HRESULT WINAPI visual_collection_RemoveAll( IVisualCollection *iface )
+{
+    struct visual_collection *impl = impl_from_IVisualCollection( iface );
+    struct visual_collection_entry *entry, *next;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p.\n", iface );
+
+    if (impl->owner && impl->owner->dcomp_visual)
+        hr = IDCompositionVisual2_RemoveAllVisuals( impl->owner->dcomp_visual );
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &impl->children, struct visual_collection_entry, entry )
+    {
+        list_remove( &entry->entry );
+        IVisual_Release( entry->visual );
+        free( entry );
+    }
+    impl->count = 0;
+    return hr;
+}
