+ * become an IDCompositionVisual::SetTransform() once dcomp composites with a
+ * transform; size/relative size have private dcomp slots
+ * (survey/impl-presentation.md section 2.3) that no public header declares. */
+#define VISUAL_RECORD_SETTER( name, type, fmt, ... )                                               \
+    static HRESULT WINAPI visual_put_##name( IVisual *iface, type value )                          \
+    {                                                                                              \
+        struct composition_visual *impl = impl_from_IVisual( iface );                              \
+        TRACE( "iface %p, value " fmt ".\n", iface, ## __VA_ARGS__ );                               \
+        impl->name = value;                                                                        \
+        return S_OK;                                                                               \
+    }
