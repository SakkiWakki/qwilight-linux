+
+int inproc_sync_try_wait( struct object *obj )
+{
+    return -1;
+}
+
+struct inproc_waiter *create_inproc_waiter( struct object *obj, inproc_waiter_callback callback, void *private )
+{
+    set_error( STATUS_NOT_IMPLEMENTED );
+    return NULL;
+}
+
+void cancel_inproc_waiter( struct inproc_waiter *waiter )
+{
+}
