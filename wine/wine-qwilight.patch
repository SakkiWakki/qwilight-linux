+static void manager_update_status( struct manager2 *mgr )
+{
+    UI_ANIMATION_MANAGER_STATUS status = list_empty( &mgr->storyboards ) ? UI_ANIMATION_MANAGER_IDLE : UI_ANIMATION_MANAGER_BUSY;
+    UI_ANIMATION_MANAGER_STATUS previous = mgr->status;
+
+    if (status == previous) return;
+    mgr->status = status;
+    TRACE( "manager %p: %d -> %d.\n", mgr, previous, status );
+    if (mgr->handler) IUIAnimationManagerEventHandler2_OnManagerStatusChanged( mgr->handler, status, previous );
+}
+
+/* Take the storyboard out of the manager's active list (it keeps a reference while listed). */
+static void storyboard_unlist( struct storyboard2 *sb )
+{
+    struct sb_transition *st;
+
+    if (!sb->in_list) return;
+    list_remove( &sb->entry );
+    sb->in_list = FALSE;
+    LIST_FOR_EACH_ENTRY( st, &sb->transitions, struct sb_transition, entry )
+    {
+        if (st->variable->current == sb) st->variable->current = NULL;
+        st->transition->scheduled = FALSE;
+    }
+    IUIAnimationStoryboard2_Release( &sb->IUIAnimationStoryboard2_iface );
+}
+
+static double storyboard_keyframe_offset( struct storyboard2 *sb, int index );
+
+static double storyboard_transition_end( struct storyboard2 *sb, int index )
+{
+    struct sb_transition *st;
+    int i = 0;
+    LIST_FOR_EACH_ENTRY( st, &sb->transitions, struct sb_transition, entry )
+        if (i++ == index) return st->end;
+    return 0.0;
+}
+
+static double storyboard_keyframe_offset( struct storyboard2 *sb, int index )
+{
+    struct keyframe *kf;
+
+    if (index < 0 || index >= (int)sb->keyframe_count) return 0.0;
+    kf = &sb->keyframes[index];
+    if (kf->is_resolved) return kf->resolved;
+    kf->is_resolved = TRUE;   /* guards against cycles */
+    if (kf->kind == KF_OFFSET)
+        kf->resolved = (kf->base < 0 ? 0.0 : storyboard_keyframe_offset( sb, kf->base )) + kf->offset;
+    else
+        kf->resolved = storyboard_transition_end( sb, kf->base );
+    return kf->resolved;
+}
+
+static int keyframe_index( UI_ANIMATION_KEYFRAME kf )
+{
+    if (kf == UI_ANIMATION_KEYFRAME_STORYBOARD_START) return -1;
+    return (int)(ULONG_PTR)kf - 1;
+}
+
+/* Lay the transitions out in time from the variables' current values. */
+static void storyboard_resolve( struct storyboard2 *sb )
+{
+    struct sb_transition *st;
+    struct variable2 *var;
+    unsigned int i;
+    int index = 0;
+
+    for (i = 0; i < sb->keyframe_count; i++) sb->keyframes[i].is_resolved = FALSE;
+
+    /* projected value per variable: kept in variable->final while resolving */
+    LIST_FOR_EACH_ENTRY( st, &sb->transitions, struct sb_transition, entry )
+        memcpy( st->variable->final, st->variable->value, sizeof(st->variable->value) );
+
+    sb->end_offset = 0.0;
+    LIST_FOR_EACH_ENTRY( st, &sb->transitions, struct sb_transition, entry )
+    {
+        struct sb_transition *prev;
+        double v0[WAM_MAX_DIM];
+
+        var = st->variable;
+        if (st->start_keyframe >= 0) st->start = storyboard_keyframe_offset( sb, st->start_keyframe );
+        else
+        {
+            st->start = 0.0;
+            LIST_FOR_EACH_ENTRY( prev, &sb->transitions, struct sb_transition, entry )
+            {
+                if (prev == st) break;
+                if (prev->variable == var && prev->end > st->start) st->start = prev->end;
+            }
+        }
+        memcpy( v0, var->final, sizeof(v0) );
+        transition_resolve( st->transition, v0, NULL );
+        if (st->end_keyframe >= 0)
+        {
+            double end = storyboard_keyframe_offset( sb, st->end_keyframe );
+            if (end > st->start) st->transition->resolved_duration = end - st->start;
+        }
+        st->end = st->start + st->transition->resolved_duration;
+        st->done = FALSE;
+        st->transition->scheduled = TRUE;
+        transition_value( st->transition, st->transition->resolved_duration, st->transition->end_value );
+        memcpy( var->final, st->transition->end_value, var->dim * sizeof(double) );
+        if (st->end > sb->end_offset) sb->end_offset = st->end;
+        /* keyframes placed after this transition become known now */
+        for (i = 0; i < sb->keyframe_count; i++)
+            if (sb->keyframes[i].kind == KF_AFTER_TRANSITION && sb->keyframes[i].base == index)
+            {
+                sb->keyframes[i].resolved = st->end;
+                sb->keyframes[i].is_resolved = TRUE;
+            }
+        index++;
+    }
+}
+
+/* Advance the storyboard to the given time; returns TRUE when a variable changed. */
+static BOOL storyboard_update( struct storyboard2 *sb, double now )
+{
+    struct sb_transition *st;
+    BOOL changed = FALSE, all_done = TRUE;
+    double value[WAM_MAX_DIM];
+
+    sb->elapsed = now - sb->start_time;
+    if (sb->elapsed < 0.0) sb->elapsed = 0.0;
+    if (sb->status == UI_ANIMATION_STORYBOARD_SCHEDULED) storyboard_set_status( sb, UI_ANIMATION_STORYBOARD_PLAYING );
+
+    LIST_FOR_EACH_ENTRY( st, &sb->transitions, struct sb_transition, entry )
+    {
+        if (st->done) continue;
+        if (sb->elapsed < st->start) { all_done = FALSE; continue; }
+        if (sb->elapsed >= st->end)
+        {
+            memcpy( value, st->transition->end_value, st->variable->dim * sizeof(double) );
+            st->done = TRUE;
+        }
+        else
+        {
+            transition_value( st->transition, sb->elapsed - st->start, value );
+            all_done = FALSE;
+        }
+        variable_set_value( st->variable, sb, value, &changed );
+    }
+    if (changed && sb->handler)
+        IUIAnimationStoryboardEventHandler2_OnStoryboardUpdated( sb->handler, &sb->IUIAnimationStoryboard2_iface );
+    if (all_done)
+    {
+        IUIAnimationStoryboard2_AddRef( &sb->IUIAnimationStoryboard2_iface );
+        storyboard_set_status( sb, UI_ANIMATION_STORYBOARD_FINISHED );
+        storyboard_unlist( sb );
+        storyboard_set_status( sb, UI_ANIMATION_STORYBOARD_READY );
+        IUIAnimationStoryboard2_Release( &sb->IUIAnimationStoryboard2_iface );
+    }
+    return changed;
+}
