+/* One GL share group per physical adapter per process: a "root" context per
+ * adapter LUID that every device context shares with, so that texture,
+ * renderbuffer and sync object names are a single namespace across all
+ * wined3d devices (and all struct wined3d instances) on the adapter. Root
+ * contexts are never made current and never destroyed. The table has its own
+ * lock because device contexts are created on command stream threads, which
+ * must not take wined3d_mutex. */
+struct wined3d_root_gl_ctx
+{
+    LUID luid;
+    HGLRC gl_ctx;
+};
+
+static struct wined3d_root_gl_ctx *root_gl_ctxs;
+static SIZE_T root_gl_ctx_count, root_gl_ctx_size;
+
+static CRITICAL_SECTION root_gl_ctx_cs;
+static CRITICAL_SECTION_DEBUG root_gl_ctx_cs_debug =
+{
+    0, 0, &root_gl_ctx_cs,
+    {&root_gl_ctx_cs_debug.ProcessLocksList, &root_gl_ctx_cs_debug.ProcessLocksList},
+    0, 0, {(DWORD_PTR)(__FILE__ ": root_gl_ctx_cs")}
+};
+static CRITICAL_SECTION root_gl_ctx_cs = {&root_gl_ctx_cs_debug, -1, 0, 0, 0, 0};
+
+static HGLRC wined3d_context_gl_create_root_ctx(const struct wined3d_gl_info *gl_info)
+{
+    PIXELFORMATDESCRIPTOR pfd;
+    HGLRC gl_ctx = NULL;
+    int pixel_format;
+    HWND wnd;
+    HDC dc;
+
+    /* Like wined3d_caps_gl_ctx_create(): a hidden window, since GetDC(0)
+     * can't be given a pixel format. The window is intentionally leaked; it
+     * goes away with its thread, which does not affect the GL context. */
+    if (!(wnd = CreateWindowA(WINED3D_OPENGL_WINDOW_CLASS_NAME, "WineD3D shared GL context",
+            WS_OVERLAPPEDWINDOW, 10, 10, 10, 10, NULL, NULL, NULL, NULL)))
+    {
+        ERR("Failed to create a window.\n");
+        return NULL;
+    }
+    if (!(dc = GetDC(wnd)))
+    {
+        ERR("Failed to get a DC.\n");
+        DestroyWindow(wnd);
+        return NULL;
+    }
+
+    memset(&pfd, 0, sizeof(pfd));
+    pfd.nSize = sizeof(pfd);
+    pfd.nVersion = 1;
+    pfd.dwFlags = PFD_SUPPORT_OPENGL | PFD_DOUBLEBUFFER | PFD_DRAW_TO_WINDOW;
+    pfd.iPixelType = PFD_TYPE_RGBA;
+    pfd.cColorBits = 32;
+    pfd.iLayerType = PFD_MAIN_PLANE;
+
+    if (!(pixel_format = ChoosePixelFormat(dc, &pfd)) || !SetPixelFormat(dc, pixel_format, &pfd))
+    {
+        ERR("Failed to set a pixel format, last error %#lx.\n", GetLastError());
+        goto done;
+    }
+
+    if (gl_info->p_wglCreateContextAttribsARB)
+        gl_ctx = context_create_wgl_attribs(gl_info, dc, NULL);
+    else
+        gl_ctx = wglCreateContext(dc);
+    if (!gl_ctx)
+        ERR("Failed to create the root GL context, last error %#lx.\n", GetLastError());
+
+done:
+    ReleaseDC(wnd, dc);
+    return gl_ctx;
+}
+
+static HGLRC wined3d_context_gl_get_root_ctx(const struct wined3d_adapter_gl *adapter_gl)
+{
+    const LUID *luid = &adapter_gl->a.luid;
+    HGLRC gl_ctx = NULL;
+    SIZE_T i;
+
+    EnterCriticalSection(&root_gl_ctx_cs);
+
+    for (i = 0; i < root_gl_ctx_count; ++i)
+    {
+        if (root_gl_ctxs[i].luid.LowPart == luid->LowPart && root_gl_ctxs[i].luid.HighPart == luid->HighPart)
+        {
+            gl_ctx = root_gl_ctxs[i].gl_ctx;
+            goto done;
+        }
+    }
+
+    if (!wined3d_array_reserve((void **)&root_gl_ctxs, &root_gl_ctx_size,
+            root_gl_ctx_count + 1, sizeof(*root_gl_ctxs)))
+        goto done;
+
+    if (!(gl_ctx = wined3d_context_gl_create_root_ctx(&adapter_gl->gl_info)))
+        goto done;
+
+    TRACE("Created root GL context %p for adapter LUID %08lx:%08lx.\n", gl_ctx, luid->HighPart, luid->LowPart);
+    root_gl_ctxs[root_gl_ctx_count].luid = *luid;
+    root_gl_ctxs[root_gl_ctx_count].gl_ctx = gl_ctx;
+    ++root_gl_ctx_count;
+
+done:
+    LeaveCriticalSection(&root_gl_ctx_cs);
+    return gl_ctx;
+}
