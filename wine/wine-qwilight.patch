+    if (env && *env == '0') return FALSE;
+    if (!(style & WS_POPUP) || (style & WS_CHILD) || !GetWindow(hwnd, GW_OWNER)) return FALSE;
+    if (!(ex_style & WS_EX_NOREDIRECTIONBITMAP)) return FALSE;
+    if (!(ex_style & WS_EX_LAYERED))
+        SetWindowLongW(hwnd, GWL_EXSTYLE, ex_style | WS_EX_LAYERED);
+    return TRUE;
