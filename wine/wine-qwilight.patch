+DEFINE_IINSPECTABLE( site_statics, IInputSiteStatics, struct input_site_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI site_statics_GetForVisual( IInputSiteStatics *iface, IInspectable *visual, IInspectable **site )
+{
+    TRACE( "iface %p, visual %p, site %p.\n", iface, visual, site );
+
+    if (!site) return E_POINTER;
+    *site = NULL;
+    if (!visual) return E_INVALIDARG;
