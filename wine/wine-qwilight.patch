+static BOOL property_transform_supports(enum property_transform_kind kind, REFIID iid)
+{
+    static const IID *const iids[][2] =
+    {
+        {&IID_IDCompositionTranslateTransform, &IID_IDCompositionTransform},
+        {&IID_IDCompositionScaleTransform, &IID_IDCompositionTransform},
+        {&IID_IDCompositionRotateTransform, &IID_IDCompositionTransform},
+        {&IID_IDCompositionSkewTransform, &IID_IDCompositionTransform},
+        {&IID_IDCompositionTranslateTransform3D, NULL},
+        {&IID_IDCompositionScaleTransform3D, NULL},
+        {&IID_IDCompositionRotateTransform3D, NULL},
+    };
+    return IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDCompositionEffect)
+            || IsEqualGUID(iid, &IID_IDCompositionTransform3D)
+            || IsEqualGUID(iid, iids[kind][0]) || (iids[kind][1] && IsEqualGUID(iid, iids[kind][1]));
+}
