+
+    LIST_FOR_EACH_ENTRY( binding, &impl->sources, struct effect_source_binding, entry )
+    {
+        if (SUCCEEDED(WindowsCompareStringOrdinal( binding->name, name, &order )) && !order)
+            return binding;
+    }
+    return NULL;
