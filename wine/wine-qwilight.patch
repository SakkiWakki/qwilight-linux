+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE threadpool_timer_get_Period(IThreadPoolTimer *iface, TimeSpan *value)
+{
+    struct threadpool_timer *timer = impl_from_IThreadPoolTimer(iface);
