+/* Read the HRESULT out of an IRestrictedErrorInfo. The object stored for the
+ * thread can come from SetRestrictedErrorInfo() and need not be one of ours, so
+ * always go through the interface. */
+static HRESULT restricted_error_info_get_error(IRestrictedErrorInfo *iface, HRESULT *error)
+{
+    BSTR description = NULL, restricted_description = NULL, capability_sid = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = IRestrictedErrorInfo_GetErrorDetails(iface, &description, error,
+            &restricted_description, &capability_sid)))
+        return hr;
+
+    SysFreeString(description);
+    SysFreeString(restricted_description);
+    SysFreeString(capability_sid);
+    return S_OK;
+}
+
+/* Replace the calling thread's originated error with one carrying new_error.
+ *
+ * WIL's error macros call this whenever they map one HRESULT onto another, so
+ * that the originated information keeps describing the error the caller will
+ * actually see. An error that is not the one being transformed is left alone,
+ * and an old_error of S_OK matches whatever the thread holds. Nothing here may
+ * fail the calling code: the return value only says whether the stored error
+ * was replaced, the HRESULT the caller is propagating is untouched either way. */
+static BOOL transform_restricted_error(HRESULT old_error, HRESULT new_error, HSTRING message)
+{
+    HSTRING_HEADER header;
+    struct tlsdata *tlsdata;
+    HSTRING kept = NULL;
+    BSTR description = NULL;
+    HRESULT stored;
+    BOOL ret;
+
+    if (SUCCEEDED(new_error))
+        return FALSE;
+
+    if (FAILED(com_get_tlsdata(&tlsdata)))
+        return FALSE;
+
+    if (tlsdata->restricted_errorinfo)
+    {
+        BSTR restricted_description = NULL, capability_sid = NULL;
+
+        if (FAILED(IRestrictedErrorInfo_GetErrorDetails(tlsdata->restricted_errorinfo, &description,
+                &stored, &restricted_description, &capability_sid)))
+            return FALSE;
+        SysFreeString(restricted_description);
+        SysFreeString(capability_sid);
+
+        if (old_error != S_OK && stored != old_error)
+        {
+            SysFreeString(description);
+            return FALSE;
+        }
+
+        /* Keep the description of the error being transformed when the caller
+         * does not supply a new one. */
+        if (!message && description
+                && SUCCEEDED(WindowsCreateStringReference(description, SysStringLen(description), &header, &kept)))
+            message = kept;
+    }
+
+    ret = originate_restricted_error(new_error, message, NULL);
+    SysFreeString(description);
+    return ret;
+}
+
+/***********************************************************************
+ *      RoTransformError (combase.@)
+ */
+BOOL WINAPI RoTransformError(HRESULT old_error, HRESULT new_error, HSTRING message)
+{
+    TRACE("%#lx, %#lx, %s\n", old_error, new_error, debugstr_hstring(message));
+
+    return transform_restricted_error(old_error, new_error, message);
+}
+
+/***********************************************************************
+ *      RoTransformErrorW (combase.@)
+ */
+BOOL WINAPI RoTransformErrorW(HRESULT old_error, HRESULT new_error, UINT max_len, const WCHAR *message)
+{
+    HSTRING_HEADER header;
+    HSTRING string;
+    UINT len;
+
+    TRACE("%#lx, %#lx, %u, %s\n", old_error, new_error, max_len, debugstr_w(message));
+
+    len = message ? wcslen(message) : 0;
+    if (max_len && len > max_len)
+        len = max_len;
+
+    if (FAILED(WindowsCreateStringReference(message, len, &header, &string)))
+        return FALSE;
+
+    return transform_restricted_error(old_error, new_error, string);
+}
+
+/***********************************************************************
+ *      RoGetMatchingRestrictedErrorInfo (combase.@)
+ */
+HRESULT WINAPI RoGetMatchingRestrictedErrorInfo(HRESULT error, IRestrictedErrorInfo **info)
+{
+    struct tlsdata *tlsdata;
+    HRESULT hr, stored;
+
+    TRACE("%#lx, %p\n", error, info);
+
+    if (!info)
+        return E_INVALIDARG;
+
+    *info = NULL;
+
+    if (FAILED(hr = com_get_tlsdata(&tlsdata)))
+        return hr;
+
+    if (!tlsdata->restricted_errorinfo)
+        return S_FALSE;
+
+    if (FAILED(restricted_error_info_get_error(tlsdata->restricted_errorinfo, &stored)) || stored != error)
+        return S_FALSE;
+
+    /* The error matches, so it is handed to the caller and cleared from the
+     * thread, the same way GetRestrictedErrorInfo() does. */
+    *info = tlsdata->restricted_errorinfo;
+    tlsdata->restricted_errorinfo = NULL;
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *      IsErrorPropagationEnabled (combase.@)
+ */
+BOOL WINAPI IsErrorPropagationEnabled(void)
+{
+    TRACE("()\n");
+
+    /* Originated errors are recorded for the thread and handed to the language
+     * projection, so callers may propagate them. */
+    return TRUE;
+}
+
+/***********************************************************************
+ *      RoReportFailedDelegate (combase.@)
+ */
+HRESULT WINAPI RoReportFailedDelegate(IUnknown *delegate, IRestrictedErrorInfo *info)
+{
+    HRESULT error = S_OK;
+
+    if (info)
+        restricted_error_info_get_error(info, &error);
+
+    FIXME("%p, %p (error %#lx): stub\n", delegate, info, error);
+
+    return S_OK;
+}
