+static ULONG STDMETHODCALLTYPE transform_group_Release(IUnknown *iface)
+{
+    struct composition_transform_group *group = impl_from_transform_group(iface);
+    ULONG ref = InterlockedDecrement(&group->ref);
+    UINT i;
+
+    TRACE("iface %p, ref %lu.\n", iface, ref);
+    if (!ref)
+    {
+        for (i = 0; i < group->count; ++i)
+            if (group->members[i]) IUnknown_Release(group->members[i]);
+        free(group->members);
+        free(group);
+    }
+    return ref;
