+static HRESULT WINAPI storyboard2_AddTransition( IUIAnimationStoryboard2 *iface, IUIAnimationVariable2 *variable,
+        IUIAnimationTransition2 *transition )
+{
+    struct storyboard2 *This = impl_from_IUIAnimationStoryboard2( iface );
+    TRACE( "%p, %p, %p.\n", iface, variable, transition );
+    return storyboard_add( This, variable, transition, -1, -1 );
+}
+
+static HRESULT storyboard_add_keyframe( struct storyboard2 *This, enum keyframe_kind kind, int base, double offset,
+        UI_ANIMATION_KEYFRAME *keyframe )
+{
+    struct keyframe *kf;
+
+    if (!keyframe) return E_POINTER;
+    if (This->keyframe_count >= WAM_MAX_KEYFRAMES) return E_OUTOFMEMORY;
+    kf = &This->keyframes[This->keyframe_count];
+    kf->kind = kind;
+    kf->base = base;
+    kf->offset = offset;
+    kf->is_resolved = FALSE;
+    *keyframe = (UI_ANIMATION_KEYFRAME)(ULONG_PTR)(This->keyframe_count + 1);
+    This->keyframe_count++;
+    return S_OK;
+}
