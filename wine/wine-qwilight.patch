+static HRESULT WINAPI storyboard2_AddKeyframeAfterTransition( IUIAnimationStoryboard2 *iface,
+        IUIAnimationTransition2 *transition, UI_ANIMATION_KEYFRAME *keyframe )
+{
+    struct storyboard2 *This = impl_from_IUIAnimationStoryboard2( iface );
+    struct sb_transition *st;
+    int index = 0;
+
+    TRACE( "%p, %p, %p.\n", iface, transition, keyframe );
+
+    LIST_FOR_EACH_ENTRY( st, &This->transitions, struct sb_transition, entry )
+    {
+        if (&st->transition->IUIAnimationTransition2_iface == transition)
+            return storyboard_add_keyframe( This, KF_AFTER_TRANSITION, index, 0.0, keyframe );
+        index++;
+    }
+    return E_INVALIDARG;
+}
